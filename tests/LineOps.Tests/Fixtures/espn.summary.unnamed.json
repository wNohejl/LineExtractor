            "athletes": [
              {
                "athlete": {
                  "id": "p-100",
                  "displayName": "Shohei Ohtani",
                  "position": { "abbreviation": "DH" }
                },
                "stats": [ "4", "1", "2", "3" ]
              },
              {
                "athlete": {
                  "id": "p-200",
                  "displayName": "Cal Raleigh",
                  "position": { "abbreviation": "C" }
                },
                "stats": [ "5", "0", "1", "0" ]
              }
            ]
          },
          {
            "//": "The pitching group. The same two-way player appears again, and H now means hits allowed.",
            "labels": [ "IP", "H", "ER", "K" ],
            "athletes": [
              {
                "athlete": { "id": "p-100", "displayName": "Shohei Ohtani" },
                "stats": [ "6.0", "5", "2", "9" ]
              }

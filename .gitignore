bin/
obj/
.vs/
.vscode/
*.user
*.suo

# Local agent/editor tooling. Machine-specific and nobody else's business, except the
# project's skills, which are shared: a new one is committed without needing `git add -f`.
.claude/*
!.claude/skills/

# Local secrets: API keys belong in user-secrets or environment variables, never in the repo.
# .env holds the database and certificate passwords; .env.example is the committed template.
appsettings.Local.json
appsettings.*.Local.json
.env
!.env.example

# Certificates must never be committed, whatever the extension.
*.pfx
*.p12
*.key
*.pem

# The hosted stack's nightly dumps, if deploy/ is ever run from a clone.
deploy/backups/

# The journal, parlays and operator settings in transit between your own machines
# (scripts/publish-journal.ps1). Never committed: the repository is public.
data/personal/
# The clone of the private journal repository (CLAUDE.md, "The journal").
/lineops-journal/
# A database snapshot never enters this public repository: it lives in data/personal/snapshots.
data/snapshots/

@namespace XLines.Desk.Primitives

@*
    A grouped form, drawn as a section card: the house shape for asking the operator for
    something, and for one section of a window that holds several.

    One card — the group fill with one hairline edge — whose name sits INSIDE it, in a header bar
    at its top: the title in the headline style (semibold, the primary ink) and, trailing, an
    optional key, count or segmented filter (Keys). A full-width hairline divides the bar from
    the rows, and the rows inside are divided by inset hairlines; nothing inside draws another
    box. The sentence that explains the group is its footer, under the card — the HIG's grouped
    list, drawn the way macOS draws a grouped form (apple-hig-components, forms.md).

    The name used to be a quiet grey line floating above the group, and on a window of several
    sections the sections ran together: a header attached to nothing, a gap, a box (user report,
    Nov 22). In the bar the title belongs to its card, and the card's edge is what separates one
    section from the next. Every window used to spell this as class names, and the spelling
    drifted; the primitive is the spelling.

    The rows are FormRows, a split row (.wgroup__split) for two compact controls side by side, or
    any .wgroup__row the caller draws for a row that is not label and control (a card, a leg).
    The group is a container query root, so its rows stack their labels above their controls
    from the card's own width, not the window's.

    Several cards in one window sit in a .wflow flow, which gives them as many columns as the
    window's width allows; Span says whether this card takes one track, the whole row, or the
    rest of the row after the first card.

    The label column is the group's to set: --form-label, as a CSS length, so every row in the
    group lines its controls up on the same edge.
*@

<section class="wsection @SpanClass @Class"
         aria-labelledby="@(Title is null ? null : _headId)"
         style="@Style"
         @attributes="Rest">
    <div class="wgroup @GroupClass" style="@(LabelWidth is null ? null : $"--form-label: {LabelWidth}")">
        @if (Title is not null || Keys is not null)
        {
            <div class="wgroup__bar">
                @if (Title is not null)
                {
                    <h3 class="wgroup__title" id="@_headId">@Title</h3>
                }
                @if (Keys is not null)
                {
                    <div class="wgroup__keys">@Keys</div>
                }
            </div>
        }
        @ChildContent
    </div>

    @Notice

    @if (Footer is not null)
    {
        <p class="wgroup__foot">@Footer</p>
    }
</section>

@code {
    /// <summary>The rows.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// The card's name, in sentence case, in the header bar at its top. Leave it off for a group the
    /// window already names — with no Keys either, the card has no bar.
    /// </summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>
    /// What trails the title in the header bar: a small key, a count, or a segmented filter over the
    /// card's rows. One thing, quiet — never the window's Filled key.
    /// </summary>
    [Parameter] public RenderFragment? Keys { get; set; }

    /// <summary>
    /// A Note about the group's state — a cost worth knowing — under the card and before its footer:
    /// a box of its own, so never inside the card.
    /// </summary>
    [Parameter] public RenderFragment? Notice { get; set; }

    /// <summary>The sentence that explains the group, under the card: what it will do, what it returns.</summary>
    [Parameter] public RenderFragment? Footer { get; set; }

    /// <summary>How much of a <c>.wflow</c> flow's row the card takes. One track unless it says otherwise.</summary>
    [Parameter] public DeskCardSpan Span { get; set; } = DeskCardSpan.Track;

    /// <summary>The label column's width as a CSS length ("120px"), shared by every row; unset, the group's default.</summary>
    [Parameter] public string? LabelWidth { get; set; }

    /// <summary>Extra classes on the section.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Extra classes on the group itself, for a window's own rows.</summary>
    [Parameter] public string? GroupClass { get; set; }

    [Parameter] public string? Style { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? Rest { get; set; }

    private readonly string _headId = "fg-" + Guid.NewGuid().ToString("N")[..8];

    private string? SpanClass => Span switch
    {
        DeskCardSpan.Row => "wsection--span",
        DeskCardSpan.Rest => "wsection--rest",
        _ => null
    };
}

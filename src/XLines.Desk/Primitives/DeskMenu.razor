@namespace XLines.Desk.Primitives
@implements IAsyncDisposable
@inject IJSRuntime JS

@*
    A menu: a column of commands that the keyboard can drive.

    The hand-built menus it replaces declared role="menu" or nothing, and then left the
    keyboard on the opener: no focus into the panel, no arrows, Escape only where someone had
    remembered it. A menu the pointer can use and the keyboard cannot is half a menu.

    One Tab stop (a roving tabindex), arrows that wrap, Home and End, and typeahead — a letter
    jumps to the next item starting with it, a quick run of letters to the item starting with
    the run. Enter and Space are the focused button's own, so a key activates an item through
    the same click a pointer does and nothing can run twice. Escape asks the popover the menu
    sits in to close; the popover gives focus back to its opener. Delete or Backspace on a
    removable row (DeskMenuItem OnRemove) removes it and keeps the menu open on the next one.

    The bookkeeping is in C# wherever it can be, so it is testable: DeskMenuItems register
    here and this decides which one holds the Tab stop. Menus whose items are not
    DeskMenuItems — the workspace launcher's own buttons, which this primitive must not
    require rewriting — are driven by popover.js instead, against any [role^="menuitem"]
    descendant. Escape works for both, because it is handled here.

    A long menu is put in DeskMenuGroups: each draws its own heading and the hairline above it,
    and its rows register here through it, so the keyboard walks every row in drawn order and
    never lands on a heading.
*@

<div @ref="_element"
     class="menu @Class"
     role="menu"
     aria-label="@Label"
     tabindex="-1"
     @onkeydown="OnKeyDown">
    <CascadingValue Value="this" IsFixed="true">
        @ChildContent
    </CascadingValue>
</div>

@code {
    /// <summary>How long a run of typed letters is still one search, as the platform does it.</summary>
    private const long TypeaheadWindowMs = 500;

    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>The accessible name of the whole menu — usually the opener's own label.</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;

    /// <summary>
    /// The items are mutually exclusive choices rather than commands: each becomes a
    /// menuitemradio, and the checked one says so.
    /// </summary>
    [Parameter] public bool Radio { get; set; }

    [Parameter] public string? Class { get; set; }

    /// <summary>The popover this menu sits in, if any — what Escape and a choice close.</summary>
    [CascadingParameter] public DeskPopover? Popover { get; set; }

    // What the menu holds directly, in drawn order: rows, and DeskMenuGroups that hold their
    // own rows. A group's rows are created only when the group renders, after the menu has
    // created everything at its own level, so a single list in creation order would put a row
    // drawn after a group ahead of the group's rows; each group keeps its rows instead and the
    // arrow order is read through them.
    private readonly List<object> _entries = [];
    private ElementReference _element;
    private IJSObjectReference? _module;
    private DeskMenuItem? _active;
    private string _typed = string.Empty;
    private long _typedAt;

    // Every row, in the order it is drawn. Flattened once and kept until a row or group comes or
    // goes: every item asks for the Tab stop on every render, which reads this.
    private List<DeskMenuItem>? _rows;

    private List<DeskMenuItem> Rows() => _rows ??= _entries
        .SelectMany(e => e is DeskMenuGroup g ? g.Items : [(DeskMenuItem)e])
        .ToList();

    // Rows and groups register in the order they are created, which is the order they are
    // drawn: a render creates every child before any of them renders. A row inserted later
    // lands at the end of its group, or of the menu; the desk's menus are rebuilt on each
    // open, so none do.
    internal void Register(DeskMenuItem item, DeskMenuGroup? group)
    {
        if (group is not null)
            group.Items.Add(item);
        else
            _entries.Add(item);

        _rows = null;
    }

    internal void Unregister(DeskMenuItem item, DeskMenuGroup? group)
    {
        if (group is not null)
            group.Items.Remove(item);
        else
            _entries.Remove(item);

        _rows = null;

        if (ReferenceEquals(_active, item))
            _active = null;
    }

    internal void Register(DeskMenuGroup group)
    {
        _entries.Add(group);
        _rows = null;
    }

    internal void Unregister(DeskMenuGroup group)
    {
        _entries.Remove(group);
        _rows = null;

        if (_active is not null && group.Items.Contains(_active))
            _active = null;
    }

    /// <summary>Whether the group opens the menu, and so draws no hairline above itself.</summary>
    internal bool IsFirst(DeskMenuGroup group) => _entries.Count == 0 || ReferenceEquals(_entries[0], group);

    /// <summary>The item that holds the menu's one Tab stop.</summary>
    internal bool IsTabStop(DeskMenuItem item) => ReferenceEquals(item, Current);

    /// <summary>An item was chosen by pointer; the keyboard carries on from there if the menu stays.</summary>
    internal void Chose(DeskMenuItem item) => _active = item;

    // Focus lands on the first item that can do something. A dimmed item can still be reached
    // with the arrows, so its reason is read out, but opening on one would make the first
    // thing the menu says a refusal.
    private DeskMenuItem? Current
    {
        get
        {
            if (_active is not null)
                return _active;

            var rows = Rows();

            // A menu of choices opens on the current one, as a pop-up button's menu does, so
            // the first thing heard is what is chosen and an arrow moves from there.
            if (Radio && rows.FirstOrDefault(i => i.IsChecked && !i.Disabled) is { } chosen)
                return chosen;

            return rows.FirstOrDefault(i => !i.Disabled) ?? rows.FirstOrDefault();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _module = await JS.InvokeAsync<IJSObjectReference>("import", DeskAssets.Module("popover.js"));

        // The script stops arrow keys scrolling the panel, and drives a menu of foreign items
        // outright — including moving focus into it.
        if (_module is not null)
            await _module.InvokeVoidAsync("menu", _element);

        if (Current is { } first)
            await first.FocusAsync();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            if (Popover is not null)
                await Popover.CloseAsync();

            return;
        }

        // Foreign items are popover.js's to move between.
        if (Current is not { } current)
            return;

        if (e.Key is "Delete" or "Backspace" && current.CanRemove)
        {
            await RemoveAsync(current);
            return;
        }

        var items = Rows();
        var count = items.Count;
        var at = items.IndexOf(current);

        var next = e.Key switch
        {
            "ArrowDown" => items[(at + 1) % count],
            "ArrowUp" => items[(at - 1 + count) % count],
            "Home" => items[0],
            "End" => items[count - 1],
            _ => Typeahead(e, items, at)
        };

        if (next is null || ReferenceEquals(next, current))
            return;

        _active = next;
        current.Refresh();
        next.Refresh();

        await next.FocusAsync();
    }

    /// <summary>
    /// Removes a row from the keyboard and keeps the keyboard in the menu: the Tab stop moves first
    /// to the next removable row (the one below, else the one above), so the reader carries on down
    /// the same list rather than landing on a command after it. A removal that takes the whole menu
    /// with it (its owner closes) leaves focus to the owner.
    /// </summary>
    internal async Task RemoveAsync(DeskMenuItem row)
    {
        var rows = Rows();
        var at = rows.IndexOf(row);
        var removable = rows.Where(r => r.CanRemove && !ReferenceEquals(r, row)).ToList();
        var neighbour = removable.FirstOrDefault(r => rows.IndexOf(r) > at)
                        ?? removable.LastOrDefault(r => rows.IndexOf(r) < at);

        _active = neighbour;
        await row.RemoveAsync();

        if (neighbour is null || !Rows().Contains(neighbour))
            return;

        neighbour.Refresh();

        try
        {
            await neighbour.FocusAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or JSException or JSDisconnectedException)
        {
            // Not attached (a test renderer), or the menu went with the row.
        }
    }

    /// <summary>
    /// The item a typed letter jumps to, or null when the key is not a letter or nothing
    /// matches. A single letter searches from the item after the focused one, so pressing it
    /// again walks every item that starts with it; a run of letters searches from the focused
    /// item, so "fe" stays on "Fetch files" rather than skipping past it.
    /// </summary>
    private DeskMenuItem? Typeahead(KeyboardEventArgs e, List<DeskMenuItem> items, int at)
    {
        if (e.Key.Length != 1 || char.IsWhiteSpace(e.Key[0]) || e.CtrlKey || e.MetaKey || e.AltKey)
            return null;

        var now = Environment.TickCount64;
        _typed = now - _typedAt <= TypeaheadWindowMs ? _typed + e.Key : e.Key;
        _typedAt = now;

        // "ff" is someone pressing f twice, not searching for a word that starts "ff".
        var search = _typed.Distinct().Count() == 1 ? _typed[..1] : _typed;
        var start = search.Length == 1 ? at + 1 : at;

        for (var step = 0; step < items.Count; step++)
        {
            var candidate = items[(start + step) % items.Count];

            if (candidate.Label.StartsWith(search, StringComparison.CurrentCultureIgnoreCase))
                return candidate;
        }

        return null;
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is null)
            return;

        try
        {
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The circuit went first — nothing to release on a browser that is gone.
        }
    }
}

@using XLines.Desk.Windowing
@implements IAsyncDisposable
@inject WindowManager Manager
@inject DeskFollowUps FollowUps
@inject DeskBrand Brand
@inject IJSRuntime JS

@*
    Header and footer are fixed chrome. Between them sits the desk: one horizontal row of
    full-height columns, up to the operator's limit, with a draggable divider wherever two
    expanded ones meet. Past the limit a column holds several windows as a tab group (ADR 0027):
    every one of them is rendered here, the ones behind a tab hidden but kept.
*@
<div class="shell">

    <DeskHeader />

    <div class="shell__body">
        @* tabindex="-1": focus with nowhere else to go lands here (toasts.js), not on <body>. *@
        <main class="desk" data-desk aria-label="Desk" tabindex="-1">
            @* A declared resolution gets a real surface of that size and the desk scrolls to
               it, rather than layout pretending the screen is bigger than it is. *@
            <div class="desk__surface"
                 style="@(Fixed ? $"width:{Manager.DeskWidth}px; height:{Manager.DeskHeight}px" : null)">

                @if (Row.Count == 0)
                {
                    @* The empty desk guides to a workflow (HIG, Onboarding: let people start right
                       away, teach by doing). A headline and one sentence; then the application's
                       workspaces as the choice, the first featured with the page's one Filled key;
                       then the ones saved here; then a quieter way to open a single window; and the
                       desk's mechanics folded into a disclosure for whoever wants them. Every name,
                       description and window title comes from the catalogue the visitor may see. *@
                    var workspaces = OfferedWorkspaces(Manager.Catalog.Workspaces);
                    var saved = OfferedWorkspaces(Manager.UserWorkspaces);
                    var featured = workspaces.FirstOrDefault();

                    <div class="desk-empty">
                        <div class="desk-empty__inner">
                            <header class="desk-empty__lead">
                                <div class="desk-empty__mark" aria-hidden="true">@Brand.Wordmark<em>@Brand.Emphasis</em></div>
                                <h1 class="desk-empty__headline">@(featured is null ? "Start with a window" : "Start with a workspace")</h1>
                                <p class="desk-empty__sub">
                                    @(featured is null
                                        ? "Each window opens as a column on the desk, beside the ones already open."
                                        : "A workspace opens the windows one job needs, side by side. Pick one to begin.")
                                </p>
                            </header>

                            @if (featured is not null || saved.Count > 0)
                            {
                                @* The outline: the headline (h1), then Workspaces (h2) over every
                                   choice, each workspace and each group of them an h3. *@
                                <h2 class="sr-only">Workspaces</h2>
                            }

                            @if (featured is not null)
                            {
                                <section class="desk-empty__featured" aria-labelledby="desk-empty-featured">
                                    <span class="desk-empty__icon desk-empty__icon--featured" aria-hidden="true">
                                        <Glyph Icon="@(featured.Workspace.Icon ?? Icons.Material.Filled.Dashboard)" />
                                    </span>
                                    <div class="desk-empty__body">
                                        <h3 class="desk-empty__name" id="desk-empty-featured">@featured.Workspace.Name</h3>
                                        @if (!string.IsNullOrWhiteSpace(featured.Workspace.Description))
                                        {
                                            <p class="desk-empty__desc">@featured.Workspace.Description</p>
                                        }
                                        <p class="desk-empty__windows">Opens @featured.Windows</p>
                                    </div>
                                    <DeskButton Emphasis="DeskEmphasis.Filled" Class="desk-empty__go"
                                                OnClick="() => Apply(featured.Workspace)">
                                        Open @featured.Workspace.Name
                                    </DeskButton>
                                </section>
                            }

                            @if (workspaces.Count > 1)
                            {
                                <WorkspaceList Heading="More workspaces" Offered="@workspaces.Skip(1).ToList()"
                                               Fallback="@Icons.Material.Filled.Dashboard" OnChoose="Apply" />
                            }

                            @if (saved.Count > 0)
                            {
                                <WorkspaceList Heading="Saved on this desk" Offered="saved"
                                               Fallback="@Icons.Material.Filled.Bookmark" OnChoose="Apply" />
                            }

                            <p class="desk-empty__single">
                                @if (featured is null)
                                {
                                    <DeskButton Emphasis="DeskEmphasis.Filled" Icon="@Icons.Material.Filled.AddBox" OnClick="OpenPrimary">
                                        Open @PrimaryTitle
                                    </DeskButton>
                                }
                                else
                                {
                                    <span>Or open a single window:</span>
                                    <DeskButton Emphasis="DeskEmphasis.Plain" Size="DeskKeySize.Small" Icon="@Icons.Material.Filled.AddBox" OnClick="OpenPrimary">
                                        Open @PrimaryTitle
                                    </DeskButton>
                                }
                                <span class="desk-empty__palette">
                                    or go to anything with <kbd>Ctrl</kbd><kbd>K</kbd>
                                </span>
                            </p>

                            <DeskDisclosure Label="How the desk works" Class="desk-empty__how">
                                <ul class="desk-empty__facts">
                                    <li>Windows open as columns in one row; @PrimaryHint</li>
                                    <li>Once every column is in use, the next window joins one as a tab. Nothing closes to make room.</li>
                                    <li>Drag a column by its title to reorder the row, or the gap between two to share their width.</li>
                                </ul>
                            </DeskDisclosure>
                        </div>
                    </div>
                }

                @* Every window is rendered — the ones behind a tab, in a collapsed column and outside
                   a maximised one too — so each keeps what it holds; those not in view are hidden
                   (AppWindow). In the order they were opened, never the row's or a strip's: a
                   window whose element moved in the page would lose its scroll position, and a
                   strip reorders on every selection. Maximise used to render its column alone,
                   and every other window's input went with the rest of the row. *@
                @{ var holding = Manager.MaximisedColumn; }

                @foreach (var window in Manager.Windows)
                {
                    @* Keyed by id so Blazor reuses the element rather than recreating it and
                       losing the drag/divider bindings that point at it. *@
                    <AppWindow @key="window.Id"
                               Window="window"
                               IsFocused="Manager.FocusedId == window.Id"
                               Concealed="@(holding is not null && holding.Id != window.ColumnId)" />
                }

                @* One divider per adjacent pair of expanded tabs. Suppressed next to a
                   collapsed tab (nothing to resize there) and while a window holds the whole
                   row (there is no split to adjust). *@
                @if (!Maximised)
                {
                    @for (var i = 0; i < Row.Count - 1; i++)
                    {
                        var left = Row[i];
                        var right = Row[i + 1];

                        if (left.Minimised || right.Minimised)
                        {
                            continue;
                        }

                        var key = $"{left.Id}|{right.Id}";
                        var range = SplitRange.Of(left, right, Manager.MinWidthOf(left), Manager.MinWidthOf(right));

                        @* A focusable separator is a slider in all but name: it says where it
                           stands (the leading column's width) and how far it can go, so a
                           screen reader hears the split rather than only that there is one.
                           The readout says the same to the eye, and only while the divider is
                           held or focused from the keyboard; windowing.js keeps its figures
                           current through a drag, before the server hears of it. *@
                        <div class="divider"
                             @key="key"
                             style="left:@Px(left.X + left.Width)"
                             role="separator"
                             aria-orientation="vertical"
                             aria-label="@($"Resize {left.Title} and {right.Title}")"
                             aria-controls="@($"win-{left.Id} win-{right.Id}")"
                             aria-valuenow="@range.Now"
                             aria-valuemin="@range.Min"
                             aria-valuemax="@range.Max"
                             aria-valuetext="@($"{left.Title} {range.Now} pixels wide, {right.Title} {range.Total - range.Now}")"
                             aria-keyshortcuts="ArrowLeft ArrowRight Shift+ArrowLeft Shift+ArrowRight Home End"
                             tabindex="0"
                             @onkeydown="e => OnDividerKey(e, left, right)"
                             @ref="_dividerHandles[key]">
                            <span class="divider__grip"></span>
                            <span class="divider__readout num" aria-hidden="true">
                                <span class="divider__width" data-split-left data-width="@range.Now"></span>
                                <span class="divider__width" data-split-right data-width="@(range.Total - range.Now)"></span>
                            </span>
                        </div>
                    }
                }
            </div>
        </main>
    </div>

    <DeskFooter />

    @* Follow-ups opened from inside a floating dialog land here, where nothing clips them. *@
    <XLines.Desk.Primitives.FollowUpLayer Launcher="FollowUps.Launcher" />

    <CommandPalette />

    @* The manager's notice — a window closed, an open refused — goes to the desk's toast stack
       (the header's DeskToastStack, "Activities"), never into the header's own controls. *@
    <DeskNoticeToasts />
</div>

@code {
    private IJSObjectReference? _module;
    private DotNetObjectReference<Desk>? _self;
    private readonly Dictionary<string, ElementReference> _dividerHandles = [];
    private string _wiredDividers = string.Empty;
    private string _wiredTabs = string.Empty;
    private long _historyVersion;

    /// <summary>The window each column shows, left to right: what the dividers sit between.</summary>
    private List<WindowInstance> Row =>
        Manager.Columns.Select(c => c.Showing).ToList();

    private bool Maximised => Manager.MaximisedColumn is not null;

    private bool Fixed => Manager.Settings.ResolutionMode == ResolutionMode.Fixed;

    private WindowDefinition? Primary
        => Manager.Catalog.Find(Manager.Settings.PrimaryWindowKey ?? Manager.Catalog.DefaultPrimary);

    private string PrimaryTitle => Primary?.Title ?? "a window";

    private string PrimaryHint => Manager.Settings.PrimaryWindowKey is null
        ? "every column gets an equal share."
        : $"{PrimaryTitle} is primary, so it takes the larger share wherever it sits.";

    private static string Px(double value)
        => $"{value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}px";

    protected override void OnInitialized() => Manager.Changed += OnManagerChanged;

    /// <summary>Per product, so two desks served from one origin in development never share a row.</summary>
    private string LayoutKey => Brand.LayoutKey;

    private string? _savedLayout;
    private bool _saveQueued;

    // What the page was last told. 1 is what the stylesheet declares, so a desk at 100% never
    // makes the call at all.
    private double _appliedUiScale = 1;
    private double _appliedTextScale = 1;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", DeskAssets.Module("windowing.js"));
            _self = DotNetObjectReference.Create(this);

            // Before initialise: the first viewport report sets a default window ceiling unless
            // the operator chose one, and a restored layout carries that choice.
            _savedLayout = await _module.InvokeAsync<string?>("loadLayout", LayoutKey);
            if (DeskLayout.Parse(_savedLayout) is { } layout && Manager.Windows.Count == 0)
                Manager.Restore(layout);

            await _module.InvokeVoidAsync("initialise", _self);

            _historyVersion = Manager.HistoryVersion;
            await _module.InvokeVoidAsync("trackHistory", Manager.HistoryDepth);
        }

        if (_module is null)
            return;

        // The scale is the manager's setting and the page's zoom; this is the one place that
        // owns both the setting and the module, so it is the one place that keeps them agreed.
        // Compared rather than pushed on every render, because every change to the row
        // re-renders the desk — a resize, a focus, a divider drag.
        var (ui, text) = (Manager.Settings.UiScale, Manager.Settings.TextScale);
        if (ui != _appliedUiScale || text != _appliedTextScale)
        {
            (_appliedUiScale, _appliedTextScale) = (ui, text);
            await _module.InvokeVoidAsync("applyScale", ui, text);
        }

        // A new step on the desk becomes a browser history entry, so Back has somewhere to go.
        // A walk back or forward changes the depth but not the version, and is already an entry.
        if (Manager.HistoryVersion != _historyVersion)
        {
            _historyVersion = Manager.HistoryVersion;
            await _module.InvokeVoidAsync("pushHistory", Manager.HistoryDepth);
        }

        // Rebind dividers only when the set of adjacent pairs actually changes — a drag
        // causes renders, and rewiring mid-gesture would drop it.
        var dividerSignature = string.Join(",", _dividerHandles.Keys);
        if (dividerSignature != _wiredDividers)
        {
            _wiredDividers = dividerSignature;

            foreach (var (key, handle) in _dividerHandles)
            {
                var ids = key.Split('|');
                await _module.InvokeVoidAsync("attachDivider", handle, ids[0], ids[1]);
            }
        }

        // Tab-drag wiring only needs the id, not neighbours, so it only needs rebinding
        // when the set of open windows changes — not on every reorder or resize render. A
        // window outside a maximised column draws no bar, so a restored row has new bars to
        // wire: the column holding the row is part of the signature.
        var tabSignature = string.Join(",", Row.Select(w => w.Id)) + "|" + Manager.MaximisedColumn?.Id + "|" + Manager.ColumnCount;
        if (tabSignature != _wiredTabs)
        {
            _wiredTabs = tabSignature;
            await _module.InvokeVoidAsync("attachAllTabs", "[data-desk]");
        }
    }

    /// <summary>Called from JS when a divider drag ends. See windowing.js.</summary>
    [JSInvokable]
    public void OnSplitCommitted(string leftId, string rightId, double leftWidth, double rightWidth)
        => Manager.AdjustSplit(leftId, rightId, leftWidth, rightWidth);

    /// <summary>Called from JS when a tab drag ends with the row's new left-to-right order.</summary>
    [JSInvokable]
    public void OnReordered(string[] orderedIds)
        => Manager.Reorder(orderedIds);

    /// <summary>
    /// Called from JS when a tab — a window's title bar, or a row of a group's tab menu — is
    /// dropped on another window: it joins that window's column as a tab. See windowing.js.
    /// </summary>
    [JSInvokable]
    public void OnTabDropped(string id, string targetId)
    {
        if (Manager.MoveIntoColumn(id, targetId))
            Manager.RequestTabFocus(id);
    }

    /// <summary>Ctrl+K or ⌘K, from anywhere on the page. See windowing.js.</summary>
    [JSInvokable]
    public void OnPaletteRequested() => Manager.RequestPalette();

    /// <summary>Ctrl+, or ⌘, — the platform's settings chord, from anywhere. See windowing.js.</summary>
    [JSInvokable]
    public void OnSettingsRequested() => OpenSettings(Manager);

    /// <summary>
    /// Ctrl+Z or ⌘Z outside a field. Through the browser's history rather than straight to
    /// <see cref="WindowManager.Back"/>, so the chord, the header's Back, the browser's own and
    /// Alt+Left all walk one list: a step taken behind the browser's back would leave its entry
    /// standing, and the next Back pressed anywhere would land on it and do nothing.
    /// </summary>
    [JSInvokable]
    public async Task OnUndoRequested()
    {
        if (Manager.CanGoBack)
            await JS.InvokeVoidAsync("history.back");
    }

    /// <summary>⇧⌘Z, Ctrl+Shift+Z or Ctrl+Y outside a field; the same road as undo, the other way.</summary>
    [JSInvokable]
    public async Task OnRedoRequested()
    {
        if (Manager.CanGoForward)
            await JS.InvokeVoidAsync("history.forward");
    }

    /// <summary>
    /// Ctrl+Alt+← or → outside a field: the keyboard's tab drag. Without it the row's order was
    /// pointer-only. See <see cref="MoveFocused"/>.
    /// </summary>
    [JSInvokable]
    public void OnMoveWindowRequested(int delta) => MoveFocused(Manager, delta);

    /// <summary>
    /// Ctrl+[ or Ctrl+] outside a field: the focused window's own Back or Forward, the keys on
    /// its bar. See <see cref="PageFocused"/>.
    /// </summary>
    [JSInvokable]
    public void OnPageRequested(int delta) => PageFocused(Manager, delta);

    /// <summary>
    /// Turns the focused window back or forward a page. Nothing focused, or nowhere to go, is a
    /// chord that does nothing — the same answer its dimmed key gives.
    /// </summary>
    public static bool PageFocused(WindowManager manager, int delta)
    {
        if (manager.FocusedId is not { } id)
            return false;

        return delta < 0 ? manager.PageBack(id) : manager.PageForward(id);
    }

    /// <summary>
    /// The catalogue key of the desk's settings window — the Window manager. The desk names it
    /// rather than the application because Ctrl+, is the desk's chord; a catalogue without an
    /// entry under it simply has no settings to open, and the chord does nothing.
    /// </summary>
    public const string SettingsKey = "desk";

    /// <summary>Opens the Window manager, or focuses it if it is already on the desk.</summary>
    public static void OpenSettings(WindowManager manager)
    {
        if (manager.Catalog.Find(SettingsKey) is { } settings)
            manager.Open(settings);
    }

    /// <summary>
    /// Shifts the focused window one place along the row. Nothing focused, or already at that
    /// end, is a key that does nothing — and leaves the row untouched rather than reordering it
    /// into the order it already had.
    /// </summary>
    public static void MoveFocused(WindowManager manager, int delta)
    {
        if (manager.FocusedId is not { } id)
            return;

        // The row is columns: a window in a group moves its column, tabs and all.
        var order = manager.Columns.Select(c => c.Showing.Id).ToList();
        var shifted = Shifted(order, id, delta);

        if (!shifted.SequenceEqual(order))
            manager.Reorder(shifted);
    }

    /// <summary>
    /// <paramref name="order"/> with <paramref name="id"/> moved <paramref name="delta"/> places,
    /// clamped to the row: at either end, or for an id not in it, the same order comes back. The
    /// row does not wrap, because the end of a list on the platform is a stop, not a door.
    /// </summary>
    public static IReadOnlyList<string> Shifted(IReadOnlyList<string> order, string id, int delta)
    {
        var from = order.ToList().IndexOf(id);
        var to = from + delta;

        if (from < 0 || delta == 0 || to < 0 || to >= order.Count)
            return order;

        var moved = order.ToList();
        moved.RemoveAt(from);
        moved.Insert(to, id);
        return moved;
    }

    /// <summary>The browser's Back or Forward landed on a desk entry. See windowing.js.</summary>
    [JSInvokable]
    public async Task OnHistoryTraversed(int depth)
    {
        // A walk refused for unsaved input leaves the browser on an entry the desk is not at;
        // send it back to the desk's own, or the next Back would be counted from the wrong place.
        if (HistoryCorrection(Manager, depth) is var steps and not 0)
            await JS.InvokeVoidAsync("history.go", steps);
    }

    /// <summary>
    /// Walks the desk to the browser's <paramref name="depth"/> and says how far the browser must
    /// then move to agree with it: zero when the walk happened, and the refused distance back
    /// when it did not. The landing fires popstate at the desk's own depth, which walks nowhere.
    /// </summary>
    public static int HistoryCorrection(WindowManager manager, int depth)
        => manager.TraverseTo(depth) ? 0 : manager.HistoryDepth - depth;

    [JSInvokable]
    public void OnViewportChanged(double width, double height)
        => Manager.SetViewport(width, height);

    /// <summary>
    /// Keyboard equivalent of a divider drag. A pointer-only resize would put column widths
    /// out of reach for anyone not using a mouse.
    /// </summary>
    private void OnDividerKey(KeyboardEventArgs e, WindowInstance left, WindowInstance right)
    {
        if (SplitByKey(e.Key, e.ShiftKey, left, right, Manager.MinWidthOf(left), Manager.MinWidthOf(right)) is var (leftWidth, rightWidth))
            Manager.AdjustSplit(left.Id, right.Id, leftWidth, rightWidth);
    }

    /// <summary>
    /// Where a key on the divider between <paramref name="left"/> and <paramref name="right"/>
    /// moves it, as the two widths it leaves; null for a key that does not move it, or a move
    /// that is already at its stop. The arrows step 16px, 48px with Shift; Home and End go to
    /// either stop, as they do on any slider.
    ///
    /// <para>
    /// The pair's combined width never changes, and neither column crosses its minimum — the
    /// bounds a drag has (windowing.js). The keys once clamped each column on its own, so a
    /// press at a stop grew one column without shrinking the other, and the row's other
    /// columns paid for a divider that was meant to be local.
    /// </para>
    /// </summary>
    public static (double Left, double Right)? SplitByKey(string key, bool shift, WindowInstance left, WindowInstance right,
        int? leftMin = null, int? rightMin = null)
    {
        var step = shift ? 48d : 16d;
        var total = left.Width + right.Width;

        // As the drag bounds them: on a desk too narrow for both minimums a column may grow
        // but not shrink further, rather than the bounds crossing. A tab group's minimum is its
        // widest tab's (WindowColumn.MinWidth), which the caller passes.
        var lowest = Math.Min((leftMin ?? left.Definition.MinWidth) - left.Width, 0);
        var highest = Math.Max(right.Width - (rightMin ?? right.Definition.MinWidth), 0);

        var delta = key switch
        {
            "ArrowLeft" => -step,
            "ArrowRight" => step,
            "Home" => lowest,
            "End" => highest,
            _ => 0d
        };

        delta = Math.Clamp(delta, lowest, highest);

        if (delta == 0)
            return null;

        return (left.Width + delta, total - (left.Width + delta));
    }

    /// <summary>
    /// The divider between two columns read as a slider: the leading column's width now, the
    /// least and most it can be while both keep their minimums, and the pair's combined width.
    /// Whole pixels, because that is how a reader hears them and how the readout draws them.
    /// </summary>
    public readonly record struct SplitRange(int Now, int Min, int Max, int Total)
    {
        public static SplitRange Of(WindowInstance left, WindowInstance right, int? leftMin = null, int? rightMin = null)
        {
            var now = (int)Math.Round(left.Width);
            var total = (int)Math.Round(left.Width + right.Width);

            // A desk too narrow for both minimums already has a column under its own; the range
            // still contains where the divider stands rather than claiming a value outside it.
            var min = Math.Min(leftMin ?? left.Definition.MinWidth, now);
            var max = Math.Max(total - (rightMin ?? right.Definition.MinWidth), now);

            return new SplitRange(now, min, max, total);
        }
    }

    /// <summary>
    /// The workspaces an empty desk offers, in the order given, each with the windows it opens
    /// said in words. A window the catalogue does not hold for this person — an operator's, at a
    /// visitor's desk — is left out of the words, and a workspace left with none is not offered:
    /// a choice that would open nothing is not a choice.
    /// </summary>
    public IReadOnlyList<OfferedWorkspace> OfferedWorkspaces(IEnumerable<Workspace> workspaces)
        => workspaces
            .Select(w => (Workspace: w, Titles: w.WindowKeys
                .Select(k => Manager.Catalog.Find(k)?.Title)
                .OfType<string>()
                .Distinct()
                .ToList()))
            .Where(w => w.Titles.Count > 0)
            .Select(w => new OfferedWorkspace(w.Workspace, w.Titles, WindowsSentence(w.Titles)))
            .ToList();

    /// <summary>"One", "One and Two", "One, Two and Three"; past five, the first four "and 3 more".</summary>
    public static string WindowsSentence(IReadOnlyList<string> titles)
    {
        if (titles.Count == 0)
            return string.Empty;

        var named = titles.Count > 5 ? titles.Take(4).Append($"{titles.Count - 4} more").ToList() : titles.ToList();

        return named.Count == 1
            ? named[0]
            : $"{string.Join(", ", named.Take(named.Count - 1))} and {named[^1]}";
    }

    private void Apply(Workspace workspace) => Manager.ApplyWorkspace(workspace);

    private void OpenPrimary()
    {
        if (Primary is not null)
            Manager.Open(Primary);
    }

    private void OnManagerChanged()
    {
        InvokeAsync(StateHasChanged);

        // Changed fires for focus, the notice and every resize as well as for the layout, so
        // saving is deferred and only written when the layout itself differs from what the
        // browser already holds. A window's status is not on it (WindowChanged): the desk
        // neither redraws nor saves for one, and each window redraws itself.
        if (_module is null || _saveQueued)
            return;

        _saveQueued = true;
        _ = SaveLayoutSoonAsync();
    }

    private async Task SaveLayoutSoonAsync()
    {
        await Task.Delay(500);
        _saveQueued = false;

        await InvokeAsync(async () =>
        {
            var json = Manager.Capture().Serialise();
            if (json == _savedLayout || _module is null)
                return;

            try
            {
                await _module.InvokeVoidAsync("saveLayout", LayoutKey, json);
                _savedLayout = json;
            }
            catch (JSDisconnectedException)
            {
                // The browser has gone; the last saved layout stands.
            }
        });
    }

    public async ValueTask DisposeAsync()
    {
        Manager.Changed -= OnManagerChanged;

        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit already gone; nothing to release in the browser.
            }
        }

        _self?.Dispose();
    }
}

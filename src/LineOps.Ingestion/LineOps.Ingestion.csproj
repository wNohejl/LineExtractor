<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A library, deliberately. The worker host lives in LineOps.Worker so that the web app can
    consume the ingestion pipeline without also inheriting an executable's entry point and
    appsettings — two projects shipping the same appsettings.json is a publish conflict and,
    worse, silent config drift between the UI and the worker.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LineOps.Core\LineOps.Core.csproj" />
    <ProjectReference Include="..\LineOps.Data\LineOps.Data.csproj" />
    <ProjectReference Include="..\LineOps.Reliability\LineOps.Reliability.csproj" />
  </ItemGroup>
</Project>

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "LineOps": "Host=localhost;Port=5433;Database=lineops;Username=lineops"
  },
  "Ingestion": {
    "//": "Kept in step with src/LineOps.Web/appsettings.json — both hosts run the same scheduler.",
    "Sports": [ "mlb" ],
    "MovementWindow": "36:00:00",
    "RunOnStartup": false,

    "LinePolling": {
      "Mode": "Manual",
      "RequestsPerSportPerScan": 2,
      "DailyReserve": 50,
      "HourlyReserve": 10,
      "MinimumInterval": "00:05:00",
      "MaximumInterval": "03:00:00"
    },

    "GamePasses": {
      "Enabled": true,
      "PreGameLead": "03:00:00",
      "SlateRefresh": "00:30:00",
      "ResultsAfterStart": "04:00:00",
      "ResultsRetry": "00:30:00"
    },

    "//": "A clone with no keys still ingests: ESPN and the MLB Stats API need none. Odds do — set Enabled=true and an ApiKey on a real odds source, supplied out of band. Until then there is no odds source, which reads as unconfigured rather than as an outage.",

    "OddsApiIo": {
      "Enabled": false,
      "ApiKey": "",
      "Bookmakers": [ "draftkings", "fanduel" ]
    },
    "TheOddsApi": {
      "Enabled": false,
      "ApiKey": ""
    },
    "BallDontLie": {
      "Enabled": false,
      "ApiKey": ""
    },
    "Espn": {
      "Enabled": true
    }
  },
  "Reliability": {
    "FreshnessSlo": "26:00:00",
    "SuccessRateSlo": 0.95,
    "SuccessRateWindow": "7.00:00:00",
    "VolumeAnomalyThreshold": 0.5,
    "VolumeBaselineDays": 7,
    "BudgetWarnThreshold": 0.8,
    "EvaluationInterval": "00:05:00",
    "AutoIncidentAfterCriticals": 2
  },

  "//Observability": [
    "A distinct ServiceName from the web app: when both run, a trace has to say which host",
    "produced the span, and 'lineops' twice would make the split deployment invisible."
  ],
  "Observability": {
    "Enabled": false,
    "ServiceName": "lineops-worker",
    "OtlpEndpoint": "http://localhost:18889",
    "MetricsSampleInterval": "00:00:30"
  }
}

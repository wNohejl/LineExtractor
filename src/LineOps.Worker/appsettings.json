{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "LineOps": "Host=localhost;Port=5433;Database=lineops;Username=lineops"
  },
  "Ingestion": {
    "//": "Kept in step with src/LineOps.Web/appsettings.json — both hosts run the same scheduler.",
    "Sports": [ "mlb" ],
    "MovementWindow": "36:00:00",
    "RunOnStartup": false,

    "LinePolling": {
      "Mode": "Manual",
      "RequestsPerSportPerScan": 2,
      "DailyReserve": 50,
      "HourlyReserve": 10,
      "MinimumInterval": "00:05:00",
      "MaximumInterval": "03:00:00"
    },

    "GamePasses": {
      "Enabled": true,
      "PreGameLead": "03:00:00",
      "SlateRefresh": "00:30:00",
      "ResultsAfterStart": "04:00:00",
      "ResultsRetry": "00:30:00"
    },

    "//": "Demo is enabled so a cold clone runs with no keys and no spend. Set an ApiKey and Enabled=true on a real source to switch over.",
    "Demo": { "Enabled": true },

    "OddsApiIo": {
      "Enabled": false,
      "ApiKey": "",
      "Bookmakers": [ "draftkings", "fanduel" ]
    },
    "TheOddsApi": {
      "Enabled": false,
      "ApiKey": ""
    },
    "BallDontLie": {
      "Enabled": false,
      "ApiKey": ""
    },
    "Espn": {
      "Enabled": true
    }
  },
  "Reliability": {
    "FreshnessSlo": "26:00:00",
    "SuccessRateSlo": 0.95,
    "SuccessRateWindow": "7.00:00:00",
    "VolumeAnomalyThreshold": 0.5,
    "VolumeBaselineDays": 7,
    "BudgetWarnThreshold": 0.8,
    "EvaluationInterval": "00:05:00",
    "AutoIncidentAfterCriticals": 2
  }
}

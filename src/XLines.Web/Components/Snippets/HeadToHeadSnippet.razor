@namespace XLines.Web.Components.Snippets
@using XLines.Core.Entities
@using XLines.Data.CrossReference
@inject IServiceScopeFactory ScopeFactory
@inject ILogger<HeadToHeadSnippet> Logger
@implements IDisposable

@*
    The last few meetings between these two sides, with what the market made of each.

    Scores and the closing number sit side by side deliberately: a 6-2 win says one thing on
    its own and another next to a line that had them at -1.5, and the pair is the reading an
    operator is actually after.

    Most rows will have no number. Closing lines only exist for games this desk was running
    for — scans are deleted at first pitch (ADR 0010) and only the close survives — so a
    fixture reaching back five meetings will usually reach past what is held. The rows stay
    and the cells read "—", because hiding them would understate the record itself.
*@

@if (_read.Loading)
{
    <DeskSkeleton Lines="3" />
}
else if (_read.Error is not null)
{
    <SnippetFailure Message="@_read.Error" OnRetry="LoadAsync" />
}
else if (_rows.Count == 0)
{
    <EmptyState Kind="EmptyStateKind.Filtered" Compact>
        No previous meeting on record. Either these sides have not met inside the history
        held, or the backfill has not reached that far.
    </EmptyState>
}
else
{
    <div class="gridwrap"><table class="grid grid--tight">
        <thead>
            <tr>
                <th>Date</th>
                <th>Meeting</th>
                <th class="r">Score</th>
                <th class="r">Line</th>
                <th class="r">ATS</th>
                <th class="r">Total</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in _rows)
            {
                <tr>
                    <td class="dim">@Day(row.StartsAt)</td>
                    <td class="trunc"><TeamMark Sport="@row.SportKey" Abbrev="@row.AwayAbbrev" />@row.AwayTeam at <TeamMark Sport="@row.SportKey" Abbrev="@row.HomeAbbrev" />@row.HomeTeam</td>
                    <td class="r mono">
                        @(row.HasScore ? $"{row.AwayScore}-{row.HomeScore}" : "—")
                    </td>
                    <td class="r mono">@(row.ClosingSpread is { } s ? Line(s) : "—")</td>
                    <td class="r">
                        @if (row.AtsResult is { } ats && ResultTag.Of(ats) is { } cover)
                        {
                            <ResultTag Result="@cover">@(ats == EntryResult.Win ? "Covered" : ats == EntryResult.Loss ? "Missed" : "Push")</ResultTag>
                        }
                        else
                        {
                            <text>—</text>
                        }
                    </td>
                    <td class="r">
                        @* Graded from the over's point of view, so a win is an over and a loss an under. *@
                        @if (row.TotalResult is { } total && row.ClosingTotal is { } line && ResultTag.Of(total) is { } over)
                        {
                            <ResultTag Result="@over">@(total == EntryResult.Win ? "O" : total == EntryResult.Loss ? "U" : "P") @Total(line)</ResultTag>
                        }
                        else
                        {
                            <text>—</text>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table></div>

    @* Coverage is stated rather than inferred. A column of dashes says nothing about whether
       the market data is missing or the games were simply never priced, and the difference is
       the whole reading. Mirrors the Board's "N of M priced" strip. *@
    <p class="snippet__coverage">
        @_covered of @_rows.Count with a closing line
        @if (_covered == 0)
        {
            <text> — prices are only kept from the point this desk started watching a fixture.</text>
        }
    </p>
}

@code {
    [Parameter, EditorRequired] public int GameId { get; set; }

    /// <summary>How many meetings the snippet shows before the window is worth opening.</summary>
    [Parameter] public int Take { get; set; } = 5;

    private IReadOnlyList<HeadToHeadRow> _rows = [];
    private int _covered;
    private readonly SnippetRead _read = new();

    /// <summary>
    /// Meetings already read by the host — the Game window's head to head reads them once for
    /// its label and hands them on, so the label and the rows are one query. Null to read here.
    /// </summary>
    [Parameter] public IReadOnlyList<HeadToHeadRow>? Rows { get; set; }

    protected override Task OnParametersSetAsync()
    {
        if (Rows is null)
            return LoadAsync();

        // The host's rows are the answer, so a read of this snippet's own still in flight is
        // cancelled rather than left to land over them.
        _read.Settle();
        _rows = Rows;
        _covered = _rows.Count(r => r.HasClosingLine);
        return Task.CompletedTask;
    }

    /// <summary>The snippet's one read, run on arrival and again from Try again.</summary>
    private Task LoadAsync()
    {
        // Read into locals and handed over only by the latest read: a slow read of the game the
        // row moved on from cannot land last. A snippet that fails must not take the row down with
        // it — the other actions on this row still work, and the operator should be told which
        // one did not.
        var (gameId, take) = (GameId, Take);

        return _read.RunAsync(async ct =>
        {
            await using var scope = ScopeFactory.CreateAsyncScope();
            var log = scope.ServiceProvider.GetRequiredService<GameLogService>();

            return await log.HeadToHeadAsync(gameId, take, ct);
        }, rows =>
        {
            _rows = rows;
            _covered = rows.Count(r => r.HasClosingLine);
        }, "Previous meetings did not load.", Logger);
    }

    public void Dispose() => _read.Dispose();

    private static string Day(DateTimeOffset at) => DisplayTime.Format(at, "MMM d, yyyy");

    /// <summary>A spread as every price table writes one: "+3.5", "-7", never "+3.50".</summary>
    private static string Line(decimal value) => OddsMath.FormatLine(value, string.Empty);

    /// <summary>A total as the Board writes the number: "47.5", never "47.50".</summary>
    private static string Total(decimal value) => value.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
}

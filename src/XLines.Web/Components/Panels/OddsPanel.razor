@using XLines.Data
@using XLines.Data.CrossReference
@using XLines.Web.Components.Snippets
@using XLines.Desk.Windowing
@using XLines.Web.Services
@using Microsoft.EntityFrameworkCore
@inherits PanelBase
@inject IDbContextFactory<XLinesDbContext> DbFactory
@inject IServiceScopeFactory ScopeFactory
@inject XLines.Core.Contracts.IDataTier Tier
@inject IServiceProvider Provider
@inject Microsoft.Extensions.Options.IOptions<XLines.Ingestion.Configuration.IngestionOptions> IngestionOptions

@*
    Line movement: how one side of a market moved at each book, a row per book.

    It used to be a chart of every book and both sides at once — eight lines for two books
    and a moneyline, each side the mirror of the other in probability, told apart by a palette
    and a legend that drew itself over the table beneath — and then that table again, with
    the latest prices the chart had just drawn. Apple's charting guidance is to keep a chart
    simple and let people choose the detail, to use a small chart for glanceable information
    about one item, and to put data in a table where nobody is being asked to analyse it. So
    the window shows one side at a time, because the other side is its mirror, and the rows
    are the representation: each book's open, where it is now, the move between them, when it
    last moved, and a sparkline of the path, on one time axis shared down the column so a move
    that hit every book in the same hour lines up.
*@

<PanelToolbar>
    <ChildContent>
    @* The games with moves on record — the ones this window can show. Scans are kept until
       first pitch and then folded into one closing line (ADR 0010), so every game ahead of
       us with a price on file is in this list. It is the only game control: the search that
       sat beside it named the same game a second time, cut off at the window's edge. A game
       opened from elsewhere and not in the list is added to it, so the select always names
       the game the rows are about.

       Each option leads with its day (GameOption). Capped at 280px, the select cut
       "Dallas Cowboys at Philadelphia Eagles — Oct 26" after the dash, so the picker read as a
       matchup trailing a stray dash and never showed the date that tells a series apart. It
       now takes the width its longest option asks, up to the toolbar's; a window narrower than
       that still clips, but at the end of the home club's name rather than mid-separator. *@
    <DeskSelect TValue="int?" aria-label="Game" Class="odds-game"
                disabled="@(_games.Count == 0 && _picked is null)"
                Value="@(Listed(_gameId) ? _gameId : null)" ValueChanged="OnGameChanged">
        <option value="">@(_games.Count == 0 ? "No game has moves on record" : "Games with moves…")</option>
        @if (_picked is { } picked && !_games.Any(g => g.Id == picked.Id))
        {
            <option value="@picked.Id">@GameOption(picked)</option>
        }
        @foreach (var g in _games)
        {
            <option value="@g.Id">@GameOption(g)</option>
        }
    </DeskSelect>
    </ChildContent>

    @* The view's own switches, on the toolbar's row beside the game, as the Board's scope
       pickers are. They had a row of their own: before the toolbar could fold, a window beside
       the Board ran out of row, the game was cut off and the side switch fell past the edge. Now
       they are the row's Overflow, so a narrow window folds them into More, each with its label,
       and the game stays on the row. *@
    <Overflow>
        <div class="ptoolbar__item">
            <span class="ptoolbar__label" aria-hidden="true">Market</span>
            <DeskSwitch Options="_marketOptions" Label="Market"
                        Value="_market" ValueChanged="@((string market) => SetMarketAsync(market))" />
        </div>

        @* The market's two outcomes, away first as the matchup reads, Over before Under. One at a
           time: a price that shortens on one side drifts on the other, so showing both doubles
           the rows and says nothing the first half did not. Built from the stored outcomes, so a
           market priced on one side offers no switch, and More no label with nothing beside it. *@
        @if (_sideOptions.Count > 1)
        {
            <div class="ptoolbar__item">
                <span class="ptoolbar__label" aria-hidden="true">Side</span>
                <DeskSwitch TValue="string" Options="_sideOptions" Label="Side"
                            Value="_side" ValueChanged="@((string side) => SetSide(side))" />
            </div>
        }
    </Overflow>

    @* The Board's pull menu, here too: a price moves only when lines are pulled (polling is
       Manual by default), so the window that shows prices standing still offers what would move
       them — every entry with its cost, and a metered one asking first. The standing view's Pull
       key presses this menu rather than running anything itself. Drawn once the window has
       loaded, as the rest of its body is. *@
    <Actions>
        @if (Loaded)
        {
            <DeskJobMenu @ref="_pull" Label="Pull data" Icon="@Icons.Material.Filled.CloudDownload" OnRan="LoadAsync" />
        }
    </Actions>
</PanelToolbar>

@* The failure line sits above whatever the window already holds, as the Board's does: Line
   movement refreshes on every odds signal, and one refresh that failed must not take the rows
   the operator was reading. Before the first load the window holds its shape — the headline
   and the first books' rows, where they will land — because "No stored prices" said there was
   nothing on record while the window was still asking, and a load that failed said it too. *@
@if (Failed)
{
    <PanelLoadFailure Message="@LoadError" OnRetry="RetryAsync" />
}
else if ((!Loaded && !_movesIn) || _turning)
{
    @* Turned to another game (_turning), as before the first load: the last game's rows are
       not this one's, and "No stored prices" is not known yet. *@
    <DeskSkeleton Width="40%" />
    <DeskGrid T="MovementRow" Items="@(Array.Empty<MovementRow>())" Loading="true" SkeletonRows="4"
              LoadingLabel="Fetching the line's moves" />
}

@* Line watch (ADR 0029): the window follows what is pressed on the Board, and says what. Before
   anything is pressed it picks nothing — a game nobody chose, shown as if it were the choice,
   was the complaint — and shows the slate's overview instead. *@
@if (Loaded && Overview)
{
    <section class="slatewatch" aria-label="The slate today">
        <p class="slatewatch__prompt">Press a game or a price on the Board to follow it here.</p>

        @if (_slate.Moves.Count > 0)
        {
            <h3 class="panel-h slatewatch__title">Biggest moves today</h3>
            <div class="slatewatch__list">
                @foreach (var move in _slate.Moves)
                {
                    var m = move;
                    <button type="button" class="slatewatch__row" @onclick="() => FollowAsync(m.Game, m.Market, m.Row.Now.Outcome)"
                            aria-label="@MoveLabel(m)">
                        <span class="slatewatch__game">
                            <span class="slatewatch__matchup">@Matchup(m.Game)</span>
                            <span class="slatewatch__detail">@SelectionText.MarketWord(m.Market) · @SideLabel(m.Row.Now.Outcome) · @BookNames.Display(m.Row.Book)</span>
                        </span>
                        <span class="slatewatch__move num">
                            <span>@Quote(m.Row.Open) → @Quote(m.Row.Now)</span>
                            <span class="slatewatch__size">@MoveText(m.Row)</span>
                        </span>
                    </button>
                }
            </div>
        }
        else
        {
            <p class="slatewatch__none">Nothing on the slate has moved today.</p>

            @if (_slate.Next.Count > 0)
            {
                <h3 class="panel-h slatewatch__title">Next games</h3>
                <div class="slatewatch__list">
                    @foreach (var game in _slate.Next)
                    {
                        var g = game;
                        <button type="button" class="slatewatch__row" @onclick="() => FollowAsync(g, null, null)"
                                aria-label="@($"Follow {Matchup(g)}, {DisplayTime.Stamp(g.StartsAt)}")">
                            <span class="slatewatch__game">
                                <span class="slatewatch__matchup">@Matchup(g)</span>
                                <span class="slatewatch__detail">@g.Sport?.Key.ToUpperInvariant()</span>
                            </span>
                            <span class="slatewatch__move num">@DisplayTime.Stamp(g.StartsAt)</span>
                        </button>
                    }
                </div>
            }
            else
            {
                <p class="slatewatch__none">No game starts in the next two days.</p>
            }
        }
    </section>
}
else
{
@if (Loaded && Watching && _picked is { } followed)
{
    @* What is being followed, in words, and the way back to the overview. *@
    <div class="slatewatch__following" role="status">
        <span class="slatewatch__following-text">
            Following <strong>@Matchup(followed)</strong> · @SelectionText.MarketWord(_market)@(_side is { } side ? $" · {SideLabel(side)}" : "")
        </span>
        <DeskButton Size="DeskKeySize.Small" Icon="@Icons.Material.Filled.ArrowBack" OnClick="ShowOverviewAsync">
            Overview
        </DeskButton>
    </div>
}

@if (_rows.Count == 0)
{
    @* An empty result means "nothing here" only once there has been a result, and only while
       the last read did not fail. *@
    @if (Loaded && !Failed && !_turning)
    {
        <EmptyState Kind="EmptyStateKind.Filtered">
            No stored prices for this game and market. Try another market, or open the game: once
            it starts, its moves are folded into one closing line, which the Game window shows.
        </EmptyState>
    }
}
else
{
    @* The finding first, then the span it was found over (HIG charts: summarise the main
       message before the detail). The headline is about the side in focus, the same rows
       the table shows, so the sentence and the rows never disagree about who moved. *@
    <div class="movement">
        <div class="movement__cap">
            @* The side in focus leads with its club's crest when the side is a club: a total's Over
               and Under name none, and a bout's fighters carry none. *@
            <p class="movement__headline">
                @if (_market != Markets.Total && Club(_side) is { } club)
                {
                    <TeamMark Sport="@CrestSport" Abbrev="@club.Abbrev" Size="TeamMarkSize.Small" />
                }
                @_headline
            </p>
            <p class="movement__span">@_span</p>
        </div>

        @* Where the side stands now — the fair price, each side's best, the last change on record,
           and what could move it next — read from the board's row for this game. A side nobody
           has moved shows each book's standing in place of the movement columns, which would be
           "unmoved" and "seen once" in every row. *@
        <PriceStanding Rows="_rows" Side="@SideOffer" Other="@OtherOffer"
                       SideName="@SideName(_side)" OtherName="@SideName(OtherSide)"
                       ShowBooks="@(!AnyMoves)" Expanded="@_expanded.Contains(_market)" ExpandedChanged="@((bool open) => SetExpanded(open))" Closing="@(_board?.PricesAreClosing == true)"
                       Scheduled="@(_scheduled == true)"
                       PullLabel="@PullLabel" PullUnavailable="@PullUnavailable" OnPull="PullAsync" />

        @if (AnyMoves)
        {
        @* Ranked on the whole market and capped at the top five, as every book table on the desk is
           (BookRanking): the books holding the best price on either side lead, then the lowest hold,
           and the rest are behind the key under the grid. It opened sorted by book name; a heading
           still sorts the rows showing. *@
        <div class="oddsbooks" id="@_booksId">
        <DeskGrid T="MovementRow" Items="BookRanking.Visible(BookRanking.Order(_rows, r => r.Book, SideOffer, OtherOffer), _expanded.Contains(_market))" Resizable="false" EmptyText="No prices on this side.">
            @* The book by its name, as Every book names it: the feed's key ("draftkings") is
               for joining rows, not for reading. *@
            @* Every value here holds one line; the trend takes what is left, so the book's name
               and its figures never break while the sparkline has room to draw its path. *@
            <PropertyColumn T="MovementRow" TProperty="string" Property="r => r.Book" Title="Book"
                            HeaderClass="ops-col--fit" CellClass="ops-col--fit">
                <CellTemplate>@BookNames.Display(context.Item.Book)</CellTemplate>
            </PropertyColumn>

            @* No colour and no axis: the numbers are in the next cells, and the shape only has
               to say which way and when. A book seen once draws a dash, not a flat line. *@
            <TemplateColumn T="MovementRow" Title="Trend" Sortable="false" HeaderClass="ops-col--grow" CellClass="ops-col--grow">
                <CellTemplate>
                    <DeskSparkline Values="context.Item.Trend" Positions="context.Item.Positions" Step="true"
                                   Label="@TrendLabel(context.Item)" />
                </CellTemplate>
            </TemplateColumn>

            <TemplateColumn T="MovementRow" Title="Open" Align="Align.Right" Sortable="true"
                            SortBy="@(r => Rank(r.Open))" HeaderClass="col--wide ops-col--fit" CellClass="col--wide ops-col--fit">
                <CellTemplate>
                    @* When the open was seen is a tooltip on a trigger that takes focus, not a title
                       only a pointer raises (HIG 12). *@
                    <DeskTooltip Text="@OpenedTooltip(context.Item)">
                        <span class="dim movement__quote" tabindex="0">@Quote(context.Item.Open)</span>
                    </DeskTooltip>
                </CellTemplate>
            </TemplateColumn>

            @* Sorting on the current number is how you find the best one across books. *@
            <TemplateColumn T="MovementRow" Title="Now" Align="Align.Right" Sortable="true"
                            SortBy="@(r => Rank(r.Now))" HeaderClass="ops-col--fit" CellClass="ops-col--fit">
                <CellTemplate>
                    <span class="movement__quote">@Quote(context.Item.Now)</span>
                </CellTemplate>
            </TemplateColumn>

            @* The arrow is the direction the number moved as it is written, the same way the
               sparkline draws it, and nothing more: the ink is neutral because a price moving
               is not good or bad. The tooltip says it in words — shortened or drifted. *@
            <TemplateColumn T="MovementRow" Title="Move" Align="Align.Right" Sortable="true"
                            SortBy="@(r => MoveSize(r))" HeaderClass="ops-col--fit" CellClass="ops-col--fit">
                <CellTemplate>
                    <DeskTooltip Text="@MoveTitle(context.Item, _market)">
                        <span class="movement__move @(context.Item.Moved ? null : "dim")" tabindex="0">@MoveText(context.Item)</span>
                    </DeskTooltip>
                </CellTemplate>
            </TemplateColumn>

            <TemplateColumn T="MovementRow" Title="Last moved" Align="Align.Right" Sortable="true"
                            SortBy="@(r => r.LastMoved ?? DateTimeOffset.MinValue)"
                            HeaderClass="col--wide ops-col--fit" CellClass="col--wide ops-col--fit">
                <CellTemplate>
                    @if (context.Item.LastMoved is { } at)
                    {
                        <DeskTooltip Text="@($"Last moved {DisplayTime.Stamp(at)}")">
                            <span class="dim" tabindex="0">@Ago(at, DateTimeOffset.UtcNow)</span>
                        </DeskTooltip>
                    }
                    else
                    {
                        @* Said in the cell: the dash meant it, but only to a pointer. When it was
                           seen is the Open cell's tooltip. *@
                        <span class="dim">seen once</span>
                    }
                </CellTemplate>
            </TemplateColumn>
        </DeskGrid>
        <MoreBooks Total="_rows.Count" Expanded="@_expanded.Contains(_market)" ExpandedChanged="@((bool open) => SetExpanded(open))" Controls="@_booksId" />
        </div>
        }
    </div>
}

@*
    The cross-reference. Odds say what the market thinks; these say what actually happened.
    Read live from the stats history by reference — nothing here is copied onto the odds tier,
    because form changes daily and a stored copy would go stale without saying so.

    Read in the same load as the moves, so it waits for that load: before the first one lands
    "Select a game" was the answer to a question the window was still asking.
*@

@* Only with something to cross-reference. An empty roster read under a line's standing was a
   second empty state about a different question, and pushed the window's one useful finding
   — where the price stands — into competition with "no appearances on record". The Form window
   and the Board row's Form glance answer it, and say how to fill it. *@
@if (Loaded && _form is { IsEmpty: false })
{
<PanelSection Title="Recent form">

@{ var form = _form!;

    <DeskRow>
        <DeskSwitch Options="GateOptions.LookbackDays" Label="Lookback window" Mono="true"
                    Value="_windowDays" ValueChanged="@((int days) => SetWindowAsync(days))" />
        <span class="meta">
            @form.LinesRead.ToString("N0") stat @(form.LinesRead == 1 ? "line" : "lines") read by reference
        </span>
    </DeskRow>

    @RenderSide(form.Away, form.Game.AwayTeam?.Name ?? "Away", form.Game.AwayTeam)
    @RenderSide(form.Home, form.Game.HomeTeam?.Name ?? "Home", form.Game.HomeTeam)
}
</PanelSection>
}
}

@code {
    protected override IReadOnlySet<string> Watches { get; } = new HashSet<string> { DataTopics.Odds };

    protected override Task RefreshAsync() => LoadAsync();

    protected override string LoadSubject => "Line movement";

    /// <summary>The game to show: a press in Line watch, or a link from elsewhere; otherwise the next game to start.</summary>
    [Parameter] public int? GameId { get; set; }

    /// <summary>
    /// The market to show (<c>Markets.*</c>), from a price pressed on the Board in Line watch.
    /// Null keeps the market the window is on: a row press names only the game.
    /// </summary>
    [Parameter] public string? Market { get; set; }

    /// <summary>The side to show, as stored ("Kansas City Chiefs", "Over"). Null keeps the side, or the first.</summary>
    [Parameter] public string? Outcome { get; set; }

    /// <summary>
    /// The press that aimed the window: a token Line watch issues for every Board press, and for a
    /// game followed from the overview (LineWatch.Issue), so a press that names what the window was
    /// last aimed at still turns it back there after the operator has looked elsewhere in it, and a
    /// token not issued today (a desk saved on an earlier day) is not taken as today's choice
    /// (LineWatch.IsCurrent). Object, not string: whatever a saved desk restores, it reads as text.
    /// </summary>
    [Parameter] public object? Press { get; set; }

    /// <summary>
    /// What the window was last aimed at, the press included. Line watch re-aims the window already
    /// on the desk rather than opening another, so the window follows its parameters after the
    /// first load, not only at it; a render that hands the same aim back (the window redrawn for
    /// focus or layout) changes nothing the operator chose here.
    /// </summary>
    private (int? Game, string? Market, string? Outcome, string? Press)? _aimedAt;

    /// <summary>The window's reads; the database's unless a test hands it others.</summary>
    private ILineMovementData Reads => _reads ??= Provider.GetService<ILineMovementData>()
        ?? new LineMovementData(DbFactory, ScopeFactory, Tier, IngestionOptions);

    private ILineMovementData? _reads;

    /// <summary>The board's row for the game: each side's best, fair price and every book's rung.</summary>
    private BoardRow? _board;

    /// <summary>This league's lines pull, as the job menu offers it; null before a read or with none.</summary>
    private XLines.Ingestion.Services.IngestionJob? _linesJob;

    /// <summary>Whether lines are scanned on a schedule; null when the setting could not be read.</summary>
    private bool? _scheduled;

    private DeskJobMenu? _pull;

    private List<Game> _games = [];
    private Game? _picked;
    private int? _gameId;
    private string _market = Markets.Moneyline;

    /// <summary>Every stored price on the chosen market, both sides. The side switch reads from it without a query.</summary>
    private List<OddsSnapshot> _snapshots = [];

    /// <summary>
    /// The outcome in focus, as stored. Kept across a market change when the new market has
    /// the same outcome — a team's moneyline and its spread — and reset to the first side
    /// when it does not.
    /// </summary>
    private string? _side;

    private IReadOnlyList<DeskSwitchOption<string>> _sideOptions = [];
    private IReadOnlyList<MovementRow> _rows = [];

    private string _headline = string.Empty;
    private string _span = string.Empty;

    private static readonly IReadOnlyList<DeskSwitchOption<string>> _marketOptions =
    [
        new(Markets.Moneyline, "Moneyline"),
        new(Markets.Spread, "Spread"),
        new(Markets.Total, "Total")
    ];

    /// <summary>
    /// The markets showing every book rather than the top five, by key: the operator's choice per
    /// market, kept for as long as the window is open — across a side switch, a refresh, another
    /// game followed — and shared by the movement grid and the standing's books, which are the
    /// same books.
    /// </summary>
    private readonly HashSet<string> _expanded = new(StringComparer.Ordinal);

    private void SetExpanded(bool open)
    {
        if (open)
            _expanded.Add(_market);
        else
            _expanded.Remove(_market);
    }

    private readonly string _booksId = "oddsbooks-" + Guid.NewGuid().ToString("N")[..8];

    private MatchupForm? _form;
    private int _windowDays = 30;

    /// <summary>
    /// The chosen game's sport, for a crest — null for a bout, whose fighters carry none, and
    /// before a game is chosen. Read off the game the window already holds with its sport.
    /// </summary>
    private string? CrestSport => _picked is { } game && !FightSports.IsFight(game.Sport?.Key) ? game.Sport?.Key : null;

    /// <summary>The chosen game's club by the name an outcome gives it, or null for Over, Under or a bout.</summary>
    private Team? Club(string? name)
    {
        if (CrestSport is null || _picked is not { } game || string.IsNullOrEmpty(name))
            return null;

        return string.Equals(name, game.AwayTeam?.Name, StringComparison.OrdinalIgnoreCase) ? game.AwayTeam
            : string.Equals(name, game.HomeTeam?.Name, StringComparison.OrdinalIgnoreCase) ? game.HomeTeam
            : null;
    }

    private RenderFragment RenderSide(IReadOnlyList<PlayerForm> side, string teamName, Team? team) => @<text>
        @if (side.Count > 0)
        {
            @* Each roster under its club's name and crest. The crest is drawn only where the form
               is about the game the window holds, which is where its sport is known. *@
            <PanelSection>
            <TitleContent>
                @if (CrestSport is { } sport && _picked?.Id == _form?.Game.Id && team is not null)
                {
                    <TeamMark Sport="@sport" Abbrev="@team.Abbrev" Size="TeamMarkSize.Small" />
                }
                @teamName
            </TitleContent>
            <ChildContent>
            <XLines.Web.Components.Snippets.RosterTable Side="side" MaxColumns="5" ShowLastPlayed="true" GrowName="true" />
            </ChildContent>
            </PanelSection>
        }
    </text>;

    /// <summary>
    /// The games list and the first game's moves, as one load. The list is read inside it rather
    /// than ahead of it: a database that refused that first read threw out of the lifecycle and
    /// took the circuit — the whole desk — with it, and Try again has to repeat both.
    /// </summary>
    protected override Task OnInitializedAsync()
        => WithActivityAsync(async () =>
        {
            // Only games this reader has moves to see (ADR 0024): an evaluation feed's are the operator's.
            _games = (await Reads.GamesAsync()).ToList();

            _aimedAt = Aim;

            // In Line watch the window shows what the Board pressed, and nothing until it has: a
            // game a desk saved in an earlier run is not today's choice (LineWatch.IsCurrent).
            // Outside it, the window opens on the next game to start, as it always has.
            _following = !Watching || LineWatch.IsCurrent(Press);
            _gameId = !_following ? null : GameId ?? NextUp(_games, DateTimeOffset.UtcNow)?.Id;

            // An old aim restored with the desk leaves with it: the title no longer names the old
            // game over the overview, and the desk saves the overview, not the stale game.
            if (!_following)
                Remember([], null);
            _market = Market ?? _market;
            _side = Outcome ?? _side;

            await ReadAsync();
        }, Standing, StatusLine);

    /// <summary>
    /// The game the window opens on when nothing aimed it: the next to start, or the one that
    /// started last when none is ahead. It opened on the list's first, which was the oldest game
    /// on file once closing lines were kept — last April's, on a desk holding a season.
    /// </summary>
    public static Game? NextUp(IReadOnlyList<Game> games, DateTimeOffset now)
        => games.Where(g => g.StartsAt >= now).MinBy(g => g.StartsAt)
           ?? games.MaxBy(g => g.StartsAt);

    /// <summary>The parameters as one aim, the press as text so a saved desk's number compares.</summary>
    private (int? Game, string? Market, string? Outcome, string? Press) Aim
        => (GameId, Market, Outcome, Press?.ToString());

    /// <summary>
    /// Re-aimed in place (Line watch): the game, market and side a Board press names are shown as
    /// choosing them here would show them. Only a new aim does this — a press moves the count, so
    /// pressing the same price again after looking elsewhere here turns the window back to it —
    /// and a render handing the same aim back leaves what the operator chose here alone.
    /// </summary>
    protected override Task OnParametersSetAsync()
    {
        var aim = Aim;

        if (_aimedAt is null || _aimedAt == aim)
            return Task.CompletedTask;

        _aimedAt = aim;

        if (Watching && LineWatch.IsCurrent(Press))
            _following = true;
        else if (Overview)
            return Task.CompletedTask;

        if (Market is not null)
            _market = Market;

        if (Outcome is not null)
            _side = Outcome;

        if (GameId is { } id && id != _gameId)
            return OnGameChanged(id);

        return LoadAsync();
    }

    /// <summary>Whether the select has an option for this game, so it names it rather than its placeholder.</summary>
    private bool Listed(int? id)
        => id is not null && (_games.Any(g => g.Id == id) || _picked?.Id == id);

    private Task OnGameChanged(int? id)
    {
        _gameId = id;
        _following = true;

        return LoadAsync();
    }

    // ---- Line watch: the overview, and what is followed (ADR 0029) ------------------------

    /// <summary>Line watch is the workspace on the desk, and this window answers the Board.</summary>
    private bool Watching => LineWatch.Drives(Manager, WindowId);

    /// <summary>
    /// A game is being followed: pressed on the Board today, chosen from the overview, or picked in
    /// the window's own select. Outside Line watch the window always follows its game.
    /// </summary>
    private bool _following = true;

    /// <summary>Line watch with nothing chosen yet: the slate's overview stands where a game would.</summary>
    private bool Overview => Watching && !_following;

    private SlateOverview _slate = SlateOverview.Empty;

    /// <summary>A row of the overview pressed: that game, and from a move its market and side, followed here.</summary>
    private Task FollowAsync(Game game, string? market, string? outcome)
    {
        _following = true;
        _gameId = game.Id;

        if (market is not null)
            _market = market;

        _side = outcome;

        // Followed as a Board press is: in the window's parameters and title, so the window says
        // what it shows and a desk saved now comes back on this game, not the last one pressed.
        var aim = new Dictionary<string, object> { ["GameId"] = game.Id, ["Press"] = LineWatch.Issue() };
        if (market is not null)
            aim["Market"] = market;
        if (outcome is not null)
            aim["Outcome"] = outcome;

        Remember(aim, Matchup(game));
        return LoadAsync();
    }

    /// <summary>Back to the overview: nothing followed until the next press.</summary>
    private Task ShowOverviewAsync()
    {
        _following = false;
        _gameId = null;
        _picked = null;
        Remember([], null);
        return LoadAsync();
    }

    /// <summary>
    /// Writes what the window now follows into its own parameters and title, as LineWatch.Show
    /// does for a Board press: the title bar names it, and a saved desk keeps it. The aim is
    /// noted as this window's own, so the parameters coming back on the next render re-read nothing.
    /// The load that follows redraws the title bar (its pulse moves).
    /// </summary>
    private void Remember(Dictionary<string, object> aim, string? title)
    {
        _aimedAt = (aim.GetValueOrDefault("GameId") as int?, aim.GetValueOrDefault("Market") as string,
            aim.GetValueOrDefault("Outcome") as string, aim.GetValueOrDefault("Press")?.ToString());

        if (WindowId is null || Manager.Find(WindowId) is not { } window)
            return;

        WindowManager.Aim(window.Parameters, aim);
        window.TitleOverride = title;
    }


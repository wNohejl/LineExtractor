    /// <summary>
    /// "Quietest line", not "oldest". Prices are stored on change (ADR 0001), so an old
    /// timestamp means the line has not moved rather than that the data is stale — and a close
    /// contributes nothing here, because it is old by construction and will never move again.
    /// </summary>
    private string MovesNote
        => _oldest is { } quiet && quiet > TimeSpan.FromMinutes(1)
            ? $"quietest line {Age(quiet.TotalMinutes)} unmoved"
            : "written only when a price moves";

    /// <summary>
    /// Severity, not just a count. "2 open" says something is wrong; "1 critical" says whether
    /// it is worth interrupting what you were doing, which is the question being asked here.
    /// </summary>
    private string AlertNote => _alerts == 0
        ? "all clear"
        : _criticalAlerts > 0
            ? $"{_criticalAlerts} critical — open Ops"
            : "none critical — open Ops";

    private DeskState AlertState => _criticalAlerts > 0
        ? DeskState.Negative
        : _alerts > 0 ? DeskState.Warning : DeskState.Positive;

    private string PhaseWord => _phase switch
    {
        BoardPhase.Upcoming => "unstarted",
        BoardPhase.Live => "in-play",
        BoardPhase.Played => "finished",
        _ => ""
    };

    /// <summary>
    /// Which side a price column is for, as the team's own short form.
    ///
    /// <para>
    /// The board orders every market home-first so a column reads down consistently, but that
    /// ordering is only a convention until it is written on the cell. Abbreviations are right
    /// here — this is a dense grid where the same names repeat down the column, which is exactly
    /// where a short form belongs rather than where a game is being identified.
    /// </para>
    ///
    /// <para>
    /// Falls back to "H"/"A" for a team with no abbreviation on record, which is better than a
    /// blank: the reader still learns which side they are looking at.
    /// </para>
    /// </summary>
    /// <summary>"LAC ML · FD +295" — the side, the market, and where to take it.</summary>
    private static string PickLabel(BoardRow row, ValuePick pick)
    {
        var first = pick.IsFirstSide(row.Game);
        var side = pick.Market == Markets.Total ? (first ? "O" : "U") : Side(row, first);
        var bet = pick.Market switch
        {
            Markets.Moneyline => $"{side} ML",
            _ when pick.Book.Line is { } line => pick.Market == Markets.Total
                ? $"{OddsMath.FormatLine(line, pick.Outcome)}"
                : $"{side} {OddsMath.FormatLine(line, pick.Outcome)}",
            _ => side
        };

        return $"{bet} · {PriceCell.Monogram(pick.Book.Book)} {OddsMath.FormatPrice(pick.Book.PriceAmerican)}";
    }

    /// <summary>
    /// The Value cell's tooltip, spoken: the side, the book by name (the feed's key, "draftkings",
    /// was printed here before), the price and the edge against the fair price.
    /// </summary>
    private static string ValueTitle(BoardRow row, ValuePick pick)
        => $"{pick.Outcome} at {BookNames.Display(pick.Book.Book)}, {OddsMath.FormatPrice(pick.Book.PriceAmerican)}: "
           + $"{PriceCell.EvLabel(pick.Book.Ev!.Value)} against the fair price — the most value on this game.";

    /// <summary>The same under its title: where to take it on one line, what it is worth on the next.</summary>
    private static string ValueCaption(ValuePick pick)
        => $"{pick.Outcome} at {BookNames.Display(pick.Book.Book)}, {OddsMath.FormatPrice(pick.Book.PriceAmerican)}\n"
           + $"{PriceCell.EvLabel(pick.Book.Ev!.Value)} against the fair price";

    private static string Side(BoardRow row, bool home)
    {
        var team = home ? row.Game.HomeTeam : row.Game.AwayTeam;

        return string.IsNullOrWhiteSpace(team?.Abbrev)
            ? home ? "H" : "A"
            : team!.Abbrev;
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task OnSportChanged(string value)
    {
        _sport = value ?? string.Empty;
        await LoadAsync();
    }

    private async Task SetWindowAsync(int hours)
    {
        _windowHours = hours;
        await LoadAsync();
    }

    /// <summary>Narrowing the view costs nothing — the rows are already loaded.</summary>
    private void SetPhase(BoardPhase phase)
    {
        _phase = phase;

        // A row left open under another filter would linger as a detached strip.
        _open = null;
        _snippet = null;
        _take = null;
        ApplyFilter();
    }

    /// <summary>
    /// The load in flight, cancelled by the next, so a slower read of the last league or horizon
    /// cannot land last and paint it under the new filter — and no superseded read runs to its
    /// end for nothing. Its <see cref="LatestRead.Gone"/> is for the alert recount, which is not a load.
    /// </summary>
    private readonly LatestRead _reads = new();

    /// <summary>
    /// The board's reads, together: the rows, today's moves, the alert counts and the league
    /// names each have a context of their own and none needs another's answer, so the wait is
    /// the slowest read's rather than the sum. Everything is read into locals and handed over at
    /// once, and only by the latest load: a newer filter cancels this one (<see cref="LatestRead.Next"/>),
    /// and one that comes back anyway hands over nothing. The token is taken inside the work so
    /// Try again, which repeats it, starts a read of its own.
    /// </summary>
    private async Task LoadAsync()
    {
        await WithActivityAsync(async () =>
        {
            var ct = _reads.Next();
            var sport = _sport;

            await LatestRead.HandOverAsync(ct, async () =>
            {
                await using var scope = ScopeFactory.CreateAsyncScope();
                var board = scope.ServiceProvider.GetRequiredService<BoardService>();

                var rowsRead = board.GetAsync(
                    string.IsNullOrEmpty(sport) ? null : sport,
                    TimeSpan.FromHours(_windowHours),
                    Lookback,
                    ct);
                var movesRead = MovesTodayAsync(ct);
                var alertsRead = AlertCountsAsync(ct);
                var namesRead = SportNamesAsync(ct);

                // A failure in any of them still reaches WithActivityAsync, so the window says
                // the board did not load exactly as it did when they ran one after another.
                await Task.WhenAll(rowsRead, movesRead, alertsRead, namesRead);

                var rows = (await rowsRead).ToList();

                // Which stats source fills the board (ADR 0026), for the empty state's sentence and key.
                var port = scope.ServiceProvider.GetService<SourceRegistry>()?.Port;

                return (Rows: rows, Port: port, Moves: await movesRead, Alerts: await alertsRead, Names: await namesRead);
            },
            read => HandOver(read.Rows, read.Port, read.Moves, read.Alerts, read.Names));
        },
        settle: () => _rows.Count == 0 ? PulseState.Idle : PulseState.Healthy,
        status: () => _rows.Count == 0 ? "no games" : $"{_priced}/{_rows.Count} priced");
    }

    /// <summary>What the latest load read, onto the board at once.</summary>
    private void HandOver(
        List<BoardRow> rows, StatsPort? port, long moves, (int Open, int Critical) alerts, Dictionary<string, string> names)
    {
        _rows = rows;
        _bookCount = _rows.Count == 0 ? 0 : _rows.Max(r => r.BookCount);
        _fewestBooks = _rows.Where(r => r.BookCount > 0).Select(r => r.BookCount).DefaultIfEmpty().Min();
        _priced = _rows.Count(r => r.HasPrices);
        _unpriced = _rows.Count - _priced;
        _port = port;

        // Age is only reported for the live market. BoardRow already withholds it from a
        // closing row, so this reads "how long since anything moved" rather than "how old
        // is the oldest number on screen".
        _oldest = _rows.Select(r => r.Age).Where(a => a is not null).DefaultIfEmpty().Max();

        _movesToday = moves;
        (_alerts, _criticalAlerts) = alerts;

        BuildSportOptions(names);
        BuildPhaseOptions();
        ApplyFilter();
    }

    /// <summary>Price moves written today, counted over the scans this reader may see (ADR 0024), as the rows are priced.</summary>
    private async Task<long> MovesTodayAsync(CancellationToken ct)
    {
        await using var db = await DbFactory.CreateDbContextAsync(ct);

        var dayStart = LeagueClock.StartOf(LeagueClock.Today());
        return await db.OddsSnapshots.FromVisible(await db.VisibleSourceIdsAsync(Tier, ct))
            .LongCountAsync(s => s.CapturedAt >= dayStart, ct);
    }

    /// <summary>Open alerts and the critical ones among them, each counted on a context of its own so they go out together.</summary>
    private async Task<(int Open, int Critical)> AlertCountsAsync(CancellationToken ct)
    {
        var open = CountAlertsAsync(critical: false, ct);
        var critical = CountAlertsAsync(critical: true, ct);
        await Task.WhenAll(open, critical);

        return (await open, await critical);
    }

    private async Task<int> CountAlertsAsync(bool critical, CancellationToken ct)
    {
        await using var db = await DbFactory.CreateDbContextAsync(ct);

        return critical
            ? await db.Alerts.CountAsync(a => a.ResolvedAt == null && a.Severity == AlertSeverity.Critical, ct)
            : await db.Alerts.CountAsync(a => a.ResolvedAt == null, ct);
    }

    /// <summary>
    /// The alert tile after a notice of alerts alone (<see cref="RefreshAsync(IReadOnlySet{string})"/>).
    /// Outside <c>WithActivityAsync</c> on purpose: it neither cancels a load in flight nor
    /// becomes the load Try again repeats, and a failure is the base class's "refresh failed".
    /// </summary>
    private async Task RecountAlertsAsync()
    {
        (_alerts, _criticalAlerts) = await AlertCountsAsync(_reads.Gone);
    }

    /// <summary>The enabled leagues' names by key, for the league filter.</summary>
    private async Task<Dictionary<string, string>> SportNamesAsync(CancellationToken ct)
    {
        await using var db = await DbFactory.CreateDbContextAsync(ct);

        return await db.Sports
            .Where(s => s.Enabled)
            .AsNoTracking()
            .ToDictionaryAsync(s => s.Key, s => s.Name, StringComparer.OrdinalIgnoreCase, ct);
    }

    private void ApplyFilter()
    {
        _visible = _phase switch
        {
            BoardPhase.Upcoming => _rows.Where(r => r.Game.Status == GameStatus.Scheduled).ToList(),
            BoardPhase.Live => _rows.Where(r => r.Game.Status == GameStatus.Live).ToList(),
            BoardPhase.Played => _rows
                .Where(r => r.Game.Status is GameStatus.Final or GameStatus.Postponed)
                .ToList(),
            _ => _rows
        };

        if (!string.IsNullOrWhiteSpace(_team))
        {
            _visible = _visible.Where(r => SearchService.MatchesAllWords(_team,
                r.Game.HomeTeam?.Name, r.Game.AwayTeam?.Name,
                r.Game.HomeTeam?.Abbrev, r.Game.AwayTeam?.Abbrev)).ToList();
        }

        // Counted over the whole slate, so the key says how many there are before it is pressed;
        // and let go of once a refresh leaves none, rather than showing an empty board for a
        // reason the operator can no longer see.
        _valueRows = _rows.Count(r => r.BestEv > 0);
        if (_valueRows == 0)
            _valueOnly = false;

        if (_valueOnly)
            _visible = _visible.Where(r => r.BestEv > 0).OrderByDescending(r => r.BestEv).ToList();

        _closing = _visible.Count(r => r.PricesAreClosing);

        // A filter or a reload that drops the open row closes it, as a phase change does. Left
        // open, the row would come back with a fresh strip showing nothing chosen while the
        // snippet it no longer owns still hung under it.
        _open = StillOpen(_open, _visible);
        if (_open is null)
        {
            _snippet = null;
            _take = null;
        }
    }

    /// <summary>
    /// The league filter's options: every requested league, plus any league that turned up on
    /// the board without being asked for.
    ///
    /// <para>
    /// Built from configuration rather than only from the data, so a league the desk is polling
    /// still appears on a day it has no fixtures. The operator asked for it, and an option that
    /// vanishes when the answer is "none" cannot be told apart from one that was never offered
    /// — ADR 0003's two kinds of zero. The count rides in the label, so an empty league says so
    /// before it is chosen.
    /// </para>
    /// </summary>
    private void BuildSportOptions(Dictionary<string, string> names)
    {

        // Counts only mean anything on an unfiltered load; once a league is selected the board
        // holds that league alone, so the other options keep whatever they last showed.
        if (_sport.Length == 0)
        {
            _counts = _rows
                .GroupBy(r => r.Game.Sport?.Key ?? string.Empty)
                .Where(g => g.Key.Length > 0)
                .ToDictionary(g => g.Key, g => g.Count(), StringComparer.OrdinalIgnoreCase);
        }

        var keys = IngestionOptions.Value.EffectiveSports
            .Concat(_counts.Keys)
            .Concat(names.Keys)
            .Where(k => k.Length > 0)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(k => k, StringComparer.OrdinalIgnoreCase)
            .ToList();

        _sportOptions = keys.Select(k =>
        {
            var name = names.TryGetValue(k, out var n) ? n : k.ToUpperInvariant();
            var count = _counts.TryGetValue(k, out var c) ? c : 0;

            return new SportOption(k, count == 0 ? name : $"{name} · {count}");
        }).ToList();
    }

    private Dictionary<string, int> _counts = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>
    /// The phase gate's positions, offered only for the phases actually on the board.
    ///
    /// A board of nothing but scheduled games has no "in play" to switch to, and a gate holding
    /// positions that cannot change what is on screen teaches the operator to ignore it.
    /// </summary>
    private void BuildPhaseOptions()
    {
        var live = _rows.Count(r => r.Game.Status == GameStatus.Live);
        var played = _rows.Count(r => r.Game.Status is GameStatus.Final or GameStatus.Postponed);
        var upcoming = _rows.Count(r => r.Game.Status == GameStatus.Scheduled);

        var options = new List<DeskSwitchOption<BoardPhase>>
        {
            new(BoardPhase.Any, "All", $"Every game in the window — {_rows.Count}")
        };

        if (upcoming > 0 && (live > 0 || played > 0))
            options.Add(new(BoardPhase.Upcoming, "Next", $"Not started yet — {upcoming}"));

        if (live > 0)
            options.Add(new(BoardPhase.Live, "Live", $"Being played now — {live}"));

        if (played > 0)
            options.Add(new(BoardPhase.Played, "Final", $"Finished or postponed — {played}"));

        _phaseOptions = options.Count > 1 ? options : [];

        // A filter left pointing at a phase that has emptied would show nothing for a reason
        // the operator did not choose.
        if (!_phaseOptions.Any(o => EqualityComparer<BoardPhase>.Default.Equals(o.Value, _phase)))
            _phase = BoardPhase.Any;
    }

    /// <summary>
    /// Opening a row is what reveals its actions. One at a time: two open rows would push the
    /// board around and the actions would stop being obviously attached to a game.
    /// </summary>
    private void Toggle(BoardRow row)
    {
        _open = _open?.Game.Id == row.Game.Id ? null : row;
        _snippet = null;
        _take = null;
        _watched = null;

        // Line watch (ADR 0029): a game opened here is the game Line movement shows. The row
        // still opens, so its strip — and the take behind Place wager — is a press away.
        if (_open is not null && Watching)
            Watch(row, market: null, outcome: null);
    }

    /// <summary>Whether Line watch is the workspace on the desk, and a press here drives Line movement.</summary>
    private bool Watching => LineWatch.IsActive(Manager);

    /// <summary>Shows the game, and from a price its market and side, in the Line movement window.</summary>
    private void Watch(BoardRow row, string? market, string? outcome)
        => LineWatch.Show(Manager, row.Game.Id, market, outcome, Matchup(row.Game), WindowId);

    // The hint and the press rule follow the workspace: applied or left while the Board is open,
    // the Board redraws when it changes.
    private bool _watchingDrawn;

    private void OnDeskChanged()
    {
        if (Watching != _watchingDrawn)
            _ = InvokeAsync(StateHasChanged);
    }

    protected override void OnAfterRender(bool firstRender) => _watchingDrawn = Watching;

    /// <summary>
    /// The open row, if the rows now showing still include its game; otherwise none. By game,
    /// because a reload brings the same game back as a new row.
    /// </summary>
    public static BoardRow? StillOpen(BoardRow? open, IReadOnlyList<BoardRow> visible)
        => open is not null && visible.FirstOrDefault(r => r.Game.Id == open.Game.Id) is { } row ? row : null;

    /// <summary>
    /// The row the grid opens under the open game: the strip first, on a line of its own, then
    /// whatever answer is up — a glance the strip handed over, or a take. A press anywhere in it
    /// stops there (DeskGrid's child row), so only the game row's own click closes the row.
    /// </summary>
    private RenderFragment OpenRow(BoardRow row) => __builder =>
    {
        @* Keyed by the game so moving to another row is a fresh strip rather than one still
           showing the previous game's snippet — and by the take, so a price pressed while a
           glance was open leaves the strip with nothing chosen rather than a segment lit for a
           snippet no longer showing. *@
        <RowActions @key="(row.Game.Id, _takeSerial)" Actions="ActionsFor(row)"
                    SnippetHost="@((RenderFragment? snippet) => HostSnippet(row.Game.Id, snippet))" />
        @_snippet
    };

    /// <summary>
    /// A strip handing over its snippet, or taking it back. Only the open game's strip is heard:
    /// a strip going away after another row opened cannot clear the newer row's snippet.
    /// </summary>
    private void HostSnippet(int gameId, RenderFragment? snippet)
    {
        if (_open?.Game.Id != gameId)
            return;

        // A take owns the row's snippet until something replaces it: the strip it re-keyed
        // away hands back null on its way out, and that must not put the take away.
        if (snippet is null && _take is not null)
            return;

        _take = null;
        _snippet = snippet;
    }

    private static DeskState StatusState(GameStatus status) => status switch
    {
        GameStatus.Live => DeskState.Warning,
        GameStatus.Final => DeskState.Positive,
        GameStatus.Postponed => DeskState.Negative,
        _ => DeskState.Info
    };


    /// <summary>
    /// A game whose state says it has been played but whose score has not arrived. That is a
    /// results pass that has not run, not an empty cell — so the row says which.
    /// </summary>
    private static string MissingScoreHint(GameStatus status)
        => status == GameStatus.Postponed ? "not played" : "no score yet";

    /// <summary>
    /// One club in the matchup cell: a line of its crest, its nickname and its starter. The line
    /// dissolves into the cell's grid (.board__sides), so the away and home lines share their
    /// columns and the two starters start at one edge.
    /// </summary>
    private static RenderFragment Side(BoardRow row, bool home, bool loser) => __builder =>
    {
        var team = home ? row.Game.HomeTeam : row.Game.AwayTeam;
        var starter = Starter(row, home);

        <span class="board__side@(loser ? " board__team--loser" : "")">
            <TeamMark Sport="@row.Game.Sport?.Key" Abbrev="@team?.Abbrev" />
            <span class="board__team">@TeamNames.Short(team, Scoreline.Abbrev(team, home ? "Home" : "Away"))</span>
            @if (starter is { } s)
            {
                @* No title of its own: the starter sits inside the matchup link, which takes focus,
                   so the full name and what the role means ride on the link's tooltip
                   (MatchupTooltip) instead of a title only a pointer raises (HIG 12). *@
                <span class="board__starter">
                    @if (s.Role.Length > 0)
                    {
                        <span class="board__starter-role">@s.Role</span>@(" ")
                    }
                    @s.Name
                </span>
            }
        </span>
    };

    /// <summary>
    /// The first header of a market's pair: the market's name, which the stylesheet draws centred
    /// over both columns (.board__market), and the side the column holds, for a screen reader.
    /// </summary>
    private static RenderFragment MarketHeader(string market, string side) => __builder =>
    {
        <span class="board__market">@market</span><span class="sr-only">, @side</span>
    };

    /// <summary>The second header of a pair: nothing drawn under the shared name, a name of its own to hear.</summary>
    private static RenderFragment SideHeader(string market, string side) => __builder =>
    {
        <span class="sr-only">@market, @side</span>
    };

    /// <summary>
    /// The matchup link's tooltip: the game it opens, then each side's starter in full — the
    /// sentence the abbreviated "SP Gasser" stands for. The link takes focus, so this reaches
    /// the keyboard and a screen reader, where a title on the starter's own span did not.
    /// </summary>
    public static string MatchupTooltip(BoardRow row)
    {
        var game = row.Game;
        var fight = row.Bout is not null;
        var lines = new List<string> { WindowShortcuts.Describe(game) };

        // Billed order, as the cell draws it: red corner first for a fight, away first otherwise.
        foreach (var home in fight ? new[] { true, false } : new[] { false, true })
        {
            if (Starter(row, home) is { } s)
            {
                var team = home ? game.HomeTeam : game.AwayTeam;
                lines.Add($"{TeamNames.Short(team, Scoreline.Abbrev(team, home ? "Home" : "Away"))}: {s.Title}");
            }
        }

        return string.Join("\n", lines);
    }

    /// <summary>
    /// A club's starter as the matchup cell names it: the probable pitcher MLB has announced, or
    /// the quarterback an NFL club started its last game with. Null when the game has neither
    /// side's; a side not yet named reads TBD, so the two starters still line up under their clubs.
    /// </summary>
    public static (string Role, string Name, string Title)? Starter(BoardRow row, bool home)
    {
        var game = row.Game;

        // A fighter's record going into the bout stands where a starter would (ADR 0021).
        if (row.Bout is { } bout)
        {
            var record = home ? bout.HomeRecord : bout.AwayRecord;
            return record is null ? null : ("", record, $"Record going into this fight: {record}");
        }

        if (game.AwayProbablePitcher is not null || game.HomeProbablePitcher is not null)
        {
            var pitcher = home ? game.HomeProbablePitcher : game.AwayProbablePitcher;
            return ("SP", Surname(pitcher), pitcher is null
                ? "Starting pitcher not yet named"
                : $"Probable starting pitcher: {pitcher}");
        }

        if (row.AwayQuarterback is not null || row.HomeQuarterback is not null
            || row.AwayQuarterbackBasis is not null || row.HomeQuarterbackBasis is not null)
        {
            var quarterback = home ? row.HomeQuarterback : row.AwayQuarterback;
            var basis = home ? row.HomeQuarterbackBasis : row.AwayQuarterbackBasis;

            // A starter ruled out says so: the tooltip is the injury and who stands in. A plain
            // basis — the last game's starter, or this game's own passer once it is under way —
            // is said with the name after it.
            var plain = basis is XLines.Data.CrossReference.Starters.LastGameBasis
                or XLines.Data.CrossReference.Starters.ThisGameBasis;
            var title = basis is not null && !plain
                ? basis
                : quarterback is null
                    ? "No passing on record for this club"
                    : $"{basis ?? XLines.Data.CrossReference.Starters.LastGameBasis}: {quarterback}";

            return ("QB", quarterback is null ? "—" : Surname(quarterback), title);
        }

        return null;
    }

    /// <summary>
    /// Who leads a finished game, so its loser can read lighter; Level or None for a game that
    /// is live, tied or unscored, where both sides keep full weight.
    /// </summary>
    private static ScoreLeader FinalLeader(Game game)
        => game.Status == GameStatus.Final ? Scoreline.Leader(game) : ScoreLeader.None;

    /// <summary>W, L or D for one side of a finished fight; NC for a no contest.</summary>
    private static string FightMark(Bout bout, ScoreLeader leader, bool home) => bout.Outcome switch
    {
        BoutOutcome.NoContest => "NC",
        BoutOutcome.Draw => "D",
        _ => leader == (home ? ScoreLeader.Home : ScoreLeader.Away) ? "W" : "L"
    };

    /// <summary>The score spelled out with full names: the cell's tooltip, and what it reads aloud.</summary>
    private static string ScoreTitle(Game game)
        => $"{game.AwayTeam?.Name ?? "Away"} {game.AwayScore ?? 0} — "
           + $"{game.HomeTeam?.Name ?? "Home"} {game.HomeScore ?? 0}";

    /// <summary>
    /// Presses the pull menu rather than running a job directly, so an inline offer and the
    /// menu entry are the same press: same busy key, same result note, same reload.
    /// </summary>
    private async Task PullAsync(string key)
    {
        if (_pull is null || !_pullingKeys.Add(key))
            return;

        try
        {
            await _pull.RunAsync(key);
        }
        finally
        {
            _pullingKeys.Remove(key);
        }
    }

    /// <summary>
    /// A pull runs in the menu or on the Date range key; the panel only reflects it on its own
    /// pulse strip. Counted, not flagged: the two keys can run at once, and the first to finish
    /// must not read as the end of both.
    /// </summary>
    private void OnPullBusy(bool busy)
    {
        _pullsRunning = Math.Max(0, _pullsRunning + (busy ? 1 : -1));

        if (_pullsRunning > 0)
            Report(PulseState.Active, "pulling");
    }

    /// <summary>
    /// What this row can do, in the order an operator reaches for them.
    ///
    /// <para>
    /// The first three answer their question on the row — a price, a fixture's history, both
    /// sides' form — because none of them is worth evicting a window for. So does More bets:
    /// the book-by-book table opens under the row, and its escape makes it a window or a tab.
    /// Place wager is a command: it opens the take in the row.
    /// </para>
    ///
    /// <para>
    /// A row with no price on it offers neither: there is nothing to lay out book by book and
    /// nothing to wager against. It gets the pull that would fix it instead, where the gap is
    /// stated — and only while a pull could still help, since no book will re-quote a game that
    /// has already started.
    /// </para>
    /// </summary>
    private List<RowAction> ActionsFor(BoardRow row)
    {
        var id = row.Game.Id;
        var name = Matchup(row.Game);

        var actions = new List<RowAction>
        {
            new()
            {
                Key = "odds",
                Label = "Odds",
                Icon = Icons.Material.Filled.ShowChart,
                Snippet = @<OddsSnippet GameId="id" />,
                OpenLabel = "Movement",
                OpenWindow = Command(() => Launch(WindowCatalog.Odds, "GameId", id, name))
            },
            new()
            {
                Key = "h2h",
                Label = "H2H",
                Icon = Icons.Material.Filled.CompareArrows,
                Snippet = @<HeadToHeadSnippet GameId="id" />,
                OpenLabel = "Full history",
                OpenWindow = Command(() => Launch(WindowCatalog.HeadToHead, "GameId", id, name))
            },
            new()
            {
                Key = "form",
                Label = "Form",
                Icon = Icons.Material.Filled.QueryStats,
                Snippet = @<FormSnippet GameId="id" />,
                OpenLabel = row.Bout is null ? "Both rosters" : "Tale of the tape",
                OpenWindow = Command(() => Launch(WindowCatalog.Form, "GameId", id, name))
            }
        };

        // A live NFL game can be followed play by play. A destination, not a glance: the drive
        // log and the field are somewhere to watch from for a whole half, so it opens a desk
        // window, as the matchup's own link opens the Game window, rather than a follow-up dialog.
        if (row.Game.Status == GameStatus.Live && GamecastPanel.Offered(row.Game))
        {
            actions.Add(new RowAction
            {
                Key = "gamecast",
                Label = "Gamecast",
                Icon = Icons.Material.Filled.SportsFootball,
                OpenWindow = Command(() => Manager.OpenGamecast(id, WindowShortcuts.Describe(row.Game)))
            });
        }

        // A visitor reads the board — every book's number — but has no wager to log and no
        // lines to pull (ADR 0018).
        var operate = Manager.Access.CanOperate;

        if (row.HasPrices)
        {
            // Every book's number drops down under the row, as the glances do. It was a
            // destination, and on a full desk a destination floats: the dialog sat over the
            // slate it was opened from, the open row and its take behind it. The table is three
            // short grids, which the row has the width for; the escape is for keeping it.
            actions.Add(new RowAction
            {
                Key = "bets",
                Label = "More bets",
                Icon = Icons.Material.Filled.ViewList,
                Snippet = @<BoardAllBets GameId="id" />,
                // Its markets are section cards of their own, so the drawer is their pane header.
                SnippetCards = true,
                OpenLabel = Manager.AtCapacity ? "Open as tab" : "Open window",
                OpenWindow = Command(() => OpenBets(id, name))
            });

            if (operate)
            {
                actions.Add(new RowAction
                {
                    Key = "wager",
                    // The row strip is the Desk's to draw, so the key is not a WagerKey; it
                    // takes the wager key's own label and glyph, so it reads as one.
                    Label = WagerKey.PlaceLabel,
                    Icon = WagerKey.Glyph,
                    // Tinted, not Filled: the strip repeats on every row the operator opens, and a
                    // solid accent per row would put a dozen primaries on one slate. The Board is a
                    // place to look, and the take this opens holds the commit.
                    Emphasis = DeskEmphasis.Tinted,
                    // Door 1 opens on the most value, in the row, as a pressed price does; a game
                    // with no value read anywhere has no side to start from, so it is the form. In
                    // Line watch a price pressed on this row is the side being watched, so the take
                    // opens on it (ADR 0029), and the most value only when none was pressed. Read
                    // at the press, not now: the strip is built before the price is pressed.
                    OpenWindow = Command(() => PlaceWager(row))
                });
            }
        }
        else if (operate && CanPull(row))
        {
            actions.Add(new RowAction
            {
                Key = "pull",
                // The pull runs on the toolbar's menu, and the row's key says so too: busy, and
                // worded as what is happening, so a press here is answered here rather than only
                // by a key at the top of the window. This sport's lines, not any pull: a range
                // pull for another league leaves this key as it was.
                Label = _pullingKeys.Contains(IngestionJobs.OddsLinesPrefix + row.Game.Sport!.Key)
                    ? $"Pulling {row.Game.Sport!.Key.ToUpperInvariant()} lines"
                    : $"Pull {row.Game.Sport!.Key.ToUpperInvariant()} lines",
                Icon = Icons.Material.Filled.CloudDownload,
                Emphasis = DeskEmphasis.Tinted,
                Busy = _pullingKeys.Contains(IngestionJobs.OddsLinesPrefix + row.Game.Sport!.Key),
                OpenWindow = Command(() => PullAsync(IngestionJobs.OddsLinesPrefix + row.Game.Sport!.Key))
            });
        }

        return actions;
    }

    /// <summary>
    /// A row command as a callback this panel owns, so the panel is drawn after it. The press is
    /// the strip's event; run as a bare delegate from there, a command that changed this panel's
    /// state — the take opened under the row, a Pull key marked busy — drew nothing until a
    /// refresh or a live score redrew the board.
    /// </summary>
    private EventCallback Command(Func<Task> run) => EventCallback.Factory.Create(this, run);

    private EventCallback Command(Action run) => EventCallback.Factory.Create(this, run);

    /// <summary>
    /// Whether pulling lines could still fill this row. No book re-quotes a game that is under
    /// way, so offering the pull there would be a key that cannot work.
    /// </summary>
    private static bool CanPull(BoardRow row)
        => row.Game.Sport is not null
           && row.Game.Status == GameStatus.Scheduled
           && row.Game.StartsAt > DateTimeOffset.UtcNow;

    /// <summary>
    /// Every book as a window of its own, never a dialog over the Board: a column while one is
    /// free, and once none is the front tab of the column beside the Board (WindowManager.Open
    /// keeps out of the column being worked in) — or of the Board's own on a one-column desk.
    /// </summary>
    private void OpenBets(int id, string name)
    {
        if (Manager.Catalog.Find(WindowCatalog.Bets) is not { } definition)
            return;

        Manager.Open(definition, new Dictionary<string, object> { ["GameId"] = id }, $"{definition.Title} · {name}");
    }

    private Task Launch(string key, string parameter, int id, string name, string width = "640px")
    {
        _followUps.Launch(Manager, key, parameter, id, name, width);
        return Task.CompletedTask;
    }

    /// <summary>A price taken in its row: which game, which side, from which book.</summary>
    private sealed record TakeRequest(int GameId, string Market, string Outcome, string? Book);

    /// <summary>The take open under the open row, or null. It owns the row's snippet while it is.</summary>
    private TakeRequest? _take;

    /// <summary>
    /// In Line watch, the price last pressed on the open row: shown in Line movement, and the one its
    /// Place wager takes. Cleared when the row closes or another row opens.
    /// </summary>
    private TakeRequest? _watched;

    /// <summary>
    /// The row's Place wager: the take on the price watched on this row, else on the most value,
    /// else — nothing to start from — the full form.
    /// </summary>
    private Task PlaceWager(BoardRow row)
    {
        if (_watched is { } watched && watched.GameId == row.Game.Id)
            return OpenTake(row, watched.Market, watched.Outcome, watched.Book);

        if (row.BestPick is { } pick)
            return OpenTake(row, pick.Market, pick.Outcome, pick.Book.Book);

        return Launch(WindowCatalog.Wager, "GameId", row.Game.Id, Matchup(row.Game), "480px");
    }

    /// <summary>
    /// Bumped each time a take opens, and part of the row strip's key, so the strip is redrawn with
    /// nothing chosen rather than lighting the segment of a glance the take has replaced.
    /// </summary>
    private int _takeSerial;

    /// <summary>How many pulls are running from the toolbar's two keys; the pulse strip is Active while any is.</summary>
    private int _pullsRunning;

    /// <summary>The job keys pressed from a row that are still running; that row's Pull lines key shows it.</summary>
    private readonly HashSet<string> _pullingKeys = [];

    private bool IsTaking(BoardRow row, MarketPair pair, BestOffer? offer)
        => offer is not null && _take is { } take && take.GameId == row.Game.Id
           && take.Market == pair.Market && take.Outcome == offer.Outcome;

    /// <summary>Whether the slip holds this cell's price: the same side, line and book.</summary>
    private bool IsBanked(BoardRow row, MarketPair pair, BestOffer? offer)
        => offer is not null && Slip.Items.Any(i => i.GameId == row.Game.Id && i.Market == pair.Market
               && i.Outcome == offer.Outcome && i.Line == offer.Line
               && string.Equals(i.Book, offer.Book, StringComparison.OrdinalIgnoreCase));

    /// <summary>
    /// Door 2: a live price opens its take under the row — the stake, what is worth knowing and
    /// Log, without a window over the board. The same price pressed again puts it away. The full
    /// wager form is the take's escape, for what a row cannot say.
    /// </summary>
    private Task Take(BoardRow row, MarketPair pair, BestOffer? offer)
    {
        if (offer is null)
            return Task.CompletedTask;

        // Line watch (ADR 0029): a price pressed shows its market and side in Line movement, and
        // the row opens on it with nothing taken — the take is the open row's Place wager key.
        // A take already open, on this row or another, is put away: left open it would go on
        // offering, and logging, the price pressed before.
        if (Watching)
        {
            if (_open?.Game.Id != row.Game.Id)
            {
                _open = row;
                _snippet = null;
                _take = null;
            }
            else if (_take is not null)
                CloseTake();

            // The price the row's Place wager takes, until the row closes or another opens.
            _watched = new TakeRequest(row.Game.Id, pair.Market, offer.Outcome, offer.Book);
            Watch(row, pair.Market, offer.Outcome);
            return Task.CompletedTask;
        }

        if (IsTaking(row, pair, offer))
        {
            CloseTake();
            return Task.CompletedTask;
        }

        return OpenTake(row, pair.Market, offer.Outcome, offer.Book);
    }

    /// <summary>
    /// Opens the row, if it is not, and draws the take as its snippet. Reached from a price cell's
    /// own press and from the row's Place wager key (a <see cref="Command"/>), and this panel is
    /// drawn after either.
    /// </summary>
    private Task OpenTake(BoardRow row, string market, string outcome, string? book)
    {
        _open = row;
        _take = new TakeRequest(row.Game.Id, market, outcome, book);
        _takeSerial++;
        _snippet = TakeSnippet;
        return Task.CompletedTask;
    }

    private void CloseTake()
    {
        _take = null;
        _snippet = null;
    }

    /// <summary>
    /// Another side chosen in the open take (its bet pop-up): the request follows, so the cell
    /// lit on the row and the form the take's escape opens are that side's, on its best book.
    /// In Line watch it is also the side being watched, as a pressed price is (ADR 0029).
    /// </summary>
    private void ChooseSide(BoardRow row, string market, string outcome)
    {
        if (_take is not { } take || take.GameId != row.Game.Id)
            return;

        _take = take with { Market = market, Outcome = outcome, Book = null };

        if (Watching)
        {
            _watched = _take;
            Watch(row, market, outcome);
        }
    }

    /// <summary>
    /// The take, read from the open row at render time rather than captured, so a reload that
    /// re-prices the board re-prices the take with it.
    /// </summary>
    private RenderFragment TakeSnippet => __builder =>
    {
        if (_take is { } take && _open is { } row && row.Game.Id == take.GameId)
        {
            <div class="rowacts__snippet">
                @* Keyed by the serial alone: every take opened bumps it (OpenTake), and a side
                   chosen inside the take changes the request without opening another, so the
                   take keeps its stake while the row follows it. *@
                <QuickTake @key="_takeSerial" Row="row" Market="@take.Market" Outcome="@take.Outcome"
                           Book="@take.Book" Matchup="@Matchup(row.Game)"
                           OnClose="CloseTake"
                           OnChooseSide="@(((string Market, string Outcome) side) => ChooseSide(row, side.Market, side.Outcome))"
                           OnOpenForm="@(((string Book, decimal Stake) form) => OpenForm(row, take, form.Book, form.Stake))"
                           OnOpenTyped="@((TypedTake typed) => OpenForm(row, take, typed.Book, typed.Stake, typed))"
                           OnViewSlip="ViewSlip" />
            </div>
        }
    };

    /// <summary>
    /// The take's escape: the full wager form on the same side and book, with the stake typed so
    /// far. With <paramref name="typed"/>, the form opens with its price typed from that number,
    /// through the same parameters a copied bet's typed price takes (WagerPrefill.ToParameters).
    /// </summary>
    private Task OpenForm(BoardRow row, TakeRequest take, string book, decimal stake, TypedTake? typed = null)
    {
        var parameters = TypedTake.Door(row.Game.Id, take.Market, take.Outcome,
            book.Length > 0 ? book : take.Book ?? string.Empty, stake, typed);

        _followUps.Launch(Manager, WindowCatalog.Wager, parameters, row.Game.Id, Matchup(row.Game), "480px");
        CloseTake();
        return Task.CompletedTask;
    }

    private void ViewSlip() => _ = InvokeAsync(() => Manager.Open(WindowCatalog.Find(WindowCatalog.Slip)!));

    protected override void OnInitialized()
    {
        Slip.Changed += OnSlipChanged;
        Manager.Changed += OnDeskChanged;
    }

    /// <summary>The stats source the registry reported at the last load; configuration's answer before one.</summary>
    private StatsPort? _port;

    /// <summary>What fills the board: ESPN, The Odds API on a key, or nothing yet (ADR 0026).</summary>
    internal StatsPort Port => _port ?? (IngestionOptions.Value.Espn.Enabled ? StatsPort.Espn : StatsPort.None);

    protected override void OnDispose()
    {
        Slip.Changed -= OnSlipChanged;
        Manager.Changed -= OnDeskChanged;

        // A closed window's reads have nobody to hand over to.
        _reads.Cancel();
    }

    /// <summary>A leg banked or removed anywhere redraws the cells' "on slip" marks.</summary>
    private void OnSlipChanged() => _ = InvokeAsync(StateHasChanged);

    /// <summary>
    /// Door 2, shifted: a live price goes onto the slip as a parlay leg, at the book the cell
    /// shows, with no window opened. The toast is the acknowledgment and names what the slip now
    /// holds, as the wager window's badge does.
    /// </summary>
    private Task Bank(BoardRow row, MarketPair pair, BestOffer? offer)
    {
        if (offer is null || offer.IsClosing)
            return Task.CompletedTask;

        var price = XLines.Web.Services.WagerOffer.Best(pair.Market, offer);
        Slip.AddLeg(price.ToSlipItem(row.Game, Matchup(row.Game), 0m, null));

        var legs = Slip.Items.Count(i => i.AsLeg);
        Toasts.Added($"Added a leg: {price.Label} {Price(price.PriceAmerican)} ({price.Book}) · "
                     + $"{legs} {(legs == 1 ? "leg" : "legs")} on the slip.",
            "View slip", () => _ = InvokeAsync(() => Manager.Open(WindowCatalog.Find(WindowCatalog.Slip)!)));

        return Task.CompletedTask;
    }
}

@namespace LineOps.Desk.Primitives
@typeparam T
@using MudBlazor

@*
    The desk's table.

    Every panel had its own hand-written <table class="grid">, which was fine while a table was
    a thing you read and nothing more. It stopped being fine once the desk started holding a
    season: a column you cannot sort is a column you have to scan, and a row you cannot act on
    is a dead end in an application whose whole idea is moving between connected views.

    So the markup moves to MudDataGrid — for the sorting, and for the room to grow into
    filtering, grouping and virtualisation — and the appearance stays exactly where it was.
    Nothing here restates the desk's table styling; css/mud-bridge.css already teaches
    MudBlazor's table classes the same hairline, dense, tabular rhythm .grid uses, so a
    converted panel looks unchanged and a future Mud component arrives already matching.

    Columns are declared by the caller as ordinary MudDataGrid columns:

        <DeskGrid Items="_rows" Context="row">
            <PropertyColumn Property="x => x.Name" Title="Player" />
            <TemplateColumn Title="Team">...</TemplateColumn>
        </DeskGrid>
*@

<div class="deskgrid @(Dense ? "deskgrid--dense" : null) @Class">
@*  While the first page is on its way there is nothing to sort and nothing to click, so the
    grid stands aside and skeleton rows hold its shape. They are laid out on the same row
    rhythm the real body uses, which is the whole point: the header stays put, the panel does
    not collapse to nothing and then jump back, and the operator can see how much is coming.

    Only for the empty first load. A grid that already has rows keeps them and reports the
    refresh through the window's pulse — replacing read numbers with grey bars loses
    information the operator was using.  *@
    @if (Loading && Items?.Any() != true)
    {
        <div class="deskgrid__skeleton" aria-busy="true" aria-live="polite" aria-label="@LoadingLabel">
            @for (var i = 0; i < SkeletonRows; i++)
            {
                <div class="deskgrid__skeleton-row">
                    <DeskSkeleton Width="34%" />
                    <DeskSkeleton Width="22%" />
                    <DeskSkeleton Width="18%" />
                </div>
            }
        </div>
    }
    else
    {
    <MudDataGrid T="T"
                 Items="@Items"
                 Dense="true"
                 Hover="true"
                 Bordered="false"
                 Striped="false"
                 Elevation="0"
                 SortMode="@(Sortable ? SortMode.Multiple : SortMode.None)"
                 Filterable="false"
                 ShowColumnOptions="false"
                 FixedHeader="@FixedHeader"
                 Height="@Height"
                 RowClick="@OnRowClick"
                 RowClass="@RowClass"
                 RowClassFunc="@RowClassFunc"
                 Loading="@Loading"
                 Virtualize="@Virtualize"
                 ChildRowRenderer="@(ChildRow is null ? null : ChildRowFor)">
        <Columns>
            @ChildContent
        </Columns>
        <NoRecordsContent>
            <div class="empty">@EmptyText</div>
        </NoRecordsContent>
    </MudDataGrid>
    }
</div>

@code {
    [Parameter, EditorRequired] public IEnumerable<T> Items { get; set; } = [];

    /// <summary>The column definitions — MudDataGrid's own, not a wrapper of them.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Multi-column sort by default. A desk operator comparing sources or books wants "worst
    /// success rate, then oldest" without giving up one to get the other.
    /// </summary>
    [Parameter] public bool Sortable { get; set; } = true;

    [Parameter] public bool Dense { get; set; } = true;

    /// <summary>
    /// Pins the header while the body scrolls. Off by default: a window body already scrolls,
    /// and a grid that manages its own height inside one has two scrollbars competing.
    /// </summary>
    [Parameter] public bool FixedHeader { get; set; }

    [Parameter] public string? Height { get; set; }

    /// <summary>
    /// The first page has not arrived. With no rows yet, the grid is replaced by
    /// <see cref="SkeletonRows"/> placeholder rows on its own row rhythm; with rows already
    /// on screen it stays out of the way and MudDataGrid's own loading state applies, so a
    /// refresh never blanks numbers the operator is reading.
    /// </summary>
    [Parameter] public bool Loading { get; set; }

    /// <summary>
    /// How many placeholder rows to hold the space with. Set it to the page size you expect,
    /// so the panel is the height it will be rather than growing under the reader.
    /// </summary>
    [Parameter] public int SkeletonRows { get; set; } = 6;

    /// <summary>
    /// What is being fetched, as a specific action phrase — the accessible announcement while
    /// the placeholders are up. Never "Loading…"; name the work, as <c>DeskProgress</c> does.
    /// </summary>
    [Parameter] public string LoadingLabel { get; set; } = "Fetching rows";

    /// <summary>
    /// Only worth it past a few hundred rows — it costs the browser's find-in-page, which on a
    /// grid of players is a real loss.
    /// </summary>
    [Parameter] public bool Virtualize { get; set; }

    [Parameter] public string EmptyText { get; set; } = "Nothing to show.";

    [Parameter] public EventCallback<DataGridRowClickEventArgs<T>> OnRowClick { get; set; }

    /// <summary>One class for every row. See <see cref="RowClassFunc"/> for per-row state.</summary>
    [Parameter] public string? RowClass { get; set; }

    /// <summary>
    /// A class per row, so a row can show its own state.
    ///
    /// The desk.s rule is that a row you opened should look opened — otherwise the only sign
    /// is the action strip further down the cell, which is invisible once the row scrolls under
    /// the header. <c>RowClass</c> alone cannot express this: it applies to every row equally.
    /// </summary>
    [Parameter] public Func<T, int, string>? RowClassFunc { get; set; }

    [Parameter] public string? Class { get; set; }

    /// <summary>
    /// What opens under a row, across it: null for a row with nothing under it, which then
    /// draws no row at all.
    ///
    /// The Board opened a game's snippet inside its matchup cell, so a book list was as wide as
    /// that one column and wrapped every team name. A row of its own spans the table instead.
    /// It is MudDataGrid's <c>ChildRowRenderer</c>, which draws the whole <c>&lt;tr&gt;</c>, rather
    /// than <c>ChildRowContent</c>, which draws one cell spanning every column for every row
    /// (or, with a <c>HierarchyColumn</c>, only those its expander opened): the Board's open row
    /// is its own state, not an expander's, and the content has to start under a column of the
    /// caller's choosing.
    /// </summary>
    [Parameter] public Func<T, RenderFragment?>? ChildRow { get; set; }

    /// <summary>
    /// How many leading columns the child row leaves empty, so its content starts at the next
    /// column's leading edge whatever width those take. The Board passes 1: its snippet lines up
    /// with the matchup, not with the start time.
    /// </summary>
    [Parameter] public int ChildRowIndent { get; set; }

    // Not a MudBlazor row: it takes no row click and no row hover, and holds whatever the
    // caller opened; its cells take the grid's cell class for the same padding and hairline.
    // colspan 1000 is HTML's ceiling and MudDataGrid's own idiom for "the rest".
    private RenderFragment<CellContext<T>> ChildRowFor => context => __builder =>
    {
        if (ChildRow?.Invoke(context.Item) is not { } content)
            return;

        <tr class="deskgrid__child">
            @if (ChildRowIndent > 0)
            {
                <td class="mud-table-cell deskgrid__child-lead" colspan="@ChildRowIndent"></td>
            }
            <td class="mud-table-cell deskgrid__child-cell" colspan="1000">@content</td>
        </tr>
    };
}

@namespace LineOps.Desk.Primitives

@*
    A small state word.

    Every table on the desk ends up with a column of these, and before this component
    each call site picked its own modifier with an inline ternary — the same
    "won ? good : lost ? bad : info" logic copied into a dozen panels, where a change
    of mind about what a state means had to be found and edited a dozen times. Here the
    caller states the state (State) and the modifier is not their problem.

    The tag always carries its word: hue is the second channel, never the only one, so
    a tag that says nothing is a tag that says nothing to an operator who cannot see the
    difference between the positive and negative state colours.

    Unmatched attributes splat *before* class, so a stray class= from a call site cannot
    quietly erase .tag and take the badge's whole appearance with it.

    Live leads the word with a small pulsing dot: a game in progress is the one state on the
    desk still changing while the operator looks at it. The dot is a second channel, like the
    hue — hidden from assistive tech, and never a stand-in for the word, which is what is read.
*@

<span @attributes="Extra" class="@Classes" title="@Title">@if (Live)
    {
        <span class="tag__live" aria-hidden="true"></span>
    }@ChildContent</span>

@code {
    /// <summary>The state word itself. A tag is never blank — hue alone carries no meaning.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>What the state means for the operator. See <see cref="DeskState"/> — name the state, not the colour.</summary>
    [Parameter] public DeskState State { get; set; } = DeskState.Neutral;

    /// <summary>Tooltip, for the detail that does not fit in a badge (an error message, a timestamp).</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>The game is in progress: a pulsing dot leads the word the caller still writes.</summary>
    [Parameter] public bool Live { get; set; }

    /// <summary>Extra classes, appended last so a one-off can still win.</summary>
    [Parameter] public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? Extra { get; set; }

    private string Classes => string.Join(' ', Parts().Where(p => p is { Length: > 0 }));

    private IEnumerable<string?> Parts()
    {
        yield return "tag";

        yield return State switch
        {
            DeskState.Positive => "tag--good",
            DeskState.Negative => "tag--bad",
            DeskState.Warning => "tag--warn",
            DeskState.Info => "tag--info",
            _ => null
        };

        yield return Live ? "tag--live" : null;

        yield return Class;
    }
}

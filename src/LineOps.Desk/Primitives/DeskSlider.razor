@namespace LineOps.Desk.Primitives
@using System.Globalization

@*
    A slider: a value along a continuous range, chosen by dragging.

    It is for a value whose exact figure matters less than where it sits between two ends — a
    share, a level, a mix — and where seeing it move is the point. A value that is typed, or
    whose exact figure is the point, is a field with a stepper beside it; a handful of fixed
    steps is a gate switch.

    The native range input stays in the tree, so the arrow keys, Page Up and Down, Home and End,
    the pointer and the screen reader are all the browser's own. The value moves while the thumb
    is dragged rather than when it is let go, so the readout and whatever the slider governs
    follow the pointer.

    The readout beside the track says the value in the caller's words — "45%", not 45 — and the
    reader hears the same words through aria-valuetext. The readout itself is hidden from the
    reader so the value is not announced twice.

    The row is 28px, the toolbar height, so it lines up with the fields and keys beside it.
*@

<div class="slider @DeskLayout.ExtraClass(Extra) @Class"
     style="@DeskLayout.MergeStyle(null, Extra)">
    <input type="range"
           class="slider__input"
           min="@Invariant(Min)"
           max="@Invariant(Max)"
           step="@Invariant(Step)"
           value="@Invariant(Value)"
           aria-label="@Label"
           aria-valuetext="@Text"
           disabled="@Disabled"
           @attributes="DeskLayout.WithoutClassAndStyle(Extra)"
           @oninput="OnInputAsync" />
    <output class="slider__value num" aria-hidden="true">@Text</output>
</div>

@code {
    [Parameter] public double Value { get; set; }
    [Parameter] public EventCallback<double> ValueChanged { get; set; }

    [Parameter] public double Min { get; set; }
    [Parameter] public double Max { get; set; } = 100;
    [Parameter] public double Step { get; set; } = 1;

    /// <summary>What the slider sets, in sentence case — the input's accessible name.</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;

    /// <summary>
    /// The value in the caller's words, for the readout and the reader alike — a percentage, a
    /// unit. Without it the figure is shown to two places at most.
    /// </summary>
    [Parameter] public Func<double, string>? Format { get; set; }

    [Parameter] public bool Disabled { get; set; }

    /// <summary>Extra classes, appended last so a one-off can still win.</summary>
    [Parameter] public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? Extra { get; set; }

    private string Text => Format?.Invoke(Value) ?? Value.ToString("0.##");

    // The browser reads these attributes in its own invariant format whatever the page's culture,
    // so a step of a half is "0.5" here even where the readout would write "0,5".
    private static string Invariant(double value) => value.ToString(CultureInfo.InvariantCulture);

    private async Task OnInputAsync(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var value))
            await ValueChanged.InvokeAsync(value);
    }
}

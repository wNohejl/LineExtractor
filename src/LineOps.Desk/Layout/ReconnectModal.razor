﻿<script type="module" src="@Assets[$"{DeskAssets.Root}/Layout/ReconnectModal.razor.js"]"></script>

@*
    The circuit-lost notice. The framework drives it by the ids and the state classes below
    (ReconnectModal.razor.js answers its events), so those names stay; the copy, the spinner and
    the keys are the Desk's own. The spinner is the Desk's ring, hidden from a reader because
    the sentence beside it already says what is under way.
*@
<dialog id="components-reconnect-modal" data-nosnippet>
    <div class="components-reconnect-container">
        <div class="components-rejoining-animation" aria-hidden="true">
            <span class="spinner spinner--md"><span class="spinner__ring"></span></span>
        </div>
        <p class="components-reconnect-first-attempt-visible">
            Reconnecting to the server…
        </p>
        <p class="components-reconnect-repeated-attempt-visible">
            Couldn’t reconnect. Trying again in <span id="components-seconds-to-next-attempt"></span> seconds…
        </p>
        <p class="components-reconnect-failed-visible">
            Couldn’t reconnect to the server.<br />Retry, or reload the page.
        </p>
        <button type="button" id="components-reconnect-button" class="components-reconnect-failed-visible">
            Retry
        </button>
        <p class="components-pause-visible">
            The server paused this session.
        </p>
        <p class="components-resume-failed-visible">
            Couldn’t resume the session.<br />Retry, or reload the page.
        </p>
        <button type="button" id="components-resume-button" class="components-pause-visible components-resume-failed-visible">
            Resume
        </button>
    </div>
</dialog>

    /// <summary>
    /// The sheet, opened the way every call site should open one: through
    /// <see cref="IDeskSheets"/>, which holds the dialog options, so the caller states only the
    /// sheet and what goes in it.
    ///
    /// <para>
    /// The outcome is read off the awaited <see cref="DialogResult"/>, never off
    /// <c>OnCancel</c>. Escape and backdrop dismissal go through MudBlazor's own cancel path
    /// and never reach the component's callbacks, so a caller listening to <c>OnCancel</c>
    /// would sit waiting on a sheet the operator already dismissed. The shape below —
    /// <c>result is { Canceled: false, Data: … }</c> — treats every route out that is not an
    /// explicit completion as a "no", which is the only reading that is safe.
    /// </para>
    /// </summary>
    private async Task OpenSheetAsync()
    {
        _sheetOutcome = null;
        _noteTitle = null;
        _noteBody = null;

        var parameters = new DialogParameters<DeskSheet>
        {
            { x => x.Title, "Add a note" },
            { x => x.Subtitle, "A demonstration — nothing is written" },
            { x => x.ChildContent, SheetBody },
            { x => x.Footer, SheetFooter }
        };

        _sheet = await Sheets.ShowAsync(parameters);

        var result = await _sheet.Result;

        _sheetOutcome = result is { Canceled: false, Data: string outcome }
            ? $"\"{outcome}\" — completed"
            : "cancelled (Escape, backdrop, or the way out)";

        StateHasChanged();
    }

    // One grouped form, as every form in a window is (the Anatomy's, above): labels leading in
    // one column, bare fields trailing, each named for a screen reader since the label beside
    // it is not its <label>.
    private RenderFragment SheetBody => @<div>
        <p class="empty">
            Modal, on purpose. The scrim is the statement: this task is self-contained, and
            completing or cancelling it is the only thing on offer until it is done.
        </p>
        <div class="wgroup">
            <div class="wgroup__row wgroup__row--form">
                <span class="wgroup__label">Title</span>
                <DeskField TValue="string" Class="wfield--fill" aria-label="Title" placeholder="Required"
                           @bind-Value="_noteTitle" />
            </div>
            <div class="wgroup__row wgroup__row--form">
                <span class="wgroup__label">Note</span>
                <DeskTextArea Class="wfield--fill" aria-label="Note" rows="3" placeholder="Optional"
                              @bind-Value="_noteBody" />
            </div>
        </div>
    </div>;

    private RenderFragment SheetFooter => @<DeskRow Justify="DeskJustify.End" Gap="DeskSpace.Space2">
        <DeskButton Emphasis="DeskEmphasis.Plain"
                    OnClick="@(() => _sheet?.Close())">
            Cancel
        </DeskButton>
        <DeskButton Emphasis="DeskEmphasis.Filled"
                    OnClick="@(() => _sheet?.Close(DialogResult.Ok(string.IsNullOrWhiteSpace(_noteTitle) ? "Untitled" : _noteTitle)))">
            Add note
        </DeskButton>
    </DeskRow>;

    /// <summary>
    /// The destructive alert. One await is the whole point — if guarding a dangerous action
    /// cost six lines of DialogParameters, call sites would quietly skip the guard.
    /// </summary>
    private async Task AskAsync()
    {
        var confirmed = await Alerts.ConfirmAsync(
            "Delete this run?",
            message: "The imported rows stay; only the run record goes.",
            confirmLabel: "Delete run",
            cancelLabel: "Keep it",
            destructive: true);

        _alertOutcome = confirmed ? "true — confirmed" : "false — kept";
    }


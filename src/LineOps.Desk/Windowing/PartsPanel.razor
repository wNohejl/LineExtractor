@using LineOps.Desk.Primitives
@using LineOps.Desk.Windowing
@inject WindowManager Manager
@inject DeskToasts Toasts
@inject IDeskAlerts Alerts
@inject IDeskSheets Sheets

@*
    The parts bin: every reusable control the desk owns, in one window you can open
    beside the thing you are building.

    It exists because the alternative is reading CSS to find out what already exists,
    which is how a second button gets invented. Being a window rather than a doc page
    is the point (ADR 0008) — it renders in the same column width, on the same surface,
    under the same theme as the panel it is being copied into, so "does this fit?" is
    answerable by looking rather than guessing.

    Everything below teaches the shipped system, whose four load-bearing rules are:
    weight replaces hue, state lives on values, materials float, and comparison is
    never modal.

    It is the Desk's own window, so everything in it is the Desk's: its sample copy names no
    application's records, and its sheet opens through IDeskSheets as any caller's would. An
    application lists it in its catalogue, and a fresh project that wires the Desk can open it.
*@

@* One wrapper, for one reason: the prose below runs at a reading width (HIG, Typography: 45-75
   characters a line) while the parts it describes keep the window's width, since "does this
   fit?" is answered at the width a panel has. See "The Parts window" in the Desk's stylesheet. *@
<div class="parts">

<Note>
    Everything here is live. Press what looks pressable, and tab through each row —
    the keyboard has to get the same signal the pointer does, or only half the desk
    is finished.
</Note>

@* ==========================================================================
   Anatomy
   ========================================================================== *@

<PanelSection Title="Anatomy">
    <p class="empty">
        Every window body renders its parts in one order — title, toolbar, note, metrics,
        sections, forms — and each part owns the air beneath it, so a panel never writes a
        margin. Below, every slot once, in that order.
    </p>

    <PanelTitle>
        <ChildContent>Quarterly review</ChildContent>
        <Tags>
            <Tag State="DeskState.Positive">Complete</Tag>
            <Tag State="DeskState.Info">2026</Tag>
        </Tags>
        <Detail>Sat Oct 24 · 7:10 PM · <span class="ptitle__em">Ames</span> and <span class="ptitle__em">Ruiz</span></Detail>
        <Keys>
            <DeskSwitch Options="_anatomyYears" Label="Year" Mono="true" @bind-Value="_anatomyYear" />
        </Keys>
    </PanelTitle>

    <PanelToolbar Message="3 updated">
        <ChildContent>
            @* The toolbar every list window draws: a fixed set of kinds is a segment, and a filter
               that searches is a search field that names its scope. *@
            <DeskSwitch Options="_anatomyKinds" Label="Kind" Size="DeskKeySize.Small" @bind-Value="_anatomyKind" />
            <DeskSearch Placeholder="Search items" Label="Items" @bind-Value="_anatomySearch" />
        </ChildContent>
        <Actions>
            <DeskButton Icon="@Icons.Material.Filled.Refresh">Refresh</DeskButton>
            <DeskButton Emphasis="DeskEmphasis.Filled" Icon="@Icons.Material.Filled.Sync">Sync now</DeskButton>
        </Actions>
    </PanelToolbar>

    <MetricRow>
        <Metric Label="Sources in SLO" Value="2/2" State="DeskState.Positive" />
        <Metric Label="Rows today" Value="16,835" />
    </MetricRow>

    <PanelSection Title="Recent items">
        <Keys>
            <DeskButton Size="DeskKeySize.Small" Emphasis="DeskEmphasis.Tinted">Mine</DeskButton>
            <DeskButton Size="DeskKeySize.Small">Shared</DeskButton>
        </Keys>
        <Detail>
            <span class="mono">12-9</span>
            <span>8 overdue</span>
            <span class="psection__aside">14 of 21 reviewed</span>
        </Detail>
        <ChildContent>
            <EmptyState Kind="EmptyStateKind.Filtered">No items match this filter.</EmptyState>
        </ChildContent>
    </PanelSection>

    @* A form in a window is the grouped form (apple-hig-components, forms.md): pform--grouped
       draws no card of its own, because the group is the fill and a frame around it would be a
       box inside a box. Each row's label leads in one column and its control trails; a field's
       width matches what goes in it. Every edit form on the desk is this, row for row. *@
    <PanelForm Title="Edit entry" Class="pform--grouped">
        <Detail>Item 42 · added Oct 26</Detail>
        <ChildContent>
            <div class="wgroup">
                <div class="wgroup__row wgroup__row--form">
                    <span class="wgroup__label">Owner</span>
                    <DeskSelect TValue="string" Class="wfield--short" aria-label="Owner" @bind-Value="_anatomyOwner">
                        <option value="ames">Ames</option>
                        <option value="ruiz">Ruiz</option>
                        <option value="chen">Chen</option>
                    </DeskSelect>
                </div>
                <div class="wgroup__row wgroup__row--form">
                    <span class="wgroup__label">Amount</span>
                    <DeskField TValue="int?" Mono="true" Class="wfield--short" type="number"
                               aria-label="Amount" placeholder="120" @bind-Value="_anatomyAmount" />
                </div>
                <div class="wgroup__row wgroup__row--form">
                    <span class="wgroup__label">Note</span>
                    <DeskField TValue="string" Class="wfield--fill" aria-label="Note" placeholder="Optional"
                               @bind-Value="_anatomyNote" />
                </div>
            </div>
        </ChildContent>
        <Destructive>
            <DeskButton Role="DeskRole.Destructive">Delete</DeskButton>
        </Destructive>
        <Footer>
            <DeskButton>Cancel</DeskButton>
            <DeskButton Emphasis="DeskEmphasis.Filled">Save changes</DeskButton>
        </Footer>
    </PanelForm>
</PanelSection>

@* ==========================================================================
   Buttons
   ========================================================================== *@

<PanelSection Title="Buttons — emphasis">
<p class="empty">
    Weight says how loud, not what colour. Hue is no longer an affordance channel: an
    interface with five coloured button types has no primary action, only five competing
    ones. A call site answers two questions it can actually answer —
    <span class="mono">Emphasis</span> for how much of the panel this claims, and
    <span class="mono">Role</span> for whether pressing it destroys something.
</p>

<DeskStack Gap="DeskSpace.Space3">
    @foreach (var (emphasis, name, use) in _emphases)
    {
        <DeskStack Gap="DeskSpace.Space1">
            <div class="meta">
                <span class="mono">@name</span> — @use
            </div>
            @* Destructive is red at Plain or Tinted weight and never Filled: the one prominent key
               in a view is never the one that destroys (HIG, Buttons), so the catalogue does not
               draw the pairing it would be wrong to copy. *@
            <DeskRow Gap="DeskSpace.Space2">
                <DeskButton Emphasis="@emphasis">Apply</DeskButton>
                @if (emphasis != DeskEmphasis.Filled)
                {
                    <DeskButton Emphasis="@emphasis" Role="DeskRole.Destructive">Delete run</DeskButton>
                }
            </DeskRow>
        </DeskStack>
    }
</DeskStack>

<Note>
    <strong>Exactly one Filled per context.</strong> If a panel seems to need two, one of
    them is not the primary action — demote it to Tinted and the panel says what it is for.
    And it is never the destructive key: a delete is red at Plain or Tinted weight.
</Note>

</PanelSection>

<PanelSection Title="Buttons — size">
<p class="empty">
    Size is about how much of the panel the action deserves, not about fitting. Chrome and
    row actions are Small; a panel's own intent is Medium; Large is for the one button a
    whole view exists to press, which most views do not have.
</p>

<DeskRow Gap="DeskSpace.Space2" Align="DeskAlign.Center">
    <DeskButton Size="DeskKeySize.Small" Emphasis="DeskEmphasis.Tinted">Small</DeskButton>
    <DeskButton Size="DeskKeySize.Medium" Emphasis="DeskEmphasis.Tinted">Medium</DeskButton>
    <DeskButton Size="DeskKeySize.Large" Emphasis="DeskEmphasis.Tinted">Large</DeskButton>
    <DeskButton Icon="@Icons.Material.Filled.Refresh" Title="Reload" />
</DeskRow>

</PanelSection>

<PanelSection Title="Buttons — state">

<DeskRow Gap="DeskSpace.Space2">
    <DeskButton Emphasis="DeskEmphasis.Filled" Busy="@_busy" OnClick="RunAsync">
        @(_busy ? "Ingesting" : "Press to run")
    </DeskButton>
    <DeskButton Emphasis="DeskEmphasis.Tinted" Disabled="true">Disabled</DeskButton>
    <DeskButton Emphasis="DeskEmphasis.Plain" Disabled="true">Disabled, plain</DeskButton>
</DeskRow>

<p class="empty">
    A busy button keeps its weight and runs the in-flight sweep: it is occupied, not inert,
    and it refuses further presses without pretending it has gone away. A disabled button
    drops to the muted ink instead — the two states look different because they mean
    different things, and an operator who cannot tell them apart will keep pressing.
</p>

@* ==========================================================================
   Fields
   ========================================================================== *@

</PanelSection>

<PanelSection Title="Fields">
<p class="empty">
    The button's inverse: inset into the panel rather than standing off it. Same height, so
    a row of mixed controls still lines up. Bare — no <span class="mono">Label</span>, no
    <span class="mono">Error</span> — each renders as a plain element with no wrapper and
    sits straight in a row. Bare is not nameless: a placeholder disappears on the first
    keystroke, so a bare field carries an <span class="mono">aria-label</span>, and in a form it
    sits beside a label in the grouped row (Anatomy, above).
</p>

<DeskRow Gap="DeskSpace.Space2">
    <DeskField TValue="string" placeholder="Name" aria-label="Name" style="max-width:150px" @bind-Value="_text" />
    <DeskField TValue="decimal?" Mono="true" type="number" placeholder="Amount" aria-label="Amount"
               style="max-width:100px" @bind-Value="_number" />
    <DeskSelect TValue="string" aria-label="Stage" @bind-Value="_choice">
        <option value="draft">Draft</option>
        <option value="review">Review</option>
        <option value="final">Final</option>
    </DeskSelect>
    <DeskField TValue="string" placeholder="Disabled" aria-label="Disabled field" disabled style="max-width:120px" />
</DeskRow>

<p class="empty">
    Given a label, the field grows a frame: a real <code>&lt;label for&gt;</code> that stays put
    once there is text in the box, the required mark, and — the rule that matters — the error
    sitting under the control it is about rather than somewhere else on the panel. State lives
    on the value. <span class="mono">Mono</span> puts tabular figures under a number, so a
    column of amounts lines up on the digit rather than on the glyph.
</p>

<DeskStack Gap="DeskSpace.Space2">
<DeskRow Gap="DeskSpace.Space2" Align="DeskAlign.Start">
    <DeskField TValue="string" Label="Name" Required="true" placeholder="Ames"
               style="max-width:150px" @bind-Value="_text" />
    <DeskField TValue="decimal?" Label="Amount" Mono="true" type="number" placeholder="120"
               style="max-width:100px" @bind-Value="_number"
               Error="@(_number is null ? "An amount is required to file this." : null)" />
    <DeskSelect TValue="string" Label="Stage" style="max-width:150px" @bind-Value="_choice">
        <option value="draft">Draft</option>
        <option value="review">Review</option>
        <option value="final">Final</option>
    </DeskSelect>
</DeskRow>

<DeskTextArea Label="Why this entry" rows="3"
              placeholder="Prose, so it commits on blur rather than per keystroke."
              @bind-Value="_prose" />
</DeskStack>

@* ==========================================================================
   Gate
   ========================================================================== *@

</PanelSection>

<PanelSection Title="Gate">
<p class="empty">
    One visible choice among a few — a view, a lookback, a mode. The cap slides to the
    position you press, and arrows move it from the keyboard. Two to five fixed positions;
    past that, a select is the honest control, because a segmented gate that scrolls is a
    select wearing a costume.
</p>

<DeskRow Gap="DeskSpace.Space3">
    <DeskSwitch Options="_gateViews" Label="Demo view" @bind-Value="_gateView" />
    <DeskSwitch Options="GateOptions.LookbackDays" Label="Demo lookback" Mono="true"
                @bind-Value="_gateDays" />
</DeskRow>

<p class="empty">
    <span class="mono">GateOptions.LookbackDays</span> is shared — a lookback window reads
    "14d / 30d / 90d" in every window, not two spellings of the same question.
</p>

</PanelSection>

<PanelSection Title="Steps">
<p class="empty">
    <span class="mono">DeskSteps</span> is a vertical stepper for a form that is a sequence. Only
    the step to do is open, with a sentence of guidance; a done step folds to its title and what
    was chosen, which is the link that reopens it; a waiting step is one line saying what it waits for.
    Reach for it wherever a form has to be done in order.
</p>

<DeskSteps Label="Example">
    <DeskStep Number="1" Title="Your item" State="DeskStepState.Done" OnOpen="() => { }">
        <Summary>Report · North region</Summary>
    </DeskStep>
    <DeskStep Number="2" Title="Where it goes" State="DeskStepState.Current"
              Hint="The folder your item is filed in, and who reviews it there.">
        <DeskRow Gap="DeskSpace.Space2">
            <DeskButton Size="DeskKeySize.Small">Archive · Ames</DeskButton>
            <DeskButton Size="DeskKeySize.Small">Shared · Ruiz</DeskButton>
        </DeskRow>
    </DeskStep>
    <DeskStep Number="3" Title="Schedule" State="DeskStepState.Todo" Waiting="Choose where it goes first." />
</DeskSteps>
</PanelSection>

<PanelSection Title="Tabs">
<p class="empty">
    The same marble, doing the other job. A gate changes what one reading is made of; tabs
    change which reading you are looking at, so they are flat — nothing here is pressed
    down. A section with nothing behind it is never offered, and one section on its own
    renders with no bar at all.
</p>

<DeskStack>
<DeskTabs TValue="string" Tabs="_demoTabs" Label="Demo sections" @bind-Value="_demoTab">
    <Note>
        Showing <span class="mono">@context</span>. The third tab is marked unavailable, so
        it is not on the bar — flip it to see the marble re-measure itself.
    </Note>
</DeskTabs>

<DeskRow Gap="DeskSpace.Space2">
    <DeskButton Size="DeskKeySize.Small" OnClick="() => _thirdTab = !_thirdTab">
        @(_thirdTab ? "Take the third section away" : "Give the third section content")
    </DeskButton>
</DeskRow>
</DeskStack>

@* ==========================================================================
   Tags
   ========================================================================== *@

</PanelSection>

<PanelSection Title="Tags">
<p class="empty">
    The state word, at word scale. A tag always says its word — the wash is the second
    channel, never the only one, so the row still reads with the colour taken away. Neutral
    carries no state at all and is the right choice for a label that is only a label.
</p>

<DeskRow Gap="DeskSpace.Space2">
    @foreach (var (state, word) in _tagStates)
    {
        <Tag State="@state">@word</Tag>
    }
</DeskRow>

<p class="empty">
    Name the consequence, not the colour: <span class="mono">DeskState.Negative</span> on a
    breached SLO, never "the red one". The day the wash changes, every call site that named
    the outcome still reads correctly.
</p>

@* ==========================================================================
   Display
   ========================================================================== *@

</PanelSection>

<PanelSection Title="Display — metrics">
<p class="empty">
    State lives on the value, not on a chrome around it. The label stays quiet in every
    case; only the number changes colour, because the number is the thing that went wrong.
</p>

<MetricRow>
    <Metric Label="Uptime" Value="98.4%" Note="30-day rolling" State="DeskState.Positive" Numeric="true" />
    <Metric Label="Credits left" Value="412" State="DeskState.Warning" Numeric="true" />
    <Metric Label="Change" Value="-2.1%" State="DeskState.Negative" Numeric="true" />
    <Metric Label="Sources" Value="6" State="DeskState.Info" Numeric="true" />
</MetricRow>

</PanelSection>

<PanelSection Title="Display — linked cell">
<p class="empty">
    <span class="mono">DeskLink</span> is a cell that names something with a window of its
    own. A cell cannot lift the way a key does without disturbing its row, so it says the same
    thing the other way: highlight it and the shortcut appears, naming where the click goes.
    The shortcut's width is reserved rather than revealed, so nothing reflows as the pointer
    crosses a column of them.
</p>
<p class="empty">
    Beside it, a <span class="mono">Tag</span> carries the row's state in a word. Live leads
    the word with a pulsing dot for something happening now — a second channel, like the hue,
    never a stand-in for the word.
</p>

<DeskStack Gap="DeskSpace.Space2">
<DeskRow Gap="DeskSpace.Space6" Align="DeskAlign.Center">
    <DeskLink Destination="details" OnClick="@(() => _linkOpened = "North region")">North region</DeskLink>
    <DeskLink Destination="history" Icon="@Icons.Material.Filled.History"
              OnClick="@(() => _linkOpened = "Ames")">Ames</DeskLink>
    <Tag State="DeskState.Positive" Live="true">Live</Tag>
    <Tag State="DeskState.Info">Queued</Tag>
</DeskRow>

@if (_linkOpened is not null)
{
    <div class="meta">
        Pressed <span class="mono">@_linkOpened</span> — a panel opens its window here.
    </div>
}
</DeskStack>

</PanelSection>

<PanelSection Title="Display — progress">
<p class="empty">
    Prefer determinate whenever the denominator is knowable — if you are walking six sources,
    you know it. The label names the action, never the wait: "Loading…" describes the
    operator's experience, which they already have, rather than the system's work, which they
    do not. Mode is a parameter, chosen once and held; a bar that changes style mid-flight
    reads as a restart.
</p>

<DeskStack Gap="DeskSpace.Space4">
    <DeskProgress Label="Fetching from 6 sources" Value="@_progress" Max="100" />
    <DeskProgress Indeterminate="true" Label="Reconciling open items" />

    <DeskRow Gap="DeskSpace.Space2">
        <DeskButton Size="DeskKeySize.Small" Emphasis="DeskEmphasis.Tinted"
                    Busy="@_stepping" OnClick="StepAsync">
            Advance the bar
        </DeskButton>
    </DeskRow>
</DeskStack>

</PanelSection>

<PanelSection Title="Display — skeletons">
<p class="empty">
    A placeholder holds the shape the real content will take, so the layout does not jump
    when it lands. Match the final shape — lines for prose, a block for a chart — and give it
    the width the real thing has. Opaque, never a material: this holds data and does not
    float. Reduced motion keeps the block and drops the shimmer.
</p>

<DeskStack Gap="DeskSpace.Space3">
    <DeskStack Gap="DeskSpace.Space1">
        <div class="meta">One line, 40% wide</div>
        <DeskSkeleton Width="40%" />
    </DeskStack>
    <DeskStack Gap="DeskSpace.Space1">
        <div class="meta">Three lines — the last runs short, the way prose does</div>
        <DeskSkeleton Lines="3" />
    </DeskStack>
    <DeskStack Gap="DeskSpace.Space1">
        <div class="meta">A block, standing in for a chart</div>
        <DeskSkeleton Shape="DeskSkeletonShape.Block" Height="64px" />
    </DeskStack>
</DeskStack>

<PanelSection Title="In a grid">
<p class="empty">
    <span class="mono">DeskGrid</span> takes <span class="mono">Loading</span>: with no rows
    yet it stands aside and placeholder rows hold its rhythm. A grid that already has rows
    keeps them and reports the refresh through the pulse strip instead — replacing read
    numbers with grey bars loses information the operator was using.
</p>

<DeskStack>
<DeskRow Gap="DeskSpace.Space2">
    <DeskButton Size="DeskKeySize.Small" OnClick="@(() => _gridLoading = !_gridLoading)">
        @(_gridLoading ? "Show rows" : "Show placeholders")
    </DeskButton>
</DeskRow>

<DeskGrid T="PartRow" Items="@(_gridLoading ? Array.Empty<PartRow>() : _rows)" Loading="@_gridLoading"
          LoadingLabel="Fetching rows" SkeletonRows="4" Sortable="false">
    <PropertyColumn T="PartRow" TProperty="string" Property="x => x.Source" Title="Source" />
    <PropertyColumn T="PartRow" TProperty="string" Property="x => x.Stage" Title="Stage" />
    <PropertyColumn T="PartRow" TProperty="string" Property="x => x.Amount" Title="Amount" />
</DeskGrid>
</DeskStack>
</PanelSection>

</PanelSection>

<PanelSection Title="Display — empty states">
<p class="empty">
    Nothing to show is still something to say. <span class="mono">Kind</span> picks which
    sentence the panel is writing, and the reader's next move follows from it — the wrong
    kind sends them to check the feed when the filter was the problem. Each carries at most
    one action, and it is the first step rather than a menu of them.
</p>

<DeskStack Gap="DeskSpace.Space1">
    <EmptyState>
        Default — the bare line. Loading notes and neutral asides live here.
    </EmptyState>

    <EmptyState Kind="EmptyStateKind.New">
        <ChildContent>
            New — nothing exists yet, so the message is about what would.
        </ChildContent>
        <Action>
            <DeskButton Size="DeskKeySize.Small" Emphasis="DeskEmphasis.Tinted"
                        Icon="@Icons.Material.Filled.Add">Log the first entry</DeskButton>
        </Action>
    </EmptyState>

    <EmptyState Kind="EmptyStateKind.Filtered">
        <ChildContent>
            Filtered — rows exist; this window excluded them. Name the control that did it.
        </ChildContent>
        <Action>
            <DeskButton Size="DeskKeySize.Small"
                        Icon="@Icons.Material.Filled.FilterAltOff">Clear the filter</DeskButton>
        </Action>
    </EmptyState>

    <EmptyState Kind="EmptyStateKind.Error">
        <ChildContent>
            Error — the load failed, which a grey sentence alone would not distinguish from
            "nothing here yet". Hue plus shape, never hue on its own.
        </ChildContent>
        <Action>
            <DeskButton Size="DeskKeySize.Small" Icon="@Icons.Material.Filled.Refresh">Retry</DeskButton>
        </Action>
    </EmptyState>
</DeskStack>

@* ==========================================================================
   Modality
   ========================================================================== *@

</PanelSection>

<PanelSection Title="Modality">
<p class="empty">
    Three live examples. Open each one; the decision rule underneath is easier to believe
    once you have felt the difference between a surface that lets you keep working and one
    that does not.
</p>

<DeskStack Gap="DeskSpace.Space3">
<DeskRow Gap="DeskSpace.Space2">
    <DeskButton Emphasis="DeskEmphasis.Tinted" Icon="@Icons.Material.Filled.OpenInNew"
                OnClick="@(() => _dialogOpen = true)">
        Floating dialog
    </DeskButton>

    <DeskButton Emphasis="DeskEmphasis.Tinted" Icon="@Icons.Material.Filled.VerticalAlignBottom"
                OnClick="OpenSheetAsync">
        Modal sheet
    </DeskButton>

    <DeskButton Emphasis="DeskEmphasis.Tinted" Role="DeskRole.Destructive"
                Icon="@Icons.Material.Filled.DeleteOutline"
                OnClick="AskAsync">
        Destructive alert
    </DeskButton>
</DeskRow>

@if (_sheetOutcome is not null || _alertOutcome is not null)
{
    <DeskStack Gap="DeskSpace.Space1">
        @if (_sheetOutcome is not null)
        {
            <div class="meta">
                Sheet returned <span class="mono">@_sheetOutcome</span>
            </div>
        }
        @if (_alertOutcome is not null)
        {
            <div class="meta">
                Alert returned <span class="mono">@_alertOutcome</span>
            </div>
        }
    </DeskStack>
}
</DeskStack>

<Note>
    <strong>The rule, in full.</strong> Use a <span class="mono">DeskSheet</span> when the
    task is self-contained and completing it is the only goal — a form that must complete or
    cancel, a multi-step configuration. Use a <span class="mono">DeskDialog</span> when the
    operator needs to see or compare other things while working; it floats, several can be
    open at once, and it never takes the desk hostage.
    <span class="mono">Alerts.ConfirmAsync</span> is the narrowest tier and the only one
    allowed to interrupt: a decision that must be made before anything else happens, and
    nothing else. <strong>Comparison is never modal. If you are unsure, do not be modal.</strong>
</Note>

<p class="empty">
    Two details the demos above are here to pin, both found the hard way. <strong>Read the
    <span class="mono">DialogResult</span>, never <span class="mono">OnCancel</span>.</strong>
    Escape and backdrop dismissal go through MudBlazor's own cancel path and never raise the
    component's callback, so a sheet that only listened to <span class="mono">OnCancel</span>
    would treat a dismissed task as an unanswered one forever. The pattern is
    <span class="mono">result is { Canceled: false, Data: … }</span> — an unanswered question
    is a "no", which is also why this sheet can afford
    <span class="mono">BackdropClick = true</span> on a form with a required field: a stray
    click outside costs the operator the draft, not a bad write. An alert does the opposite
    (<span class="mono">DeskAlerts</span> sets it false) because a decision must not be
    dismissed by missing it. And a destructive confirm is <em>never</em> the default: the
    alert focuses Cancel on open, so Enter backs out — unless there is no Cancel to focus, in
    which case a one-button acknowledgement gives the default back to its only button rather
    than leaving Enter to answer the page behind it. Tab once to reach the red button, which
    is exactly as much friction as deleting something deserves.
</p>

@if (_dialogOpen)
{
    <DeskDialog Title="Floating dialog"
                Subtitle="Drag the bar — the desk stays usable behind it"
                Width="420px"
                OnClose="@(() => _dialogOpen = false)">
        <p class="empty">
            Not modal, on purpose. There is no scrim, the panels behind still scroll and
            accept clicks, and several of these can be open at once — because the workflow
            this serves is comparing things, and a modal would force you to finish with one
            record before looking at the next.
        </p>
        <p class="empty">
            It borrows the window's own chrome — same title bar height, same controls, same
            shadow — so it reads as a member of the desk rather than a web dialog that
            wandered in.
        </p>
    </DeskDialog>
}

@* ==========================================================================
   Notices
   ========================================================================== *@

</PanelSection>

<PanelSection Title="Notices">
<p class="empty">
    <span class="mono">&lt;Note&gt;</span> is the ambient tier: it sits beside the thing it
    describes and stays as long as the thing is true. No dismiss control, no timer — if it
    needs acknowledging it is an alert, and if it should vanish it is a toast.
</p>

<DeskStack Gap="DeskSpace.Space2">
    <Note>
        A note carries context the operator needs but did not ask for.
    </Note>
    <Note State="DeskState.Warning">
        A warning carries a cost. State what it is, and what to do instead.
    </Note>
</DeskStack>

<p class="empty">
    Only <span class="mono">DeskState.Warning</span> changes the skin, because a cost is the
    one thing an operator has to act on. ADR 0016's rule holds inside the box too: the hue
    never carries the message on its own — the sentence says what the cost is, and the wash
    only makes it findable.
</p>

<DeskRow Gap="DeskSpace.Space2" Align="DeskAlign.Center">
    <span class="meta">At word scale, inside a row or cell:</span>
    <span class="mono">
        <Note Inline State="DeskState.Warning">62%</Note>
    </span>
</DeskRow>

</PanelSection>

<PanelSection Title="Toasts">
<p class="empty">
    The transient tier. A toast reports that something finished while you were looking
    somewhere else: non-critical, auto-dismissing, recoverable from the panel that raised it.
    Anything needing a decision stays inline or becomes an alert, because a notice that has
    dismissed itself cannot be acted on. Panels take
    <span class="mono">DeskToasts</span>, never <span class="mono">ISnackbar</span>.
</p>

<DeskRow Gap="DeskSpace.Space2">
    <DeskButton Size="DeskKeySize.Small"
                OnClick="@(() => Toasts.Success("Evaluated — every source inside its SLO."))">
        Success
    </DeskButton>
    <DeskButton Size="DeskKeySize.Small"
                OnClick="@(() => Toasts.Info("Layout saved to this browser."))">
        Info
    </DeskButton>
    <DeskButton Size="DeskKeySize.Small"
                OnClick="@(() => Toasts.Warn("Pull finished — 12 pulls left in today's allowance."))">
        Warn
    </DeskButton>
    <DeskButton Size="DeskKeySize.Small"
                OnClick="@(() => Toasts.Fail("Scheduled pull failed — the provider timed out."))">
        Fail
    </DeskButton>
    <DeskButton Size="DeskKeySize.Small"
                OnClick="@(() => Toasts.Show("Nothing to report."))">
        Neutral
    </DeskButton>
</DeskRow>

@* ==========================================================================
   Pulse
   ========================================================================== *@

</PanelSection>

<PanelSection Title="Pulse">
<p class="empty">
    The window chrome's own state channel, and the one a busy button's sweep borrows from.
    Set it from a panel with <span class="mono">WindowManager.SetPulse(id, PulseState.Active)</span>
    rather than drawing it yourself.
</p>

<DeskStack Gap="DeskSpace.Space1">
    @foreach (var (state, label) in _pulses)
    {
        <DeskRow Gap="DeskSpace.Space3" Align="DeskAlign.Center">
            <div class="pulse @state" style="width:120px; border-radius:1px"></div>
            <span class="meta">@label</span>
        </DeskRow>
    }
</DeskStack>

@* ==========================================================================
   Charts
   ========================================================================== *@

</PanelSection>

<PanelSection Title="Charts">
<p class="empty">
    <span class="mono">DeskChart</span> is the seam over MudBlazor's chart. A caller states
    the data, what kind of number it is, and one sentence a screen reader can use — never a
    colour. The family decides the series palette once, so the same kind of number reads the
    same in every window.
</p>

<DeskChart Series="@_movement" Labels="@_chartLabels" Height="180px"
           Family="DeskChartFamily.Movement"
           Headline="Movement — values over time"
           Takeaway="Hue is identity here, not state: accent, positive, warning, negative, then neutrals."
           Description="Demonstration line chart with three series in the movement palette." />

<DeskChart Series="@_ledger" Labels="@_chartLabels" Height="160px"
           Family="DeskChartFamily.Ledger"
           ShowLegend="false"
           Headline="Ledger — money you kept"
           Takeaway="Opens on the positive state, because that is already how the desk spells won."
           Description="Demonstration line chart of a single cumulative units series." />

<DeskChart Series="@_health" Labels="@_chartLabels" Kind="DeskChartKind.Bar" Height="160px"
           Family="DeskChartFamily.Health"
           Headline="Health — how a source is behaving"
           Takeaway="Ordered like the pulse strip: healthy, warn, breached."
           Description="Demonstration bar chart with three series in the health palette." />

@* ==========================================================================
   Foundation
   ========================================================================== *@

</PanelSection>

<PanelSection Title="Spacing">
<p class="empty">
    One 4px ramp. Pass a step to <span class="mono">DeskRow</span> or
    <span class="mono">DeskStack</span> rather than writing a pixel gap inline.
</p>

<DeskStack Gap="DeskSpace.Space1">
    @foreach (var (step, name, px) in _spaces)
    {
        <DeskRow Gap="DeskSpace.Space3">
            <span class="mono meta parts-key">@name</span>
            <div style="height:8px; border-radius:1px; background:var(--text-tertiary); width:@px"></div>
            <span class="meta">@px</span>
            <span class="meta">@_spaceUse[step]</span>
        </DeskRow>
    }
</DeskStack>

</PanelSection>

<PanelSection Title="Type styles">
<p class="empty">
    The HIG's text styles at macOS's density, named for the job, not the size —
    <span class="mono">--text-body</span> keeps meaning the right thing when Text size makes 13px
    something else. Hierarchy comes from these and the four label colours; a screen that needs a
    size not on this list needs a different style instead.
</p>

<DeskStack Gap="DeskSpace.Space2">
    @foreach (var (token, size, leading, weight, use) in _typeStyles)
    {
        <DeskRow Gap="DeskSpace.Space3" Align="DeskAlign.Baseline">
            <span class="mono meta parts-key">@token</span>
            <span style="font-size:var(@token); line-height:var(@leading); font-weight:var(@weight)">Every value in its place</span>
            <span class="meta">@size / @use</span>
        </DeskRow>
    }
</DeskStack>

</PanelSection>

<PanelSection Title="Row and stack">
<p class="empty">
    <span class="mono">DeskRow</span> is the horizontal one with its gap, alignment and
    justification named; <span class="mono">DeskStack</span> is the vertical one. Both leave
    the 8px default alone when Gap is unset.
</p>

<DeskStack Gap="DeskSpace.Space3">
    <DeskRow Gap="DeskSpace.Space2">
        <span class="meta">Row, Space2 — the default gap.</span>
        <Tag>One</Tag>
        <Tag>Two</Tag>
    </DeskRow>

    <DeskRow Gap="DeskSpace.Space4">
        <span class="meta">Row, Space4.</span>
        <Tag>One</Tag>
        <Tag>Two</Tag>
    </DeskRow>

    <DeskRow Justify="DeskJustify.End" Gap="DeskSpace.Space2">
        <DeskButton Emphasis="DeskEmphasis.Plain">Cancel</DeskButton>
        <DeskButton Emphasis="DeskEmphasis.Filled">Apply</DeskButton>
    </DeskRow>

    <DeskRow Justify="DeskJustify.Between">
        <span class="meta">Justify=Between — label left, control right.</span>
        <Tag>Right</Tag>
    </DeskRow>
</DeskStack>

</PanelSection>

<PanelSection Title="Panel headings">
<p class="empty">
    Every rule on this page is a <code>PanelSection</code>: it renders the rule through
    <code>PanelHeader</code>, owns the air to the next section, and steps its heading rank
    down when nested, so no call site writes a margin or a level. <code>PanelHeader</code>
    on its own is for a rule inside a row that is already spacing it:
</p>

<DeskRow Gap="DeskSpace.Space2" Align="DeskAlign.Baseline">
    <PanelHeader Tight>Tight — the row is already spacing it</PanelHeader>
    <Tag State="DeskState.Info">Live</Tag>
</DeskRow>
</PanelSection>

</div>

@code {
    // ---------------------------------------------------------------- buttons ---

    private static readonly (DeskEmphasis Emphasis, string Name, string Use)[] _emphases =
    [
        (DeskEmphasis.Plain, "Plain",
            "transparent until pointed at — toolbar actions, and every way out of a thing"),
        (DeskEmphasis.Tinted, "Tinted",
            "an accent wash — secondary actions that still have to be found in a dense panel"),
        (DeskEmphasis.Filled, "Filled",
            "solid accent — the one action this context exists to commit")
    ];

    private bool _busy;

    private int _anatomyYear = 2026;

    private static readonly IReadOnlyList<DeskSwitchOption<int>> _anatomyYears =
        [new(2026, "2026"), new(2025, "2025")];

    private string _anatomyKind = "";
    private string _anatomySearch = "";

    private static readonly IReadOnlyList<DeskSwitchOption<string>> _anatomyKinds =
        [new("", "All", "Every kind"), new("open", "Open"), new("closed", "Closed")];

    private string _anatomyOwner = "ames";
    private int? _anatomyAmount = 120;
    private string? _anatomyNote;

    // Deliberately fake. A catalog's job is to let you look at a state, and busy is a state
    // you otherwise have to catch mid-request to see.
    private async Task RunAsync()
    {
        _busy = true;
        Report(PulseState.Active, "demonstrating");

        await Task.Delay(1400);

        _busy = false;
        Report(PulseState.Healthy, "reference");
    }

    // ----------------------------------------------------------------- fields ---

    private string? _text;
    private decimal? _number;
    private string _choice = "draft";
    private string? _prose;

    // ------------------------------------------------------------ gate and tabs ---

    private static readonly IReadOnlyList<DeskSwitchOption<string>> _gateViews =
    [
        new("list", "List"),
        new("grid", "Grid"),
        new("chart", "Chart")
    ];

    private string _gateView = "list";
    private int _gateDays = 30;

    private string _demoTab = "Summary";
    private bool _thirdTab;

    private IReadOnlyList<DeskTab<string>> _demoTabs =>
    [
        new("Summary", "Summary"),
        new("Details", "Details"),
        new("History", "History", _thirdTab)
    ];

    // ------------------------------------------------------------------- tags ---

    private static readonly (DeskState State, string Word)[] _tagStates =
    [
        (DeskState.Neutral, "Neutral"),
        (DeskState.Info, "Selected"),
        (DeskState.Positive, "Healthy"),
        (DeskState.Warning, "Degraded"),
        (DeskState.Negative, "Breached")
    ];

    // ---------------------------------------------------------------- display ---

    private sealed record PartRow(string Source, string Stage, string Amount);

    private static readonly PartRow[] _rows =
    [
        new("North", "Draft", "120"),
        new("South", "Review", "85"),
        new("East", "Final", "1,340"),
        new("West", "Draft", "64")
    ];

    private bool _gridLoading = true;

    /// <summary>What the last linked cell pressed would have opened, so the demo says it was heard.</summary>
    private string? _linkOpened;

    private double _progress = 34;
    private bool _stepping;

    // Deliberately fake, for the same reason the busy button is: a determinate bar is only
    // legible while it is moving.
    private async Task StepAsync()
    {
        _stepping = true;

        try
        {
            for (var i = 0; i < 6; i++)
            {
                await Task.Delay(220);
                _progress = _progress >= 100 ? 0 : Math.Min(100, _progress + 11);
                StateHasChanged();
            }
        }
        finally
        {
            // Without the finally the button would stay lit for good on a throw, which is
            // the one thing a busy button must never do.
            _stepping = false;
            StateHasChanged();
        }
    }

    // --------------------------------------------------------------- modality ---

    private bool _dialogOpen;
    private string? _sheetOutcome;
    private string? _alertOutcome;
    private IDeskSheetHandle? _sheet;
    private string? _noteTitle;
    private string? _noteBody;

    /// <summary>
    /// The sheet, opened the way every call site should open one: through
    /// <see cref="IDeskSheets"/>, which holds the dialog options, so the caller states only the
    /// sheet and what goes in it.
    ///
    /// <para>
    /// The outcome is read off the awaited <see cref="DialogResult"/>, never off
    /// <c>OnCancel</c>. Escape and backdrop dismissal go through MudBlazor's own cancel path
    /// and never reach the component's callbacks, so a caller listening to <c>OnCancel</c>
    /// would sit waiting on a sheet the operator already dismissed. The shape below —
    /// <c>result is { Canceled: false, Data: … }</c> — treats every route out that is not an
    /// explicit completion as a "no", which is the only reading that is safe.
    /// </para>
    /// </summary>
    private async Task OpenSheetAsync()
    {
        _sheetOutcome = null;
        _noteTitle = null;
        _noteBody = null;

        var parameters = new DialogParameters<DeskSheet>
        {
            { x => x.Title, "Add a note" },
            { x => x.Subtitle, "A demonstration — nothing is written" },
            { x => x.ChildContent, SheetBody },
            { x => x.Footer, SheetFooter }
        };

        _sheet = await Sheets.ShowAsync(parameters);

        var result = await _sheet.Result;

        _sheetOutcome = result is { Canceled: false, Data: string outcome }
            ? $"\"{outcome}\" — completed"
            : "cancelled (Escape, backdrop, or the way out)";

        StateHasChanged();
    }

    // One grouped form, as every form in a window is (the Anatomy's, above): labels leading in
    // one column, bare fields trailing, each named for a screen reader since the label beside
    // it is not its <label>.
    private RenderFragment SheetBody => @<div>
        <p class="empty">
            Modal, on purpose. The scrim is the statement: this task is self-contained, and
            completing or cancelling it is the only thing on offer until it is done.
        </p>
        <div class="wgroup">
            <div class="wgroup__row wgroup__row--form">
                <span class="wgroup__label">Title</span>
                <DeskField TValue="string" Class="wfield--fill" aria-label="Title" placeholder="Required"
                           @bind-Value="_noteTitle" />
            </div>
            <div class="wgroup__row wgroup__row--form">
                <span class="wgroup__label">Note</span>
                <DeskTextArea Class="wfield--fill" aria-label="Note" rows="3" placeholder="Optional"
                              @bind-Value="_noteBody" />
            </div>
        </div>
    </div>;

    private RenderFragment SheetFooter => @<DeskRow Justify="DeskJustify.End" Gap="DeskSpace.Space2">
        <DeskButton Emphasis="DeskEmphasis.Plain"
                    OnClick="@(() => _sheet?.Close())">
            Cancel
        </DeskButton>
        <DeskButton Emphasis="DeskEmphasis.Filled"
                    OnClick="@(() => _sheet?.Close(DialogResult.Ok(string.IsNullOrWhiteSpace(_noteTitle) ? "Untitled" : _noteTitle)))">
            Add note
        </DeskButton>
    </DeskRow>;

    /// <summary>
    /// The destructive alert. One await is the whole point — if guarding a dangerous action
    /// cost six lines of DialogParameters, call sites would quietly skip the guard.
    /// </summary>
    private async Task AskAsync()
    {
        var confirmed = await Alerts.ConfirmAsync(
            "Delete this run?",
            message: "The imported rows stay; only the run record goes.",
            confirmLabel: "Delete run",
            cancelLabel: "Keep it",
            destructive: true);

        _alertOutcome = confirmed ? "true — confirmed" : "false — kept";
    }

    // ------------------------------------------------------------------ pulse ---

    private static readonly (string Class, string Label)[] _pulses =
    [
        ("pulse--healthy", "Healthy — the source answered, and the numbers moved."),
        ("pulse--active", "Active — work is genuinely in flight."),
        ("pulse--warn", "Warn — degraded, or under budget pressure."),
        ("pulse--critical", "Critical — the one state you must not miss."),
        ("pulse--idle", "Idle — nothing has run yet.")
    ];

    // ----------------------------------------------------------------- charts ---

    // Deliberately fake, and shaped rather than random: a catalog's job is to let you compare
    // palettes side by side, which needs the same X axis under each one.
    private static readonly string[] _chartLabels = ["Mon", "", "Wed", "", "Fri", ""];

    private static readonly List<ChartSeries<double>> _movement =
    [
        new() { Name = "North · first", Data = new double[] { -110, -115, -108, -120, -125, -118 } },
        new() { Name = "North · second", Data = new double[] { -112, -110, -105, -118, -122, -120 } },
        new() { Name = "South · first", Data = new double[] { -102, -105, -112, -100, -96, -101 } }
    ];

    private static readonly List<ChartSeries<double>> _ledger =
    [
        new() { Name = "Cumulative", Data = new double[] { 0, 1.4, 0.6, 2.8, 2.1, 3.9 } }
    ];

    private static readonly List<ChartSeries<double>> _health =
    [
        new() { Name = "Healthy", Data = new double[] { 22, 24, 19, 26, 25, 27 } },
        new() { Name = "Warn", Data = new double[] { 3, 2, 6, 1, 2, 1 } },
        new() { Name = "Breached", Data = new double[] { 0, 1, 3, 0, 1, 0 } }
    ];

    // ------------------------------------------------------------- foundation ---

    private static readonly (string Step, string Name, string Px)[] _spaces =
    [
        ("1", "--space-1", "4px"),
        ("2", "--space-2", "8px"),
        ("3", "--space-3", "12px"),
        ("4", "--space-4", "16px"),
        ("6", "--space-6", "24px"),
        ("8", "--space-8", "32px"),
        ("12", "--space-12", "48px"),
        ("16", "--space-16", "64px")
    ];

    private static readonly Dictionary<string, string> _spaceUse = new()
    {
        ["1"] = "a value and its unit",
        ["2"] = "the desk's default gap",
        ["3"] = "separate controls",
        ["4"] = "groups in a section",
        ["6"] = "sections of a panel",
        ["8"] = "read at different times",
        ["12"] = "page-level separation",
        ["16"] = "any more wants a divider"
    };

    // The ramp the desk actually ships (the Desk's stylesheet, "The HIG text-style ramp"), at macOS's
    // density. This list named four tokens, three of which no longer exist — --text-title,
    // --text-callout and their leadings — so its samples fell back to the body size and taught a
    // ladder nobody could use. Headline is Body's size and differs by weight, so the sample says so.
    private static readonly (string Token, string Size, string Leading, string Weight, string Use)[] _typeStyles =
    [
        ("--text-title1", "22px", "--leading-title", "--weight-medium", "a figure that leads: a metric, a score"),
        ("--text-title2", "17px", "--leading-title", "--weight-semibold", "a window's title"),
        ("--text-title3", "15px", "--leading-title", "--weight-semibold", "a form's title, a person's name"),
        ("--text-headline", "13px semibold", "--leading-body", "--weight-semibold", "the part of a row that leads it"),
        ("--text-body", "13px", "--leading-body", "--weight-regular", "the reading size"),
        ("--text-subheadline", "12px", "--leading-body", "--weight-regular", "section headers, group footers, meta"),
        ("--text-footnote", "11px", "--leading-body", "--weight-regular", "table headers, figure labels, chart axes"),
        ("--text-caption", "10px", "--leading-body", "--weight-regular", "legends, and the 10px floor")
    ];

    protected override void OnInitialized() => Report(PulseState.Idle, "reference");

    // Not PanelBase: that is the application's, and carries its data plumbing — change signals,
    // loads and retries, the formatting of its own records. The gallery needs one thing from it,
    // the cascaded window id that puts its state on its own pulse, and holds that itself so the
    // Desk can ship it.
    [CascadingParameter(Name = "WindowId")]
    private string? WindowId { get; set; }

    /// <summary>Reports this window's state to its chrome. No-op when hosted outside a window.</summary>
    private void Report(PulseState state, string? status = null)
    {
        if (WindowId is not null)
            Manager.SetPulse(WindowId, state, status);
    }
}

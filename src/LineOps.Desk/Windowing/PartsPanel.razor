    private double _progress = 34;
    private bool _stepping;

    // Deliberately fake, for the same reason the busy button is: a determinate bar is only
    // legible while it is moving.
    private async Task StepAsync()
    {
        _stepping = true;

        try
        {
            for (var i = 0; i < 6; i++)
            {
                await Task.Delay(220);
                _progress = _progress >= 100 ? 0 : Math.Min(100, _progress + 11);
                StateHasChanged();
            }
        }
        finally
        {
            // Without the finally the button would stay lit for good on a throw, which is
            // the one thing a busy button must never do.
            _stepping = false;
            StateHasChanged();
        }
    }


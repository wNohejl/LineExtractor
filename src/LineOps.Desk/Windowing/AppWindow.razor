@using LineOps.Desk.Windowing
@inject WindowManager Manager
@inject IDeskAlerts Alerts

@*
    One tab in the row: chrome, pulse strip, and the hosted panel.

    Full height, positioned only horizontally — the manager owns X and Width. The title bar
    doubles as the tab: dragging it past a neighbour reorders the row (see windowing.js);
    dragging the divider at its edge resizes it. Collapsed, only the bar and pulse render —
    there is no separate list a collapsed window moves into, it just gets narrow.

    The panel inside receives its window id as a cascading value so it can report status
    upward, and that is the only coupling to the window system.
*@

<div class="win @(IsFocused ? "win--focused" : null) @(Window.Minimised ? "win--collapsed" : null)"
     id="@ElementId"
     style="left:@Px(Window.X); width:@Px(Window.Width);"
     data-min-width="@Window.Definition.MinWidth"
     role="region"
     aria-label="@Window.Title"
     @onpointerdown="OnPointerDown">

    <div class="win__bar" data-tab-handle @ondblclick="OnBarDoubleClick" @onclick="OnBarClick">
        @* A subject window follows its links in place (WindowManager.Follow), so it carries its
           own Back and Forward — always drawn, dimmed when there is nowhere to go, so the
           title does not jump sideways the first time a link is followed. *@
        @if (!Window.Minimised && Window.FollowsInPlace)
        {
            <div class="win__nav">
                <button class="win__nav-btn" type="button" data-window-control
                        title="@(Window.BackTitle is { } back ? $"Back to {back}" : "Back")"
                        aria-label="@(Window.BackTitle is { } backLabel ? $"Back to {backLabel}" : "Back")"
                        disabled="@(!Window.CanPageBack)"
                        @onclick="PageBack" @onclick:stopPropagation="true"
                        @ondblclick:stopPropagation="true">
                    <Glyph Icon="@Icons.Material.Filled.ChevronLeft" />
                </button>
                <button class="win__nav-btn" type="button" data-window-control
                        title="@(Window.ForwardTitle is { } forward ? $"Forward to {forward}" : "Forward")"
                        aria-label="@(Window.ForwardTitle is { } forwardLabel ? $"Forward to {forwardLabel}" : "Forward")"
                        disabled="@(!Window.CanPageForward)"
                        @onclick="PageForward" @onclick:stopPropagation="true"
                        @ondblclick:stopPropagation="true">
                    <Glyph Icon="@Icons.Material.Filled.ChevronRight" />
                </button>
            </div>
        }

        <span class="win__icon">
            <Glyph Icon="@Window.Definition.Icon" />
        </span>

        @if (!Window.Minimised)
        {
            <span class="win__title">@Window.Title</span>

            @if (!string.IsNullOrEmpty(Window.StatusText))
            {
                <span class="win__status">@Window.StatusText</span>
            }

            <span class="win__spacer"></span>

            @* Every control here stops the click going any further. The bar behind them
               is itself a control — it expands a collapsed window — and a click that
               reaches both runs both: minimise set the flag, the bar read the flag it
               had just set and expanded the window straight back. The button appeared
               to do nothing. A press on a control is for that control only. *@
            <div class="win__controls" data-glide>
                <button class="win__ctl" type="button" data-window-control
                        title="Minimise" aria-label="Minimise @Window.Title"
                        @onclick="Minimise" @onclick:stopPropagation="true">
                    <Glyph Icon="@Icons.Material.Filled.Remove" />
                </button>
                <button class="win__ctl" type="button" data-window-control
                        title="@(Window.Maximised ? "Restore the row" : "Take the whole row")"
                        aria-label="@(Window.Maximised ? "Restore" : "Maximise") @Window.Title"
                        @onclick="Maximise" @onclick:stopPropagation="true"
                        @ondblclick:stopPropagation="true">
                    <Glyph Icon="@(Window.Maximised
                                   ? Icons.Material.Filled.FilterNone
                                   : Icons.Material.Filled.CropSquare)" />
                </button>
                <button class="win__ctl win__ctl--close" type="button" data-window-control
                        data-glide-tone="stop"
                        title="Close" aria-label="Close @Window.Title"
                        @onclick="Close" @onclick:stopPropagation="true">
                    <Glyph Icon="@Icons.Material.Filled.Close" />
                </button>
            </div>
        }
    </div>

    @* SIGNATURE: this window's own state, readable without focusing it — including collapsed. *@
    <div class="pulse @PulseClass" role="status"
         aria-label="@Window.Title status: @Window.Pulse"></div>

    @if (!Window.Minimised)
    {
        @* Keyed on the page, so turning to another page builds the body afresh: scrolled to the
           top, with none of the last page's tabs or filters carried into the next. *@
        <div class="win__body" @key="Window.PageVersion">
            <CascadingValue Value="@Window.Id" Name="WindowId">
                <DynamicComponent Type="Window.Definition.ComponentType"
                                  Parameters="Window.Parameters" />
            </CascadingValue>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public WindowInstance Window { get; set; } = default!;
    [Parameter] public bool IsFocused { get; set; }

    private string ElementId => $"win-{Window.Id}";

    private string PulseClass => Window.Pulse switch
    {
        PulseState.Healthy => "pulse--healthy",
        PulseState.Warn => "pulse--warn",
        PulseState.Critical => "pulse--critical",
        PulseState.Active => "pulse--active",
        _ => "pulse--idle"
    };

    private static string Px(double value)
        => $"{value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}px";

    // Pointer-down anywhere marks this window as most recently used, which is what keeps it
    // safe from eviction. Using pointerdown rather than click means the bookkeeping happens
    // before a drag even starts.
    private void OnPointerDown() => Manager.Focus(Window.Id);

    // A collapsed tab has no controls to click — the whole bar is "expand".
    private void OnBarClick()
    {
        if (Window.Minimised)
            Manager.Focus(Window.Id);
    }

    private void OnBarDoubleClick()
    {
        if (!Window.Minimised)
            Maximise();
    }

    private void PageBack() => Manager.PageBack(Window.Id);
    private void PageForward() => Manager.PageForward(Window.Id);
    private void Minimise() => Manager.ToggleMinimise(Window.Id);
    private void Maximise() => Manager.ToggleMaximise(Window.Id);

    private bool _asking;

    // A window holding unsaved input asks before it goes: the HIG's confirm-before-closing rule,
    // and the only route by which a half-typed entry used to vanish with one click. Discard is
    // destructive, so Return lands on Keep editing. One question at a time — a second click on
    // the key while the alert is up does not stack another.
    private async Task Close()
    {
        var id = Window.Id;

        if (_asking || Manager.TryClose(id))
            return;

        _asking = true;

        try
        {
            var discard = await Alerts.ConfirmAsync(
                $"Discard {Window.UnsavedInputLabel ?? "unsaved changes"}?",
                message: "The window has input that has not been saved.",
                confirmLabel: "Discard",
                cancelLabel: "Keep editing",
                destructive: true);

            if (discard)
                Manager.Close(id);
        }
        finally
        {
            _asking = false;
        }
    }
}

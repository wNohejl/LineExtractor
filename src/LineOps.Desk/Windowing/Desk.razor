@using LineOps.Desk.Windowing
@implements IAsyncDisposable
@inject WindowManager Manager
@inject DeskFollowUps FollowUps
@inject DeskBrand Brand
@inject IJSRuntime JS

@*
    Header and footer are fixed chrome. Between them sits the desk: one horizontal row of
    full-height tabs — every window is its own tab, so there is no separate taskbar — with a
    draggable divider wherever two expanded ones meet.
*@
<div class="shell">

    <DeskHeader />

    <div class="shell__body">
        <div class="desk" data-desk>
            @* A declared resolution gets a real surface of that size and the desk scrolls to
               it, rather than layout pretending the screen is bigger than it is. *@
            <div class="desk__surface"
                 style="@(Fixed ? $"width:{Manager.DeskWidth}px; height:{Manager.DeskHeight}px" : null)">

                @if (Row.Count == 0)
                {
                    <div class="desk-empty">
                        <div class="desk-empty__mark">@Brand.Wordmark<em>@Brand.Emphasis</em></div>
                        <p class="desk-empty__hint">
                            An empty desk. Windows open as tabs in a row — @PrimaryHint
                            Drag a tab past another to reorder them.
                        </p>
                        <div class="row">
                            <DeskButton Emphasis="DeskEmphasis.Filled" Icon="@Icons.Material.Filled.AddBox" OnClick="OpenPrimary">
                                Open @PrimaryTitle
                            </DeskButton>
                            <DeskButton Icon="@Icons.Material.Filled.Workspaces" OnClick="OpenTriage">
                                Morning triage
                            </DeskButton>
                        </div>
                    </div>
                }

                @foreach (var window in Rendered)
                {
                    @* Keyed by id so Blazor reuses the element rather than recreating it and
                       losing the drag/divider bindings that point at it. *@
                    <AppWindow @key="window.Id"
                               Window="window"
                               IsFocused="Manager.FocusedId == window.Id" />
                }

                @* One divider per adjacent pair of expanded tabs. Suppressed next to a
                   collapsed tab (nothing to resize there) and while a window holds the whole
                   row (there is no split to adjust). *@
                @if (!Maximised)
                {
                    @for (var i = 0; i < Row.Count - 1; i++)
                    {
                        var left = Row[i];
                        var right = Row[i + 1];

                        if (left.Minimised || right.Minimised)
                        {
                            continue;
                        }

                        var key = $"{left.Id}|{right.Id}";

                        <div class="divider"
                             @key="key"
                             style="left:@Px(left.X + left.Width)"
                             role="separator"
                             aria-orientation="vertical"
                             aria-label="@($"Resize {left.Title} and {right.Title}")"
                             tabindex="0"
                             @onkeydown="e => OnDividerKey(e, left, right)"
                             @ref="_dividerHandles[key]">
                            <span class="divider__grip"></span>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <DeskFooter />

    @* Follow-ups opened from inside a floating dialog land here, where nothing clips them. *@
    <LineOps.Desk.Primitives.FollowUpLayer Launcher="FollowUps.Launcher" />

    <CommandPalette />
</div>

@code {
    private IJSObjectReference? _module;
    private DotNetObjectReference<Desk>? _self;
    private readonly Dictionary<string, ElementReference> _dividerHandles = [];
    private string _wiredDividers = string.Empty;
    private string _wiredTabs = string.Empty;
    private long _historyVersion;

    private List<WindowInstance> Row =>
        Manager.Windows.OrderBy(w => w.X).ToList();

    private bool Maximised => Manager.Windows.Any(w => w.Maximised && !w.Minimised);

    /// <summary>A maximised window is the only one rendered; otherwise every tab in the row is.</summary>
    private List<WindowInstance> Rendered =>
        Maximised
            ? Manager.Windows.Where(w => w.Maximised && !w.Minimised).ToList()
            : Row;

    private bool Fixed => Manager.Settings.ResolutionMode == ResolutionMode.Fixed;

    private WindowDefinition? Primary
        => Manager.Catalog.Find(Manager.Settings.PrimaryWindowKey ?? Manager.Catalog.DefaultPrimary);

    private string PrimaryTitle => Primary?.Title ?? "a window";

    private string PrimaryHint => Manager.Settings.PrimaryWindowKey is null
        ? "every tab gets an equal share."
        : $"{PrimaryTitle} is primary, so it takes the larger share wherever it sits.";

    private static string Px(double value)
        => $"{value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}px";

    protected override void OnInitialized() => Manager.Changed += OnManagerChanged;

    /// <summary>Per product, so two desks served from one origin in development never share a row.</summary>
    private string LayoutKey => $"{Brand.Wordmark}{Brand.Emphasis}.desk".ToLowerInvariant();

    private string? _savedLayout;
    private bool _saveQueued;

    // What the page was last told. 1 is what the stylesheet declares, so a desk at 100% never
    // makes the call at all.
    private double _appliedUiScale = 1;
    private double _appliedTextScale = 1;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/LineOps.Desk/js/windowing.js");
            _self = DotNetObjectReference.Create(this);

            // Before initialise: the first viewport report sets a default window ceiling unless
            // the operator chose one, and a restored layout carries that choice.
            _savedLayout = await _module.InvokeAsync<string?>("loadLayout", LayoutKey);
            if (DeskLayout.Parse(_savedLayout) is { } layout && Manager.Windows.Count == 0)
                Manager.Restore(layout);

            await _module.InvokeVoidAsync("initialise", _self);

            _historyVersion = Manager.HistoryVersion;
            await _module.InvokeVoidAsync("trackHistory", Manager.HistoryDepth);
        }

        if (_module is null)
            return;

        // The scale is the manager's setting and the page's zoom; this is the one place that
        // owns both the setting and the module, so it is the one place that keeps them agreed.
        // Compared rather than pushed on every render, because every pulse re-renders the desk.
        var (ui, text) = (Manager.Settings.UiScale, Manager.Settings.TextScale);
        if (ui != _appliedUiScale || text != _appliedTextScale)
        {
            (_appliedUiScale, _appliedTextScale) = (ui, text);
            await _module.InvokeVoidAsync("applyScale", ui, text);
        }

        // A new step on the desk becomes a browser history entry, so Back has somewhere to go.
        // A walk back or forward changes the depth but not the version, and is already an entry.
        if (Manager.HistoryVersion != _historyVersion)
        {
            _historyVersion = Manager.HistoryVersion;
            await _module.InvokeVoidAsync("pushHistory", Manager.HistoryDepth);
        }

        // Rebind dividers only when the set of adjacent pairs actually changes — a drag
        // causes renders, and rewiring mid-gesture would drop it.
        var dividerSignature = string.Join(",", _dividerHandles.Keys);
        if (dividerSignature != _wiredDividers)
        {
            _wiredDividers = dividerSignature;

            foreach (var (key, handle) in _dividerHandles)
            {
                var ids = key.Split('|');
                await _module.InvokeVoidAsync("attachDivider", handle, ids[0], ids[1]);
            }
        }

        // Tab-drag wiring only needs the id, not neighbours, so it only needs rebinding
        // when the set of open windows changes — not on every reorder or resize render.
        var tabSignature = string.Join(",", Row.Select(w => w.Id));
        if (tabSignature != _wiredTabs)
        {
            _wiredTabs = tabSignature;
            await _module.InvokeVoidAsync("attachAllTabs", "[data-desk]");
        }
    }

    /// <summary>Called from JS when a divider drag ends. See windowing.js.</summary>
    [JSInvokable]
    public void OnSplitCommitted(string leftId, string rightId, double leftWidth, double rightWidth)
        => Manager.AdjustSplit(leftId, rightId, leftWidth, rightWidth);

    /// <summary>Called from JS when a tab drag ends with the row's new left-to-right order.</summary>
    [JSInvokable]
    public void OnReordered(string[] orderedIds)
        => Manager.Reorder(orderedIds);

    /// <summary>Ctrl+K or ⌘K, from anywhere on the page. See windowing.js.</summary>
    [JSInvokable]
    public void OnPaletteRequested() => Manager.RequestPalette();

    /// <summary>Ctrl+, or ⌘, — the platform's settings chord, from anywhere. See windowing.js.</summary>
    [JSInvokable]
    public void OnSettingsRequested() => OpenSettings(Manager);

    /// <summary>
    /// Ctrl+Z or ⌘Z outside a field. Through the browser's history rather than straight to
    /// <see cref="WindowManager.Back"/>, so the chord, the header's Back, the browser's own and
    /// Alt+Left all walk one list: a step taken behind the browser's back would leave its entry
    /// standing, and the next Back pressed anywhere would land on it and do nothing.
    /// </summary>
    [JSInvokable]
    public async Task OnUndoRequested()
    {
        if (Manager.CanGoBack)
            await JS.InvokeVoidAsync("history.back");
    }

    /// <summary>⇧⌘Z, Ctrl+Shift+Z or Ctrl+Y outside a field; the same road as undo, the other way.</summary>
    [JSInvokable]
    public async Task OnRedoRequested()
    {
        if (Manager.CanGoForward)
            await JS.InvokeVoidAsync("history.forward");
    }

    /// <summary>
    /// Ctrl+Alt+← or → outside a field: the keyboard's tab drag. Without it the row's order was
    /// pointer-only. See <see cref="MoveFocused"/>.
    /// </summary>
    [JSInvokable]
    public void OnMoveWindowRequested(int delta) => MoveFocused(Manager, delta);

    /// <summary>
    /// The catalogue key of the desk's settings window — the Window manager. The desk names it
    /// rather than the application because Ctrl+, is the desk's chord; a catalogue without an
    /// entry under it simply has no settings to open, and the chord does nothing.
    /// </summary>
    public const string SettingsKey = "desk";

    /// <summary>Opens the Window manager, or focuses it if it is already on the desk.</summary>
    public static void OpenSettings(WindowManager manager)
    {
        if (manager.Catalog.Find(SettingsKey) is { } settings)
            manager.Open(settings);
    }

    /// <summary>
    /// Shifts the focused window one place along the row. Nothing focused, or already at that
    /// end, is a key that does nothing — and leaves the row untouched rather than reordering it
    /// into the order it already had.
    /// </summary>
    public static void MoveFocused(WindowManager manager, int delta)
    {
        if (manager.FocusedId is not { } id)
            return;

        var order = manager.Windows.OrderBy(w => w.Sequence).Select(w => w.Id).ToList();
        var shifted = Shifted(order, id, delta);

        if (!shifted.SequenceEqual(order))
            manager.Reorder(shifted);
    }

    /// <summary>
    /// <paramref name="order"/> with <paramref name="id"/> moved <paramref name="delta"/> places,
    /// clamped to the row: at either end, or for an id not in it, the same order comes back. The
    /// row does not wrap, because the end of a list on the platform is a stop, not a door.
    /// </summary>
    public static IReadOnlyList<string> Shifted(IReadOnlyList<string> order, string id, int delta)
    {
        var from = order.ToList().IndexOf(id);
        var to = from + delta;

        if (from < 0 || delta == 0 || to < 0 || to >= order.Count)
            return order;

        var moved = order.ToList();
        moved.RemoveAt(from);
        moved.Insert(to, id);
        return moved;
    }

    /// <summary>The browser's Back or Forward landed on a desk entry. See windowing.js.</summary>
    [JSInvokable]
    public async Task OnHistoryTraversed(int depth)
    {
        // A walk refused for unsaved input leaves the browser on an entry the desk is not at;
        // send it back to the desk's own, or the next Back would be counted from the wrong place.
        if (HistoryCorrection(Manager, depth) is var steps and not 0)
            await JS.InvokeVoidAsync("history.go", steps);
    }

    /// <summary>
    /// Walks the desk to the browser's <paramref name="depth"/> and says how far the browser must
    /// then move to agree with it: zero when the walk happened, and the refused distance back
    /// when it did not. The landing fires popstate at the desk's own depth, which walks nowhere.
    /// </summary>
    public static int HistoryCorrection(WindowManager manager, int depth)
        => manager.TraverseTo(depth) ? 0 : manager.HistoryDepth - depth;

    [JSInvokable]
    public void OnViewportChanged(double width, double height)
        => Manager.SetViewport(width, height);

    /// <summary>
    /// Keyboard equivalent of a divider drag. A pointer-only resize would put column widths
    /// out of reach for anyone not using a mouse.
    /// </summary>
    private void OnDividerKey(KeyboardEventArgs e, WindowInstance left, WindowInstance right)
    {
        var step = e.ShiftKey ? 48d : 16d;

        var delta = e.Key switch
        {
            "ArrowLeft" => -step,
            "ArrowRight" => step,
            _ => 0d
        };

        if (delta == 0)
            return;

        var leftWidth = Math.Max(left.Definition.MinWidth, left.Width + delta);
        var rightWidth = Math.Max(right.Definition.MinWidth, right.Width - delta);

        Manager.AdjustSplit(left.Id, right.Id, leftWidth, rightWidth);
    }

    private void OpenTriage() => Manager.ApplyWorkspace(Manager.Catalog.Workspaces[0]);

    private void OpenPrimary()
    {
        if (Primary is not null)
            Manager.Open(Primary);
    }

    private void OnManagerChanged()
    {
        InvokeAsync(StateHasChanged);

        // Changed also fires for every pulse and status line, so saving is deferred and only
        // written when the layout itself differs from what the browser already holds.
        if (_module is null || _saveQueued)
            return;

        _saveQueued = true;
        _ = SaveLayoutSoonAsync();
    }

    private async Task SaveLayoutSoonAsync()
    {
        await Task.Delay(500);
        _saveQueued = false;

        await InvokeAsync(async () =>
        {
            var json = Manager.Capture().Serialise();
            if (json == _savedLayout || _module is null)
                return;

            try
            {
                await _module.InvokeVoidAsync("saveLayout", LayoutKey, json);
                _savedLayout = json;
            }
            catch (JSDisconnectedException)
            {
                // The browser has gone; the last saved layout stands.
            }
        });
    }

    public async ValueTask DisposeAsync()
    {
        Manager.Changed -= OnManagerChanged;

        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit already gone; nothing to release in the browser.
            }
        }

        _self?.Dispose();
    }
}

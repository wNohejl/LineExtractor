@implements IDisposable
@inject WindowManager Manager
@inject ThemeService Theme
@inject IDeskAccess Access
@inject NavigationManager Navigation

@*
    Desk configuration. Every control here changes the desk immediately — there is no Save,
    because the desk behind this window *is* the preview.

    It is a settings screen, so it is drawn as one (apple-hig-components, forms.md, and the
    HIG's Settings pattern): a column of grouped lists, each a fill with its labels leading in
    one column and the controls trailing, a quiet header naming the group and a footer
    explaining it. It was a note, a row of metric tiles and a stack of rules with body-size
    prose running to the window's edge and a picker as wide as the desk. The figures the tiles
    held are value rows in the group they describe, the prose is each group's footer, and the
    column stops at a form's width so a label and its control stay within one glance.
*@

@* Who is at this desk, on a desk that can be reached by more than one person (ADR 0018). A
   sign-in is a page load, not a window: the cookie it sets needs an HTTP response. Whether there
   is a gate, and where its pages are, is the application's to say (IDeskAccess); the desk only
   links to them. *@
@if (Access.IsGated)
{
    <PanelToolbar>
        <ChildContent>
            @if (Access.CanOperate)
            {
                <Tag State="DeskState.Positive">Operator</Tag>
                <span class="dim">Everything on this desk is yours to change.</span>
            }
            else
            {
                <Tag State="DeskState.Info">Visitor</Tag>
                <span class="dim">This desk reads everything and changes nothing.</span>
            }
        </ChildContent>
        <Actions>
            @if (Access.CanOperate)
            {
                <DeskButton Size="DeskKeySize.Small" Icon="@Icons.Material.Filled.Logout"
                            OnClick="@(() => Navigation.NavigateTo(Access.SignOutPath!, forceLoad: true))">
                    Sign out
                </DeskButton>
            }
            else
            {
                <DeskButton Size="DeskKeySize.Small" Icon="@Icons.Material.Filled.Login"
                            OnClick="@(() => Navigation.NavigateTo(Access.SignInPath!, forceLoad: true))">
                    Operator sign-in
                </DeskButton>
            }
        </Actions>
    </PanelToolbar>
}

<div class="wsections wm">

    @*
        Appearance leads, because it is the only setting on this panel that changes the panel
        itself. There is no preview: the desk under this gate repaints as the cap slides.
    *@
    <section class="wsection" aria-labelledby="wm-appearance-h">
        <h3 class="wgroup__head" id="wm-appearance-h">Appearance</h3>
        <div class="wgroup">
            <div class="wgroup__row wgroup__row--form">
                <span class="wgroup__label">Mode</span>
                <DeskSwitch Options="_themes" Label="Appearance"
                            Value="Theme.Mode"
                            ValueChanged="@((DeskThemeMode mode) => Theme.SetModeAsync(mode))" />
            </div>

            @* The family, beneath the mode rather than beside it, because it is the finer choice:
               every family has a dark and a light desk, so the mode above still decides which one
               of the pair is showing. Each swatch is painted by its own family's token block in
               the appearance showing now — flip Light above and every swatch turns with the desk.

               One family among several is a single choice, so the tiles are the desk's radio
               group, not a row of toggles: one Tab stop on the chosen tile, and arrows move the
               choice, as on every gate. The group owns the radios and their keys; the template
               only paints each tile, and the tile carries its family's data-theme so the group's
               own button stays in the desk's colours. Its label sits at the top of the row,
               beside the first line of tiles, because a label centred on two lines of tiles
               belongs to neither. *@
            <div class="wgroup__row wgroup__row--form wm-row--top">
                <span class="wgroup__label">Theme</span>
                <DeskRadioGroup TValue="DeskThemeFamily" Options="_families" Label="Theme" Class="swatches"
                                Value="Theme.Family"
                                ValueChanged="@((DeskThemeFamily family) => Theme.SetFamilyAsync(family))">
                    <ItemTemplate Context="option">
                        <span class="swatch @(option.Value == Theme.Family ? "swatch--on" : null)"
                              data-theme="@DeskThemeFamilies.Attribute(option.Value, Theme.IsDark)">
                            <span class="swatch__panel" aria-hidden="true">
                                <span class="swatch__ink"></span>
                                <span class="swatch__ink swatch__ink--secondary"></span>
                                <span class="swatch__marks">
                                    <span class="swatch__pill"></span>
                                    <span class="swatch__dot swatch__dot--positive"></span>
                                    <span class="swatch__dot swatch__dot--warning"></span>
                                    <span class="swatch__dot swatch__dot--negative"></span>
                                </span>
                            </span>
                            <span class="swatch__name">@option.Label</span>
                        </span>
                    </ItemTemplate>
                </DeskRadioGroup>
            </div>

            @* The accent, beneath the family because it refines one of them: only the Standard
               desk takes a chosen accent, the others keep the one they were designed around. So
               the row is here only while Standard is showing — the desk never shows a control
               that cannot act, and a row of hues that changed nothing on a Nord desk would be
               exactly that. ShowingFamily rather than Family: under Increase Contrast an
               unchosen family shows as High contrast, and that desk has no accent to choose. *@
            @if (Theme.ShowingFamily == DeskThemeFamily.Standard)
            {
                <div class="wgroup__row wgroup__row--form">
                    <span class="wgroup__label">Accent</span>
                    <DeskAccentPicker Value="Theme.Accent" IsDark="Theme.IsDark"
                                      ValueChanged="@((DeskAccent accent) => Theme.SetAccentAsync(accent))" />
                </div>
            }
        </div>
        @* Naming the resolved theme is the point of the first sentence. "System" alone does not
           tell an operator which desk they are about to get, and it is the one position where the
           answer is not written on the control. *@
        <p class="wgroup__foot">
            Kept in this browser. System follows your machine and keeps following it — right now
            that is @(Theme.IsDark ? "dark" : "light"). Every theme has a dark and a light desk, and
            the mode decides which one shows.
        </p>
    </section>

    @*
        Scale sits with appearance because it is the other half of "how the desk looks", and like
        everything on this panel it has no preview: the desk behind the window is the preview, and
        this window grows with it. The values are the manager's settings, so they are kept with the
        layout — per browser, restored on reload — rather than beside the theme.
    *@
    <section class="wsection" aria-labelledby="wm-scale-h">
        <h3 class="wgroup__head" id="wm-scale-h">Scale</h3>
        <div class="wgroup">
            <div class="wgroup__row wgroup__row--form">
                <span class="wgroup__label">Interface</span>
                <DeskSwitch Options="_uiScales" Label="Interface scale" Mono="true"
                            Value="S.UiScale" ValueChanged="@((double scale) => SetUiScale(scale))" />
            </div>
            <div class="wgroup__row wgroup__row--form">
                <span class="wgroup__label">Text</span>
                <DeskSwitch Options="_textScales" Label="Text size" Mono="true"
                            Value="S.TextScale" ValueChanged="@((double scale) => SetTextScale(scale))" />
            </div>
            @* A key inside a sentence reads as a link drawn the wrong shape. It is a row of the group
               it resets, in the control column, under the switches it puts back. *@
            @if (S.UiScale != 1 || S.TextScale != 1)
            {
                <div class="wgroup__row wgroup__row--form">
                    <span class="wgroup__label" aria-hidden="true"></span>
                    <DeskButton Class="wm-key" OnClick="ResetScale">Reset to 100%</DeskButton>
                </div>
            }
        </div>
        <p class="wgroup__foot">
            Interface scales everything — type, spacing, controls — so fewer windows fit a row
            @(S.UiScale > 1 ? $"(this desk now fits {Manager.RecommendedCapacity})" : "at larger sizes").
            Text grows only the words and leaves the layout where it is.
        </p>
    </section>

    @* The limit, and the two readings that say whether it suits this desk: how many are open
       against it, and how many fit at a readable width. They were tiles above everything; they
       are value rows beside the setting they qualify. *@
    <section class="wsection" aria-labelledby="wm-windows-h">
        <h3 class="wgroup__head" id="wm-windows-h">Windows</h3>
        <div class="wgroup">
            @* A count is a value, so it is a field — typed when the jump is large — with the
               stepper beside it for the nudge of one (HIG: a stepper always sits beside a field
               showing the value). *@
            <div class="wgroup__row wgroup__row--form">
                <span class="wgroup__label">Open at once</span>
                <div class="row">
                    <DeskField TValue="int?" Mono="true" Class="field--count" type="number"
                               min="@MinWindows" max="@MaxWindows" aria-label="Concurrent windows"
                               Value="S.MaxConcurrentWindows" ValueChanged="@((int? n) => SetMax(n))" />
                    @* One capsule of two halves, not two loose keys; it disables the half that
                       would cross a bound. *@
                    <DeskStepper Label="Concurrent windows" Min="MinWindows" Max="MaxWindows"
                                 Value="S.MaxConcurrentWindows" ValueChanged="@((int n) => SetMax(n))" />
                    <DeskButton OnClick="MatchRecommended">
                        Match this desk (@Manager.RecommendedCapacity)
                    </DeskButton>
                </div>
            </div>
            <div class="wgroup__row wgroup__row--form">
                <span class="wgroup__label">Open now</span>
                <span class="wm-value">@Manager.OpenCount of @S.MaxConcurrentWindows</span>
            </div>
            @* The one reading that can be wrong for the operator, so it carries the warning ink —
               and the note under the group says why in words, so the colour is never alone. *@
            <div class="wgroup__row wgroup__row--form">
                <span class="wgroup__label">Fits readably</span>
                <span class="wm-value">
                    <span class="@(Crowded ? "wm-value--warn" : null)">@Manager.RecommendedCapacity</span>
                    <span class="meta">at this size and layout</span>
                </span>
            </div>
        </div>
        @if (Crowded)
        {
            <Note State="DeskState.Warning">
                Your limit is above what this desk fits at a readable width. Columns hold at
                @DeskSettings.MinColumnWidth px and the row scrolls rather than squeezing further.
            </Note>
        }
        <p class="wgroup__foot">
            Opening past the limit closes the least recently used window — named in the footer when
            it happens, and in the launcher before it does. Windows tile as one row, each its own
            tab: drag a title bar past a neighbour to reorder them, or the divider between two to
            resize them.
        </p>
    </section>

    <section class="wsection" aria-labelledby="wm-primary-h">
        <h3 class="wgroup__head" id="wm-primary-h">Primary window</h3>
        <div class="wgroup">
            @* A pop-up sized to its longest title, not to the row: a picker as wide as the desk put
               its caret a screen away from the words it opens. *@
            <div class="wgroup__row wgroup__row--form">
                <span class="wgroup__label">Window</span>
                <DeskSelect TValue="string" aria-label="Primary window"
                            Value="@(S.PrimaryWindowKey ?? "")"
                            ValueChanged="OnPrimaryChanged">
                    <option value="">None — every window equal</option>
                    @* A destination cannot be opened on its own, so it cannot be the window that
                       opens on an empty desk either. *@
                    @foreach (var definition in Manager.Catalog.All.Where(d => !d.RequiresSubject))
                    {
                        <option value="@definition.Key">@definition.Title</option>
                    }
                </DeskSelect>
            </div>

            @if (S.PrimaryWindowKey is not null)
            {
                @* A share is a value along a range, so it is the desk's slider: the row moves as the
                   thumb does, and the reader hears the percentage the readout shows. *@
                <div class="wgroup__row wgroup__row--form">
                    <span class="wgroup__label">Share</span>
                    <DeskSlider Label="The primary window's share of the row" Min="20" Max="80" Step="5"
                                Value="@Math.Round(S.PrimaryShare * 100)"
                                ValueChanged="OnShareChanged"
                                Format="@(v => $"{v:0}%")" />
                </div>
                <div class="wgroup__row wgroup__row--form">
                    <span class="wgroup__label" aria-hidden="true"></span>
                    <DeskButton Class="wm-key" OnClick="@(_ => Manager.ResetWidths())">Reset widths</DeskButton>
                </div>
            }
        </div>
        <p class="wgroup__foot">
            @if (S.PrimaryWindowKey is not null)
            {
                @:The primary window takes this share of the row wherever it sits — it does not force
                @:its position, so dragging it to reorder the row is never fought. It is also what
                @:opens on an empty desk. Dragging a divider overrides the share until you reset the widths.
            }
            else
            {
                @:A primary window takes a larger share of the row wherever it sits, and it is what
                @:opens on an empty desk.
            }
        </p>
    </section>

    @* The desk's size was a tile ("Desk, measured"); it is the footer of the setting that decides
       whether it is measured or declared. *@
    <section class="wsection" aria-labelledby="wm-resolution-h">
        <h3 class="wgroup__head" id="wm-resolution-h">Resolution</h3>
        <div class="wgroup">
            <div class="wgroup__row wgroup__row--form">
                <span class="wgroup__label">Size</span>
                <DeskSwitch Options="_modes" Label="Resolution mode"
                            Value="S.ResolutionMode" ValueChanged="@((ResolutionMode mode) => SetMode(mode))" />
            </div>

            @if (S.ResolutionMode == ResolutionMode.Fixed)
            {
                <div class="wgroup__row wgroup__row--form">
                    <span class="wgroup__label">Preset</span>
                    @* A custom size typed below matches no preset, and then the gate's cap simply
                       is not there — no position pretends to be the one you are on. *@
                    <DeskSwitch Options="_presets" Label="Preset size" Mono="true"
                                Value="(S.CustomWidth, S.CustomHeight)"
                                ValueChanged="@(((int W, int H) size) => ApplyPreset(size.W, size.H))" />
                </div>

                <div class="wgroup__row wgroup__row--form">
                    <span class="wgroup__label">Custom</span>
                    <div class="row">
                        @* int? rather than int so that clearing the box is "no number yet" rather
                           than a zero the clamp would turn into 640. *@
                        <DeskField TValue="int?" Mono="true" Class="wm-px" type="number" min="640" max="7680" step="10"
                                   aria-label="Width in pixels"
                                   Value="S.CustomWidth" ValueChanged="OnWidthChanged" />
                        <span class="dim" aria-hidden="true">×</span>
                        <DeskField TValue="int?" Mono="true" Class="wm-px" type="number" min="480" max="4320" step="10"
                                   aria-label="Height in pixels"
                                   Value="S.CustomHeight" ValueChanged="OnHeightChanged" />
                    </div>
                </div>
            }
        </div>
        <p class="wgroup__foot">
            @if (S.ResolutionMode == ResolutionMode.Fixed)
            {
                @:The desk lays out against @((int)Manager.DeskWidth)×@((int)Manager.DeskHeight) while your
                @:browser is @((int)Manager.ViewportWidth)×@((int)Manager.ViewportHeight). Use this to arrange
                @:a desk for the screen you will run it on, not the one you are configuring it from — the
                @:view scrolls if the declared size is larger.
            }
            else
            {
                @:The desk lays out against this browser's window, measured at
                @:@((int)Manager.DeskWidth)×@((int)Manager.DeskHeight).
            }
        </p>
    </section>

    @* The saved desks are rows of one list, each with its way out at the trailing edge, and the
       row that adds one comes last, as a grouped list ends with its "Add" row. *@
    <section class="wsection" aria-labelledby="wm-workspaces-h">
        <h3 class="wgroup__head" id="wm-workspaces-h">Workspaces</h3>
        <div class="wgroup">
            @foreach (var workspace in Manager.UserWorkspaces)
            {
                <div class="wgroup__row wm-workspace" @key="workspace.Name">
                    <span class="wm-workspace__text">
                        <span class="wm-workspace__name">@workspace.Name</span>
                        <span class="meta">@string.Join(", ", workspace.WindowKeys.Select(k => Manager.Catalog.Find(k)?.Title ?? k))</span>
                    </span>
                    <DeskButton Size="DeskKeySize.Small" Role="DeskRole.Destructive" Icon="@Icons.Material.Filled.Delete"
                                OnClick="@(_ => Manager.DeleteWorkspace(workspace.Name))">
                        Delete
                    </DeskButton>
                </div>
            }

            @* Saves what is open now, left to right, under a name; it then sits in the brand menu
               beside the built-in ones. Windows opened on a subject — one record, one person — are
               left out, since a workspace is a desk to start from, not one subject's. A Save that
               cannot be pressed says what it waits for. *@
            <div class="wgroup__row wgroup__row--form">
                <span class="wgroup__label">Save as</span>
                <div class="row wm-save">
                    <DeskField TValue="string" Immediate="true" Class="wm-save__name" placeholder="Name this desk"
                               aria-label="Workspace name" @bind-Value="_workspaceName" />
                    <DeskButton Emphasis="DeskEmphasis.Tinted" Icon="@Icons.Material.Filled.BookmarkAdd"
                                Disabled="@(SaveWaitsFor is not null)" Title="@SaveWaitsFor"
                                OnClick="SaveWorkspace">
                        Save
                    </DeskButton>
                </div>
            </div>
        </div>
        <p class="wgroup__foot">
            @if (Manager.UserWorkspaces.Count == 0)
            {
                @:None saved yet. The layout itself is kept for you anyway — a reload puts the row back
                @:as it was.
            }
            A workspace keeps the windows open now, left to right, and sits in the brand menu beside
            the built-in ones. Windows opened on a single subject are left out.
        </p>
    </section>

</div>

@code {
    // Not PanelBase: that is the application's, and carries its data plumbing — change signals,
    // loads and retries, the formatting of its own records. This window needs two things from it,
    // the cascaded window id that puts its count on its own pulse and a disposal hook, and holds
    // them itself so the Desk can ship it.
    [CascadingParameter(Name = "WindowId")]
    private string? WindowId { get; set; }

    /// <summary>Reports this window's state to its chrome. No-op when hosted outside a window.</summary>
    private void Report(PulseState state, string? status = null)
    {
        if (WindowId is not null)
            Manager.SetPulse(WindowId, state, status);
    }

    private DeskSettings S => Manager.Settings;

    /// <summary>The limit is set above what this desk fits at a readable width.</summary>
    private bool Crowded => S.MaxConcurrentWindows > Manager.RecommendedCapacity;

    private string? _workspaceName;

    /// <summary>Why Save cannot be pressed yet, or null when it can.</summary>
    private string? SaveWaitsFor =>
        string.IsNullOrWhiteSpace(_workspaceName) ? "Name the desk first."
        : !Manager.Windows.Any(w => w.Parameters.Count == 0) ? "Open a window that is not about a single subject first."
        : null;

    private void SaveWorkspace()
    {
        if (Manager.SaveWorkspace(_workspaceName ?? string.Empty) is not null)
            _workspaceName = null;
    }

    // Dark first, because it is the desk the product is: the gate reads left-to-right as
    // "what it was, the alternative, let the machine decide".
    private static readonly IReadOnlyList<DeskSwitchOption<DeskThemeMode>> _themes =
    [
        new(DeskThemeMode.Dark, "Dark"),
        new(DeskThemeMode.Light, "Light"),
        new(DeskThemeMode.System, "System")
    ];

    // The families in the picker's order, each named as its tile names it.
    private static readonly IReadOnlyList<DeskRadioOption<DeskThemeFamily>> _families =
        DeskThemeFamilies.All
            .Select(family => new DeskRadioOption<DeskThemeFamily>(family, DeskThemeFamilies.Name(family), DeskThemeFamilies.Name(family)))
            .ToList();

    // Interface starts at 90%, not 80%: a laptop running a four-window desk is the case for
    // shrinking, but at 80% the desk's captions fall under 10px, below the type floor, and a
    // caption nobody can read saves no room. Text starts at 90% for the same reason — the
    // footnote is already 11px and going smaller only makes it unreadable.
    private static readonly IReadOnlyList<DeskSwitchOption<double>> _uiScales =
    [
        new(0.9, "90%"),
        new(1.0, "100%"),
        new(1.25, "125%"),
        new(1.5, "150%")
    ];

    private static readonly IReadOnlyList<DeskSwitchOption<double>> _textScales =
    [
        new(0.9, "90%"),
        new(1.0, "100%"),
        new(1.1, "110%"),
        new(1.25, "125%"),
        new(1.4, "140%")
    ];

    private static readonly IReadOnlyList<DeskSwitchOption<ResolutionMode>> _modes =
    [
        new(ResolutionMode.Auto, "Follow browser"),
        new(ResolutionMode.Fixed, "Declare a size")
    ];

    private static readonly IReadOnlyList<DeskSwitchOption<(int W, int H)>> _presets =
    [
        new((1280, 720), "1280×720"),
        new((1920, 1080), "1920×1080"),
        new((2560, 1440), "2560×1440"),
        new((3440, 1440), "3440×1440")
    ];

    protected override void OnInitialized()
    {
        Report(PulseState.Idle, $"{Manager.OpenCount}/{S.MaxConcurrentWindows}");

        // The machine's own preference can move while this panel is open, and under
        // System that changes both the cap's position and the sentence beneath it.
        // Neither is a parameter, so nothing else would ask this panel to look again.
        Theme.Changed += OnThemeChanged;

        // The desk's measured size moves under this panel too, and a scale change is the case
        // that makes it visible: the click re-renders the panel at once, but the browser only
        // reports the desk's new layout width after the zoom has landed — so "Desk" and "Fits
        // readably" would describe the desk as it was until the next click. The manager says
        // when it has relaid out; this panel is the one that reports on it.
        Manager.Changed += OnManagerChanged;
    }

    private Task OnThemeChanged() => InvokeAsync(StateHasChanged);

    private void OnManagerChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Theme.Changed -= OnThemeChanged;
        Manager.Changed -= OnManagerChanged;
    }

    // The bounds the field, the stepper and a typed value all keep to.
    private const int MinWindows = 1;
    private const int MaxWindows = 12;

    /// <summary>
    /// A typed count, held to the same bounds. A cleared field is not a request for zero
    /// windows, so it changes nothing.
    /// </summary>
    private void SetMax(int? count)
    {
        if (count is { } n)
            Manager.UpdateSettings(s => s.MaxConcurrentWindows = Math.Clamp(n, MinWindows, MaxWindows));
    }

    private void MatchRecommended()
    {
        var target = Manager.RecommendedCapacity;
        Manager.UpdateSettings(s => s.MaxConcurrentWindows = target);
    }

    private void OnPrimaryChanged(string key)
        => Manager.UpdateSettings(s => s.PrimaryWindowKey = string.IsNullOrEmpty(key) ? null : key);

    private void OnShareChanged(double percent)
        => Manager.UpdateSettings(s => s.PrimaryShare = percent / 100d);

    private void SetUiScale(double scale) => Manager.UpdateSettings(s =>
        s.UiScale = DeskSettings.ClampScale(scale, DeskSettings.MinUiScale, DeskSettings.MaxUiScale));

    private void SetTextScale(double scale) => Manager.UpdateSettings(s =>
        s.TextScale = DeskSettings.ClampScale(scale, DeskSettings.MinTextScale, DeskSettings.MaxTextScale));

    private void ResetScale() => Manager.UpdateSettings(s =>
    {
        s.UiScale = 1;
        s.TextScale = 1;
    });

    private void SetMode(ResolutionMode mode)
        => Manager.UpdateSettings(s => s.ResolutionMode = mode);

    private void ApplyPreset(int width, int height) => Manager.UpdateSettings(s =>
    {
        s.CustomWidth = width;
        s.CustomHeight = height;
    });

    private void OnWidthChanged(int? value)
    {
        if (value is { } width)
            Manager.UpdateSettings(s => s.CustomWidth = Math.Clamp(width, 640, 7680));
    }

    private void OnHeightChanged(int? value)
    {
        if (value is { } height)
            Manager.UpdateSettings(s => s.CustomHeight = Math.Clamp(height, 480, 4320));
    }
}

<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    The desk, on its own: the window manager, the strip, the primitives, the theme and the
    stylesheet. Nothing in here knows what an order, a customer or a price is. An application
    supplies a window catalogue and a brand, and gets the desk described in ADRs 0007, 0013
    and 0016 — which is what lets a second product start from the same chrome.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LineOps.Desk</RootNamespace>
  </PropertyGroup>

  <!--
    The package. The assembly, the namespace and the _content/LineOps.Desk path keep their
    names, so a consumer's links and imports are the same whether it references the project or
    the package. The XML documentation ships with it; CS1591 is off because the documentation
    is written where a seam needs explaining, not on every public member.
  -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>LineOps.Desk</PackageId>
    <Version>0.2.0</Version>
    <Description>An Apple-HIG desk for Blazor Server on MudBlazor: windows, primitives, themes and a chosen accent.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="MudBlazor" />
  </ItemGroup>

</Project>

@using LineOps.Web.Windowing
@implements IDisposable
@inject WindowManager Manager

@*
    The toolbar: everything that is open, and everything you could open, in one strip.

    Each window appears exactly once, and which half of the strip it sits in says what
    it is:

      · Open      — a tab, on the left, carrying its column's name, its pulse and a
                    close. In the desk's own left-to-right order, so the strip is a map
                    of the row rather than a second arrangement to hold in your head.
      · Not open  — a quiet key, after the hairline, in catalogue order and grouped the
                    way the catalogue groups things.

    The previous arrangement kept every catalogue entry in one run and let an open one
    grow a name in place. That was one item per window on paper, but on screen a 190px
    named tab sat wedged between 26px launcher icons with nothing but width to tell them
    apart — so the bar read as two interleaved lists, and the one thing you could not do
    was tell a launcher from a tab. Sorting them into two runs costs one short move when
    a window opens and buys the distinction outright.

    Destinations — a game, a team, a player — have no key at all, because they are about
    a subject and cannot be opened cold. They exist only as tabs, which is also what
    keeps them out of the resting strip's width.

    Two separate signals, because they answer two questions:

      · Which one am I in?   The current tab is washed in the accent, and stays that way
                             no matter where the pointer goes.
      · Which one am I on?   The marble, which follows the pointer and settles back on
                             the current tab when it leaves.

    The marble alone could not do both: it travels on hover, so the moment you reached
    for anything else the answer to the first question left with it.
*@

<div class="bar__strip"
     role="toolbar"
     aria-label="Windows"
     @onkeydown="OnKeyDown">

    @{
        var open = OpenItems;
        var closed = ClosedGroups;

        // Both lists are walked once here and the slot numbers come out of that single
        // pass. Asking a property per item instead would rebuild the whole strip on every
        // button it drew.
        var total = open.Count + closed.Sum(g => g.Count);

        if (_refs.Length != total)
            _refs = new ElementReference[total];

        var currentSlot = open.FindIndex(i => i.IsCurrent);

        if (currentSlot < 0)
            currentSlot = 0;

        var slot = 0;
    }

    @* The desk, as tabs. Carries the marble: this is the run that has a "current". *@
    <div class="bar__open" data-glide="marble" role="group" aria-label="Open windows">
        @foreach (var item in open)
        {
            var index = slot++;
            var window = item.Open!;
            var current = item.IsCurrent;

            @* The wrapper is the tab to the eye and to the marble; the two buttons
               inside are the two things you can do to it. *@
            <div class="tab @(current ? "tab--current" : null) @(window.Minimised ? "tab--collapsed" : null)"
                 data-glide-item
                 data-glide-rest="@(current ? "" : null)">

                <button class="tab__go"
                        type="button"
                        aria-current="@(current ? "true" : null)"
                        tabindex="@(index == currentSlot ? "0" : "-1")"
                        title="@Tip(item)"
                        aria-label="@Label(item)"
                        @ref="_refs[index]"
                        @onclick="() => Press(item)">
                    <Glyph Icon="@item.Icon" />
                    <span class="tab__name">@item.Title</span>
                    <span class="bar__pulse @PulseClass(window.Pulse)" aria-hidden="true"></span>
                </button>

                @* Out of the tab order on purpose: the strip is a roving toolbar with
                   one tab stop, so a second focusable per window would make Tab walk
                   the desk twice. Delete on the tab itself is the keyboard route. *@
                <button class="tab__close"
                        type="button"
                        tabindex="-1"
                        title="Close @item.Title"
                        aria-label="Close @item.Title"
                        @onclick="() => Manager.Close(window.Id)">
                    <Glyph Icon="@Icons.Material.Filled.Close" />
                </button>
            </div>
        }
    </div>

    @if (open.Count > 0 && closed.Count > 0)
    {
        <span class="bar__split" aria-hidden="true"></span>
    }

    @* Everything not on the desk. No marble: nothing here is current — the plain
       plate follows the pointer and leaves with it. *@
    <div class="bar__closed" data-glide role="group" aria-label="Open a window">
        @for (var g = 0; g < closed.Count; g++)
        {
            @if (g > 0)
            {
                <span class="bar__split bar__split--quiet" aria-hidden="true"></span>
            }

            @foreach (var item in closed[g])
            {
                var index = slot++;

                <button class="bar__key"
                        type="button"
                        tabindex="@(index == currentSlot ? "0" : "-1")"
                        title="@Tip(item)"
                        aria-label="@Label(item)"
                        @ref="_refs[index]"
                        @onclick="() => Press(item)">
                    <Glyph Icon="@item.Icon" />
                </button>
            }
        }
    </div>
</div>

@code {
    private ElementReference[] _refs = [];

    /// <summary>One place in the bar: a window that is open, or one that could be.</summary>
    private sealed record Item(
        string Icon,
        string Title,
        WindowDefinition? Definition,
        WindowInstance? Open,
        bool IsCurrent);

    protected override void OnInitialized() => Manager.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Manager.Changed -= OnChanged;

    /// <summary>
    /// Every open window, in the order its column sits in the row. Sequence breaks ties so
    /// two windows that have not been laid out yet still have a stable order rather than
    /// swapping places on an unrelated re-render.
    /// </summary>
    private List<Item> OpenItems => Manager.Windows
        .OrderBy(w => w.X)
        .ThenBy(w => w.Sequence)
        .Select(w => new Item(
            w.Definition.Icon,
            w.Title,
            w.Definition,
            w,
            w.Id == Manager.FocusedId))
        .ToList();

    /// <summary>
    /// The catalogue minus what is already open, in catalogue order and grouped the way the
    /// catalogue groups it. A definition with an open window is left out because that window
    /// is already in the strip as a tab — which is the whole "exactly once" rule.
    ///
    /// That also holds the line for the non-singleton entries: pressing a key has always
    /// focused an existing window rather than making a second one, so a key that would now
    /// do nothing new is a key with nothing to say.
    /// </summary>
    private List<List<Item>> ClosedGroups => WindowCatalog.All
        .Where(d => !d.RequiresSubject)
        .Where(d => Manager.Windows.All(w => w.Definition.Key != d.Key))
        .GroupBy(d => d.Group)
        .Select(g => g.Select(d => new Item(d.Icon, d.Title, d, null, false)).ToList())
        .Where(g => g.Count > 0)
        .ToList();

    /// <summary>
    /// The strip in the order it is drawn: open tabs, then the closed keys. Only the
    /// keyboard needs this — the render builds the same order inline and keeps the slot
    /// numbers from that one pass.
    /// </summary>
    private List<Item> Flat
    {
        get
        {
            var flat = OpenItems;
            flat.AddRange(ClosedGroups.SelectMany(g => g));
            return flat;
        }
    }

    private static string PulseClass(PulseState pulse) => pulse switch
    {
        PulseState.Healthy => "pulse--healthy",
        PulseState.Warn => "pulse--warn",
        PulseState.Critical => "pulse--critical",
        PulseState.Active => "pulse--active",
        _ => "pulse--idle"
    };

    private static string Label(Item item)
        => item.Open is null
            ? $"Open {item.Title}"
            : item.Open.Minimised
                ? $"Restore {item.Title}"
                : $"Focus {item.Title}";

    /// <summary>An icon has to carry its name somewhere, and a closed one carries it here.</summary>
    private static string Tip(Item item)
    {
        if (item.Open is null)
            return $"{item.Title} — {item.Definition?.Description}";

        var state = item.Open.Minimised ? " — collapsed, press to restore" : null;

        return string.IsNullOrEmpty(item.Open.StatusText)
            ? $"{item.Title}{state}"
            : $"{item.Title} · {item.Open.StatusText}{state}";
    }

    /// <summary>Open it, or go to it. Focus restores a collapsed column on the way.</summary>
    private void Press(Item item)
    {
        if (item.Open is not null)
            Manager.Focus(item.Open.Id);
        else if (item.Definition is not null)
            Manager.Open(item.Definition);
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        var flat = Flat;
        var last = flat.Count - 1;

        if (last < 0)
            return;

        var current = flat.FindIndex(i => i.IsCurrent);

        if (current < 0)
            current = 0;

        // Closing from the keyboard. The × is out of the tab order, so this is the route,
        // and it only ever acts on a tab — there is nothing to close about a closed key.
        if (e.Key is "Delete" or "Backspace")
        {
            if (flat[current].Open is { } window)
                Manager.Close(window.Id);

            return;
        }

        var next = e.Key switch
        {
            "ArrowRight" or "ArrowDown" => current == last ? 0 : current + 1,
            "ArrowLeft" or "ArrowUp" => current == 0 ? last : current - 1,
            "Home" => 0,
            "End" => last,
            _ => current
        };

        if (next == current)
            return;

        // Arrows walk the bar without opening anything: pressing is what opens. Moving
        // focus to a closed window would otherwise open a window per keystroke.
        if (next < _refs.Length)
            await _refs[next].FocusAsync();
    }
}

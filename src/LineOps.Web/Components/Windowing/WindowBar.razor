@using LineOps.Web.Windowing
@implements IDisposable
@inject WindowManager Manager

@*
    The toolbar: the whole catalogue, in one strip that does not move.

    Every openable window is drawn exactly once, always, in catalogue order and grouped the
    way the catalogue groups things — whether or not it is open. State is painted onto that
    fixed furniture rather than changing what the furniture is:

      · Closed   — a quiet key. Press it and the window opens.
      · Open     — the same key, lit, carrying its window's pulse so state travels up here.
      · Current  — washed in the accent, and staying that way wherever the pointer goes.
      · Collapsed — open but put away; said quietly, so it does not read as a column.

    Earlier arrangements appended open windows as tabs, which rearranged the strip on every
    open and close: the key you were reaching for slid sideways, and a subject window with a
    long name pushed the whole catalogue along with it. A toolbar whose contents move is a
    toolbar you have to re-read. Nothing is added here and nothing is removed, so every key
    keeps its place for the whole session.

    Subject windows — a game, a team, a player, a head-to-head — appear nowhere in the strip.
    They are about a subject rather than a destination, several can exist at once, and their
    names are long. They live where they already are, as columns on the desk.

    Two separate signals, because they answer two questions:

      · Which one am I in?   The current key's wash, which does not depend on the pointer.
      · Which one am I on?   The marble, which follows the pointer and settles back on the
                             current key when it leaves.

    The marble alone could not do both: it travels on hover, so the moment you reached for
    anything else the answer to the first question left with it.
*@

<div class="bar__strip"
     role="toolbar"
     aria-label="Windows">

    @{
        var groups = CatalogueGroups;

        // Walked once here so the slot numbers come out of the same pass that draws them.
        var total = groups.Sum(g => g.Count);

        if (_refs.Length != total)
            _refs = new ElementReference[total];

        var currentSlot = groups.SelectMany(g => g).ToList().FindIndex(i => i.IsCurrent);

        if (currentSlot < 0)
            currentSlot = 0;

        var slot = 0;
    }

    @* One run, in catalogue order, that does not move.

       Windows used to be appended as tabs on the left, which meant the strip rearranged
       itself every time something opened: the key you were aiming at slid sideways, and a
       subject window with a long name pushed the whole catalogue along with it. A toolbar
       whose contents move is a toolbar you have to re-read.

       So the catalogue is fixed furniture and state is drawn onto it. Current is washed in
       the accent; open-but-not-current carries a dot and its window's pulse. Nothing is
       added and nothing is removed, so every key keeps its place for the whole session. *@
    <div class="bar__run" data-glide="marble" role="group" aria-label="Windows">
        @for (var g = 0; g < groups.Count; g++)
        {
            @if (g > 0)
            {
                <span class="bar__split bar__split--quiet" aria-hidden="true"></span>
            }

            @* The catalogue already groups these; naming the group turns a hairline into an
               answer. Hidden from assistive tech because each key states its own group in
               its accessible name — read aloud it would be said twice per key. *@
            <span class="bar__group-name" aria-hidden="true">@groups[g][0].Definition!.Group</span>

            @foreach (var item in groups[g])
            {
                var index = slot++;
                var open = item.Open;

                <button class="bar__key @(item.IsCurrent ? "bar__key--current" : null) @(open is not null ? "bar__key--open" : null) @(open?.Minimised == true ? "bar__key--collapsed" : null)"
                        type="button"
                        aria-current="@(item.IsCurrent ? "true" : null)"
                        tabindex="@(index == currentSlot ? "0" : "-1")"
                        title="@Tip(item)"
                        aria-label="@Label(item)"
                        data-glide-rest="@(item.IsCurrent ? "" : null)"
                        @ref="_refs[index]"
                        @onkeydown="e => OnKeyDown(e, index)"
                        @onclick="() => Press(item)">
                    <Glyph Icon="@item.Icon" />
                    <span class="bar__key-name">@item.Title</span>

                    @if (open is not null)
                    {
                        <span class="bar__pulse @PulseClass(open.Pulse)" aria-hidden="true"></span>
                    }
                </button>
            }
        }
    </div>
</div>

@code {
    private ElementReference[] _refs = [];

    /// <summary>One place in the bar: a window that is open, or one that could be.</summary>
    private sealed record Item(
        string Icon,
        string Title,
        WindowDefinition? Definition,
        WindowInstance? Open,
        bool IsCurrent);

    protected override void OnInitialized() => Manager.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Manager.Changed -= OnChanged;

    /// <summary>
    /// The catalogue, always, grouped the way the catalogue groups it — with whichever
    /// window is open attached to its own entry.
    ///
    /// <para>
    /// Every entry is present whether or not it is open, because the strip's job is to be in
    /// the same place every time you look at it. An entry that disappeared when its window
    /// opened, or a tab that appeared beside it, would move every key to its right.
    /// </para>
    ///
    /// <para>
    /// Subject windows — a game, a team, a player, a head-to-head — have no catalogue entry
    /// and deliberately get none here. They are about a subject rather than a destination,
    /// there can be several at once, and their names are long: appending them is exactly what
    /// made the strip unreadable. They are reachable where they already are, as columns on
    /// the desk, and a collapsed one still leaves its own stub to press.
    /// </para>
    /// </summary>
    private List<List<Item>> CatalogueGroups => WindowCatalog.All
        .Where(d => !d.RequiresSubject)
        .GroupBy(d => d.Group)
        .Select(g => g.Select(d =>
        {
            var open = Manager.Windows.FirstOrDefault(w => w.Definition.Key == d.Key);

            return new Item(d.Icon, d.Title, d, open, open is not null && open.Id == Manager.FocusedId);
        }).ToList())
        .Where(g => g.Count > 0)
        .ToList();

    /// <summary>
    /// The strip in the order it is drawn. Only the keyboard needs this — the render builds
    /// the same order inline and keeps the slot numbers from that one pass.
    /// </summary>
    private List<Item> Flat => CatalogueGroups.SelectMany(g => g).ToList();

    private static string PulseClass(PulseState pulse) => pulse switch
    {
        PulseState.Healthy => "pulse--healthy",
        PulseState.Warn => "pulse--warn",
        PulseState.Critical => "pulse--critical",
        PulseState.Active => "pulse--active",
        _ => "pulse--idle"
    };

    private static string Label(Item item)
        => item.Open is null
            ? $"Open {item.Title}"
            : item.Open.Minimised
                ? $"Restore {item.Title}"
                : $"Focus {item.Title}";

    /// <summary>An icon has to carry its name somewhere, and a closed one carries it here.</summary>
    private static string Tip(Item item)
    {
        if (item.Open is null)
            return $"{item.Title} — {item.Definition?.Description}";

        var state = item.Open.Minimised ? " — collapsed, press to restore" : null;

        return string.IsNullOrEmpty(item.Open.StatusText)
            ? $"{item.Title}{state}"
            : $"{item.Title} · {item.Open.StatusText}{state}";
    }

    /// <summary>Open it, or go to it. Focus restores a collapsed column on the way.</summary>
    private void Press(Item item)
    {
        if (item.Open is not null)
            Manager.Focus(item.Open.Id);
        else if (item.Definition is not null)
            Manager.Open(item.Definition);
    }

    private async Task OnKeyDown(KeyboardEventArgs e, int pressedOn)
    {
        var flat = Flat;
        var last = flat.Count - 1;

        if (last < 0)
            return;

        // The key the keystroke landed on. Each key handles its own keydown and says which it
        // is, so this never has to be inferred from focus events — which a hidden document
        // does not dispatch — or from the current window, which is where focus may not be.
        var current = Math.Clamp(pressedOn, 0, last);

        // Closing from the keyboard: acts on the key that has focus, and only if it has a
        // window — there is nothing to close about a closed key.
        if (e.Key is "Delete" or "Backspace")
        {
            if (flat[current].Open is { } window)
                Manager.Close(window.Id);

            return;
        }

        var next = e.Key switch
        {
            "ArrowRight" or "ArrowDown" => current == last ? 0 : current + 1,
            "ArrowLeft" or "ArrowUp" => current == 0 ? last : current - 1,
            "Home" => 0,
            "End" => last,
            _ => current
        };

        if (next == current)
            return;

        // Arrows walk the bar without opening anything: pressing is what opens. Moving
        // focus to a closed window would otherwise open a window per keystroke.
        if (next < _refs.Length)
            await _refs[next].FocusAsync();
    }
}

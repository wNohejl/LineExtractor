@using LineOps.Desk.Windowing
@using LineOps.Desk.Theming
@inherits PanelBase
@inject ThemeService Theme
@inject Microsoft.Extensions.Options.IOptions<LineOps.Web.Access.AccessOptions> AccessOptions
@inject NavigationManager Navigation

@*
    Desk configuration. Every control here changes the desk immediately — there is no Save,
    because the desk behind this window *is* the preview.
*@

@* Who is at this desk, on a desk that can be reached by more than one person (ADR 0018). A
   sign-in is a page load, not a window: the cookie it sets needs an HTTP response. *@
@if (AccessOptions.Value.Mode == LineOps.Web.Access.AccessMode.Gated)
{
    <PanelToolbar>
        <ChildContent>
            @if (Manager.Access.CanOperate)
            {
                <Tag State="DeskState.Positive">Operator</Tag>
                <span class="dim">Everything on this desk is yours to change.</span>
            }
            else
            {
                <Tag State="DeskState.Info">Visitor</Tag>
                <span class="dim">This desk reads everything and changes nothing.</span>
            }
        </ChildContent>
        <Actions>
            @if (Manager.Access.CanOperate)
            {
                <DeskButton Size="DeskKeySize.Small" Icon="@Icons.Material.Filled.Logout"
                            OnClick="@(() => Navigation.NavigateTo(LineOps.Web.Access.AccessEndpoints.SignOutPath, forceLoad: true))">
                    Sign out
                </DeskButton>
            }
            else
            {
                <DeskButton Size="DeskKeySize.Small" Icon="@Icons.Material.Filled.Login"
                            OnClick="@(() => Navigation.NavigateTo(LineOps.Web.Access.AccessEndpoints.SignInPath, forceLoad: true))">
                    Operator sign-in
                </DeskButton>
            }
        </Actions>
    </PanelToolbar>
}

@* Anatomy order (spec 2026-10-24): toolbar, note, metrics, sections. *@
@if (S.MaxConcurrentWindows > Manager.RecommendedCapacity)
{
    <Note State="DeskState.Warning">
        Your ceiling is above what this desk fits at a readable width. Columns hold at
        @DeskSettings.MinColumnWidth px and the row scrolls rather than squeezing further.
    </Note>
}

<Note>
    Windows always tile as one horizontal row — every window is its own tab. Drag a title
    bar past a neighbour to reorder them, or the divider between two to resize them.
</Note>

<MetricRow>
    <Metric Label="Windows open" Note="ceiling you set" State="DeskState.Info">
        @Manager.OpenCount/@S.MaxConcurrentWindows
    </Metric>
    <Metric Label="Desk" Note='@(S.ResolutionMode == ResolutionMode.Fixed ? "declared" : "measured")'>
        @((int)Manager.DeskWidth)×@((int)Manager.DeskHeight)
    </Metric>
    <Metric Label="Fits readably"
            Value="@Manager.RecommendedCapacity.ToString()"
            Note="at this size and layout"
            State="@(S.MaxConcurrentWindows > Manager.RecommendedCapacity ? DeskState.Warning : DeskState.Positive)" />
</MetricRow>

@*
    Appearance leads, because it is the only setting on this panel that changes the panel
    itself. The note above is truer here than anywhere: there is no preview, because the
    desk under this gate repaints as the cap slides.
*@
<PanelSection Title="Appearance">
<div class="row">
    <DeskSwitch Options="_themes" Label="Appearance"
                Value="Theme.Mode"
                ValueChanged="@((DeskThemeMode mode) => Theme.SetModeAsync(mode))" />
</div>
<p class="empty">
    @* Naming the resolved theme is the point of the sentence. "System" alone does not tell
       an operator which desk they are about to get, and it is the one position where the
       answer is not written on the control. *@
    Kept in this browser. System follows your machine and keeps following it — right now
    that is @(Theme.IsDark ? "dark" : "light").
</p>

@* The family, beneath the appearance rather than beside it, because it is the finer choice:
   every family has a dark and a light desk, so the appearance above still decides which one
   of the pair is showing. Each swatch is painted by its own family's token block in the
   appearance showing now — flip Light above and every swatch turns with the desk. *@
<div class="swatches" role="group" aria-label="Theme">
    @foreach (var family in DeskThemeFamilies.All)
    {
        var on = family == Theme.Family;

        <button type="button"
                class="swatch @(on ? "swatch--on" : null)"
                data-theme="@DeskThemeFamilies.Attribute(family, Theme.IsDark)"
                aria-pressed="@(on ? "true" : "false")"
                title="@DeskThemeFamilies.Name(family)"
                @onclick="@(() => Theme.SetFamilyAsync(family))">
            <span class="swatch__panel" aria-hidden="true">
                <span class="swatch__ink"></span>
                <span class="swatch__ink swatch__ink--secondary"></span>
                <span class="swatch__marks">
                    <span class="swatch__pill"></span>
                    <span class="swatch__dot swatch__dot--positive"></span>
                    <span class="swatch__dot swatch__dot--warning"></span>
                    <span class="swatch__dot swatch__dot--negative"></span>
                </span>
            </span>
            <span class="swatch__name">@DeskThemeFamilies.Name(family)</span>
        </button>
    }
</div>

@*
    Scale sits with appearance because it is the other half of "how the desk looks", and like
    everything on this panel it has no preview: the desk behind the window is the preview, and
    this window grows with it. The values are the manager's settings, so they are kept with the
    layout — per browser, restored on reload — rather than beside the theme.
*@
</PanelSection>

<PanelSection Title="Scale">
<div class="row">
    <span class="meta" style="min-width:70px">Interface</span>
    <DeskSwitch Options="_uiScales" Label="Interface scale" Mono="true"
                Value="S.UiScale" ValueChanged="@((double scale) => SetUiScale(scale))" />
</div>
<div class="row">
    <span class="meta" style="min-width:70px">Text</span>
    <DeskSwitch Options="_textScales" Label="Text size" Mono="true"
                Value="S.TextScale" ValueChanged="@((double scale) => SetTextScale(scale))" />
</div>
<p class="empty">
    Interface scales everything — type, spacing, controls — so fewer windows fit a row
    @(S.UiScale > 1 ? $"(this desk now fits {Manager.RecommendedCapacity})" : "at larger sizes").
    Text grows only the words and leaves the layout where it is.
    @if (S.UiScale != 1 || S.TextScale != 1)
    {
        <DeskButton Size="DeskKeySize.Small" OnClick="ResetScale">Reset to 100%</DeskButton>
    }
</p>

</PanelSection>

<PanelSection Title="Concurrent windows">
<div class="row">
    <DeskButton Title="One fewer window" aria-label="One fewer window"
                OnClick="() => AdjustMax(-1)" Disabled="@(S.MaxConcurrentWindows <= 1)">
        <Glyph Icon="@Icons.Material.Filled.Remove" />
    </DeskButton>
    <span class="num readout" style="min-width:2.5ch; text-align:center">@S.MaxConcurrentWindows</span>
    <DeskButton Title="One more window" aria-label="One more window"
                OnClick="() => AdjustMax(1)" Disabled="@(S.MaxConcurrentWindows >= 12)">
        <Glyph Icon="@Icons.Material.Filled.Add" />
    </DeskButton>
    <DeskButton OnClick="MatchRecommended">
        Match this desk (@Manager.RecommendedCapacity)
    </DeskButton>
</div>
<p class="empty">
    Opening past this closes the least recently used window — named in the footer when it
    happens, and in the launcher before it does.
</p>

</PanelSection>

<PanelSection Title="Primary window">
<div class="row">
    <DeskSelect TValue="string" style="min-width:200px"
                Value="@(S.PrimaryWindowKey ?? "")"
                ValueChanged="OnPrimaryChanged">
        <option value="">None — every window equal</option>
        @* A destination cannot be opened on its own, so it cannot be the window that opens
           on an empty desk either. *@
        @foreach (var definition in Manager.Catalog.All.Where(d => !d.RequiresSubject))
        {
            <option value="@definition.Key">@definition.Title</option>
        }
    </DeskSelect>
</div>

@if (S.PrimaryWindowKey is not null)
{
    <div class="row">
        <span class="meta" style="min-width:70px">Share</span>
        <input type="range" min="20" max="80" step="5"
               value="@((int)(S.PrimaryShare * 100))"
               @oninput="OnShareChanged"
               style="flex:1; max-width:240px; accent-color: var(--accent)" />
        <span class="num" style="min-width:4ch">@((int)(S.PrimaryShare * 100))%</span>
    </div>
    <p class="empty">
        The primary window takes this share of the row wherever it sits — it does not force
        its position, so dragging it to reorder the row is never fought. It is also what
        opens on an empty desk. Dragging a divider overrides the share until you
        <DeskButton Size="DeskKeySize.Small" OnClick="@(_ => Manager.ResetWidths())">
            reset widths
        </DeskButton>.
    </p>
}

</PanelSection>

<PanelSection Title="Resolution">
<div class="row">
    <DeskSwitch Options="_modes" Label="Resolution mode"
                Value="S.ResolutionMode" ValueChanged="@((ResolutionMode mode) => SetMode(mode))" />
</div>

@if (S.ResolutionMode == ResolutionMode.Fixed)
{
    <div class="row">
        @* A custom size typed below matches no preset, and then the gate's cap simply
           is not there — no position pretends to be the one you are on. *@
        <DeskSwitch Options="_presets" Label="Preset size" Mono="true"
                    Value="(S.CustomWidth, S.CustomHeight)"
                    ValueChanged="@(((int W, int H) size) => ApplyPreset(size.W, size.H))" />
    </div>

    <div class="row">
        <span class="meta" style="min-width:70px">Custom</span>
        @* int? rather than int so that clearing the box is "no number yet" rather than a
           zero the clamp would turn into 640. *@
        <DeskField TValue="int?" Mono="true" type="number" min="640" max="7680" step="10"
                   style="max-width:100px"
                   Value="S.CustomWidth" ValueChanged="OnWidthChanged" />
        <span class="dim">×</span>
        <DeskField TValue="int?" Mono="true" type="number" min="480" max="4320" step="10"
                   style="max-width:100px"
                   Value="S.CustomHeight" ValueChanged="OnHeightChanged" />
    </div>

    <Note>
        The desk lays out against @((int)Manager.DeskWidth)×@((int)Manager.DeskHeight) while your browser is
        @((int)Manager.ViewportWidth)×@((int)Manager.ViewportHeight). Use this to arrange a desk for the screen
        you will run it on, not the one you are configuring it from — the view scrolls if the
        declared size is larger.
    </Note>
}

</PanelSection>

<PanelSection Title="Workspaces">
<div class="row">
    @* Saves what is open now, left to right, under a name; it then sits in the brand menu beside
       the built-in ones. Windows opened on something — a game, a player — are left out, since a
       workspace is a desk to start from, not a particular game's. *@
    <DeskField TValue="string" Immediate="true" placeholder="Name this desk" style="flex:1; min-width:160px"
               @bind-Value="_workspaceName" />
    <DeskButton Emphasis="DeskEmphasis.Tinted" Icon="@Icons.Material.Filled.BookmarkAdd"
                Disabled="@(string.IsNullOrWhiteSpace(_workspaceName) || !Manager.Windows.Any(w => w.Parameters.Count == 0))"
                OnClick="SaveWorkspace">
        Save
    </DeskButton>
</div>

@if (Manager.UserWorkspaces.Count == 0)
{
    <p class="empty">
        None saved yet. The layout itself is kept for you anyway — a reload puts the row back as
        it was.
    </p>
}
else
{
    @foreach (var workspace in Manager.UserWorkspaces)
    {
        <div class="row">
            <span style="flex:1">@workspace.Name <span class="dim">· @string.Join(", ", workspace.WindowKeys.Select(k => Manager.Catalog.Find(k)?.Title ?? k))</span></span>
            <DeskButton Size="DeskKeySize.Small" Icon="@Icons.Material.Filled.Delete"
                        OnClick="@(_ => Manager.DeleteWorkspace(workspace.Name))">
                Delete
            </DeskButton>
        </div>
    }
}
</PanelSection>

@code {
    private DeskSettings S => Manager.Settings;

    private string? _workspaceName;

    private void SaveWorkspace()
    {
        if (Manager.SaveWorkspace(_workspaceName ?? string.Empty) is not null)
            _workspaceName = null;
    }

    // Dark first, because it is the desk the product is: the gate reads left-to-right as
    // "what it was, the alternative, let the machine decide".
    private static readonly IReadOnlyList<DeskSwitchOption<DeskThemeMode>> _themes =
    [
        new(DeskThemeMode.Dark, "Dark"),
        new(DeskThemeMode.Light, "Light"),
        new(DeskThemeMode.System, "System")
    ];

    // Five positions each, the gate's honest ceiling. Interface reaches down to 80% because a
    // laptop running a four-window desk is the case for shrinking; text starts at 90% because
    // the desk's footnote is already 11px and going smaller only makes it unreadable.
    private static readonly IReadOnlyList<DeskSwitchOption<double>> _uiScales =
    [
        new(0.8, "80%"),
        new(0.9, "90%"),
        new(1.0, "100%"),
        new(1.25, "125%"),
        new(1.5, "150%")
    ];

    private static readonly IReadOnlyList<DeskSwitchOption<double>> _textScales =
    [
        new(0.9, "90%"),
        new(1.0, "100%"),
        new(1.1, "110%"),
        new(1.25, "125%"),
        new(1.4, "140%")
    ];

    private static readonly IReadOnlyList<DeskSwitchOption<ResolutionMode>> _modes =
    [
        new(ResolutionMode.Auto, "Follow browser"),
        new(ResolutionMode.Fixed, "Declare a size")
    ];

    private static readonly IReadOnlyList<DeskSwitchOption<(int W, int H)>> _presets =
    [
        new((1280, 720), "1280×720"),
        new((1920, 1080), "1920×1080"),
        new((2560, 1440), "2560×1440"),
        new((3440, 1440), "3440×1440")
    ];

    protected override void OnInitialized()
    {
        Report(PulseState.Idle, $"{Manager.OpenCount}/{S.MaxConcurrentWindows}");

        // The machine's own preference can move while this panel is open, and under
        // System that changes both the cap's position and the sentence beneath it.
        // Neither is a parameter, so nothing else would ask this panel to look again.
        Theme.Changed += OnThemeChanged;

        // The desk's measured size moves under this panel too, and a scale change is the case
        // that makes it visible: the click re-renders the panel at once, but the browser only
        // reports the desk's new layout width after the zoom has landed — so "Desk" and "Fits
        // readably" would describe the desk as it was until the next click. The manager says
        // when it has relaid out; this panel is the one that reports on it.
        Manager.Changed += OnManagerChanged;
    }

    private Task OnThemeChanged() => InvokeAsync(StateHasChanged);

    private void OnManagerChanged() => InvokeAsync(StateHasChanged);

    protected override void OnDispose()
    {
        Theme.Changed -= OnThemeChanged;
        Manager.Changed -= OnManagerChanged;
    }

    private void AdjustMax(int delta) => Manager.UpdateSettings(s =>
        s.MaxConcurrentWindows = Math.Clamp(s.MaxConcurrentWindows + delta, 1, 12));

    private void MatchRecommended()
    {
        var target = Manager.RecommendedCapacity;
        Manager.UpdateSettings(s => s.MaxConcurrentWindows = target);
    }

    private void OnPrimaryChanged(string key)
        => Manager.UpdateSettings(s => s.PrimaryWindowKey = string.IsNullOrEmpty(key) ? null : key);

    private void OnShareChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var percent))
            Manager.UpdateSettings(s => s.PrimaryShare = percent / 100d);
    }

    private void SetUiScale(double scale) => Manager.UpdateSettings(s =>
        s.UiScale = DeskSettings.ClampScale(scale, DeskSettings.MinUiScale, DeskSettings.MaxUiScale));

    private void SetTextScale(double scale) => Manager.UpdateSettings(s =>
        s.TextScale = DeskSettings.ClampScale(scale, DeskSettings.MinTextScale, DeskSettings.MaxTextScale));

    private void ResetScale() => Manager.UpdateSettings(s =>
    {
        s.UiScale = 1;
        s.TextScale = 1;
    });

    private void SetMode(ResolutionMode mode)
        => Manager.UpdateSettings(s => s.ResolutionMode = mode);

    private void ApplyPreset(int width, int height) => Manager.UpdateSettings(s =>
    {
        s.CustomWidth = width;
        s.CustomHeight = height;
    });

    private void OnWidthChanged(int? value)
    {
        if (value is { } width)
            Manager.UpdateSettings(s => s.CustomWidth = Math.Clamp(width, 640, 7680));
    }

    private void OnHeightChanged(int? value)
    {
        if (value is { } height)
            Manager.UpdateSettings(s => s.CustomHeight = Math.Clamp(height, 480, 4320));
    }
}

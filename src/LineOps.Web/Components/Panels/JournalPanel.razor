    private void EditEntry(JournalEntry entry)
    {
        _message = null;
        _editing = entry;
        _entry = new Draft
        {
            GameId = entry.GameId,
            Game = entry.Game,
            Market = entry.FreeTextMarket is null ? entry.Market : FreeText,
            FreeTextMarket = entry.FreeTextMarket,
            Outcome = entry.Outcome == "—" ? string.Empty : entry.Outcome,
            // Without the column's scale, so the field reads "-3" as the book printed it and not
            // "-3.00". Decimal equality ignores scale, so this is not an unsaved change.
            LineTaken = entry.LineTaken is { } line ? line / 1.000000000000000000000000000000000m : null,
            PriceTaken = entry.PriceTaken,
            Stake = entry.Stake,
            Book = entry.Book,
            Note = entry.Note,
            OriginalPrice = entry.PriceTaken,
            OriginalLine = entry.LineTaken,
            WasManual = entry.ManualPrice
        };
        _opened = _entry.ToDraft();
        _parlay = null;
        _parlayOpened = null;
        _touched.Clear();
        _mode = FormMode.Entry;

        // Opened on another bet, the form holds nothing the journal lacks yet.
        MarkUnsaved(false);
    }

    /// <summary>The same grouped form, on a parlay: its money and book, and the price on each leg.</summary>
    private void EditParlay(Parlay parlay)
    {
        _message = null;
        _editing = null;
        _opened = null;
        _parlay = new ParlayEditDraft(parlay);
        _parlayOpened = _parlay.ToEdit();
        _touched.Clear();
        _mode = FormMode.EditParlay;
        MarkUnsaved(false);
    }

    private void CloseForm()
    {
        _mode = FormMode.None;
        _editing = null;
        _opened = null;
        _parlay = null;
        _parlayOpened = null;
        _touched.Clear();

        // Saved or cancelled, the form holds nothing the journal lacks.
        MarkUnsaved(false);
    }

    private Task SetParlayBookAsync(string book)
    {
        if (_parlay is { } edited)
            Edit("book", () => edited.Book = book);

        return Task.CompletedTask;
    }

    /// <summary>
    /// Saves the parlay form. A write that fails keeps the form open with what was typed, and
    /// says so: the operator's corrections are not thrown away with the error.
    /// </summary>
    private async Task SaveParlayChangesAsync()
    {
        if (_parlay is not { } edited || ParlayWaiting(edited) is not null)
            return;

        try
        {
            await WriteParlayAsync(edited.Parlay.Id, edited.ToEdit());
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "The parlay did not save");
            _message = "The parlay was not saved. Try again.";
            return;
        }

        _message = "Parlay saved.";
        CloseForm();
        await LoadAsync();
    }

    /// <summary>
    /// Puts a logged parlay back on the slip to log again: each leg at the price it was taken at,
    /// typed rather than fetched (<see cref="SlipItem.ManualPrice"/>), so a leg on a game that
    /// has started is a leg and not a closing line; then the parlay's stake, book and price. The
    /// slip is shown in its tab here, beside the journal it was copied from.
    ///
    /// <para>
    /// The slip holds one parlay, so wagers already on it are asked about before they are
    /// replaced: they are banked and unlogged, and a copy laid over them would mix the two.
    /// </para>
    /// </summary>
    private async Task DuplicateParlayAsync(Parlay parlay)
    {
        _message = null;

        // The slip holds bets on games the desk tracks, at a price. A leg that is a described
        // bet, on no tracked game, or logged without its price has no card to become.
        if (parlay.Legs.Any(l => l.Game is null || !string.IsNullOrWhiteSpace(l.FreeTextMarket) || l.PriceTaken == 0))
        {
            _message = "The slip holds bets on tracked games at a price, and a leg of this parlay is not one. Nothing was copied.";
            return;
        }

        if (Slip.Items.Count > 0)
        {
            var held = Slip.Items.Count == 1 ? "1 wager" : $"{Slip.Items.Count} wagers";
            var replace = await Alerts.ConfirmAsync(
                "Replace the slip?",
                confirmLabel: "Replace",
                message: $"The slip holds {held}. They leave it unlogged, and this parlay's {parlay.Legs.Count} legs take their place.",
                destructive: true);

            if (!replace)
                return;

            Slip.Clear();
        }

        foreach (var leg in parlay.Legs.OrderBy(l => l.Id))
        {
            var game = leg.Game!;
            Slip.AddLeg(new SlipItem(
                Guid.Empty,
                game.Id, Matchup(game), game.StartsAt, game.Sport?.Key ?? string.Empty,
                leg.Market, leg.Outcome, leg.LineTaken,
                parlay.Book, leg.PriceTaken, leg.PlacedAt, IsClosing: false,
                Stake: 0m, Note: null, Fair: null, Ev: null,
                ManualPrice: true));
        }

        Slip.SetMode(SlipMode.Parlay);
        Slip.SetParlay(parlay.Stake, parlay.PriceQuoted, parlay.Book);

        _tab = JournalTab.Slip;
        Toasts.Success($"Copied the {parlay.Legs.Count}-leg parlay to the slip");
    }

    private Task SetEntryBookAsync(string book)
    {
        Edit("book", () => _entry.Book = book);
        return Task.CompletedTask;
    }

    private async Task SaveEntryAsync()
    {
        await using var scope = ScopeFactory.CreateAsyncScope();
        await scope.ServiceProvider.GetRequiredService<JournalService>()
            .SaveEntryAsync(_entry.ToDraft(), _editing?.Id);

        _message = _editing is null ? "Entry logged." : "Entry saved.";
        CloseForm();
        await LoadAsync();
    }

    private async Task DeleteEntryAsync(JournalEntry entry)
    {
        var confirmed = await Alerts.ConfirmAsync(
            "Delete this entry?",
            message: $"{Describe(entry)} — {entry.Stake:C0} at {Price(entry.PriceTaken)}. It leaves the journal and every figure built on it.",
            confirmLabel: "Delete", destructive: true);

        if (!confirmed)
            return;

        await using var scope = ScopeFactory.CreateAsyncScope();
        await scope.ServiceProvider.GetRequiredService<JournalService>().DeleteEntryAsync(entry.Id);

        _message = "Entry deleted.";
        await LoadAsync();
    }

    private async Task DeleteParlayAsync(Parlay parlay)
    {
        var confirmed = await Alerts.ConfirmAsync(
            "Delete this parlay?",
            message: $"{parlay.Legs.Count} legs, {parlay.Stake:C0}. The parlay and all its legs leave the journal.",
            confirmLabel: "Delete", destructive: true);

        if (!confirmed)
            return;

        await using var scope = ScopeFactory.CreateAsyncScope();
        await scope.ServiceProvider.GetRequiredService<JournalService>().DeleteParlayAsync(parlay.Id);

        _message = "Parlay deleted.";
        await LoadAsync();
    }

    private async Task SetResultAsync(int entryId, EntryResult result)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var entry = await db.JournalEntries.FirstAsync(e => e.Id == entryId);

        PerformanceAnalytics.ApplyResult(entry, result);
        await db.SaveChangesAsync();
        await LoadAsync();
    }

    private async Task SetParlayResultAsync(Parlay parlay, EntryResult result)
    {
        var payout = result == EntryResult.Win && parlay.PriceQuoted is { } q
            ? OddsMath.PayoutOnWin(q, parlay.Stake)
            : (decimal?)null;

        await using var scope = ScopeFactory.CreateAsyncScope();
        await scope.ServiceProvider.GetRequiredService<JournalService>().SetParlayResultAsync(parlay.Id, result, payout);
        await LoadAsync();
    }

    private async Task SettleAsync()
    {
        _busy = true;
        Report(PulseState.Active, "settling");

        try
        {
            await using var scope = ScopeFactory.CreateAsyncScope();
            var summary = await scope.ServiceProvider
                .GetRequiredService<SettlementService>().SettleAsync();

            _message = $"{summary.Graded} graded · {summary.Voided} voided · {summary.ParlaysSettled} parlays · "
                       + $"{summary.ClvResolved} CLV resolved · {summary.LeftPending} pending";
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>Why a pending parlay whose legs are all in has not settled, if that is the case.</summary>
    private static string? Stuck(Parlay parlay)
        => parlay.Legs.All(l => l.Result != EntryResult.Pending)
            ? ParlayGrading.Grade(parlay, parlay.Legs).Reason
            : null;

    private RenderFragment LegFields(Draft d) => @<text>

@using LineOps.Data
@using LineOps.Ingestion.Services
@using LineOps.Desk.Windowing
@using Microsoft.EntityFrameworkCore
@inherits PanelBase
@inject IDbContextFactory<LineOpsDbContext> DbFactory
@inject IServiceScopeFactory ScopeFactory
@inject IDeskAlerts Alerts
@using LineOps.Web.Services
@using LineOps.Web.Windowing
@inject IWagerData Wagers
@inject WagerSlip Slip
@inject DeskToasts Toasts

@*
    The slip is a tab of the Journal, as it is of the wager window: the bets banked this session
    sit one click from the bets already logged, with the count on the tab, and no third window.
*@
<DeskTabs TValue="JournalTab" Tabs="Tabs" Label="Journal sections" Class="wtabs" Context="tab"
          Value="_tab" ValueChanged="@((JournalTab t) => _tab = t)">
@if (tab == JournalTab.Slip)
{
    <SlipPanel />
}
else
{
<PanelToolbar Message="@_message">
    <ChildContent>
        <DeskSwitch Options="Statuses" Label="Status" Size="DeskKeySize.Small"
                    Value="_status" ValueChanged="@((JournalStatus s) => FilterAsync(() => _status = s))" />
    </ChildContent>
    @* Period, sport and book are the narrower cuts; a narrow Journal folds them into More and
       keeps status and the keys on the row, then folds the keys before Log entry as well. *@
    <Overflow>
        <div class="ptoolbar__item">
            <span class="ptoolbar__label" aria-hidden="true">Placed within</span>
            <DeskSwitch Options="Periods" Label="Placed within" Size="DeskKeySize.Small"
                        Value="_days" ValueChanged="@((int d) => FilterAsync(() => _days = d))" />
        </div>
        @* Two leagues and "all" is a fixed set of three, so it is a segment beside the other two
           rather than a pop-up that hides the alternatives (HIG: segmented controls). *@
        <div class="ptoolbar__item">
            <span class="ptoolbar__label" aria-hidden="true">Sport</span>
            <DeskSwitch Options="SportOptions" Label="Sport" Size="DeskKeySize.Small"
                        Value="@(_sport ?? "")" ValueChanged="@((string s) => FilterAsync(() => _sport = s is { Length: > 0 } ? s : null))" />
        </div>
        <div class="ptoolbar__item">
            <span class="ptoolbar__label" aria-hidden="true">Book</span>
            <DeskSelect TValue="string" aria-label="Book"
                        Value="_bookFilter" ValueChanged="@((string? b) => FilterAsync(() => _bookFilter = b))">
                <option value="">All books</option>
                @foreach (var book in _books)
                {
                    <option value="@book">@BookNames.Display(book)</option>
                }
            </DeskSelect>
        </div>
    </Overflow>
    @* Secondary: the last thing to fold, into the top of More, when even the pickers there
       leave the row too wide. Log entry, the key this window is for, never leaves it. *@
    <SecondaryActions>
        @* Parlays are logged from the slip (spec §5.4), the tab beside this one. Build parlay
           fills it leg by leg, from the same wager window Log entry opens. *@
        <DeskButton Icon="@Icons.Material.Filled.Gavel" OnClick="SettleAsync" Busy="@_busy">
            Settle finished games
        </DeskButton>
        <DeskButton Icon="@Icons.Material.Filled.Link"
                    Title="Find each leg's game and add it to the slip as a parlay leg"
                    OnClick="BuildParlay">
            Build parlay
        </DeskButton>
    </SecondaryActions>
    <Actions>
        @* The same window the Board's Place wager opens, here on a game search: one form records
           a bet, whichever door it is reached by. Tinted, not Filled: it opens a window rather
           than committing anything here. *@
        <DeskButton Emphasis="DeskEmphasis.Tinted" Icon="@Icons.Material.Filled.Add"
                    Title="Find the game and log the bet in the wager window"
                    OnClick="OpenWager">
            Log entry
        </DeskButton>
    </Actions>
</PanelToolbar>

@if (_mode == FormMode.Entry)
{
    @* The form names the row it edits on the line under its title, so "Edit entry" is about
       something before the eye reaches the fields. *@
    <PanelForm Title="Edit entry" Class="pform--grouped">
    <Detail>@(_editing is { } editing ? $"Placed {Starts(editing.PlacedAt)}" : null)</Detail>
    <ChildContent>

        @if (_editing is { IsGraded: true })
        {
            <Note>
                This entry is graded. Changing the game, market, selection, line, price, stake or book
                sends it back to pending, and settlement grades it again from the game.
            </Note>
        }

        @* The wager window's grouped form, row for row (apple-hig-components, forms.md): the
           label leads in one column, the control trails, one inset rule between rows. A typed
           price is said in the group's footer, under the rows it qualifies, rather than in a
           box of its own above them. *@
        <section class="wsection" aria-label="Entry">
            <div class="wgroup jform">
                @LegFields(_entry)

                <div class="wgroup__row wgroup__row--form">
                    <span class="wgroup__label">Stake</span>
                    <StakeRow Stake="_entry.Stake" StakeChanged="@(s => Edit("stake", () => _entry.Stake = s))"
                              PriceAmerican="@(_entry.PriceTaken == 0 ? null : _entry.PriceTaken)"
                              Error="@(Touched("stake") ? StakeError(_entry.Stake) : null)" />
                </div>
                <div class="wgroup__row wgroup__row--form">
                    <span class="wgroup__label">Book</span>
                    @BookPicker(_entry.Book, SetEntryBookAsync)
                </div>
                <div class="wgroup__row wgroup__row--form">
                    <span class="wgroup__label">Note</span>
                    <DeskField TValue="string" Class="wfield--fill" aria-label="Note"
                               placeholder="Optional" Value="_entry.Note"
                               ValueChanged="@((string? n) => Edit("note", () => _entry.Note = n))" />
                </div>
            </div>
            @if (_entry.ManualPrice)
            {
                <p class="wgroup__foot journal-manual-note">You typed this price; the desk did not fetch it.</p>
            }
        </section>

    </ChildContent>
    <Footer>
        <DeskButton OnClick="CloseForm">Cancel</DeskButton>
        @* A disabled key that does not say what it is waiting for is a key the operator
           has to guess at — and a tooltip only tells the one who hovers. The reason is text
           beside the key, and the key points a screen reader at it. *@
        @if (!EntryValid(_entry, true))
        {
            <span class="meta" id="save-why">Needs a selection, a stake above zero, a price and a book.</span>
        }
        <DeskButton Emphasis="DeskEmphasis.Filled" OnClick="SaveEntryAsync" Disabled="@(!EntryValid(_entry, true))"
                    aria-describedby="@(EntryValid(_entry, true) ? null : "save-why")">
            Save changes
        </DeskButton>
    </Footer>
    </PanelForm>
}

@if (_mode == FormMode.EditParlay && _parlay is { } edited)
{
    @* The entry form's grouped rows, for the parlay's money: one bet, so one stake, one book and
       one price, and beneath them the legs it was built from. A leg's side is the bet itself and
       is not edited here — a different side is a different parlay, logged from the slip — but
       the price it was taken at is a number, and a mistyped one is corrected like any other. *@
    <PanelForm Title="Edit parlay" Class="pform--grouped">
    <Detail>@($"{edited.Parlay.Legs.Count} legs · placed {Starts(edited.Parlay.PlacedAt)}")</Detail>
    <ChildContent>

        @if (edited.Parlay.IsGraded)
        {
            <Note>
                This parlay is graded. Changing the stake, the book's price, a leg's price or the book
                sends it back to pending, and settlement grades it again from its legs.
            </Note>
        }

        <div class="wsections">
            <div class="wgroup jform">
                <div class="wgroup__row wgroup__row--form">
                    <span class="wgroup__label">Book</span>
                    @BookPicker(edited.Book, SetParlayBookAsync)
                </div>
                <div class="wgroup__row wgroup__row--form">
                    <span class="wgroup__label">Stake</span>
                    <StakeRow Stake="edited.Stake" StakeChanged="@(s => Edit("stake", () => edited.Stake = s))"
                              PriceAmerican="@CombinedPrice(edited)"
                              Error="@(Touched("stake") ? StakeError(edited.Stake) : null)" />
                </div>
                <div class="wgroup__row wgroup__row--form">
                    <span class="wgroup__label">Book's price</span>
                    @* The book's own price for the parlay, when it gave one: what a clean win pays.
                       Without it the legs' prices are multiplied, as the slip does. *@
                    <DeskField TValue="int?" Mono="true" Class="wfield--short" type="number"
                               aria-label="The book's price for the parlay" placeholder="Optional"
                               Value="edited.PriceQuoted"
                               ValueChanged="@((int? q) => Edit("quoted", () => edited.PriceQuoted = q))"
                               Error="@(Touched("quoted") && edited.PriceQuoted is { } quoted ? PriceError(quoted) : null)" />
                </div>
                <div class="wgroup__row wgroup__row--form">
                    <span class="wgroup__label">Note</span>
                    <DeskField TValue="string" Class="wfield--fill" aria-label="Note"
                               placeholder="Optional" Value="edited.Note"
                               ValueChanged="@((string? n) => Edit("note", () => edited.Note = n))" />
                </div>
            </div>

            <section class="wsection" aria-labelledby="parlay-legs-h">
                <h4 class="wgroup__head" id="parlay-legs-h">Legs</h4>
                <div class="wgroup jform">
                    @foreach (var (leg, n) in edited.Parlay.Legs.OrderBy(l => l.Id).Select((l, i) => (l, i + 1)))
                    {
                        var field = $"leg-{leg.Id}";
                        <div class="wgroup__row wgroup__row--form" @key="leg.Id">
                            <span class="wgroup__label">Leg @n</span>
                            <DeskRow Justify="DeskJustify.Between">
                                <div>
                                    <div>@Describe(leg)</div>
                                    @if (leg.Game is not null)
                                    {
                                        <div class="meta">@MatchupWithDate(leg.Game)</div>
                                    }
                                </div>
                                <DeskField TValue="int?" Mono="true" Class="wfield--short" type="number"
                                           aria-label="@($"Price taken on {Describe(leg)}")" placeholder="-110"
                                           Value="@edited.LegPrices.GetValueOrDefault(leg.Id)"
                                           ValueChanged="@((int? p) => Edit(field, () => edited.LegPrices[leg.Id] = p))"
                                           Error="@(Touched(field) ? LegPriceError(edited.LegPrices.GetValueOrDefault(leg.Id), leg.PriceTaken) : null)" />
                            </DeskRow>
                        </div>
                    }
                </div>
                <p class="wgroup__foot">
                    The price each leg was taken at. Without the book's price, settlement multiplies
                    them, and after a push it reprices the parlay on the legs that are left.
                </p>
            </section>
        </div>

    </ChildContent>
    <Footer>
        <DeskButton OnClick="CloseForm">Cancel</DeskButton>
        @if (ParlayWaiting(edited) is { } why)
        {
            <span class="meta" id="parlay-save-why">@why</span>
        }
        <DeskButton Emphasis="DeskEmphasis.Filled" OnClick="SaveParlayChangesAsync" Disabled="@(ParlayWaiting(edited) is not null)"
                    aria-describedby="@(ParlayWaiting(edited) is null ? null : "parlay-save-why")">
            Save changes
        </DeskButton>
    </Footer>
    </PanelForm>
}

@if (Failed)
{
    <LoadFailure Message="@LoadError" OnRetry="RetryAsync" />
}

@if (!Loaded)
{
    @if (!Failed)
    {
        <DeskGrid T="JournalEntry" Items="_entries" Loading="true" LoadingLabel="Fetching the journal" />
    }
}
else if (_entries.Count == 0 && _parlays.Count == 0)
{
    <EmptyState Kind="@(Filtered ? EmptyStateKind.Filtered : EmptyStateKind.New)">
        @(Filtered
            ? "No entries match these filters."
            : "No entries logged yet. Log entry finds the game and records the bet; Build parlay adds legs to the slip, where the parlay is logged.")
    </EmptyState>
}

@if (_entries.Count > 0)
{
    <PanelSection Title="Entries">
    <DeskGrid T="JournalEntry" Items="_entries" EmptyText="No entries logged yet.">
        <PropertyColumn T="JournalEntry" TProperty="DateTimeOffset" Property="e => e.PlacedAt" Title="Placed"
                        InitialDirection="SortDirection.Descending">
            <CellTemplate><span class="dim">@Starts(context.Item.PlacedAt)</span></CellTemplate>
        </PropertyColumn>

        <PropertyColumn T="JournalEntry" TProperty="string" Property="e => e.Outcome" Title="Selection">
            <CellTemplate>
                @Selection(context.Item)
                @if (context.Item.Note is { } note)
                {
                    <div class="meta">@note</div>
                }
            </CellTemplate>
        </PropertyColumn>

        <PropertyColumn T="JournalEntry" TProperty="string" Property="e => e.Market" Title="Market" HeaderClass="col--wide" CellClass="col--wide">
            <CellTemplate><span class="dim">@SelectionText.MarketName(context.Item.Market)</span></CellTemplate>
        </PropertyColumn>

        <PropertyColumn T="JournalEntry" TProperty="string" Property="e => e.Book" Title="Book" HeaderClass="col--wide" CellClass="col--wide">
            <CellTemplate><span class="dim">@BookNames.Display(context.Item.Book)</span></CellTemplate>
        </PropertyColumn>

        <PropertyColumn T="JournalEntry" TProperty="int" Property="e => e.PriceTaken" Title="Price" Align="Align.Right">
            <CellTemplate>
                @* Said where the number is: a typed price is the operator's word, not an observation. *@
                @if (context.Item.ManualPrice)
                {
                    <span class="dim journal-manual" title="Entered by hand, not fetched">manual</span>
                }
                @Price(context.Item.PriceTaken)
            </CellTemplate>
        </PropertyColumn>

        <PropertyColumn T="JournalEntry" TProperty="decimal" Property="e => e.Stake" Title="Stake" Align="Align.Right">
            <CellTemplate>@context.Item.Stake.ToString("C0")</CellTemplate>
        </PropertyColumn>

        <PropertyColumn T="JournalEntry" TProperty="EntryResult" Property="e => e.Result" Title="Result">
            <CellTemplate><Tag State="@ResultState(context.Item.Result)">@context.Item.Result</Tag></CellTemplate>
        </PropertyColumn>

        <PropertyColumn T="JournalEntry" TProperty="decimal" Property="e => e.NetReturn" Title="Net" Align="Align.Right">
            <CellTemplate>
                <span class="@(context.Item.NetReturn > 0 ? "up" : context.Item.NetReturn < 0 ? "down" : null)">
                    @* Performance's signed money, so a loss reads "−$20" in both windows: "C0"
                       follows the machine's region, and on this one printed "($20)". *@
                    @(context.Item.IsSettled ? PerformancePanel.Signed(context.Item.NetReturn) : "—")
                </span>
            </CellTemplate>
        </PropertyColumn>

        @* Sorts on the reading itself, so "worst CLV" is a click; an unresolved entry sorts below
           every real one rather than as zero. A TemplateColumn because the key is computed. *@
        <TemplateColumn T="JournalEntry" Sortable="true" Title="CLV" HeaderClass="col--wider" CellClass="col--wider" Align="Align.Right"
                        SortBy="@(e => Clv(e)?.CentsPercent ?? double.MinValue)">
            <CellTemplate>@ClvCell(context.Item)</CellTemplate>
        </TemplateColumn>

        <TemplateColumn T="JournalEntry" Title="" Sortable="false" Align="Align.Right">
            <CellTemplate>
                <DeskRow Justify="DeskJustify.End" Gap="DeskSpace.Space1">
                    @* Graded rows are done; a void stays open to a correction, because an automatic
                       void is the common rule and a given book may have ruled otherwise.
                       Settling commits a result, so it is a pull-down of commands, not a pop-up
                       of values that acted on change and snapped back to its placeholder. *@
                    @if (!context.Item.IsGraded)
                    {
                        <DeskPullDown Label="Settle" Emphasis="DeskEmphasis.Plain" Size="DeskKeySize.Small" Align="DeskPopoverAlign.End">
                            <DeskMenuItem Label="Win" OnClick="@(() => SetResultAsync(context.Item.Id, EntryResult.Win))" />
                            <DeskMenuItem Label="Loss" OnClick="@(() => SetResultAsync(context.Item.Id, EntryResult.Loss))" />
                            <DeskMenuItem Label="Push" OnClick="@(() => SetResultAsync(context.Item.Id, EntryResult.Push))" />
                            <DeskMenuItem Label="Void" OnClick="@(() => SetResultAsync(context.Item.Id, EntryResult.Void))" />
                        </DeskPullDown>
                    }
                    <DeskButton Size="DeskKeySize.Small" Icon="@Icons.Material.Filled.Edit"
                                Title="Edit this entry" OnClick="() => EditEntry(context.Item)" />
                    @* The same door the wager window's own Duplicate uses: a new wager window on
                       this bet, ready to log at today's price — or at the typed one, if it was. *@
                    <DeskButton Size="DeskKeySize.Small" Icon="@Icons.Material.Filled.ContentCopy"
                                Title="Duplicate this entry in the wager window" OnClick="() => Duplicate(context.Item)" />
                    <DeskButton Size="DeskKeySize.Small" Icon="@Icons.Material.Filled.Delete"
                                Title="Delete this entry" OnClick="() => DeleteEntryAsync(context.Item)" />
                </DeskRow>
            </CellTemplate>
        </TemplateColumn>
    </DeskGrid>
    </PanelSection>
}

@if (_parlays.Count > 0)
{
    <PanelSection Title="Parlays">

    <DeskGrid T="Parlay" Items="_parlays" EmptyText="No parlays.">
        <PropertyColumn T="Parlay" TProperty="DateTimeOffset" Property="p => p.PlacedAt" Title="Placed"
                        InitialDirection="SortDirection.Descending">
            <CellTemplate><span class="dim">@Starts(context.Item.PlacedAt)</span></CellTemplate>
        </PropertyColumn>

        <TemplateColumn T="Parlay" Title="Legs" Sortable="false">
            <CellTemplate>
                @foreach (var leg in context.Item.Legs.OrderBy(l => l.Id))
                {
                    @* One line per leg: wrapped, the tag, the team and the price each took a line
                       of their own and the legs could not be told apart. *@
                    <DeskRow NoWrap style="white-space:nowrap">
                        <Tag State="@ResultState(leg.Result)">@leg.Result</Tag>
                        @Selection(leg)
                        @if (leg.PriceTaken != 0)
                        {
                            <span class="dim num">@Price(leg.PriceTaken)</span>
                        }
                        @ClvCell(leg)
                    </DeskRow>
                }
                @if (context.Item.Note is { } note)
                {
                    <div class="meta">@note</div>
                }
                @if (context.Item.Result == EntryResult.Pending && Stuck(context.Item) is { } reason)
                {
                    <div class="meta">@reason</div>
                }
            </CellTemplate>
        </TemplateColumn>

        <PropertyColumn T="Parlay" TProperty="string" Property="p => p.Book" Title="Book">
            <CellTemplate><span class="dim">@BookNames.Display(context.Item.Book)</span></CellTemplate>
        </PropertyColumn>

        <TemplateColumn T="Parlay" Title="Price" Align="Align.Right" Sortable="false">
            <CellTemplate>@(context.Item.PriceQuoted is { } q ? Price(q) : "—")</CellTemplate>
        </TemplateColumn>

        <PropertyColumn T="Parlay" TProperty="decimal" Property="p => p.Stake" Title="Stake" Align="Align.Right">
            <CellTemplate>@context.Item.Stake.ToString("C0")</CellTemplate>
        </PropertyColumn>

        <PropertyColumn T="Parlay" TProperty="EntryResult" Property="p => p.Result" Title="Result">
            <CellTemplate><Tag State="@ResultState(context.Item.Result)">@context.Item.Result</Tag></CellTemplate>
        </PropertyColumn>

        <PropertyColumn T="Parlay" TProperty="decimal" Property="p => p.NetReturn" Title="Net" Align="Align.Right">
            <CellTemplate>
                <span class="@(context.Item.NetReturn > 0 ? "up" : context.Item.NetReturn < 0 ? "down" : null)">
                    @* Performance's signed money, so a loss reads "−$20" in both windows: "C0"
                       follows the machine's region, and on this one printed "($20)". *@
                    @(context.Item.IsSettled ? PerformancePanel.Signed(context.Item.NetReturn) : "—")
                </span>
            </CellTemplate>
        </PropertyColumn>

        <TemplateColumn T="Parlay" Title="" Sortable="false" Align="Align.Right">
            <CellTemplate>
                <DeskRow Justify="DeskJustify.End" Gap="DeskSpace.Space1">
                    @* Legs grade themselves and the parlay follows. This is for the parlay a
                       missing price left pending, or a book that ruled otherwise. A win is only
                       offered where there is a price to pay it at. *@
                    @if (!context.Item.IsGraded)
                    {
                        <DeskPullDown Label="Settle" Emphasis="DeskEmphasis.Plain" Size="DeskKeySize.Small" Align="DeskPopoverAlign.End">
                            @if (context.Item.PriceQuoted is not null)
                            {
                                <DeskMenuItem Label="Win" OnClick="@(() => SetParlayResultAsync(context.Item, EntryResult.Win))" />
                            }
                            <DeskMenuItem Label="Loss" OnClick="@(() => SetParlayResultAsync(context.Item, EntryResult.Loss))" />
                            <DeskMenuItem Label="Void" OnClick="@(() => SetParlayResultAsync(context.Item, EntryResult.Void))" />
                        </DeskPullDown>
                    }
                    @* The keys an entry's row carries, in its order. Duplicate puts the legs back on
                       the slip as a parlay at the prices taken, to log again — the slip is where a
                       parlay is logged, as the wager window is where an entry is. *@
                    <DeskButton Size="DeskKeySize.Small" Icon="@Icons.Material.Filled.Edit"
                                Title="Edit this parlay" OnClick="() => EditParlay(context.Item)" />
                    <DeskButton Size="DeskKeySize.Small" Icon="@Icons.Material.Filled.ContentCopy"
                                Title="Duplicate this parlay on the slip" OnClick="() => DuplicateParlayAsync(context.Item)" />
                    <DeskButton Size="DeskKeySize.Small" Icon="@Icons.Material.Filled.Delete"
                                Title="Delete this parlay and its legs" OnClick="() => DeleteParlayAsync(context.Item)" />
                </DeskRow>
            </CellTemplate>
        </TemplateColumn>
    </DeskGrid>
    </PanelSection>
}

@if (_entries.Count >= _take || _parlays.Count >= _take)
{
    <DeskRow>
        <DeskButton OnClick="ShowMoreAsync">Show @Step more</DeskButton>
    </DeskRow>
}

@* What the Journal is, said once at its foot in the footnote voice, as the Slip tab says it.
   It used to be a filled note under the toolbar, wider than the form beneath it, and every
   form opened between the two read as a stack of boxes of three widths. *@
<p class="wfoot journal-foot">
    LineOps does not place wagers and has no connection to any sportsbook. Entries here are
    records of bets already placed elsewhere.
</p>
}
</DeskTabs>

@code {
    private enum JournalTab { Journal, Slip }

    private JournalTab _tab;

    private IReadOnlyList<DeskTab<JournalTab>> Tabs =>
    [
        new(JournalTab.Journal, "Journal"),
        new(JournalTab.Slip, $"Slip · {Slip.Items.Count}")
    ];

    protected override IReadOnlySet<string> Watches { get; } = new HashSet<string> { DataTopics.Journal, DataTopics.Games };

    protected override Task RefreshAsync() => LoadAsync();

    private const string FreeText = "__free__";
    private const int Step = 100;

    private enum FormMode { None, Entry, EditParlay }

    /// <summary>
    /// A logged parlay as the edit form holds it: the money and the book, which are the parlay's,
    /// and the price on each leg, by the leg's id — null where the field is empty, as it opens on
    /// a leg logged without one.
    /// </summary>
    private sealed class ParlayEditDraft(Parlay parlay)
    {
        public Parlay Parlay { get; } = parlay;
        public string Book { get; set; } = parlay.Book;
        public decimal Stake { get; set; } = parlay.Stake;
        public int? PriceQuoted { get; set; } = parlay.PriceQuoted;
        public string? Note { get; set; } = parlay.Note;

        public Dictionary<int, int?> LegPrices { get; } =
            parlay.Legs.ToDictionary(l => l.Id, l => l.PriceTaken == 0 ? (int?)null : l.PriceTaken);

        /// <summary>An empty leg field sends nothing: the leg keeps the price it has, or its lack of one.</summary>
        public ParlayEdit ToEdit() => new(
            Book, Stake, PriceQuoted, Note,
            LegPrices.Where(p => p.Value is not null).ToDictionary(p => p.Key, p => p.Value!.Value));
    }

    /// <summary>
    /// A straight bet as the edit form holds it. New bets are logged in the wager window; parlays
    /// are built on the slip.
    /// </summary>
    private sealed class Draft
    {
        /// <summary>The price as logged, so an edit to it can be told from an edit to the stake.</summary>
        public int OriginalPrice { get; init; }
        public decimal? OriginalLine { get; init; }
        public bool WasManual { get; init; }

        /// <summary>
        /// A typed price stays typed; a fetched one becomes typed once its number is edited here,
        /// because the number in the journal is then the operator's, not the desk's.
        /// </summary>
        public bool ManualPrice => WasManual || PriceTaken != OriginalPrice || LineTaken != OriginalLine;

        public int? GameId { get; set; }
        public Game? Game { get; set; }
        public string Market { get; set; } = Markets.Spread;
        public string? FreeTextMarket { get; set; }
        public string Outcome { get; set; } = string.Empty;
        public decimal? LineTaken { get; set; }
        public int PriceTaken { get; set; } = -110;
        public decimal Stake { get; set; } = 100m;
        public string Book { get; set; } = string.Empty;
        public string? Note { get; set; }

        public EntryDraft ToDraft() => new(
            GameId, Market == FreeText ? "other" : Market,
            Market == FreeText ? FreeTextMarket : null,
            Outcome, LineTaken, PriceTaken, Stake, Book, Note, ManualPrice);
    }

    private static readonly IReadOnlyList<DeskSwitchOption<JournalStatus>> Statuses =
    [
        new(JournalStatus.All, "All"),
        new(JournalStatus.Pending, "Pending"),
        new(JournalStatus.Settled, "Settled")
    ];

    // 0 is "all time": the switch needs a value for it, and no journal is older than that.

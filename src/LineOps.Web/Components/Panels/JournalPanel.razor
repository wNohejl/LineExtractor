            <GamePicker Value="d.GameId" Selected="d.Game"
                        SelectedChanged="@((Game? g) => Edit("game", () => d.Game = g))"
                        ValueChanged="@((int? id) => Edit("game", () => d.GameId = id))" />
        </div>

        <div class="wgroup__row wgroup__row--form">
            <span class="wgroup__label">Market</span>
            <DeskSelect TValue="string" Value="d.Market" Class="wfield--short" aria-label="Market"
                        ValueChanged="@((string? m) => Edit("market", () => d.Market = m ?? Markets.Spread))">
                <option value="@Markets.Moneyline">Moneyline</option>
                <option value="@Markets.Spread">Spread</option>
                <option value="@Markets.Total">Total</option>

@using LineOps.Core.Entities
@using LineOps.Data
@using LineOps.Ingestion.Services
@using LineOps.Web.Components.Desk
@using LineOps.Web.Windowing
@using Microsoft.EntityFrameworkCore
@inherits PanelBase
@implements IDisposable
@inject IDbContextFactory<LineOpsDbContext> DbFactory
@inject HistoryBackfillService Backfill
@inject BackfillCoordinator Coordinator

@*
    The history backfill, as an operator sees it.

    The walk itself lives in BackfillCoordinator and outlives this window, so everything here
    is a view onto something already running: close the window mid-backfill and it keeps
    going; reopen it and this reattaches.
*@

<Note Style="margin:12px 0">
    The daily schedule can only learn one day per day. This reaches back over past days to
    build the record analytics need — one request per sport per day, against an unmetered
    provider only.
</Note>

@if (_eligibility.Count > 0)
{
    <PanelHeader>Sources</PanelHeader>
    <div class="stack" style="gap:6px; margin-bottom:4px">
        @foreach (var source in _eligibility)
        {
            <div class="row" style="gap:9px">
                <Tag State="@(source.Eligible ? DeskState.Positive : DeskState.Warning)">
                    @(source.Eligible ? "Free" : "Refused")
                </Tag>
                <span class="mono" style="font-size:12px">@source.Key</span>
                <span class="dim" style="font-size:11.5px">@source.Reason</span>
            </div>
        }
    </div>

    @if (!_eligibility.Any(s => s.Eligible))
    {
        <Note State="DeskState.Warning" Style="margin:12px 0">
            Nothing to walk. Backfill runs against unmetered providers only, so a metered one
            cannot be used here even when it is configured and working — its quota is what the
            live schedule spends.
        </Note>
    }
}

<PanelHeader>Coverage</PanelHeader>

@if (_coverage is { } c)
{
    <MetricRow>
        <Metric Label="Days held"
                Value="@c.Completed.ToString()"
                Note='@($"of {c.TargetDayFetches} wanted")'
                State="@(c.Completed > 0 ? DeskState.Positive : DeskState.Neutral)"
                Numeric="true" />
        <Metric Label="Games" Value="@c.GamesFound.ToString()" State="DeskState.Info" Numeric="true" />
        <Metric Label="Rows" Value="@c.RowsIngested.ToString()" State="DeskState.Info" Numeric="true" />
        <Metric Label="Days failed"
                Value="@c.Failed.ToString()"
                State="@(c.Failed > 0 ? DeskState.Warning : DeskState.Neutral)"
                Numeric="true" />
    </MetricRow>

    <p class="empty" style="padding:9px 0 0">
        @if (c.EarliestCovered is { } earliest && c.LatestCovered is { } latest)
        {
            <text>Reaches back to <span class="mono">@earliest.ToString("yyyy-MM-dd")</span>,
                forward to <span class="mono">@latest.ToString("yyyy-MM-dd")</span>.
                @c.RequestsMade requests spent, 0 credits.</text>
        }
        else
        {
            <text>No history gathered yet.</text>
        }
    </p>
}

<PanelHeader>Run</PanelHeader>

<div class="row" style="margin-bottom:8px">
    @if (Coordinator.IsRunning)
    {
        @* A state, drawn as a state. This was a DeskButton carrying Busy and no OnClick — a key
           that could never be pressed, which is the one thing a key must not be. Busy means
           "the work you started is still running on this control"; there is no work to start
           here, only a walk to report, and Stop beside it is the control. *@
        <Tag State="DeskState.Info">Walking</Tag>
        <DeskButton Emphasis="DeskEmphasis.Tinted" Role="DeskRole.Destructive"
                    Icon="@Icons.Material.Filled.Stop" OnClick="Stop">
            Stop
        </DeskButton>
    }
    else
    {
        <DeskButton Emphasis="DeskEmphasis.Filled"
                    Icon="@Icons.Material.Filled.History"
                    Disabled="@(!_eligibility.Any(s => s.Eligible))"
                    Title="@(_eligibility.Any(s => s.Eligible)
                        ? null
                        : "No unmetered provider is available to walk — see Sources above.")"
                    OnClick="Start">
            Gather history
        </DeskButton>
        @* There is no Refresh key here on purpose. BackfillCoordinator is the only writer of
           everything this panel shows, and it raises Changed on start, on every day walked and
           on finish — which this panel is subscribed to. A key offering to reload data that
           nothing else can have changed is a key that only ever repaints the same numbers. *@

        @* Re-walking is how a day stored by older, wronger code gets corrected. It is behind a
           confirm because it is slow — every day walked again, one request per finished game —
           not because it is dangerous: rows are re-resolved onto themselves, never duplicated. *@
        @if (_confirmRewalk)
        {
            <span class="ftr__spacer"></span>
            <span class="dim" style="font-size:11.5px">
                Walk @(_coverage?.Completed ?? 0) held @((_coverage?.Completed ?? 0) == 1 ? "day" : "days") again?
            </span>
            <DeskButton Size="DeskKeySize.Small" Emphasis="DeskEmphasis.Tinted"
                        Icon="@Icons.Material.Filled.Restore" OnClick="RewalkAsync">
                Yes, re-walk
            </DeskButton>
            <DeskButton Size="DeskKeySize.Small" OnClick="() => _confirmRewalk = false">
                Cancel
            </DeskButton>
        }
        else
        {
            @* Disabled with the reason rather than hidden: "there is nothing held to re-walk"
               is a fact about the desk worth reading, and a key that vanishes teaches nothing. *@
            <DeskButton Icon="@Icons.Material.Filled.Restore"
                        Disabled="@(_coverage is null or { Completed: 0 })"
                        Title="@(_coverage is null or { Completed: 0 }
                            ? "No day is held yet, so there is nothing to walk again."
                            : null)"
                        OnClick="() => _confirmRewalk = true">
                Re-walk held days
            </DeskButton>
        }
    }
</div>

@if (Coordinator.Progress is { } p)
{
    <Note Style="margin-bottom:8px">
        <span class="mono">@p.SourceKey · @p.SportKey · @p.Date.ToString("yyyy-MM-dd")</span><br />
        @p.Walked walked · @p.Skipped already held · @p.Failed failed ·
        @p.GamesFound games · @p.RowsIngested rows
    </Note>
}

@if (!Coordinator.IsRunning && Coordinator.LastReport is { } r)
{
    <Note State="@(r.StoppedBecause is null ? DeskState.Neutral : DeskState.Warning)" Style="margin-bottom:8px">
        Finished: @r.Walked days walked, @r.Skipped already held, @r.Failed failed,
        @r.GamesFound games, @r.RowsIngested rows.
        @if (r.StoppedBecause is not null)
        {
            <br />

            @r.StoppedBecause
        }
    </Note>
}

<PanelHeader>Recent days</PanelHeader>

<DeskGrid T="BackfillCheckpoint" Items="_recent"
          EmptyText="Nothing walked yet. Start a backfill and days land here as they complete.">
    <PropertyColumn T="BackfillCheckpoint" TProperty="DateOnly" Property="c => c.Date" Title="Day"
                    InitialDirection="SortDirection.Descending">
        <CellTemplate><span class="mono">@context.Item.Date.ToString("yyyy-MM-dd")</span></CellTemplate>
    </PropertyColumn>

    <PropertyColumn T="BackfillCheckpoint" TProperty="string" Property="c => c.Sport!.Name" Title="Sport">
        <CellTemplate><span class="dim">@(context.Item.Sport?.Name ?? "—")</span></CellTemplate>
    </PropertyColumn>

    <PropertyColumn T="BackfillCheckpoint" TProperty="int" Property="c => c.GamesFound"
                    Title="Games" Align="Align.Right" />

    <PropertyColumn T="BackfillCheckpoint" TProperty="int" Property="c => c.RowsIngested"
                    Title="Rows" Align="Align.Right" />

    @* Sorting by state is how you find the days that need a retry pass. *@
    <PropertyColumn T="BackfillCheckpoint" TProperty="bool" Property="@(c => c.Error == null)" Title="State">
        <CellTemplate>
            @if (context.Item.Error is null)
            {
                <Tag State="DeskState.Positive">Held</Tag>
            }
            else
            {
                <Tag State="DeskState.Negative" Title="@context.Item.Error">Failed</Tag>
            }
        </CellTemplate>
    </PropertyColumn>
</DeskGrid>

@code {
    private IReadOnlyList<SourceEligibility> _eligibility = [];
    private BackfillCoverage? _coverage;
    private List<BackfillCheckpoint> _recent = [];

    protected override async Task OnInitializedAsync()
    {
        Coordinator.Changed += OnCoordinatorChanged;
        await LoadAsync();
    }

    // The coordinator raises Changed from its own worker thread, so the hop onto the
    // renderer's context is mandatory rather than defensive.
    private void OnCoordinatorChanged() => InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    private async Task LoadAsync()
    {
        await WithActivityAsync(async () =>
        {
            _eligibility = await Backfill.GetEligibilityAsync(CancellationToken.None);
            _coverage = await Backfill.GetCoverageAsync(CancellationToken.None);

            await using var db = await DbFactory.CreateDbContextAsync();
            _recent = await db.BackfillCheckpoints
                .Include(c => c.Sport)
                .OrderByDescending(c => c.CompletedAt)
                .Take(40)
                .ToListAsync();
        },
        settle: () => Coordinator.IsRunning ? PulseState.Active
            : _coverage is { Failed: > 0 } ? PulseState.Warn
            : _coverage is { Completed: > 0 } ? PulseState.Healthy
            : PulseState.Idle,
        status: () => Coordinator.IsRunning
            ? $"{Coordinator.Progress?.Walked ?? 0} days"
            : _coverage is { Completed: > 0 } ? $"{_coverage.Completed} days held" : "no history");
    }

    private bool _confirmRewalk;

    /// <summary>
    /// Clears the held-day bookkeeping and starts a fresh walk.
    ///
    /// This is the operation that previously required editing the database by hand: the walk
    /// skips days it has already recorded, so a day stored by code that has since been fixed
    /// could never be corrected from inside the app.
    /// </summary>
    private async Task RewalkAsync()
    {
        _confirmRewalk = false;

        await Backfill.ForgetAsync(null, CancellationToken.None);
        await LoadAsync();

        Coordinator.TryStart();
    }


    private void Start() => Coordinator.TryStart();

    private void Stop() => Coordinator.Stop();

    public void Dispose() => Coordinator.Changed -= OnCoordinatorChanged;
}

@using LineOps.Core.Entities
@using LineOps.Data.CrossReference
@using LineOps.Web.Components.Desk
@using LineOps.Web.Windowing
@inherits PanelBase
@inject IServiceScopeFactory ScopeFactory

@*
    Every meeting between these two sides that the desk holds.

    The snippet on a row shows five; this is the rest, and it exists because a fixture's history
    is one of the few things where more rows genuinely change the reading — a 3-2 split over
    five games and a 12-8 split over twenty are different claims about the same matchup.

    Takes a game id rather than two team ids so any row on the desk can reach it without
    resolving the sides first. The matchup is what was clicked.
*@

@if (_loading)
{
    <p class="empty">Reading previous meetings…</p>
}
else if (_rows.Count == 0)
{
    <p class="empty">
        No previous meeting on record between these sides. Either they have not met inside the
        history held, or the backfill has not reached that far — the History window walks
        further back.
    </p>
}
else
{
    <div class="row" style="margin-bottom:2px; align-items:baseline; flex-wrap:wrap">
        <h3 class="panel-h" style="margin:0">@_awayName v @_homeName</h3>
        <span class="tag tag--info">@_rows.Count @(_rows.Count == 1 ? "meeting" : "meetings")</span>
    </div>

    @* Coverage is stated rather than implied: a column of dashes beside a record says nothing
       about whether the market data is missing or the games were never priced. *@
    <p class="dim" style="font-size:11.5px; margin:0 0 14px">
        @_subjectWins-@_subjectLosses for @_homeName ·
        @_covered of @_rows.Count with a closing line
    </p>

    @if (_covered == 0)
    {
        <p class="note" style="margin-bottom:12px">
            None of these meetings has a stored closing line, so the market columns are empty.
            Prices are kept only from the point this desk started watching a fixture.
        </p>
    }

    <div class="gridwrap"><table class="grid">
        <thead>
            <tr>
                <th>Date</th>
                <th>Meeting</th>
                <th class="r">Score</th>
                <th class="r">Winner</th>
                <th class="r">Line</th>
                <th class="r">ATS</th>
                <th class="r">Total</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in _rows)
            {
                <tr>
                    <td class="dim">@Day(row.StartsAt)</td>
                    <td>
                        <DeskLink Destination="game" Icon="@Icons.Material.Filled.SportsScore"
                                  OnClick="() => OpenGameAsync(row.GameId)">
                            @row.AwayTeam at @row.HomeTeam
                        </DeskLink>
                    </td>
                    <td class="r mono">
                        @(row.HasScore ? $"{row.AwayScore}-{row.HomeScore}" : "—")
                    </td>
                    <td class="r">
                        @if (row.SubjectWon is { } won)
                        {
                            <span class="tag @(won ? "tag--good" : "tag--bad")">
                                @(won ? _homeName : _awayName)
                            </span>
                        }
                        else
                        {
                            <span class="dim">—</span>
                        }
                    </td>
                    <td class="r mono">@(row.ClosingSpread is { } s ? Line(s) : "—")</td>
                    <td class="r">
                        @if (row.AtsResult is { } ats)
                        {
                            <span class="tag @(ats == EntryResult.Win ? "tag--good" : ats == EntryResult.Loss ? "tag--bad" : "tag--info")"
                                  title="@_homeName against the closing spread">
                                @(ats == EntryResult.Win ? "Cover" : ats == EntryResult.Loss ? "No" : "Push")
                            </span>
                        }
                        else
                        {
                            <span class="dim">—</span>
                        }
                    </td>
                    <td class="r">
                        @if (row.TotalResult is { } total && row.ClosingTotal is { } line)
                        {
                            <span class="tag @(total == EntryResult.Win ? "tag--good" : total == EntryResult.Loss ? "tag--bad" : "tag--info")">
                                @(total == EntryResult.Win ? "O" : total == EntryResult.Loss ? "U" : "P") @line
                            </span>
                        }
                        else
                        {
                            <span class="dim">—</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table></div>
}

@code {
    /// <summary>
    /// The upcoming game whose two sides are being looked up. An id rather than an object so
    /// the view can be hosted as a desk window.
    /// </summary>
    [Parameter, EditorRequired] public int GameId { get; set; }

    /// <summary>How far back to reach. Generous — this window exists to show the whole record.</summary>
    [Parameter] public int Take { get; set; } = 40;

    private IReadOnlyList<HeadToHeadRow> _rows = [];
    private string _homeName = "Home";
    private string _awayName = "Away";
    private int _subjectWins;
    private int _subjectLosses;
    private int _covered;
    private bool _loading = true;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        await WithActivityAsync(async () =>
        {
            _loading = true;

            try
            {
                await using var scope = ScopeFactory.CreateAsyncScope();
                var board = scope.ServiceProvider.GetRequiredService<BoardService>();
                var log = scope.ServiceProvider.GetRequiredService<GameLogService>();

                if (await board.GetRowAsync(GameId) is { } row)
                {
                    _homeName = row.Game.HomeTeam?.Name ?? "Home";
                    _awayName = row.Game.AwayTeam?.Name ?? "Away";
                }

                _rows = await log.HeadToHeadAsync(GameId, Take);

                // Read from the upcoming home team's perspective throughout, which is what the
                // service already did — so the record and the column agree.
                _subjectWins = _rows.Count(r => r.SubjectWon == true);
                _subjectLosses = _rows.Count(r => r.SubjectWon == false);
                _covered = _rows.Count(r => r.HasClosingLine);
            }
            finally
            {
                _loading = false;
            }
        },
        settle: () => _rows.Count == 0 ? PulseState.Idle : PulseState.Healthy,
        status: () => _rows.Count == 0 ? "no meetings" : $"{_rows.Count} meetings");
    }

    private async Task OpenGameAsync(int gameId)
    {
        await using var scope = ScopeFactory.CreateAsyncScope();
        var board = scope.ServiceProvider.GetRequiredService<BoardService>();

        if (await board.GetRowAsync(gameId) is { } row)
            Manager.OpenGame(row.Game);
    }

    private static string Line(decimal value) => value > 0 ? $"+{value}" : value.ToString();
}

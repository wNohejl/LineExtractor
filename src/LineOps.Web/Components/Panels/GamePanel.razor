@using LineOps.Core.Entities
@using LineOps.Data.CrossReference
@using LineOps.Desk.Primitives
@using LineOps.Web.Components.Snippets
@using LineOps.Desk.Windowing
@inherits PanelBase
@inject IServiceScopeFactory ScopeFactory

@*
    The consolidated game view: lines, team data and players, in the order that matters right
    now.

    A pregame game is read top-down — what's the number, who's playing, how have they been
    playing — because nothing on the board has happened yet. A live game is read the other way:
    the score is the headline, "top bets" means what's still open rather than what closed, and
    team/player form is read as "does the game so far match the form" rather than a preview.
    Same three sections either way; only the order changes, because the question being asked of
    them changes.

    Team and player names are the way into their own history — following one is what "building
    on form" means: a flat aggregate here, a game log or a recent-record one click away.
*@

@* The failure line sits above whatever the window already holds, as the Board's does. The
   window refreshes on every game, odds and journal signal, and one refresh that failed used to
   replace a loaded scoreboard, its lines and its players with the sentence. *@
@if (Failed)
{
    <LoadFailure Message="@LoadError" OnRetry="RetryAsync" />
}

@if (_row is null)
{
    @if (!Failed)
    {
        @* The scoreboard's two rows and the first rows of the lines, in the places they will
           land — a sentence saying the game is loading is a placeholder shaped like nothing. *@
        <DeskSkeleton Shape="DeskSkeletonShape.Block" Width="45%" Height="56px" />
        <DeskSkeleton Lines="3" />
    }
}
else
{
    var game = _row.Game;
    var isLive = game.Status == GameStatus.Live;

    <PanelTitle>
        <ChildContent>
            @* Two rows, away over home, the winner heavier than the loser. *@
            <Scoreboard Game="game"
                        OnTeam="@((int teamId) => Manager.OpenTeam(teamId, teamId == game.AwayTeamId ? game.AwayTeam?.Name : game.HomeTeam?.Name, WindowId))" />
        </ChildContent>
        <Tags>
            @* A scheduled game's phase is its start time, which the detail line already says;
               the Board gives it no status tag, and neither does its window. *@
            @if (game.Status != GameStatus.Scheduled)
            {
                <Tag State="@StatusState(game.Status)" Live="@isLive">@Phase(game)</Tag>
            }
            @if (game.DoubleHeaderGame is { } number)
            {
                <Tag State="DeskState.Info">Game @number of a doubleheader</Tag>
            }
            @if (_bout is { } card)
            {
                @* A fight belongs to a card, not a season (ADR 0021). *@
                <Tag State="DeskState.Info">@(FightSports.CardName(card))</Tag>
                @if (card.TitleFight)
                {
                    <Tag State="DeskState.Info">Title fight</Tag>
                }
            }
        </Tags>
        @* When, and which season it counts toward, on the one quiet line under the title. The
           season was an Info tag on the title's row, where beside the two stacked clubs it floated
           mid-row, away from the name it qualified, with the date alone on the line below. A
           February game that is the prior year's postseason still says so: "2025 postseason". A
           fight belongs to a card, not a season (ADR 0021), so it keeps its card tag above. *@
        <Detail>
            <span>@Starts(game.StartsAt)@(_bout is null ? $" · {SeasonWords(game)}" : "")</span>
            @if (_bout is { } bout)
            {
                <span>@BoutFrame(bout)</span>
                @if (FightSports.ResultLine(game, bout) is { } result)
                {
                    <span class="ptitle__em">@result</span>
                }
            }
            @if (game.AwayProbablePitcher is not null || game.HomeProbablePitcher is not null)
            {
                @* In full here, where there is room: the Board shortens them to surnames. *@
                <span>
                    Starters
                    <span class="ptitle__em">@(game.AwayProbablePitcher ?? "TBD")</span> v
                    <span class="ptitle__em">@(game.HomeProbablePitcher ?? "TBD")</span>
                </span>
            }
        </Detail>
        <Keys>
            @* Which season the team data and rosters below are drawn from. Defaults to the
               game's own season; for a game that season has not yet produced games for, the
               one before. Hides itself when there is only one season to draw on. *@
            @if (_bout is null)
            {
            <DeskSwitch Options="_seasonOptions" Label="Season for team and player data" Mono="true"
                        Value="_seasonYear ?? 0" ValueChanged="@((int year) => SetSeasonAsync(year))" />
            }

            @* The two views this game opens onto, kept together as one cluster: they are the
               same kind of thing — a related window, one click away — and the glide plate
               slides between them rather than each lighting itself. *@
            <DeskRow Gap="DeskSpace.Space1" data-glide="">
                <DeskButton Icon="@Icons.Material.Filled.ShowChart"
                            OnClick="() => Manager.OpenMovement(GameId, WindowShortcuts.Describe(game))">
                    Movement
                </DeskButton>

                @* How these two have gone against each other, which is a different question from
                   how either has been playing — and the one the team blocks cannot answer. *@
                <DeskButton Icon="@Icons.Material.Filled.CompareArrows"
                            OnClick="() => Manager.OpenHeadToHead(GameId, WindowShortcuts.Describe(game), WindowId)">
                    Head to head
                </DeskButton>

                @* The wager wizard preloaded from this game: its form opens on this matchup
                   rather than on a game search. A visitor has no wager to log (ADR 0018). *@
                @if (Manager.Access.CanOperate)
                {
                    <DeskButton Icon="@Icons.Material.Filled.Bolt" Emphasis="DeskEmphasis.Tinted"
                                Title="Log a bet on this game in the Place wager window"
                                OnClick="() => Manager.OpenWager(game)">
                        Place wager
                    </DeskButton>
                }
            </DeskRow>
        </Keys>
    </PanelTitle>

    @* The journal wired into the desk: what you have riding on this game, where you are
       looking at it, rather than in a list in another window. *@
    @if (_bets.Count > 0)
    {
        <PanelSection>
        <TitleContent>
            Your bets on this game
            <DeskLink Destination="journal" OnClick="() => Manager.OpenJournal()">Journal</DeskLink>
        </TitleContent>
        <ChildContent>
        <DeskStack Gap="DeskSpace.Space1">
            @foreach (var bet in _bets)
            {
                var clv = PerformanceAnalytics.ComputeClv(bet);
                <DeskRow Gap="DeskSpace.Space2">
                    @if (ResultTag.Of(bet.Result) is { } settled)
                    {
                        <ResultTag Result="@settled">@bet.Result</ResultTag>
                    }
                    else
                    {
                        <Tag State="@BetState(bet.Result)">@bet.Result</Tag>
                    }
                    <span>
                        @(bet.FreeTextMarket ?? bet.Outcome)
                        @if (bet.LineTaken is { } l)
                        {
                            <span class="dim num"> @Line(l)</span>
                        }
                    </span>
                    <span class="dim">@LineOps.Web.Services.SelectionText.MarketName(bet.Market) · @BookNames.Display(bet.Book)</span>
                    @if (bet.PriceTaken != 0)
                    {
                        <span class="num">@Price(bet.PriceTaken)</span>
                    }
                    <span class="dim">@(bet.IsParlayLeg ? $"leg of a {bet.Parlay?.Stake:C0} parlay" : bet.Stake.ToString("C0"))</span>
                    @if (clv is { } c)
                    {
                        <span class="@(c.BeatClose ? "up" : "down")">
                            @(c.SameNumber ? c.CentsPercent.ToString("+0.0;-0.0") + "% CLV" : c.PointsGained!.Value.ToString("+0.#;-0.#") + " pts CLV")
                        </span>
                    }
                </DeskRow>
            }
        </DeskStack>
        </ChildContent>
        </PanelSection>
    }

    <DeskTabs TValue="Section" Tabs="@SectionsFor(isLive)" Label="Game sections"
              @bind-Value="_section">
        @if (context == Section.Markets)
        {
            @RenderMarkets()
        }
        else if (context == Section.Tape)
        {
            <TaleOfTheTape GameId="GameId" OnFighter="@(((int TeamId, string Name) f) => Manager.OpenTeam(f.TeamId, f.Name, WindowId))" />
        }
        else if (context == Section.TeamData)
        {
            @RenderTeamData()
        }
        else
        {
            @RenderPlayers()
        }
    </DeskTabs>
}

@code {
    protected override string LoadSubject => "The game";

    protected override IReadOnlySet<string> Watches { get; } = new HashSet<string> { DataTopics.Games, DataTopics.Odds, DataTopics.Journal };

    protected override Task RefreshAsync() => LoadAsync();

    /// <summary>
    /// The game this view is about. Taken as an id rather than an object so the view can be
    /// hosted as a desk window, which is rebuilt from its parameters and cannot carry a
    /// reference.
    /// </summary>
    [Parameter, EditorRequired] public int GameId { get; set; }

    private BoardRow? _row;
    private IReadOnlyList<JournalEntry> _bets = [];

    private static DeskState BetState(EntryResult result) => result switch
    {
        EntryResult.Win => DeskState.Positive,
        EntryResult.Loss => DeskState.Negative,
        EntryResult.Push => DeskState.Info,
        EntryResult.Void => DeskState.Neutral,
        _ => DeskState.Warning
    };
    private MatchupForm? _matchup;
    private TeamForm? _homeTeam;
    private TeamForm? _awayTeam;

    /// <summary>Which of the three readings is on screen. See <see cref="SectionsFor"/>.</summary>
    private enum Section { Markets, TeamData, Players, Tape }

    private Section _section = Section.Markets;

    private bool HasBox => _box is not null && !_box.IsEmpty;

    private bool HasRoster => _matchup is not null && !_matchup.IsEmpty;

    private bool HasTeamData
        => (_homeTeam?.Recent.Count ?? 0) > 0 || (_awayTeam?.Recent.Count ?? 0) > 0;

    /// <summary>
    /// The sections this game actually has.
    ///
    /// <para>
    /// Markets is always offered: an unpriced game still answers "what is the number" —
    /// with the reason there isn't one. The other two are dropped when the window holds
    /// nothing for them, so a tab never opens onto an empty panel.
    /// </para>
    ///
    /// <para>
    /// Only the first label turns on whether the game is under way. Before a game the
    /// prices are the lines being offered; during one, what is still open to bet — same
    /// section, different question, and the tab is where that gets said.
    /// </para>
    /// </summary>
    private IReadOnlyList<DeskTab<Section>> SectionsFor(bool isLive) => _bout is not null
        ?
        [
            // A fight (ADR 0021): no team data or rosters — the two fighters side by side, and
            // once it is over, each one's fight stats.
            new(Section.Markets, isLive ? "Top bets" : "Lines"),
            new(Section.Tape, "Tale of the tape"),
            new(Section.Players, "Fight stats", HasBox)
        ]
        :
    [
        new(Section.Markets, isLive ? "Top bets" : "Lines"),
        new(Section.TeamData, "Team data", HasTeamData),
        new(Section.Players, HasBox ? "Box score" : "Players", HasBox || HasRoster)
    ];

    /// <summary>The card and result when this game is a fight; null for a team sport.</summary>
    private Bout? _bout;

    /// <summary>Where a bout sits and how far it goes: "Main Card · Lightweight · 5 rounds".</summary>
    private static string BoutFrame(Bout bout)
        => string.Join(" · ", new[]
        {
            bout.MatchNumber == 1 ? "Main event" : bout.CardSegment,
            bout.WeightClass,
            $"{bout.ScheduledRounds} rounds"
        }.Where(s => !string.IsNullOrWhiteSpace(s)));

    /// <summary>This game's box score. Null until the game has produced one.</summary>
    private GameBoxScore? _box;

    /// <summary>
    /// The season the team data and rosters are drawn from — the game's own where it has
    /// games behind it, the one before for a preview. Null only when neither side has a
    /// season on record, where the readers fall back to a wide rolling window.
    /// </summary>
    private int? _seasonYear;
    private IReadOnlyList<int> _seasons = [];
    private IReadOnlyList<DeskSwitchOption<int>> _seasonOptions = [];

    /// <summary>Wide on purpose: only reached when there is no season to bound by.</summary>
    private static readonly TimeSpan FallbackWindow = TimeSpan.FromDays(365);

    /// <summary>The roster row showing its recent games. One at a time, like every other row.</summary>
    private int? _openPlayer;

    private void TogglePlayer(int playerId)
        => _openPlayer = _openPlayer == playerId ? null : playerId;

    /// <summary>
    /// What an open roster row offers.
    ///
    /// <para>
    /// One action, because there is one question. The averages in the row are what these games
    /// produced, and the mean hides the shape — four quiet games and one enormous one read the
    /// same as five steady ones. So the snippet is the games themselves, and the escape is the
    /// player's own window for anyone who wants more than five.
    /// </para>
    /// </summary>
    private List<RowAction> ActionsFor(PlayerForm player)
    {
        var id = player.PlayerId;
        var name = player.Name;

        return
        [
            new RowAction
            {
                Key = "recent",
                Label = "Last 5",
                Icon = Icons.Material.Filled.Timeline,
                Snippet = @<PlayerRecentSnippet PlayerId="id" />,
                OpenLabel = "Player window",
                OpenWindow = () =>
                {
                    Manager.OpenPlayer(id, name, WindowId);
                    return Task.CompletedTask;
                }
            }
        ];
    }

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task SetSeasonAsync(int year)
    {
        _seasonYear = year;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await WithActivityAsync(async () =>
        {
            await using var scope = ScopeFactory.CreateAsyncScope();

            _row = await scope.ServiceProvider.GetRequiredService<BoardService>().GetRowAsync(GameId);

            if (_row is null)
                return;

            var fights = scope.ServiceProvider.GetRequiredService<FightService>();
            _bout = FightSports.IsFight(_row.Game.Sport?.Key)
                ? (await fights.BoutsAsync([GameId])).GetValueOrDefault(GameId)
                : null;

            // The operator's own bets. A visitor's desk never reads the journal, so there is nothing
            // personal to leak into a window it may see (ADR 0018).
            _bets = Manager.Access.CanOperate
                ? await scope.ServiceProvider.GetRequiredService<LineOps.Ingestion.Services.JournalService>().OnGameAsync(GameId)
                : [];

            var lookup = scope.ServiceProvider.GetRequiredService<MatchupCrossReference>();
            var log = scope.ServiceProvider.GetRequiredService<GameLogService>();

            // The seasons either side has played in. The game's own season leads if it has
            // games behind it; a preview of an unplayed season draws on the one before.
            var home = await log.SeasonsForTeamAsync(_row.Game.HomeTeamId);
            var away = await log.SeasonsForTeamAsync(_row.Game.AwayTeamId);
            _seasons = home.Concat(away).Distinct().OrderByDescending(y => y).Take(3).ToList();

            if (_seasonYear is null || !_seasons.Contains(_seasonYear.Value))
                _seasonYear = _seasons.Contains(_row.Game.SeasonYear) ? _row.Game.SeasonYear
                    : _seasons.Count > 0 ? _seasons[0] : null;

            var sport = _row.Game.Sport?.Key ?? string.Empty;
            _seasonOptions = _seasons
                .Select(y => new DeskSwitchOption<int>(y, SeasonCalendar.Label(sport, y),
                    $"{sport.ToUpperInvariant()} {SeasonCalendar.Label(sport, y)} season"))
                .ToList();

            // The box score is the answer once there is one; the season aggregate is the
            // fallback for a game that has not been played. Both are loaded because the
            // fallback has to be ready the moment the box score turns out to be empty.
            _box = await log.BoxScoreAsync(GameId);

            _matchup = await lookup.GetAsync(GameId, FallbackWindow, maxPlayersPerTeam: 8, seasonYear: _seasonYear);

            // Only the recent record is wanted here — the roster comes from the matchup lookup
            // above, which resolves both sides in one query rather than two.
            _homeTeam = await lookup.GetTeamAsync(_row.Game.HomeTeamId, FallbackWindow, maxPlayers: 0, seasonYear: _seasonYear);
            _awayTeam = await lookup.GetTeamAsync(_row.Game.AwayTeamId, FallbackWindow, maxPlayers: 0, seasonYear: _seasonYear);
        },
        settle: () => _row is null ? PulseState.Idle : PulseState.Healthy,
        status: () => _row is null ? "not found" : StateStatus(_row.Game));
    }

    private static DeskState StatusState(GameStatus status) => status switch
    {
        GameStatus.Live => DeskState.Warning,
        GameStatus.Final => DeskState.Positive,
        _ => DeskState.Info
    };

    @* The tab bar names each of these now, so none of them repeats it as a heading. *@
    private RenderFragment RenderMarkets() => @<text>
        @if (_row!.Unpriced is { } reason)
        {
            <Note State="DeskState.Warning">@reason</Note>
        }
        else
        {
            @*
                A grouped list, a row per market and a column per side: away then home, as the
                title reads, and Over then Under. Each cell is the side and its number, with the
                book holding it by name beneath in secondary ink.

                It was three clusters of the Board's price cell side by side in the left third of
                the window — tiny prices, a two-letter monogram (PN, DK, MG) nobody had been told
                how to read, and a rail of ticks under each. The cell is built for a dense grid
                where the same books repeat down a column; here there are six numbers and room
                to name them. The rest of the market — every book's price — is the cell's
                tooltip, and Every book's window. A live price is a door: pressed, it opens the wager
                window on that side at that book, as the Board's prices do.
            *@
            <section class="wsection gamelines">
                <div class="wgroup">
                    @* A game reads away then home, as its title does; a fight reads red corner
                       (home) first, as its card bills it and the Board's row now leads (ADR 0021). *@
                    @if (_bout is null)
                    {
                        @LineRow("Moneyline", _row.Moneyline.Second, _row.Moneyline.First, SideName(false), SideName(true), total: false)
                    }
                    else
                    {
                        @LineRow("Moneyline", _row.Moneyline.First, _row.Moneyline.Second, SideName(true), SideName(false), total: false)
                    }
                    @* A fight has no spread (ADR 0021). *@
                    @if (_bout is null)
                    {
                        @LineRow("Spread", _row.Spread.Second, _row.Spread.First, SideName(false), SideName(true), total: false)
                    }
                    @LineRow(_bout is null ? "Total" : "Total rounds", _row.Total.First, _row.Total.Second, "Over", "Under", total: true)
                </div>
                <p class="wgroup__foot">@LinesFoot</p>
            </section>
        }
    </text>;

    /// <summary>One market: its name leading, then the two sides, each a cell of <see cref="LineCell"/>.</summary>
    private RenderFragment LineRow(string market, BestOffer? first, BestOffer? second, string firstSide, string secondSide, bool total) => @<div class="wgroup__row wgroup__row--form">
        <span class="wgroup__label">@market</span>
        <div class="gamelines__sides">
            @LineCell(first, firstSide, total, MarketKey(market))
            @LineCell(second, secondSide, total, MarketKey(market))
        </div>
    </div>;

    /// <summary>
    /// A side's best number and the book holding it: "Cowboys +3.5 −110" over "DraftKings". A
    /// total names its number bare ("Over 47.5"), since the side already says which way. Value
    /// against the fair price follows the book on a live price; a close says it is one.
    /// </summary>
    private RenderFragment LineCell(BestOffer? offer, string side, bool total, string market) => @<div class="gamelines__cell @(CanTake(offer) ? "gamelines__cell--take" : null)"
        title="@(offer is null ? null : EveryBook(offer) + (CanTake(offer) ? "\nPress to place a wager on this side." : ""))"
        role="@(CanTake(offer) ? "button" : null)" tabindex="@(CanTake(offer) ? "0" : null)"
        @onclick="() => Take(market, offer)"
        @onkeydown="@(e => { if (e.Key is "Enter" or " ") Take(market, offer); })">
        <span class="gamelines__price">
            <span class="gamelines__side">@side</span>
            @if (offer is null)
            {
                <span class="dim">—</span>
            }
            else
            {
                @if (offer.Line is { } line)
                {
                    <span>@(total ? Math.Abs(line).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) : OddsMath.FormatLine(line, offer.Outcome))</span>
                }
                <span>@OddsMath.FormatPrice(offer.PriceAmerican)</span>
            }
        </span>
        <span class="gamelines__book">
            @if (offer is null)
            {
                @:Not priced
            }
            else
            {
                @BookNames.Display(offer.Book)@(offer.IsClosing ? " · closing" : "")
                @if (!offer.IsClosing && offer.Ev is { } ev)
                {
                    <span class="@(ev > 0 ? "up" : null)"> · @PriceCell.EvLabel(ev)</span>
                }
            }
        </span>
    </div>;

    /// <summary>A row's market, as the wager window names it.</summary>
    private static string MarketKey(string row) => row switch
    {
        "Moneyline" => Markets.Moneyline,
        "Spread" => Markets.Spread,
        _ => Markets.Total
    };

    /// <summary>A live price the operator can take: a closing number is history, not a bet.</summary>
    private bool CanTake(BestOffer? offer) => offer is { IsClosing: false } && Manager.Access.CanOperate;

    /// <summary>
    /// A price pressed: the wager window on this game, landed on that side at the book holding
    /// the best number — the Board's price door, from the Game window.
    /// </summary>
    private void Take(string market, BestOffer? offer)
    {
        if (!CanTake(offer) || _row?.Game is not { } game)
            return;

        Manager.OpenWager(game, market, offer!.Outcome, offer.Book);
    }

    /// <summary>Every book's number on a side, by name — the cell's tooltip.</summary>
    private static string EveryBook(BestOffer offer)
        => string.Join("\n", offer.Rungs.Select(r =>
            $"{BookNames.Display(r.Book)} {(r.Line is { } l ? OddsMath.FormatLine(l, offer.Outcome) + " " : "")}{OddsMath.FormatPrice(r.PriceAmerican)}"));

    /// <summary>A side as the lines name it: the club's nickname, as the Board's chips do.</summary>
    private string SideName(bool home)
    {
        var team = home ? _row?.Game.HomeTeam : _row?.Game.AwayTeam;
        return TeamNames.Short(team, Scoreline.Abbrev(team, home ? "Home" : "Away"));
    }

    /// <summary>The group's footer: what the numbers are, and when a close, what that means.</summary>
    private string LinesFoot
        => _row!.PricesAreClosing
            ? "Closing prices: the last number each book showed before the start. Hover a price for every book's."
            : $"The best price on each side across {_row.BookCount:N0} {(_row.BookCount == 1 ? "book" : "books")}. Hover a price for every book's.";

    /// <summary>"2026 season", or "2025 postseason" for a February game that closes the prior year.</summary>
    private static string SeasonWords(Game game)
        => $"{SeasonCalendar.Label(game.Sport?.Key ?? string.Empty, game.SeasonYear)} "
           + (game.SeasonType == SeasonType.Postseason ? "postseason" : "season");

    private RenderFragment RenderTeamData() => @<text>
        <DeskRow Gap="DeskSpace.Space6">
            @RenderTeamRecord(_awayTeam, _row!.Game.AwayTeamId, _row.Game.AwayTeam?.Name ?? "Away")
            @RenderTeamRecord(_homeTeam, _row.Game.HomeTeamId, _row.Game.HomeTeam?.Name ?? "Home")
        </DeskRow>
    </text>;

    private RenderFragment RenderTeamRecord(TeamForm? form, int teamId, string name) => @<text>
        <DeskStack Gap="DeskSpace.Space1" Align="DeskAlign.Start">
            <DeskLink Destination="team" Icon="@Icons.Material.Filled.Shield"
                      OnClick="() => Manager.OpenTeam(teamId, name, WindowId)">@name</DeskLink>

            @* "In the window" read as the desk window this sits in; the reach is the season
               switched above. One game is a game. *@
            @if (form is null || form.Recent.Count == 0)
            {
                <div class="meta">No games on record for this season.</div>
            }
            else
            {
                <div class="meta">
                    @form.Record over @form.Recent.Count.ToString("N0") @(form.Recent.Count == 1 ? "game" : "games")
                </div>
                <div class="row">
                    <FormRun Log="@FormResult.From(form.Recent)" />
                </div>
            }
        </DeskStack>
    </text>;

    /// <summary>
    /// Who is playing, or what they did.
    ///
    /// <para>
    /// Before a game these are two rosters and their recent form, because that is the only
    /// evidence there is. Once it is under way the box score exists, and showing a thirty-day
    /// average instead would be answering a question nobody asked while looking at a specific
    /// game — the line that matters is the one from this one.
    /// </para>
    /// </summary>
    private RenderFragment RenderPlayers() => @<text>
        @if (HasBox)
        {
            @RenderBoxSide(_box!.Away, _row!.Game.AwayTeam?.Name ?? "Away")
            @RenderBoxSide(_box.Home, _row.Game.HomeTeam?.Name ?? "Home")
        }
        else
        {
            @* A roster in units where the sport names them (NFL): a back read under columns
               chosen by the side's defenders showed a row of dashes. *@
            @foreach (var (unit, players) in Units(_matchup!.Away))
            {
                @RenderRoster(players, Titled(_row!.Game.AwayTeam?.Name ?? "Away", unit))
            }
            @foreach (var (unit, players) in Units(_matchup.Home))
            {
                @RenderRoster(players, Titled(_row!.Game.HomeTeam?.Name ?? "Home", unit))
            }
        }
    </text>;

    /// <summary>One side of the box score. Columns are derived from the lines themselves.</summary>
    private RenderFragment RenderBoxSide(IReadOnlyList<BoxScoreLine> side, string teamName) => @<text>
        @if (side.Count > 0)
        {
            var columns = GameBoxScore.ColumnsFor(side);

            <PanelSection Title="@teamName">
                <div class="gridwrap">
                    <DeskGrid T="BoxScoreLine" Items="side" EmptyText="No box score lines for this side.">
                        <PropertyColumn T="BoxScoreLine" TProperty="string" Property="p => p.Name"
                                        Title="Player" CellClass="trunc">
                            <CellTemplate>
                                <span title="@context.Item.Name">
                                    <DeskLink Destination="player" Icon="@Icons.Material.Filled.Person"
                                              OnClick="() => Manager.OpenPlayer(context.Item.PlayerId, context.Item.Name, WindowId)">@context.Item.Name</DeskLink>
                                </span>
                            </CellTemplate>
                        </PropertyColumn>

                        <PropertyColumn T="BoxScoreLine" TProperty="string" Property="p => p.Position!" Title="Pos" HeaderClass="col--wide" CellClass="col--wide">
                            <CellTemplate><span class="dim">@(context.Item.Position ?? "—")</span></CellTemplate>
                        </PropertyColumn>

                        @* Box score values arrive as strings straight off the line, so they sort as
                           strings — coercing them to numbers here would invent a reading the source
                           did not give. *@
                        @foreach (var c in columns)
                        {
                            var key = c;

                            <TemplateColumn T="BoxScoreLine" Sortable="true" Title="@StatLabels.StatLabel(key)" Align="Align.Right"
                                            SortBy="@(p => p.Stats.GetValueOrDefault(key) ?? string.Empty)">
                                <CellTemplate>
                                    <span class="mono">@(context.Item.Stats.TryGetValue(key, out var v) ? v : "—")</span>
                                </CellTemplate>
                            </TemplateColumn>
                        }
                    </DeskGrid>
                </div>
            </PanelSection>
        }
    </text>;

    private static bool IsRate(IReadOnlyList<PlayerForm> side, string key)
        => side.Any(p => p.Totals.ContainsKey(key) && !p.IsCounting(key));

    /// <summary>
    /// A side split into units — Passing, Rushing, Receiving, Defense, Special teams — each with
    /// columns of its own; one table, as before, where the sport's lines name no groups.
    /// </summary>
    private static IEnumerable<(string? Unit, IReadOnlyList<PlayerForm> Players)> Units(IReadOnlyList<PlayerForm> side)
    {
        var units = side.Select(p => (Unit: StatColumns.UnitOf(p.Totals), Player: p)).ToList();

        if (units.All(u => u.Unit is null))
            return [(null, side)];

        return units
            .GroupBy(u => u.Unit)
            .OrderBy(g => StatColumns.UnitOrder(g.Key))
            .Select(g => (g.Key, (IReadOnlyList<PlayerForm>)g.Select(u => u.Player).ToList()));
    }

    private static string Titled(string team, string? unit) => unit is null ? team : $"{team} · {unit}";

    private static List<string> ColumnsFor(IReadOnlyList<PlayerForm> side)
        => StatColumns.Pick(side.Select(p => p.Totals.Keys), 4);

    private RenderFragment RenderRoster(IReadOnlyList<PlayerForm> side, string teamName) => @<text>
        @if (side.Count > 0)
        {
            var columns = ColumnsFor(side);

            <PanelSection Title="@teamName">
                @*
                    The row opens the way every other row on the desk opens.

                    This table had its own disclosure — a bare "Last 5" key in a trailing column and
                    a second <tr> underneath — written before RowActions existed. Converting the
                    table is the moment to stop having two of those: the keys and the snippet now
                    come from the shared strip, in the widest cell, exactly as the Board does it.
                    That is the row-drilldown spec's "one interaction to learn, and it holds all the
                    way down" being cashed in rather than restated.
                *@
                <div class="gridwrap">
                    <DeskGrid T="PlayerForm" Items="side" Class="deskgrid--clickable"
                              RowClassFunc="@((p, _) => _openPlayer == p.PlayerId ? "board__row--open" : string.Empty)"
                              OnRowClick="@(e => TogglePlayer(e.Item.PlayerId))"
                              EmptyText="No appearances on record.">

                        <PropertyColumn T="PlayerForm" TProperty="string" Property="p => p.Name"
                                        Title="Player" CellClass="trunc">
                            <CellTemplate>
                                <span title="@context.Item.Name">
                                    <DeskLink Destination="player" Icon="@Icons.Material.Filled.Person"
                                              OnClick="() => Manager.OpenPlayer(context.Item.PlayerId, context.Item.Name, WindowId)">@context.Item.Name</DeskLink>
                                </span>

                                @if (_openPlayer == context.Item.PlayerId)
                                {
                                    @* Keyed by the player so moving to another row is a fresh strip
                                       rather than one still showing the previous player's snippet. *@
                                    <RowActions @key="context.Item.PlayerId" Actions="ActionsFor(context.Item)" />
                                }
                            </CellTemplate>
                        </PropertyColumn>

                        <PropertyColumn T="PlayerForm" TProperty="string" Property="p => p.Position!" Title="Pos" HeaderClass="col--wide" CellClass="col--wide">
                            <CellTemplate><span class="dim">@(context.Item.Position ?? "—")</span></CellTemplate>
                        </PropertyColumn>

                        <PropertyColumn T="PlayerForm" TProperty="int" Property="p => p.Appearances"
                                        Title="GP" Align="Align.Right" />

                        @* A player with no reading for a key sorts below every real one rather than
                           beside the zeroes — the same distinction the dash makes in the cell. *@
                        @foreach (var c in columns)
                        {
                            var key = c;

                            <TemplateColumn T="PlayerForm" Sortable="true" Title="@(StatLabels.StatLabel(key) + (IsRate(side, key) ? "/g" : ""))"
                                            Align="Align.Right"
                                            SortBy="@(p => p.Summary(key) ?? double.MinValue)">
                                <CellTemplate>
                                    @(context.Item.Summary(key) is { } v
                                        ? v.ToString(context.Item.IsCounting(key) ? "#,0.##" : "0.000")
                                        : "—")
                                </CellTemplate>
                            </TemplateColumn>
                        }
                    </DeskGrid>
                </div>
            </PanelSection>
        }
    </text>;
}

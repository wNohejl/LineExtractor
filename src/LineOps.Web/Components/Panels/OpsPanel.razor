@using LineOps.Data
@using LineOps.Reliability
@using LineOps.Ingestion.Services
@using LineOps.Core.Contracts
@using LineOps.Desk.Windowing
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Options
@inherits PanelBase
@inject IServiceScopeFactory ScopeFactory
@inject IOptions<ReliabilityOptions> Options
@inject IOptions<LineOps.Ingestion.Configuration.IngestionOptions> Ingestion
@inject DeskToasts Toasts

@* A visitor reads Ops — source health, SLOs, the alerts and what they cost — and changes none of
   it: no evaluation, no polling switch, no incident, no fault injected (ADR 0018). *@

@if (Failed)
{
    <LoadFailure Message="@LoadError" OnRetry="RetryAsync" />
}

@* Until the first read, the figures and tables below would all say zero and "no alerts" —
   the all-clear this window exists to give only when it is true. Their shape stands in. *@
@if (!Loaded)
{
    @if (!Failed)
    {
        <DeskStack>
            <DeskSkeleton Lines="2" />
            <DeskGrid T="SourceHealth" Items="_health" Loading="true" LoadingLabel="Reading source health" />
        </DeskStack>
    }
}
else
{
<MetricRow>
    <Metric Label="Sources in SLO"
            State="@(_healthy == _health.Count ? DeskState.Positive : DeskState.Warning)">
        @_healthy/@_health.Count
    </Metric>
    <Metric Label="Open alerts"
            Value='@_alerts.Count.ToString("N0")'
            Note='@(_criticals > 0 ? $"{_criticals:N0} critical" : "none critical")'
            State="@(_criticals > 0 ? DeskState.Negative : _alerts.Count > 0 ? DeskState.Warning : DeskState.Positive)" />
    <Metric Label="Rows today" Value='@_rowsToday.ToString("N0")' />
    <Metric Label="Open incidents"
            Value='@_openIncidents.ToString("N0")'
            State="@(_openIncidents > 0 ? DeskState.Negative : DeskState.Positive)" />
</MetricRow>

@* The one action this window exists to commit — rolling the KPIs up and re-running the alert
   rules — so it is the panel's single Filled. Busy rather than Disabled: an evaluation in
   flight is a control that is occupied, not one that is not for you, and the shimmer says
   which. See ADR 0016.

   It sits under the figures it recomputes, leading, with the line that says what it does. It
   used to be the only thing in a toolbar of its own, pinned to the right edge: in a maximised
   window that was a 40px band above the tiles that read as empty, with the key a screen's width
   from anything it acts on (HIG: the primary action aligns with the content; nothing pinned to
   a far edge away from what it belongs to). *@
@if (Manager.Access.CanOperate)
{
    <div class="opsact">
        <DeskButton Emphasis="DeskEmphasis.Filled" Icon="@Icons.Material.Filled.Refresh"
                    OnClick="EvaluateAsync" Busy="@_busy">
            Evaluate now
        </DeskButton>
        <span class="opsact__why">Rolls today's figures up and runs the alert rules again.</span>
    </div>
}

@*
    Odds feeds get their own section because their failure mode is silence: an unconfigured
    provider is never registered, so it writes no runs and appears nowhere in source health.
    "No prices" and "no feed" look identical without this.
*@
<PanelSection Title="Odds feeds">

<DeskGrid T="OddsProviderState" Items="_feeds" EmptyText="No odds providers configured.">
    @* Live is the state a feed is meant to be in, so it is said quietly; Off keeps its tag,
       because it is the one an operator is looking for. *@
    <PropertyColumn T="OddsProviderState" TProperty="bool" Property="f => f.IsLive" Title="State"
                    InitialDirection="SortDirection.Descending">
        <CellTemplate>
            @if (context.Item.IsLive)
            {
                <span class="quiet">Live</span>
            }
            else
            {
                <Tag>Off</Tag>
            }
        </CellTemplate>
    </PropertyColumn>

    <PropertyColumn T="OddsProviderState" TProperty="string" Property="f => f.Name" Title="Provider" />

    <TemplateColumn T="OddsProviderState" Title="Books" Sortable="false">
        <CellTemplate>
            <span class="dim">@string.Join(", ", context.Item.Books.Select(BookNames.Display))</span>
        </CellTemplate>
    </TemplateColumn>

    <PropertyColumn T="OddsProviderState" TProperty="string" Property="f => f.Reason" Title="Notes">
        <CellTemplate><span class="trunc dim" title="@context.Item.Reason">@context.Item.Reason</span></CellTemplate>
    </PropertyColumn>
</DeskGrid>

@* The switch the footers below price. Held with the data, so the web host and the worker obey
   the same choice and it outlives a restart. Turning scanning on is confirmed beside its price;
   turning it off stops spending and needs no second thought. Only offered with a live feed:
   scheduling scans of a provider that cannot be reached would spend nothing and say otherwise.

   A grouped row, as a setting is drawn (apple-hig-components, forms.md): the name leads, the
   control trails, and what the choice costs is the group's footer rather than a paragraph
   running the width of the window. Two modes, both worth seeing, so a segmented control; a
   choice of Automatic waits on the confirm row under it before anything is spent. *@
@if (ShowsScanning)
{
    <div class="wgroup opsgroup">
        <div class="wgroup__row wgroup__row--form">
            <span class="wgroup__label">Scanning</span>
            <DeskSwitch TValue="bool" Options="ScanModes" Label="Scanning" Size="DeskKeySize.Small"
                        Value="@(_unattended || _confirmAutomatic)" ValueChanged="ChooseScanningAsync" />
        </div>
        @if (_confirmAutomatic)
        {
            <div class="wgroup__row opsconfirm">
                <span class="opsconfirm__ask">
                    Scan at this price until switched back, from this host and the worker alike?
                </span>
                <DeskButton Size="DeskKeySize.Small" Emphasis="DeskEmphasis.Tinted"
                            Icon="@Icons.Material.Filled.Schedule"
                            OnClick="() => SetPollingAsync(automatic: true)">
                    Yes, scan automatically
                </DeskButton>
                <DeskButton Size="DeskKeySize.Small" OnClick="() => _confirmAutomatic = false">Cancel</DeskButton>
            </div>
        }
    </div>
}

@* Manual is the default, so the usual case is that nothing is scanning. Reporting a cadence
   here regardless would describe a schedule that is not running — the number would be real
   arithmetic about an allowance nobody is spending. What is left still matters, because that is
   what a press of Pull lines draws on. *@
@if (!_unattended)
{
    <p class="@FootClass">
        Lines are pulled on request only — nothing is fetched unasked.
        @if (_plan?.ScansRemainingToday is { } available)
        {
            <text>
                @* Credits, not requests. The two are equal on this desk — one sport, two
                   markets — which is exactly why showing the wrong one would look right until
                   a market or a sport is added. *@
                <span class="num">@available.ToString("N0")</span> pulls left in @_plan.WindowLabel allowance, at
                <span class="num">@_plan.CreditsPerScan.ToString("N0")</span> credits each.
            </text>
        }
        @* A visitor has no Pull data menu (ADR 0018); pointing at it would send them looking. *@
        @if (Manager.Access.CanOperate)
        {
            <text>Use <strong>Pull data → Pull lines</strong>.</text>
        }
        @Provenance
    </p>

    @* The price, before anything is spent: what each sport's scan asks for and bills, and how
       often the scheduler would scan at that price if it were switched on. The planner paces on
       what is left, so it never overspends — a longer market list shows up here as a slower
       cadence, which is the real cost of adding one. *@
    @if (_plan is { } projected && _marketsBySport.Count > 0)
    {
        <p class="@FootClass">
            @foreach (var (sport, index) in _marketsBySport.Select((m, i) => (m, i)))
            {
                @(index > 0 ? " · " : "")<span>@sport.Sport.ToUpperInvariant()</span>
                @* Spelled as one expression: a leading space inside <text> before code was dropped, and
                   the sport ran into its markets ("MLBmoneyline"). *@
                @($" {string.Join(", ", sport.Markets.Select(MarketName))}")
                @if (sport.Credits > 0)
                {
                    <text> (<span class="num">@sport.Credits.ToString("N0")</span> @(sport.Credits == 1 ? "credit" : "credits"))</text>
                }
            }.
            @if (projected.ScansRemainingToday is { } left && left > 0)
            {
                <text>
                    Switched to automatic, this list would scan about every
                    <span class="num">@Cadence(projected.BudgetInterval)</span> for the rest of
                    @(projected.Window == BudgetWindow.Month ? "the month" : "the day") — sooner near
                    first pitch, slower far from it.
                </text>
            }
        </p>
    }
}
else if (_plan is { } plan)
{
    <p class="@FootClass">
        Scanning every <span class="num">@Cadence(plan.Interval)</span> at
        <span class="num">@plan.CostPerScan.ToString("N0")</span> requests a scan
        @if (plan.ScansRemainingToday is { } left)
        {
            @* "today's" or "this month's" — the provider decides which, and saying the wrong
               one turns a month's remaining allowance into an apparently generous day. *@
            <text>— <span class="num">@left.ToString("N0")</span> scans left in @plan.WindowLabel allowance</text>
            @if (plan.BoundBy is { } bound)
            {
                <text>, paced by @FeedName(bound)</text>
            }
        }
        else
        {
            <text>— nothing metered, so this is the politeness floor rather than a budget</text>
        }.
        @Provenance
    </p>
}
</PanelSection>

<PanelSection Title="Source health">

<DeskGrid T="SourceHealth" Items="_health" EmptyText="No sources registered.">
    @* The source name goes through to its runs — "why is this stale" is answered there. *@
    <PropertyColumn T="SourceHealth" TProperty="string" Property="h => h.Source.Name" Title="Source">
        <CellTemplate>
            <DeskLink Destination="runs"
                      Icon="@Icons.Material.Filled.History"
                      OnClick="() => Manager.OpenRuns(context.Item.Source.Id, context.Item.Source.Name)">
                @context.Item.Source.Name
            </DeskLink>
        </CellTemplate>
    </PropertyColumn>

    <PropertyColumn T="SourceHealth" TProperty="SourceKind" Property="h => h.Source.Kind" Title="Kind" HeaderClass="col--wide" CellClass="col--wide">
        <CellTemplate><span class="dim">@context.Item.Source.Kind</span></CellTemplate>
    </PropertyColumn>

    @* Sorts on minutes, so "stalest first" is a click. A never-run source sorts as the worst
       rather than as zero, which is the two-kinds-of-zero rule from ADR 0003. *@
    <PropertyColumn T="SourceHealth" TProperty="double"
                    Property="h => h.FreshnessMinutes ?? double.MaxValue"
                    Title="Freshness" Align="Align.Right">
        <CellTemplate>
            <span class="@(IsStale(context.Item) ? "down" : null)">
                @(context.Item.FreshnessMinutes is { } m ? Age(m) : "never")
            </span>
        </CellTemplate>
    </PropertyColumn>

    <PropertyColumn T="SourceHealth" TProperty="double" Property="h => h.SuccessRate"
                    Title="Success 7d" Align="Align.Right">
        <CellTemplate>
            <Note Inline State="@(IsRateLow(context.Item) ? DeskState.Warning : DeskState.Neutral)">@context.Item.SuccessRate.ToString("P0")</Note>
        </CellTemplate>
    </PropertyColumn>

    <PropertyColumn T="SourceHealth" TProperty="int" Property="h => h.RowsToday"
                    Title="Rows today" HeaderClass="col--wider" CellClass="col--wider" Align="Align.Right" Format="N0" />

    <PropertyColumn T="SourceHealth" TProperty="double" Property="h => h.VolumeRatio ?? -1"
                    Title="Volume" HeaderClass="col--wide" CellClass="col--wide" Align="Align.Right">
        <CellTemplate>
            <span class="dim">@(context.Item.VolumeRatio is { } v ? v.ToString("P0") : "—")</span>
        </CellTemplate>
    </PropertyColumn>

    @* Healthy is said quietly, as Live is above: a column of green capsules on every row is a
       wall of colour that hides the one row that is not. Stale and Degraded keep their tags. *@
    <TemplateColumn T="SourceHealth" Title="State" Sortable="false">
        <CellTemplate>
            @if (context.Item.NeverRun)
            {
                <Tag>Not run</Tag>
            }
            else if (IsStale(context.Item))
            {
                <Tag State="DeskState.Negative">Stale</Tag>
            }
            else if (IsRateLow(context.Item))
            {
                <Tag State="DeskState.Warning">Degraded</Tag>
            }
            else
            {
                <span class="quiet">Healthy</span>
            }
        </CellTemplate>
    </TemplateColumn>
</DeskGrid>
</PanelSection>

<PanelSection Title="Open alerts">

@* Nothing open is a sentence, not an empty table: a header row with nothing under it reads as a
   table that failed to fill, and this is the all-clear the window exists to give. *@
@if (_alerts.Count == 0)
{
    <p class="opsnone">No open alerts. Every source is inside its SLO.</p>
}
else
{
<DeskGrid T="Alert" Items="_alerts" EmptyText="No open alerts. Every source is inside its SLO.">
    <PropertyColumn T="Alert" TProperty="AlertSeverity" Property="a => a.Severity" Title="Severity"
                    InitialDirection="SortDirection.Descending">
        <CellTemplate>
            <Tag State="@SeverityState(context.Item.Severity)">@SeverityName(context.Item.Severity)</Tag>
        </CellTemplate>
    </PropertyColumn>

    @* The rule's name in words; its key, which is what the runbook is filed under, on hover. *@
    <PropertyColumn T="Alert" TProperty="string" Property="a => a.RuleKey" Title="Rule">
        <CellTemplate><span class="dim" title="@context.Item.RuleKey">@RuleName(context.Item.RuleKey)</span></CellTemplate>
    </PropertyColumn>

    <PropertyColumn T="Alert" TProperty="string" Property="a => a.Message" Title="What happened">
        <CellTemplate><span class="trunc" title="@context.Item.Message">@context.Item.Message</span></CellTemplate>
    </PropertyColumn>

    <PropertyColumn T="Alert" TProperty="DateTimeOffset" Property="a => a.TriggeredAt" Title="Age" Align="Align.Right">
        <CellTemplate>
            <span class="dim">@Age((DateTimeOffset.UtcNow - context.Item.TriggeredAt).TotalMinutes)</span>
        </CellTemplate>
    </PropertyColumn>

    <TemplateColumn T="Alert" Title="" Sortable="false" Align="Align.Right">
        <CellTemplate>
            @if (context.Item.IncidentId is null)
            {
                @if (Manager.Access.CanOperate)
                {
                    <DeskButton Size="DeskKeySize.Small" Emphasis="DeskEmphasis.Tinted"
                                OnClick="() => PromoteAsync(context.Item.Id)">
                        Open incident
                    </DeskButton>
                }
            }
            else
            {
                <DeskLink Destination="incident"
                          Icon="@Icons.Material.Filled.ReportProblem"
                          OnClick="() => Manager.OpenIncident(context.Item.IncidentId.Value)">
                    <span class="num">#@context.Item.IncidentId</span>
                </DeskLink>
            }
        </CellTemplate>
    </TemplateColumn>
</DeskGrid>
}
</PanelSection>
}

@* The drill breaks a source on purpose; a visitor watches the result, never causes it.

   A grouped form: each injectable source a row, its name leading and its fault trailing; what
   the drill does is the group's footer, not a filled note above it; and the key that runs it
   leads under the group. It was a note box, then rows laid out with an inline min-width, then
   the key — three shapes for one form. *@
@if (Manager.Access.CanOperate)
{
    <PanelSection Title="On-call drill">
        @if (_injectable.Count > 0)
        {
            <div class="wgroup opsgroup opsgroup--wide">
                @foreach (var source in _injectable)
                {
                    <div class="wgroup__row wgroup__row--form" @key="source.Id">
                        <span class="wgroup__label">@source.Name</span>
                        <div class="opsrow">
                            <DeskSelect TValue="string"
                                        Value="@(source.FailureMode ?? "")"
                                        ValueChanged="v => SetModeAsync(source.Id, v)"
                                        aria-label="@($"Fault injected into {source.Name}")">
                                <option value="">Healthy</option>
                                <option value="error">Upstream 503</option>
                                <option value="timeout">Request timeout</option>
                                <option value="empty">Empty payload (silent)</option>
                            </DeskSelect>
                            @if (source.FailureMode is not null)
                            {
                                <Tag State="DeskState.Negative">Injecting</Tag>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            @* Said rather than implied. With no injectable source registered the footer still
               promises "inject a fault" and nothing on screen offers one, which reads as a missing
               control rather than as a missing adapter. *@
            <p class="opsfoot">
                No registered source accepts fault injection, so there is nothing to break on
                purpose. The drill still exercises the ingest → rollup → alert path.
            </p>
        }

        <p class="@(_injectable.Count > 0 ? "wgroup__foot opsfoot" : "opsfoot")">
            Inject a fault, run an ingest, and watch the alert fire. <strong>Empty payload</strong> is the
            one that matters — it returns HTTP 200 with no rows, so it would otherwise pass silently.
            With no fault injected the run is a real metered pull, so it scans the league with the most
            games still to start rather than a league named in the code.
        </p>

        <div class="opsact">
            <DeskButton Emphasis="DeskEmphasis.Tinted" Icon="@Icons.Material.Filled.PlayArrow"
                        OnClick="DrillAsync" Busy="@_busy">
                Run ingest &amp; evaluate
            </DeskButton>
        </div>
    </PanelSection>
}

@code {
    protected override IReadOnlySet<string> Watches { get; } = new HashSet<string> { DataTopics.Runs, DataTopics.Alerts };

    protected override Task RefreshAsync() => LoadAsync();

    private IReadOnlyList<SourceHealth> _health = [];
    private IReadOnlyList<OddsProviderState> _feeds = [];
    private PollPlan? _plan;

    private LineOps.Ingestion.Configuration.LinePollingOptions LinePolling => Ingestion.Value.LinePolling;

    /// <summary>Whether lines are scanned unasked — the stored choice where there is one, else configuration.</summary>
    private bool _unattended;
    private bool _pollingSetHere;
    private bool _confirmAutomatic;

    private async Task SetPollingAsync(bool automatic)
    {
        await using var scope = ScopeFactory.CreateAsyncScope();
        var db = scope.ServiceProvider.GetRequiredService<LineOpsDbContext>();

        await db.SetSettingAsync(AppSetting.LinePolling,
            automatic ? AppSetting.LinePollingScheduled : AppSetting.LinePollingManual);

        _confirmAutomatic = false;
        Toasts.Success(automatic
            ? "Lines are scanned automatically, paced to the allowance."
            : "Lines are pulled on request only. Nothing more is spent unasked.");

        await LoadAsync();
    }

    /// <summary>The two ways lines are fetched, as the Scanning row's segments.</summary>
    private static readonly IReadOnlyList<DeskSwitchOption<bool>> ScanModes =
    [
        new(false, "On request", "Lines are pulled only when Pull lines is pressed"),
        new(true, "Automatic", "Lines are scanned on a schedule, paced to the allowance")
    ];

    /// <summary>
    /// The segment pressed. Automatic is held on the confirm row until it is said yes to, so the
    /// control shows the choice while the question beside it is open; On request stops spending
    /// at once, and pressing the mode already in force withdraws a pending question.
    /// </summary>
    private async Task ChooseScanningAsync(bool automatic)
    {
        if (automatic == _unattended)
        {
            _confirmAutomatic = false;
            return;
        }

        if (automatic)
        {
            _confirmAutomatic = true;
            return;
        }

        await SetPollingAsync(automatic: false);
    }

    /// <summary>The switch is the operator's, and only offered when there is a live feed to scan.</summary>
    private bool ShowsScanning => Manager.Access.CanOperate && _feeds.Any(f => f.IsLive);

    /// <summary>
    /// The prose under the feeds is the Scanning group's footer when the group is drawn, inset to
    /// its rows; without it, the same lines are the section's footnotes, flush with the grid.
    /// </summary>
    private string FootClass => ShowsScanning ? "wgroup__foot opsfoot" : "opsfoot";

    /// <summary>
    /// Where the mode in force came from — said only beside the switch that sets it. It follows
    /// a sentence, and Razor drops the whitespace before an expression, so the space is its own.
    /// </summary>
    private string? Provenance => !ShowsScanning
        ? null
        : _pollingSetHere
            ? " Chosen here, for this host and the worker alike."
            : " Set by configuration until it is chosen here.";

    private IReadOnlyList<SportMarkets> _marketsBySport = [];

    /// <summary>A provider by the name the feeds table gives it; the planner reports its key.</summary>
    private string FeedName(string key)
        => _feeds.FirstOrDefault(f => string.Equals(f.Key, key, StringComparison.OrdinalIgnoreCase))?.Name ?? key;

    /// <summary>A market by its display name, as the board's headers spell it.</summary>
    private static string MarketName(string market) => market switch
    {
        Markets.Moneyline => "Moneyline",
        Markets.Spread => "Spread",
        Markets.Total => "Total",
        _ => market
    };

    /// <summary>
    /// A rule by name rather than by key: "volume_anomaly" reads as "Volume anomaly". The key
    /// stays on the cell's tooltip, because it is what the runbook files the rule under.
    /// </summary>
    private static string RuleName(string key)
        => string.IsNullOrEmpty(key) ? key : char.ToUpperInvariant(key[0]) + key[1..].Replace('_', ' ');

    /// <summary>Severity as a word, not an enum member: Warn reads as Warning.</summary>
    private static string SeverityName(AlertSeverity severity) => severity switch
    {
        AlertSeverity.Warn => "Warning",
        _ => severity.ToString()
    };

    /// <summary>A cadence read as minutes until it is long enough to read as hours.</summary>
    private static string Cadence(TimeSpan interval)
        => interval.TotalHours >= 1
            ? $"{interval.TotalHours:0.#}h"
            : $"{interval.TotalMinutes:0.#}m";

    private IReadOnlyList<Alert> _alerts = [];
    private List<Source> _injectable = [];
    private int _healthy;
    private int _criticals;
    private int _openIncidents;
    private long _rowsToday;
    private bool _busy;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    // Pulled out of the markup when the table became a grid: a cell template evaluates per
    // render, and both of these were previously computed once per row in a foreach.
    private bool IsStale(SourceHealth h)
        => !h.NeverRun && h.IsStale(Options.Value.FreshnessSlo);

    private bool IsRateLow(SourceHealth h)
        => h.RunsInWindow >= 3 && h.SuccessRate < Options.Value.SuccessRateSlo;

    protected override string LoadSubject => "Source health";

    // This window is the reason the pulse exists: it reports the platform's worst state,
    // so a minimised Ops window still shows red when something breaches.
    private Task LoadAsync() => WithActivityAsync(ReadAsync,
        () => _criticals > 0 ? PulseState.Critical
            : _alerts.Count > 0 ? PulseState.Warn
            : PulseState.Healthy,
        () => _alerts.Count == 0 ? "all clear" : $"{_alerts.Count} open");

    private async Task ReadAsync()
    {
        await using var scope = ScopeFactory.CreateAsyncScope();
        var kpi = scope.ServiceProvider.GetRequiredService<KpiCalculator>();
        var alerts = scope.ServiceProvider.GetRequiredService<AlertEngine>();
        var registry = scope.ServiceProvider.GetRequiredService<SourceRegistry>();
        var db = scope.ServiceProvider.GetRequiredService<LineOpsDbContext>();

        _feeds = scope.ServiceProvider.GetRequiredService<OddsFeedStatus>().Describe();

        _pollingSetHere = await db.GetSettingAsync(AppSetting.LinePolling) is not null;
        _unattended = await db.LinesRunUnattendedAsync(LinePolling.RunsUnattended);

        // Recomputed here rather than read off the scheduler: it is a pure function of the
        // budget already spent, so the panel and the scheduler reach the same answer without
        // the panel needing a handle on a background service.
        var planner = scope.ServiceProvider.GetRequiredService<LinePollPlanner>();
        var oddsKeys = registry.OddsSources.Select(s => s.Key).ToList();
        _plan = await planner.PlanAsync(oddsKeys);
        _marketsBySport = oddsKeys.Count == 0 ? [] : planner.MarketsBySport(oddsKeys);

        var o = Options.Value;

        _health = await kpi.GetAllHealthAsync(o.SuccessRateWindow, o.VolumeBaselineDays);
        _alerts = await alerts.GetOpenAlertsAsync();
        _healthy = _health.Count(h => h.NeverRun || !h.IsStale(o.FreshnessSlo));
        _criticals = _alerts.Count(a => a.Severity == AlertSeverity.Critical);
        _openIncidents = await db.Incidents.CountAsync(i => i.Status != IncidentStatus.Resolved);

        var dayStart = new DateTimeOffset(DateTime.UtcNow.Date, TimeSpan.Zero);
        _rowsToday = await db.IngestionRuns
            .Where(r => r.StartedAt >= dayStart)
            .SumAsync(r => (long?)r.RowsIngested) ?? 0;

        var keys = registry.OddsSources.OfType<IFailureInjectable>().Cast<IOddsSource>().Select(s => s.Key)
            .Concat(registry.StatsSources.OfType<IFailureInjectable>().Cast<IStatsSource>().Select(s => s.Key))
            .ToList();

        _injectable = await db.Sources.Where(s => keys.Contains(s.Key)).OrderBy(s => s.Name).ToListAsync();
    }

    // Identity, not arithmetic. The same EvaluateAsync pass that opens an alert also
    // auto-resolves any whose condition has cleared, so a count delta reports zero — or a
    // negative — for a pass that genuinely raised something. On a drill that is the exact
    // answer being asked for, so the two are compared by id.
    private HashSet<long> OpenAlertIds() => _alerts.Select(a => a.Id).ToHashSet();

    private int CountNew(HashSet<long> seen) => _alerts.Count(a => !seen.Contains(a.Id));

    private static DeskState SeverityState(AlertSeverity severity) => severity switch
    {
        AlertSeverity.Critical => DeskState.Negative,
        AlertSeverity.Warn => DeskState.Warning,
        _ => DeskState.Info
    };

    private async Task EvaluateAsync()
    {
        _busy = true;
        Report(PulseState.Active, "evaluating");

        try
        {
            await using var scope = ScopeFactory.CreateAsyncScope();
            await scope.ServiceProvider.GetRequiredService<KpiCalculator>().RollupDailyAsync();
            await scope.ServiceProvider.GetRequiredService<AlertEngine>().EvaluateAsync();

            var seen = OpenAlertIds();
            await LoadAsync();

            // A pass that changes nothing repaints identically to one that did not run, and
            // the rollup takes long enough that the operator has usually looked away. The
            // notice reports the outcome, not the click — and it is transient because the
            // alert table below is the durable record either way.
            var opened = CountNew(seen);

            if (_criticals > 0)
                Toasts.Warn($"Evaluated — {_alerts.Count} open, {_criticals} critical.");
            else if (opened > 0)
                Toasts.Warn($"Evaluated — {opened} new alert{(opened == 1 ? "" : "s")} opened.");
            else
                Toasts.Success($"Evaluated — {(_alerts.Count == 0 ? "every source inside its SLO" : $"{_alerts.Count} open, none critical")}.");
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// Games inside the movement window, by sport slug — what the drill reads to decide which
    /// league is worth spending a credit on. The window is the ingestion one so the drill and a
    /// real pull agree about which fixtures are still priceable.
    /// </summary>
    private async Task<IReadOnlyDictionary<string, int>> UpcomingBySportAsync(IServiceProvider provider)
    {
        var db = provider.GetRequiredService<LineOpsDbContext>();
        var horizon = DateTimeOffset.UtcNow + Ingestion.Value.MovementWindow;

        var counts = await db.Games
            .Where(g => g.StartsAt > DateTimeOffset.UtcNow && g.StartsAt <= horizon)
            .GroupBy(g => g.Sport!.Key)
            .Select(g => new { Sport = g.Key, Count = g.Count() })
            .ToListAsync();

        return counts.ToDictionary(c => c.Sport, c => c.Count, StringComparer.OrdinalIgnoreCase);
    }

    private async Task SetModeAsync(int sourceId, string? mode)
    {
        await using var scope = ScopeFactory.CreateAsyncScope();
        var db = scope.ServiceProvider.GetRequiredService<LineOpsDbContext>();

        var source = await db.Sources.FirstAsync(s => s.Id == sourceId);
        source.FailureMode = string.IsNullOrEmpty(mode) ? null : mode;
        await db.SaveChangesAsync();

        await LoadAsync();
    }

    private async Task DrillAsync()
    {
        _busy = true;
        Report(PulseState.Active, "drill running");

        try
        {
            await using var scope = ScopeFactory.CreateAsyncScope();
            var registry = scope.ServiceProvider.GetRequiredService<SourceRegistry>();
            var ingestion = scope.ServiceProvider.GetRequiredService<OddsIngestionService>();

            var sport = IngestionJobs.DrillSport(
                await UpcomingBySportAsync(scope.ServiceProvider),
                Ingestion.Value.EffectiveSports);

            if (sport is null)
            {
                Toasts.Warn("Drill skipped — no league is configured to scan.");
                return;
            }

            foreach (var source in registry.OddsSources)
                await ingestion.IngestAsync(source, sport, "odds:drill", CancellationToken.None);

            await scope.ServiceProvider.GetRequiredService<KpiCalculator>().RollupDailyAsync();
            await scope.ServiceProvider.GetRequiredService<AlertEngine>().EvaluateAsync();

            var seen = OpenAlertIds();
            await LoadAsync();

            // The drill's whole point is "did the fault get caught?", and a drill that caught
            // nothing looks exactly like one that has not finished. Two outcomes, one line.
            var fired = CountNew(seen);

            // Naming the league is not decoration: with no fault injected the drill performs a
            // real, metered pull, and an operator who cannot see what it bought cannot tell a
            // drill from a spend.
            var league = sport.ToUpperInvariant();

            if (fired > 0)
                Toasts.Success($"Drill complete on {league} — {fired} alert{(fired == 1 ? "" : "s")} fired.");
            else
                Toasts.Warn($"Drill complete on {league} — no new alerts fired.");
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task PromoteAsync(long alertId)
    {
        await using var scope = ScopeFactory.CreateAsyncScope();
        var incidents = scope.ServiceProvider.GetRequiredService<IncidentService>();

        await incidents.PromoteAsync(alertId);
        await LoadAsync();

        // Raise the incidents window so the promotion has somewhere visible to land.
        var definition = WindowCatalog.Find(WindowCatalog.Incidents);
        if (definition is not null)
            Manager.Open(definition);
    }
}

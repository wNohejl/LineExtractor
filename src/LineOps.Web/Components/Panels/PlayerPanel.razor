@using LineOps.Data
@using LineOps.Data.CrossReference
@using LineOps.Web.Components.Desk
@using LineOps.Web.Windowing
@using Microsoft.EntityFrameworkCore
@inherits PanelBase
@inject IDbContextFactory<LineOpsDbContext> DbFactory
@inject IServiceScopeFactory ScopeFactory

@*
    A player on their own — the bottom of the drilldown chain, and until now the piece that was
    missing.

    Following a player's name used to open the Players <i>list</i> focused on them, which is a
    roster view: it answers "who is on this team", not "how has this player been going". The
    game log is the answer to the second question, and it is the data every roster aggregate on
    the desk was already computed from without ever being shown.

    Columns are derived from the lines rather than fixed, because stat lines are per-sport jsonb
    and no fixed column set fits baseball and hockey both.
*@

@if (_player is null)
{
    <EmptyState>Loading the player…</EmptyState>
}
else
{
    <div class="row" style="margin-bottom:2px; align-items:baseline; flex-wrap:wrap">
        <PanelHeader Tight>@_player.FullName</PanelHeader>
        @if (_player.Position is { } position)
        {
            <Tag>@position</Tag>
        }
        @if (_seasonYear is { } seasonYear && _player.Sport?.Key is { } sportKey)
        {
            <Tag State="DeskState.Info">@SeasonCalendar.Label(sportKey, seasonYear) season</Tag>
        }
        @if (_player.Team?.Name is { } team)
        {
            <DeskLink Destination="team" Icon="@Icons.Material.Filled.Shield"
                      OnClick="() => Manager.OpenTeam(_player.TeamId!.Value, team)">@team</DeskLink>
        }
    </div>

    <div class="row" style="margin-bottom:14px">
        <span class="dim" style="font-size:11.5px">
            @_rows.Count @(_rows.Count == 1 ? "appearance" : "appearances") @SeasonPhrase
        </span>

        @* One position per season the player has appeared in, newest first. A player with a
           single season sees no gate — one season is not a choice. *@
        <DeskSwitch Options="_seasonOptions" Label="Season" Mono="true"
                    style="margin-left:auto"
                    Value="_seasonYear ?? 0" ValueChanged="@((int year) => SetSeasonAsync(year))" />
    </div>

    @if (_rows.Count == 0)
    {
        <EmptyState Kind="EmptyStateKind.New">
            No appearances on record. A player enters the desk through a box score, so one with
            no games has been named on a roster but not yet played inside the history held.
        </EmptyState>
    }
    else
    {
        <PanelHeader Level="4">Averages</PanelHeader>

        @* The aggregate every other view shows, kept here beside the games behind it so the
           two can be read against each other rather than one standing in for the other. *@
        <div class="snippet__facts" style="margin-bottom:16px">
            @foreach (var column in _columns.Take(6))
            {
                <div class="fact">
                    <div class="fact__label">@column</div>
                    <div class="fact__value mono">@Average(column)</div>
                </div>
            }
        </div>

        <PanelHeader Level="4">Game log</PanelHeader>

        @* The log is the one view on the desk where sorting is the point rather than a
           convenience: "which were the big games" and "how did the away nights go" are both
           questions about this table, and neither can be asked of a fixed date order. *@
        <div class="gridwrap">
            <DeskGrid T="PlayerGameRow" Items="_rows"
                      EmptyText="No appearances on record for this player.">
                <PropertyColumn T="PlayerGameRow" TProperty="DateTimeOffset" Property="r => r.StartsAt"
                                Title="Date" InitialDirection="SortDirection.Descending">
                    <CellTemplate><span class="dim">@Day(context.Item.StartsAt)</span></CellTemplate>
                </PropertyColumn>

                <PropertyColumn T="PlayerGameRow" TProperty="string" Property="r => r.Opponent" Title="Opponent">
                    <CellTemplate>
                        <DeskLink Destination="game" Icon="@Icons.Material.Filled.SportsScore"
                                  OnClick="() => OpenGameAsync(context.Item.GameId)">
                            @(context.Item.Home ? "vs" : "at") @context.Item.Opponent
                        </DeskLink>
                    </CellTemplate>
                </PropertyColumn>

                <PropertyColumn T="PlayerGameRow" TProperty="bool?" Property="r => r.Won"
                                Title="Result" Align="Align.Right">
                    <CellTemplate>
                        @if (context.Item.Won is { } won)
                        {
                            <span class="tag @(won ? "tag--good" : "tag--bad")">
                                @(won ? "W" : "L")@(context.Item.HasScore ? $" {context.Item.ScoreFor}-{context.Item.ScoreAgainst}" : "")
                            </span>
                        }
                        else
                        {
                            <span class="dim">—</span>
                        }
                    </CellTemplate>
                </PropertyColumn>

                @* Stat columns are per-sport jsonb, so they are declared from the data. They sort
                   as numbers where the line parses as one and fall back to the raw text where it
                   does not — "6.0 IP" and "39:09" are real values that are not doubles, and the
                   Averages strip above already refuses to coerce them. *@
                @foreach (var c in _columns)
                {
                    var key = c;
                    <TemplateColumn T="PlayerGameRow" Title="@key" Align="Align.Right"
                                    SortBy="@(r => StatSortKey(r, key))">
                        <CellTemplate>
                            <span class="mono">@(context.Item.Stats.TryGetValue(key, out var v) ? v : "—")</span>
                        </CellTemplate>
                    </TemplateColumn>
                }
            </DeskGrid>
        </div>
    }
}

@code {
    /// <summary>
    /// The player this view is about. Taken as an id rather than an object so the view can be
    /// hosted as a desk window, which is rebuilt from its parameters and cannot carry a
    /// reference.
    /// </summary>
    [Parameter, EditorRequired] public int PlayerId { get; set; }

    private Core.Entities.Player? _player;
    private IReadOnlyList<PlayerGameRow> _rows = [];
    private List<string> _columns = [];

    /// <summary>The season on screen; null only for a player with no appearance on record.</summary>
    private int? _seasonYear;
    private IReadOnlyList<int> _seasons = [];
    private IReadOnlyList<DeskSwitchOption<int>> _seasonOptions = [];

    /// <summary>A whole season, not a cap: the log is the season's games, however many.</summary>
    private const int WholeSeason = int.MaxValue;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private string SeasonPhrase => _seasonYear is { } year && _player?.Sport?.Key is { } sport
        ? $"in the {SeasonCalendar.Label(sport, year)} season"
        : "on record";

    private async Task SetSeasonAsync(int year)
    {
        _seasonYear = year;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await WithActivityAsync(async () =>
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            _player = await db.Players
                .Include(p => p.Team)
                .Include(p => p.Sport)
                .AsNoTracking()
                .FirstOrDefaultAsync(p => p.Id == PlayerId);

            if (_player is null)
                return;

            await using var scope = ScopeFactory.CreateAsyncScope();
            var log = scope.ServiceProvider.GetRequiredService<GameLogService>();

            _seasons = await log.SeasonsForPlayerAsync(PlayerId);

            if (_seasonYear is null || !_seasons.Contains(_seasonYear.Value))
                _seasonYear = _seasons.Count > 0 ? _seasons[0] : null;

            var sport = _player.Sport?.Key ?? string.Empty;
            _seasonOptions = _seasons
                .Select(y => new DeskSwitchOption<int>(y, SeasonCalendar.Label(sport, y),
                    $"{sport.ToUpperInvariant()} {SeasonCalendar.Label(sport, y)} season"))
                .ToList();

            _rows = await log.PlayerGameLogAsync(PlayerId, WholeSeason, _seasonYear);

            // Wider than the snippet's, because a window has the room and the whole point of
            // opening it was that the snippet did not show enough.
            _columns = Snippets.PlayerRecentSnippet.DeriveColumns(_rows, 8);
        },
        settle: () => _player is null ? PulseState.Idle : PulseState.Healthy,
        status: () => _player is null ? "not found" : $"{_rows.Count} games");
    }

    private async Task OpenGameAsync(int gameId)
    {
        await using var scope = ScopeFactory.CreateAsyncScope();
        var board = scope.ServiceProvider.GetRequiredService<BoardService>();

        if (await board.GetRowAsync(gameId) is { } row)
            Manager.OpenGame(row.Game);
    }

    /// <summary>
    /// The sort key for a derived stat column.
    ///
    /// <para>
    /// Every key is a double so one column never mixes comparable types — a sort that throws
    /// mid-render is worse than a column that does not move. A line the desk cannot read as a
    /// number sinks to the bottom rather than being ranked as a zero, which is the same call
    /// <see cref="Average"/> makes when it shows a dash: absent and none are different answers.
    /// </para>
    ///
    /// <para>
    /// The leading-number fallback earns its place on the lines that carry a unit — "6.0 IP"
    /// sorts on 6.0 — because those are ordinary readings rather than malformed ones, and a
    /// whole column of innings that refuses to sort is the common case, not the edge one.
    /// </para>
    /// </summary>
    private static double StatSortKey(PlayerGameRow row, string key)
    {
        if (!row.Stats.TryGetValue(key, out var raw) || string.IsNullOrWhiteSpace(raw))
            return double.MinValue;

        const System.Globalization.NumberStyles Styles = System.Globalization.NumberStyles.Float;
        var invariant = System.Globalization.CultureInfo.InvariantCulture;

        if (double.TryParse(raw, Styles, invariant, out var value))
            return value;

        // Take the numeric head of things like "6.0 IP", and only that — a value the desk has
        // to guess at is a value it should not be ordering on.
        var end = 0;
        while (end < raw.Length && (char.IsAsciiDigit(raw[end]) || raw[end] is '.' or '-' or '+'))
            end++;

        return end > 0 && double.TryParse(raw[..end], Styles, invariant, out var head)
            ? head
            : double.MinValue;
    }

    /// <summary>
    /// The mean of a stat across the games listed.
    ///
    /// Only numeric values are averaged; a line that reports "6.0 IP" or a time of "39:09"
    /// shows a dash rather than being coerced, on the same reasoning the aggregate side uses —
    /// a wrong number is worse than a missing one.
    /// </summary>
    private string Average(string key)
    {
        var values = _rows
            .Select(r => r.Stats.TryGetValue(key, out var raw)
                && double.TryParse(raw, System.Globalization.NumberStyles.Float,
                    System.Globalization.CultureInfo.InvariantCulture, out var v)
                ? (double?)v
                : null)
            .Where(v => v is not null)
            .Select(v => v!.Value)
            .ToList();

        if (values.Count == 0)
            return "—";

        // Whole numbers every time means this counts things, and a per-game mean is the right
        // summary. A fractional value anywhere means it is already a rate.
        var mean = values.Average();
        var counting = values.All(v => Math.Abs(v % 1) < 1e-9);

        return mean.ToString(counting ? "0.##" : "0.000");
    }
}

@using LineOps.Core.Analytics
@using LineOps.Data.CrossReference
@using LineOps.Desk.Primitives
@using LineOps.Web.Services
@inject IWagerData Data
@inject WindowManager Manager
@inject DeskFollowUps FollowUps
@inject WagerSlip Slip
@inject DeskToasts Toasts

@*
    Every book's number on every market for one game.

    The board deliberately shows one price per market — the best — because a board that showed
    four would be four boards. This is where the rest of it lives: the same data the rail
    summarises, laid out to be read rather than scanned.
*@

@if (Row is null)
{
    <EmptyState>Loading the market…</EmptyState>
}
else if (Row.Unpriced is { } reason)
{
    <Note State="DeskState.Warning">@reason</Note>
}
else
{

<Note>
    Best price on each line is lit. Everything else is what you would be giving up by taking it
    somewhere else.
</Note>

@foreach (var market in Markets())
{
    <PanelSection Title="@MarketName(market.Market)">

    @if (!market.IsPriced)
    {
        <EmptyState Kind="EmptyStateKind.New" Style="padding:6px 0 12px">Not priced by any book yet.</EmptyState>
    }
    else
    {
        @if (FairOf(market) is { Length: > 0 } fair)
        {
            <div class="meta" style="margin:2px 0 6px">@fair</div>
        }

        <div class="gridwrap">
            <DeskGrid T="string" Items="BooksIn(market)" EmptyText="Not priced by any book yet.">
                <PropertyColumn T="string" TProperty="string" Property="b => b" Title="Book">
                    <CellTemplate><span class="mono dim">@context.Item</span></CellTemplate>
                </PropertyColumn>

                @* The prices are rendered rather than projected — the best-price lighting lives
                   in Cell — so there is nothing here for Mud to sort on. *@
                <TemplateColumn T="string" Title="@SideName(market, first: true)"
                                Align="Align.Right" Sortable="false">
                    <CellTemplate>@Cell(market, market.First, context.Item)</CellTemplate>
                </TemplateColumn>

                <TemplateColumn T="string" Title="@SideName(market, first: false)"
                                Align="Align.Right" Sortable="false">
                    <CellTemplate>@Cell(market, market.Second, context.Item)</CellTemplate>
                </TemplateColumn>

                @* What the book keeps: its two prices' overshoot past certainty. The cheapest
                   book to bet into over a season is the one with the lowest number here. *@
                <TemplateColumn T="string" Title="Hold" Align="Align.Right" Sortable="false">
                    <CellTemplate>
                        @if (HoldOf(market, context.Item) is { } hold)
                        {
                            <span class="mono dim">@((hold * 100).ToString("0.0"))%</span>
                        }
                        else
                        {
                            <span class="dim" title="This book does not quote both sides on the same number.">—</span>
                        }
                    </CellTemplate>
                </TemplateColumn>
            </DeskGrid>
        </div>
    }
    </PanelSection>
}

}

@code {
    /// <summary>
    /// The game this view is about. Taken as an id rather than a row so the view can be hosted
    /// as a desk window, which is rebuilt from its parameters and cannot carry an object.
    /// </summary>
    [Parameter, EditorRequired] public int GameId { get; set; }

    private BoardRow? Row;


    protected override async Task OnParametersSetAsync()
        => Row = await Data.RowAsync(GameId);

    private IEnumerable<MarketPair> Markets()
    {
        if (Row is null)
            yield break;

        yield return Row.Moneyline;
        yield return Row.Spread;
        yield return Row.Total;
    }

    private static string MarketName(string market) => market switch
    {
        LineOps.Core.Entities.Markets.Moneyline => "Moneyline",
        LineOps.Core.Entities.Markets.Spread => "Spread",
        LineOps.Core.Entities.Markets.Total => "Total",
        _ => market
    };

    private string SideName(MarketPair market, bool first)
    {
        var offer = first ? market.First : market.Second;

        if (offer is not null)
            return offer.Outcome;

        return market.Market == LineOps.Core.Entities.Markets.Total
            ? (first ? "Over" : "Under")
            : (first ? Row!.Game.HomeTeam?.Name ?? "Home" : Row!.Game.AwayTeam?.Name ?? "Away");
    }

    /// <summary>Every book quoting either side, so a book missing one side still gets a row.</summary>
    private static IReadOnlyList<string> BooksIn(MarketPair market)
        => (market.First?.Rungs.Select(r => r.Book) ?? [])
            .Concat(market.Second?.Rungs.Select(r => r.Book) ?? [])
            .Distinct()
            .OrderBy(b => b)
            .ToList();

    private RenderFragment Cell(MarketPair market, BestOffer? offer, string book) => builder =>
    {
        var rung = offer?.Rungs.FirstOrDefault(r => r.Book == book);

        if (offer is null || rung is null)
        {
            builder.AddContent(0, "—");
            return;
        }

        // A live rung is a door (spec §5.3): it opens the wager window on this book's price.
        // A close stays a reading, since it can no longer be taken.
        // On a visitor's desk nothing is a door: there is no wager window to open (ADR 0018).
        var live = !offer.IsClosing && Manager.Access.CanOperate;

        if (live)
        {
            builder.OpenElement(1, "button");
            builder.AddAttribute(2, "type", "button");
            builder.AddAttribute(3, "class", "take");
            builder.AddAttribute(4, "title", "Click to log this price. Shift-click adds it to the slip as a parlay leg.");
            builder.AddAttribute(5, "onclick", EventCallback.Factory.Create<MouseEventArgs>(this,
                (MouseEventArgs e) => { if (e.ShiftKey) Bank(market, offer, book); else Take(market, offer, book); }));
        }

        var isBest = book == offer.Book;

        builder.OpenElement(6, "span");
        builder.AddAttribute(7, "class", isBest ? "up" : "dim");

        var line = rung.Line is { } l ? OddsMath.FormatLine(l, offer.Outcome) + " " : "";
        builder.AddContent(8, line + OddsMath.FormatPrice(rung.PriceAmerican));

        builder.CloseElement();

        // Value against the fair price, where this book's number has one. Positive is lit in
        // the same tone as the best price: both are reasons to bet here.
        if (rung.Ev is { } ev && live)
        {
            builder.OpenElement(9, "span");
            builder.AddAttribute(10, "class", ev > 0 ? "rung__ev up" : "rung__ev dim");
            builder.AddAttribute(11, "style", "margin-left:6px");
            builder.AddContent(12, PriceCell.EvLabel(ev));
            builder.CloseElement();
        }

        if (live)
            builder.CloseElement();
    };

    /// <summary>Door 3: a book's live price opens the wager window on that side at that book.</summary>
    private void Take(MarketPair market, BestOffer offer, string book)
    {
        if (Row is null)
            return;

        var matchup = $"{Row.Game.AwayTeam?.Name ?? "Away"} at {Row.Game.HomeTeam?.Name ?? "Home"}";

        // Door 3 floats above the desk when it is full, as the Board's doors do — on the desk's
        // own layer, not one drawn in here: Every book is often itself a floating dialog, and a
        // dialog drawn inside another is positioned against it and clipped by it.
        FollowUps.Launcher.Launch(Manager, WindowCatalog.Wager, new Dictionary<string, object>
        {
            ["GameId"] = Row.Game.Id,
            ["Market"] = market.Market,
            ["Outcome"] = offer.Outcome,
            ["Book"] = book
        }, Row.Game.Id, matchup, "480px");
    }

    /// <summary>Door 3, shifted: this book's live price goes onto the slip as a parlay leg.</summary>
    private void Bank(MarketPair market, BestOffer offer, string book)
    {
        if (Row is null || WagerOffer.AtBook(market.Market, offer, book) is not { } price)
            return;

        var matchup = $"{Row.Game.AwayTeam?.Name ?? "Away"} at {Row.Game.HomeTeam?.Name ?? "Home"}";
        Slip.AddLeg(price.ToSlipItem(Row.Game, matchup, 0m, null));

        var legs = Slip.Items.Count(i => i.AsLeg);
        Toasts.Success($"Leg added: {price.Label} {OddsMath.FormatPrice(price.PriceAmerican)} ({price.Book}) · "
                       + $"{legs} {(legs == 1 ? "leg" : "legs")} on the slip.");
    }

    /// <summary>A book's margin on a market, read from whichever side it quotes a pair on.</summary>
    private static double? HoldOf(MarketPair market, string book)
        => market.First?.Rungs.FirstOrDefault(r => r.Book == book)?.Hold
           ?? market.Second?.Rungs.FirstOrDefault(r => r.Book == book)?.Hold;

    /// <summary>
    /// What the market's value is measured against — both sides' fair prices on the best
    /// offers' numbers — or nothing, when there is no reference to measure by.
    /// </summary>
    private static string FairOf(MarketPair market)
    {
        var sides = new[] { market.First, market.Second }
            .Where(o => o?.Fair is not null)
            .Select(o => $"{o!.Outcome}{(o.Line is { } l ? " " + OddsMath.FormatLine(l, o.Outcome) : "")} {OddsMath.FormatPrice(o.Fair!.PriceAmerican)}")
            .ToList();

        if (sides.Count == 0)
            return string.Empty;

        var basis = (market.First?.Fair ?? market.Second?.Fair)!;
        var source = basis.Basis == FairValue.SharpBook ? "Pinnacle, no-vig" : $"{basis.Books}-book no-vig consensus";

        return $"Fair: {string.Join(" / ", sides)} ({source})";
    }
}

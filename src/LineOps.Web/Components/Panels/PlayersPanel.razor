@using LineOps.Data
@using LineOps.Data.CrossReference
@using LineOps.Ingestion.Services
@using LineOps.Ingestion.Configuration
@using LineOps.Desk.Windowing
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Options
@inherits PanelBase
@inject IDbContextFactory<LineOpsDbContext> DbFactory
@inject IServiceScopeFactory ScopeFactory
@inject IOptions<IngestionOptions> IngestionOptions

@*
    The roster finder. It used to keep a game log of its own, a second and lesser copy of the
    Player window; a player's name now opens that window, and a team's name the Team window —
    this list finds people, and the windows it opens say how they have been going.
*@
<PanelToolbar Actions="@(Manager.Access.CanOperate ? SyncKey : null)">
    <ChildContent>
        <DeskSelect TValue="string" Value="_sport" ValueChanged="OnSportChanged">
            <option value="">All sports</option>
            @foreach (var s in _sports)
            {
                <option value="@s.Id">@s.Name</option>
            }
        </DeskSelect>

        @* Filters as you type, after a pause: two queries per keystroke was a query storm for
           anyone typing a whole name. A player's team works too — "judge nyy". *@
        <DeskField TValue="string" Immediate="true"
                   placeholder="Search players, or player and team" Value="_search" ValueChanged="OnSearchChanged" />
    </ChildContent>

</PanelToolbar>

@if (_syncError is not null)
{
    <Note State="DeskState.Warning">@_syncError</Note>
}

@if (Failed)
{
    <LoadFailure Message="@LoadError" OnRetry="RetryAsync" />
}

@if (!Loaded)
{
    @if (!Failed)
    {
        <DeskGrid T="Row" Items="_rows" Loading="true" LoadingLabel="Fetching players" />
    }
}
else if (_rows.Count == 0)
{
    @if (string.IsNullOrWhiteSpace(_search) && string.IsNullOrEmpty(_sport))
    {
        <EmptyState Kind="EmptyStateKind.New">
            No players yet. <strong>Sync stats</strong> pulls rosters and box scores — ESPN
            needs no key, so this works at no cost.
        </EmptyState>
    }
    else
    {
        <EmptyState Kind="EmptyStateKind.Filtered">No players match this filter.</EmptyState>
    }
}
else
{
    <DeskGrid T="Row" Items="_rows" Class="deskgrid--clickable"
              OnRowClick="@(e => Manager.OpenPlayer(e.Item.Player.Id, e.Item.Player.FullName))"
              EmptyText="No players match this filter.">
        <PropertyColumn T="Row" TProperty="string" Property="r => r.Player.FullName" Title="Player"
                        InitialDirection="SortDirection.Ascending">
            <CellTemplate>
                <DeskLink Destination="player"
                          OnClick="() => Manager.OpenPlayer(context.Item.Player.Id, context.Item.Player.FullName)">
                    @context.Item.Player.FullName
                </DeskLink>
            </CellTemplate>
        </PropertyColumn>

        <PropertyColumn T="Row" TProperty="string" Property="r => r.Player.Sport!.Name" Title="Sport" HeaderClass="col--wide" CellClass="col--wide">
            <CellTemplate><Tag>@context.Item.Player.Sport?.Name</Tag></CellTemplate>
        </PropertyColumn>

        <PropertyColumn T="Row" TProperty="string" Property="r => r.Player.Position!" Title="Pos">
            <CellTemplate><span class="dim">@(context.Item.Player.Position ?? "—")</span></CellTemplate>
        </PropertyColumn>

        <PropertyColumn T="Row" TProperty="string" Property="r => r.Player.Team!.Name" Title="Team">
            <CellTemplate>
                @if (context.Item.Player.Team is { } team)
                {
                    <DeskLink Destination="team" OnClick="() => Manager.OpenTeam(team.Id, team.Name)">@team.Name</DeskLink>
                }
                else
                {
                    <span class="dim">—</span>
                }
            </CellTemplate>
        </PropertyColumn>

        <PropertyColumn T="Row" TProperty="int" Property="r => r.Games" Title="Games" Align="Align.Right" />
    </DeskGrid>

    @if (_capped)
    {
        @* The list stops at a limit; it says so, rather than letting the last row read as the
           last player there is. *@
        <p class="empty">
            Showing the first @Limit by name. Narrow the search, or pick a sport, to see the rest.
        </p>
    }
}

@code {
    /// <summary>
    /// The one thing this window does rather than shows, so it carries the panel's weight — on
    /// the operator's desk. A visitor only reads (ADR 0018), and the toolbar's actions slot is
    /// not drawn at all.
    /// </summary>
    private RenderFragment SyncKey => @<DeskButton Emphasis="DeskEmphasis.Filled" Icon="@Icons.Material.Filled.Sync"
                                                  OnClick="SyncAsync" Busy="@_busy">Sync stats</DeskButton>;

    private const int Limit = 150;

    private record Row(Player Player, int Games);

    private List<Row> _rows = [];
    private List<Sport> _sports = [];
    private bool _sportsRead;
    private string _sport = string.Empty;
    private string _search = string.Empty;
    private bool _capped;
    private bool _busy;
    private CancellationTokenSource? _pending;

    private string? _syncError;

    protected override string LoadSubject => "The players";

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task OnSportChanged(string value)
    {
        _sport = value ?? string.Empty;
        await LoadAsync();
    }

    private async Task OnSearchChanged(string value)
    {
        _search = value ?? string.Empty;

        _pending?.Cancel();
        _pending = new CancellationTokenSource();

        try
        {
            await Task.Delay(250, _pending.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        await LoadAsync();
    }

    private Task LoadAsync() => WithActivityAsync(ReadPlayersAsync, PlayersPulse, PlayersStatus);

    private PulseState PlayersPulse() => _rows.Count == 0 ? PulseState.Idle : PulseState.Healthy;

    private string? PlayersStatus() => _rows.Count == 0 ? null : $"{_rows.Count}{(_capped ? "+" : "")} players";

    private async Task ReadPlayersAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        // With the first load that succeeds, so a failed first read still gets its picker later.
        if (!_sportsRead)
        {
            _sports = await db.Sports.Where(s => s.Enabled).OrderBy(s => s.Name).ToListAsync();
            _sportsRead = true;
        }

        var query = db.Players.AsNoTracking()
            .Include(p => p.Sport).Include(p => p.Team)
            .Where(p => p.Sport!.Enabled);

        if (int.TryParse(_sport, out var sportId))
            query = query.Where(p => p.SportId == sportId);

        // Every word must match the name or the team, with LIKE's own characters escaped, the
        // same rule the command palette uses.
        foreach (var pattern in SearchService.Patterns(_search))
        {
            query = query.Where(p => EF.Functions.ILike(p.FullName, pattern, @"\")
                                     || (p.Team != null && (EF.Functions.ILike(p.Team.Name, pattern, @"\")
                                                            || EF.Functions.ILike(p.Team.Abbrev, pattern, @"\"))));
        }

        var players = await query.OrderBy(p => p.FullName).Take(Limit + 1).ToListAsync();
        _capped = players.Count > Limit;
        players = players.Take(Limit).ToList();

        var ids = players.Select(p => p.Id).ToList();

        var counts = await db.PlayerGameStats
            .Where(s => ids.Contains(s.PlayerId))
            .GroupBy(s => s.PlayerId)
            .Select(g => new { g.Key, Count = g.Count() })
            .ToDictionaryAsync(x => x.Key, x => x.Count);

        _rows = players.Select(p => new Row(p, counts.GetValueOrDefault(p.Id, 0))).ToList();
    }

    private async Task SyncAsync()
    {
        _busy = true;
        _syncError = null;
        Report(PulseState.Active, "syncing");

        try
        {
            await using var scope = ScopeFactory.CreateAsyncScope();
            var registry = scope.ServiceProvider.GetRequiredService<SourceRegistry>();
            var stats = scope.ServiceProvider.GetRequiredService<StatsIngestionService>();

            var yesterday = LeagueClock.Today().AddDays(-1);
            var rows = 0;

            foreach (var source in registry.StatsSources)
            {
                foreach (var sport in IngestionOptions.Value.EffectiveSports)
                {
                    var outcome = await stats.IngestAsync(
                        source, sport, "stats:manual", yesterday, CancellationToken.None);
                    rows += outcome.RowsIngested;
                }
            }

            await LoadAsync();

            // A reload that failed has already said so; the sync's count would paper over it.
            if (!Failed)
                Report(PulseState.Healthy, $"+{rows:N0} rows");
        }
        catch (Exception ex)
        {
            // The type name was what the pulse used to say; it belongs in the log.
            Log.LogError(ex, "Player stats sync failed");
            Report(PulseState.Critical, "sync failed");
            _syncError = "Player stats did not sync. Try again.";
        }
        finally
        {
            _busy = false;
        }
    }

    protected override void OnDispose() => _pending?.Cancel();
}

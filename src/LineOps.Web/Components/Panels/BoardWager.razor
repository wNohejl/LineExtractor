@using LineOps.Core.Analytics
@using LineOps.Core.Entities
@using LineOps.Data.CrossReference
@using LineOps.Ingestion.Services
@using LineOps.Web.Services
@inherits PanelBase
@inject IWagerData Data
@inject WagerSlip Slip
@inject DeskToasts Toasts

@*
    The one form a bet is recorded with, from either door.

    From the Board the game and the side are already known, so the form starts filled and the
    operator supplies what the board cannot: the book they used, and how much. From the Journal it
    opens on a game search; picking a game gives the same form. There is no second form: two ways
    to record a bet drifted apart once already, and a bet recorded the wrong way is a bet the
    journal misreads.

    The price is the operator's to choose. The book is a menu on the price listing every book
    quoting the side, best marked but not forced; picking one re-reads the headline, the value,
    the checks and the returns from that book's latest number. Books can be filtered out of the
    menu (remembered with the operator's settings), and where the number taken is not one the desk
    fetched — earlier, or at a book it does not scan — the pencil on the price takes the number
    typed and the Journal tags it manual.

    A panel (spec §6): it watches the odds and the journal, so a pull re-prices an open form
    instead of leaving it quoting a number the board has moved off. A typed price is never
    re-priced. Before Log, a strip of checks says what is worth knowing (§4); only a closing line
    blocks, and only a fetched one.
*@

@*
    Laid out as a numbered stepper (DeskSteps): Game, Your bet, Price and book, Stake, Review and
    log. It was a column of same-weight sections — game, selection, price, books, checks, wager —
    and once a side and a book were chosen nothing said what had happened or what came next. Each
    step now says whether it is done, the one to do now, or waiting and on what; the step to do
    carries a sentence of guidance for someone who has never logged a bet. Every step stays on
    screen, so a finished one can be changed without paging back.

    The book is no longer a section of its own: it is a menu on the price (BookPicker), because
    "which book is this number from?" is one question with one answer. The pencil that types a
    price of your own sits on the number it replaces.
*@
@if (_loading)
{
    @* Unread is not empty (ADR 0003): the shape of what is coming, not "pick a side". *@
    <DeskStack Gap="DeskSpace.Space2" Class="wager-loading" aria-busy="true">
        <DeskSkeleton Lines="1" />
        <DeskSkeleton Shape="DeskSkeletonShape.Block" Height="64px" />
    </DeskStack>
}
else if (!Searching && Row is null)
{
    <EmptyState Kind="EmptyStateKind.New">This game is no longer on the desk.</EmptyState>
}
else
{
    <DeskSteps Label="Log a wager">
        @* ---- 1 · Game ------------------------------------------------------------------ *@
        <DeskStep Number="1" Title="Game" State="@StateOf(1)"
                  Hint="Find the game the bet was on: type a team, like Steelers, or two for the matchup. Upcoming games come first. For a future or anything without a game, choose No game.">
            @if (Searching)
            {
                <GamePicker Value="_gameId" Selected="Row?.Game" OfferNoGame="true"
                            NoGame="_noGame" NoGameChanged="SetNoGame"
                            SelectedChanged="PickGameAsync" />
            }
            else if (Row is not null)
            {
                @* Opened from a board row: the game is the door's, so it is a fact here, not a field. *@
                <div class="wgroup">
                    <div class="wgroup__row game-search__chosen">
                        <div class="game-search__text">
                            <span class="game-search__match">@Matchup(Row.Game)</span>
                            <span class="game-search__when">@GameWhen(Row.Game)</span>
                        </div>
                    </div>
                </div>
            }
        </DeskStep>

        @* ---- 2 · Your bet -------------------------------------------------------------- *@
        <DeskStep Number="2" Title="Your bet" State="@StateOf(2)"
                  Waiting="Pick a game first."
                  Hint="@(_noGame
                      ? "Describe the bet in your own words, the way you would read it back later."
                      : "Pick the side you bet. Moneyline is the winner, spread is the winning margin, total is the combined score. Hover any option to read what it wins on.")">
            @if (_noGame)
            {
                <DeskField TValue="string" Immediate="true" style="width:100%"
                           placeholder="Describe the bet, e.g. Steelers to win the AFC North"
                           aria-label="The bet" Value="_described" ValueChanged="SetDescribed" />
            }
            else if (Row is not null)
            {
                <SelectionChips Row="Row" Market="@_market" Outcome="@_outcome" OnChoose="ChooseAsync" />
            }
        </DeskStep>

        @* ---- 3 · Price and book -------------------------------------------------------- *@
        <DeskStep Number="3" Title="Price and book" State="@StateOf(3)"
                  Waiting="Pick your bet first."
                  Hint="@(Typing
                      ? "Type the price you were given, like -110 or +150, and the book you used."
                      : "The latest price for your bet. If you bet somewhere else, change the book from the menu on the price; if you got a different number, press the pencil to type it.")">
            @if (Typing)
            {
                <div class="wgroup wager-price">
                    <div class="wager-typed">
                        <DeskField TValue="int?" Mono="true" type="number" Immediate="true"
                                   Label="Price" placeholder="-110" style="max-width:120px"
                                   Value="_typedPrice" ValueChanged="SetTypedPrice" />
                        @if (HasLine)
                        {
                            <DeskField TValue="decimal?" Mono="true" type="number" step="0.5" Immediate="true"
                                       Label="Line" placeholder="@(_market == Markets.Total ? "47.5" : "-3")"
                                       style="max-width:100px"
                                       Value="_typedLine" ValueChanged="SetTypedLine" />
                        }
                        <DeskField TValue="string" Immediate="true" Label="Book" placeholder="draftkings"
                                   list="@_booksListId" style="flex:1; min-width:140px"
                                   Value="_typedBook" ValueChanged="SetTypedBook" />
                        <datalist id="@_booksListId">
                            @foreach (var book in _knownBooks)
                            {
                                <option value="@book"></option>
                            }
                        </datalist>
                        @if (Side?.Offer is not null)
                        {
                            <DeskButton Size="DeskKeySize.Small" Class="wager-manual-key"
                                        Icon="@Icons.Material.Filled.Undo"
                                        aria-pressed="true"
                                        Title="Go back to the price the desk fetched"
                                        OnClick="ToggleManual">
                                Use the fetched price
                            </DeskButton>
                        }
                    </div>
                    @if (_offer is { } typed)
                    {
                        <div class="wager-offer__value">@ValueLine(typed)</div>
                    }
                </div>

                @if (Side?.Offer is null)
                {
                    <Note Class="wager-typed-why">
                        @(_noGame
                            ? "No game, so no fetched price: enter the price you got. The Journal tags it manual."
                            : "No book the desk scans prices this side: enter the price you got. The Journal tags it manual.")
                    </Note>
                }
            }
            else if (_offer is { } offer && Side?.Offer is { } quoted)
            {
                <div class="wgroup wager-offer">
                    <div class="wager-offer__top">
                        <span class="wager-offer__price num">@Price(offer.PriceAmerican)</span>
                        <DeskButton Size="DeskKeySize.Small" Class="wager-manual-key"
                                    Icon="@Icons.Material.Filled.Edit"
                                    aria-pressed="false"
                                    aria-label="Enter my own price"
                                    Title="Enter my own price"
                                    OnClick="ToggleManual" />
                        @if (offer.Line is { } line)
                        {
                            <span class="wager-offer__line num">@OddsMath.FormatLine(line, offer.Outcome)</span>
                        }
                        <BookPicker Books="@WagerOffer.Books(_market!, quoted)" Chosen="@offer.Book" Hidden="_hidden"
                                    OnChoose="ChooseBook" OnToggleHidden="ToggleBookAsync" />
                    </div>
                    <div class="wager-offer__value">@ValueLine(offer)</div>
                    <div class="wager-offer__meta">
                        <span class="wager-offer__of">
                            @(offer.IsBest ? "Best" : "One") of @offer.BooksQuoting @(offer.BooksQuoting == 1 ? "book" : "books")
                            @if (!offer.IsBest && WagerOffer.Best(_market!, quoted) is { } best)
                            {
                                <text> · best is @best.Book @Price(best.PriceAmerican)</text>
                            }
                        </span>
                        <span class="wager-offer__age" title="When the desk last fetched this price">
                            <Glyph Icon="@Icons.Material.Filled.Schedule" /> @Captured(offer)
                        </span>
                    </div>
                </div>

                @if (Visible(quoted).Count == 0)
                {
                    <Note State="DeskState.Warning">
                        Every book quoting this side is filtered out.
                        <DeskButton Size="DeskKeySize.Small" OnClick="ShowAllBooksAsync">Show all books</DeskButton>
                    </Note>
                }

                @if (_moved is not null)
                {
                    @* Said, not swapped silently: the operator was looking at the old number. *@
                    <Note State="DeskState.Positive" Class="wager-moved">@_moved</Note>
                }
            }
        </DeskStep>

        @* ---- 4 · Stake ----------------------------------------------------------------- *@
        <DeskStep Number="4" Title="Stake" State="@StateOf(4)"
                  Waiting="@(HasSide ? "Finish the price first." : "Pick your bet first.")"
                  Hint="How much you put down. What it returns if it wins updates as you type.">
            <div class="wgroup">
                <div class="wgroup__row wgroup__row--pad">
                    <StakeRow Stake="_stake" StakeChanged="SetStake" PriceAmerican="_offer?.PriceAmerican" />
                </div>
                <div class="wgroup__row wgroup__row--pad">
                    @* Immediate: a note bound on change is committed by the blur, and a press of
                       Add to slip or Log straight from the field could run before it — the wager
                       went on with no note. Bound as it is typed, the key reads what it shows. *@
                    <DeskField TValue="string" Immediate="true" placeholder="Note (optional)"
                               aria-label="Note" style="flex:1" @bind-Value="_note" />
                </div>
            </div>
        </DeskStep>

        @* ---- 5 · Review and log -------------------------------------------------------- *@
        <DeskStep Number="5" Title="Review and log" State="@StateOf(5)"
                  Waiting="@(_offer is null ? "Your bet and its price come first." : null)"
                  Hint="Check anything flagged, then log it. LineOps records the bet; nothing is sent to a sportsbook.">
            @if (_offer is not null)
            {
                <CheckList Items="Strip" ShowTitle="false" />
            }

            @if (_offer is { } logging && _stake > 0)
            {
                <p class="wreview">
                    You are logging <strong>@_stake.ToString("C0")</strong> on
                    <strong>@logging.Label at @Price(logging.PriceAmerican)</strong> with @logging.Book@(logging.Manual ? ", your own price" : "").
                    @if (logging.PriceAmerican != 0)
                    {
                        <text>It returns <strong>@OddsMath.PayoutOnWin(logging.PriceAmerican, _stake).ToString("C0")</strong> if it wins.</text>
                    }
                </p>
            }

            <div class="waction">
                @if (_error is not null)
                {
                    <Note State="DeskState.Warning">@_error</Note>
                }

                @if (_logged is not null)
                {
                    <Note State="DeskState.Positive" Class="wager-logged">@_logged</Note>
                }

                <div class="waction__keys">
                    @* Plain: the window's one Filled key is Log. The badge is the acknowledgment;
                       the slip does not open (spec §11.3). A bet on no game has no slip card. *@
                    @if (Row is not null)
                    {
                        <DeskButton Icon="@Icons.Material.Filled.Receipt" OnClick="AddToSlip"
                                    Disabled="@(_offer is null)"
                                    Title="Bank this wager on the desk's slip, to log later or build a parlay">
                            Add to slip
                            <span class="slip-badge num" aria-label="@($"{Slip.Items.Count} on the slip")">@Slip.Items.Count</span>
                        </DeskButton>
                    }

                    <DeskButton Emphasis="DeskEmphasis.Filled"
                                Icon="@Icons.Material.Filled.Bolt"
                                Busy="@_saving"
                                Disabled="@(!CanLog)"
                                Title="Record this bet in the Journal"
                                OnClick="PlaceAsync">
                        Log @(_stake > 0 ? _stake.ToString("C0") : "wager")
                    </DeskButton>
                </div>

                @if (Waiting is { } why)
                {
                    <div class="warnc wager-why">@why</div>
                }
            </div>

            <p class="wfoot">
                Logged against the price shown; closing-line value resolves once the game starts and
                the close is recorded.
            </p>
        </DeskStep>
    </DeskSteps>
}

@code {
    /// <summary>
    /// The game this view is about. Taken as an id rather than a row so the view can be hosted
    /// as a desk window, which is rebuilt from its parameters and cannot carry an object. Absent:
    /// the Journal's door, which opens on a game search.
    /// </summary>
    [Parameter] public int? GameId { get; set; }

    /// <summary>The side a door names (<c>Markets.*</c>). With <see cref="Outcome"/>; otherwise the most value.</summary>
    [Parameter] public string? Market { get; set; }

    [Parameter] public string? Outcome { get; set; }

    /// <summary>The book a door names. Where it quotes the side, the window shows its price, not the best.</summary>
    [Parameter] public string? Book { get; set; }

    [Parameter] public EventCallback OnPlaced { get; set; }

    protected override IReadOnlySet<string> Watches { get; } =
        new HashSet<string> { DataTopics.Odds, DataTopics.Journal };

    /// <summary>
    /// Odds or journal: the refresh does not say which, and both reads are cheap, so the row is
    /// re-priced and the journal re-read either way.
    /// </summary>
    protected override Task RefreshAsync() => ReloadAsync();

    private readonly string _booksListId = "books-" + Guid.NewGuid().ToString("N")[..8];

    private BoardRow? Row;
    private int? _gameId;
    private bool _noGame;
    private string? _described;

    // The side, and the book the operator chose for it. The book outlives a change of side: a bet
    // at DraftKings is usually followed by another at DraftKings.
    private string? _market;
    private string? _outcome;
    private string? _book;

    private WagerOffer? _offer;
    private HashSet<string> _hidden = new(StringComparer.OrdinalIgnoreCase);
    private IReadOnlyList<string> _knownBooks = [];

    private bool _manual;
    private int? _typedPrice;
    private decimal? _typedLine;
    private string? _typedBook;

    private bool _loading;
    private bool _settingsRead;
    private decimal _stake;
    private string? _note;
    private string? _error;
    private string? _logged;
    private string? _moved;
    private bool _saving;

    // The duplicate check's reading: a field the render reads, never a query from the render.
    private JournalEntry? _prior;
    private bool _priorRead;

    private IngestionJob? _linesJob;
    private bool _pulling;

    /// <summary>Opened without a game: the Journal's door. The search stays, so the game can be changed.</summary>
    private bool Searching => GameId is null;

    private SelectionChoice? Side
        => _market is null || _outcome is null
            ? null
            : SelectionChoice.All(Row).FirstOrDefault(c => c.Market == _market
                                                          && string.Equals(c.Outcome, _outcome, StringComparison.OrdinalIgnoreCase));

    private bool HasSide => _noGame || Side is not null;

    /// <summary>The price comes from the fields: asked for, or nothing fetched to take it from.</summary>
    private bool Typing => _manual || _noGame || (Side is { Offer: null });

    private bool HasLine => !_noGame && _market is Markets.Spread or Markets.Total;

    /// <summary>
    /// Where each step stands. Done is the step's own fact — a game chosen, a side, a price, a
    /// stake; the step to do is the first one that is not done, and everything after it waits.
    /// Review is never done: it is where the window ends.
    /// </summary>
    private DeskStepState StateOf(int step)
    {
        bool[] done = [Row is not null || _noGame, HasSide, _offer is not null, _stake > 0, false];
        var current = Array.IndexOf(done, false) + 1;

        return done[step - 1] ? DeskStepState.Done
            : step == current ? DeskStepState.Current
            : DeskStepState.Todo;
    }

    private static string GameWhen(Game game)
        => $"{DisplayTime.Stamp(game.StartsAt)} · {game.Sport?.Key.ToUpperInvariant()}"
           + (game.Status == GameStatus.Final ? " · final" : game.Status == GameStatus.Live ? " · live" : "");

    protected override void OnInitialized() => Slip.Changed += OnSlipChanged;

    protected override void OnDispose() => Slip.Changed -= OnSlipChanged;

    private void OnSlipChanged() => _ = InvokeAsync(StateHasChanged);

    protected override async Task OnParametersSetAsync()
    {
        // A first read shows the skeleton; a door re-aiming a loaded window does not flash it.
        _loading = Row is null && GameId is not null;
        _book = Book;
        _moved = null;

        try
        {
            if (!_settingsRead)
            {
                _hidden = new HashSet<string>(await Data.HiddenBooksAsync(), StringComparer.OrdinalIgnoreCase);
                _knownBooks = await Data.KnownBooksAsync();
                _settingsRead = true;
            }

            if (GameId is { } id)
            {
                _gameId = id;
                await ReadRowAsync();
            }
        }
        finally
        {
            _loading = false;
        }

        if (GameId is null)
            return;

        // A door lands on its side, or on the most value; the book is the door's, else the
        // best of the books the operator has not filtered out.
        var landed = SelectionChoice.Land(Row, Market, Outcome, null);
        _market = landed?.Market;
        _outcome = landed?.Outcome;
        _manual = false;

        Reprice();
        await ReadPriorAsync();
    }

    private async Task ReadRowAsync()
    {
        Row = _gameId is { } id ? await Data.RowAsync(id) : null;
        _linesJob = Row?.Game.Sport is { } sport ? await Data.LinesJobAsync(sport.Key) : null;
    }

    /// <summary>After a change the window watches: the same side and book, re-priced, and the journal re-read.</summary>
    private async Task ReloadAsync()
    {
        if (_gameId is null)
            return;

        var before = _offer;
        await ReadRowAsync();
        Reprice();

        if (before is { Manual: false } && _offer is { Manual: false }
            && _offer.Market == before.Market && _offer.Outcome == before.Outcome
            && string.Equals(_offer.Book, before.Book, StringComparison.OrdinalIgnoreCase)
            && (_offer.PriceAmerican != before.PriceAmerican || _offer.Line != before.Line))
        {
            _moved = $"Price moved since you opened this: {LinePrice(before)} → {LinePrice(_offer)} ({_offer.Book}).";
        }

        await ReadPriorAsync();
    }

    /// <summary>
    /// The one place the price is decided. Typed: the fields. Otherwise the chosen book's latest
    /// rung where it quotes the side, else the best of the books still shown, else the best.
    /// </summary>
    private void Reprice()
    {
        if (Typing)
        {
            var side = Side;
            var market = _noGame ? "other" : side?.Market;
            var outcome = _noGame ? string.Empty : side?.Outcome;

            _offer = market is not null && outcome is not null
                     && _typedPrice is { } price && Math.Abs(price) >= 100
                     && !string.IsNullOrWhiteSpace(_typedBook)
                     && (!_noGame || !string.IsNullOrWhiteSpace(_described))
                ? WagerOffer.Typed(market, outcome, HasLine ? _typedLine : null, _typedBook.Trim().ToLowerInvariant(),
                    price, side?.Offer, DateTimeOffset.UtcNow, _noGame ? _described!.Trim() : null)
                : null;
            return;
        }

        if (Side is not { Offer: { } quoted } chosen)
        {
            _offer = null;
            return;
        }

        _offer = (_book is not null ? WagerOffer.AtBook(chosen.Market, quoted, _book) : null)
                 ?? Visible(quoted).FirstOrDefault()
                 ?? WagerOffer.Best(chosen.Market, quoted);
    }

    /// <summary>Every book on the side the operator has not filtered out, best first.</summary>
    private IReadOnlyList<WagerOffer> Visible(BestOffer quoted)
        => WagerOffer.Books(_market!, quoted).Where(b => !_hidden.Contains(b.Book)).ToList();

    private int HiddenHere(BestOffer quoted) => quoted.Rungs.Count(r => _hidden.Contains(r.Book));

    /// <summary>
    /// The duplicate check's one query, keyed on the side (game, market, outcome) at any book, inside
    /// the activity wrapper so the title bar pulses while it runs.
    /// </summary>
    private async Task ReadPriorAsync()
    {
        if (Row is null || _market is null || _outcome is null || _noGame)
        {
            _prior = null;
            _priorRead = false;
            return;
        }

        _priorRead = false;
        var (gameId, market, outcome) = (Row.Game.Id, _market, _outcome);

        await WithActivityAsync(async () =>
        {
            _prior = await Data.LatestOnSideAsync(gameId, market, outcome, DateTimeOffset.UtcNow - Checks.DuplicateWindow);
            _priorRead = true;
        }, () => PulseState.Healthy);
    }

    private async Task PickGameAsync(Game? game)
    {
        _gameId = game?.Id;
        _market = null;
        _outcome = null;
        _manual = false;
        _moved = null;
        _logged = null;
        _offer = null;

        if (game is null)
        {
            Row = null;
            return;
        }

        _noGame = false;
        await ReadRowAsync();

        // Searched for, not opened from a row: nothing says which side was bet, so none is assumed.
        await ReadPriorAsync();
    }

    private void SetNoGame(bool noGame)
    {
        _noGame = noGame;
        _logged = null;

        if (noGame)
        {
            Row = null;
            _gameId = null;
            _market = null;
            _outcome = null;
            _typedBook ??= _book;
        }

        Reprice();
    }

    private void SetDescribed(string? text)
    {
        _described = text;
        Reprice();
    }

    private async Task ChooseAsync(SelectionChoice choice)
    {
        _market = choice.Market;
        _outcome = choice.Outcome;
        _moved = null;

        if (choice.Offer is null)
            Prefill(null);

        Reprice();
        await ReadPriorAsync();
    }

    private void ChooseBook(string book)
    {
        _book = book;
        _moved = null;
        Reprice();
    }

    private async Task ToggleBookAsync(string book)
    {
        if (!_hidden.Remove(book))
            _hidden.Add(book);

        // Filtering out the book on screen moves the price to the best book still shown.
        if (_book is not null && _hidden.Contains(_book))
            _book = null;

        Reprice();
        await Data.SetHiddenBooksAsync(_hidden);
    }

    private async Task ShowAllBooksAsync()
    {
        _hidden.Clear();
        Reprice();
        await Data.SetHiddenBooksAsync(_hidden);
    }

    /// <summary>
    /// Into a typed price starting from the number on screen, so changing -166 to -160 is one edit
    /// rather than three fields; back out to the fetched price, untouched.
    /// </summary>
    private void ToggleManual()
    {
        _manual = !_manual;
        _moved = null;

        if (_manual)
            Prefill(_offer);

        Reprice();
    }

    private void Prefill(WagerOffer? from)
    {
        _typedPrice = from?.PriceAmerican ?? _typedPrice ?? -110;
        // "-3", not the "-3.00" the stored scale prints.
        _typedLine = from?.Line is { } line ? line / 1.000000000000000000000000000000000m : _typedLine;
        _typedBook = from?.Book ?? _typedBook ?? _book;
    }

    private void SetTypedPrice(int? price)
    {
        _typedPrice = price;
        Reprice();
    }

    private void SetTypedLine(decimal? line)
    {
        _typedLine = line;
        Reprice();
    }

    private void SetTypedBook(string? book)
    {
        _typedBook = book;
        Reprice();
    }

    private void SetStake(decimal stake) => _stake = stake;

    private bool CanLog => _offer is { IsClosing: false } && _stake > 0 && (Row is not null || _noGame);

    /// <summary>What the Log key is waiting for, said under it.</summary>
    private string? Waiting
        => _offer is null && Typing
            ? (_noGame && string.IsNullOrWhiteSpace(_described)
                ? "Needs a description of the bet."
                : "Needs a price (like -110 or +150) and a book.")
           : _offer is { IsClosing: true } ? "This is the closing line. Enter my own price records the one you got."
           : _stake <= 0 ? "Needs a stake above zero."
           : null;

    private IReadOnlyList<Check> Strip
    {
        get
        {
            if (_offer is not { } offer)
                return [];

            if (Row is null)
                return [Checks.Value(offer, _stake), Checks.Typed(null, DateTimeOffset.UtcNow)];

            return Checks.Build(offer, Row.Game.StartsAt, DateTimeOffset.UtcNow, _priorRead, _prior, _stake,
                new CheckActions(PullLabel, _pulling ? null : (Func<Task>)PullAsync, OpenJournalAsync));
        }
    }

    /// <summary>"Pull NFL lines · 2 credits": the same job the Board row's pull runs, at the cost the menu quotes.</summary>
    private string? PullLabel
    {
        get
        {
            if (_linesJob is not { Available: true } job || Row?.Game.Sport is not { } sport)
                return null;

            var league = sport.Key.ToUpperInvariant();
            return job.EstimatedCredits > 0 ? $"Pull {league} lines · {job.EstimatedCredits} credits" : $"Pull {league} lines";
        }
    }

    private async Task PullAsync()
    {
        if (_linesJob is not { Available: true } job || _pulling)
            return;

        _pulling = true;

        try
        {
            var outcome = await Data.RunJobAsync(job.Key);

            if (outcome.Succeeded)
                Toasts.Success(outcome.Detail ?? $"{job.Label}: {outcome.Rows:N0} rows.");
            else
                Toasts.Warn(outcome.Detail ?? $"{job.Label}: {outcome.Failures} source failed.");

            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Toasts.Fail($"{job.Label} failed: {ex.Message}");
        }
        finally
        {
            _pulling = false;
        }
    }

    private Task OpenJournalAsync()
    {
        Manager.Open(WindowCatalog.Find(WindowCatalog.Journal)!);
        return Task.CompletedTask;
    }

    private RenderFragment ValueLine(WagerOffer offer) => @<text>
        @if (offer.Ev is { } ev)
        {
            @* The state colour sits on the number it describes, and nowhere else. *@
            <span class="wager-offer__ev @(ev > 0 ? "wager-offer__ev--up" : "wager-offer__ev--down")">@PriceCell.EvLabel(ev)</span>
            @if (offer.Fair is { } fair)
            {
                <span> · @PriceCell.FairLabel(fair)</span>
            }
        }
        else
        {
            <span>No fair price on this number</span>
        }
    </text>;

    private static string Captured(WagerOffer offer)
    {
        if (offer.IsClosing)
            return "closing price";

        // The same words as the price-age check beneath it ("1h 49m", not "1.8h"), so the two
        // lines about one number never disagree in form.
        var age = DateTimeOffset.UtcNow - offer.CapturedAt;
        return age < TimeSpan.FromMinutes(1) ? "captured just now" : $"captured {Checks.Span(age)} ago";
    }

    private static string Age(WagerOffer offer)
    {
        if (offer.IsClosing)
            return "close";

        var age = DateTimeOffset.UtcNow - offer.CapturedAt;
        return age < TimeSpan.FromMinutes(1) ? "now" : Checks.Span(age);
    }

    private static string LinePrice(WagerOffer offer)
        => (offer.Line is { } line ? OddsMath.FormatLine(line, offer.Outcome) + " " : "") + Price(offer.PriceAmerican);

    /// <summary>
    /// Banks the wager on the slip. Zero stake is allowed — it can be set on the card — and a
    /// closing price is allowed too: the card carries the same block the Log key does here.
    /// </summary>
    private void AddToSlip()
    {
        if (_offer is not { } offer || Row is null)
            return;

        // The duplicate check's reading travels with the card, so the slip can say it too.
        Slip.Add(offer.ToSlipItem(Row.Game, Matchup(Row.Game), _stake, _note) with
        {
            InJournal = _priorRead && _prior is { } prior ? Checks.Prior(prior) : null
        });

        _error = null;
        _logged = $"Added {_stake:C0} on {offer.Label} at {Price(offer.PriceAmerican)} to the slip.";
        Toasts.Success(_logged);
        _stake = 0;
        _note = null;
    }

    private async Task PlaceAsync()
    {
        if (!CanLog || _offer is not { } offer)
            return;

        _saving = true;
        _error = null;

        try
        {
            await Data.LogStraightsAsync([offer.ToDraft(Row?.Game.Id, _stake, _note)]);

            // Hosted as a window there is no host to close the form, so it says what it did and
            // clears the stake: a form left exactly as it was, key still lit, logged the same
            // wager twice on the next press. The side stays, so the journal check can name it.
            _logged = $"Logged {_stake:C0} on {offer.Label} at {Price(offer.PriceAmerican)} ({offer.Book})"
                      + (offer.Manual ? ", your own price." : ".");
            Toasts.Success(_logged);
            _stake = 0;
            _note = null;

            await OnPlaced.InvokeAsync();

            // The change notice will re-read the journal; this reads it now rather than a second later.
            await ReadPriorAsync();
        }
        catch (Exception ex)
        {
            _error = $"Not logged: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }
}

@using LineOps.Data
@using LineOps.Data.CrossReference
@using LineOps.Web.Windowing
@using Microsoft.EntityFrameworkCore
@inherits PanelBase
@inject IDbContextFactory<LineOpsDbContext> DbFactory
@inject IServiceScopeFactory ScopeFactory

<div class="row" style="margin-bottom:12px">
    @* With no game inside the window this rendered as an empty picker — a control offering a
       choice it does not have. It says which instead, and refuses the press. *@
    <DeskSelect TValue="int?" style="max-width:280px"
                disabled="@(_games.Count == 0)"
                Value="_gameId" ValueChanged="OnGameChanged">
        @if (_games.Count == 0)
        {
            <option value="">No game in the last 14 days</option>
        }
        @foreach (var g in _games)
        {
            <option value="@g.Id">@MatchupWithDate(g)</option>
        }
    </DeskSelect>

    <DeskSwitch Options="_marketOptions" Label="Market"
                Value="_market" ValueChanged="@((string market) => SetMarketAsync(market))" />
</div>

@if (_series.Count == 0)
{
    <EmptyState Kind="EmptyStateKind.Filtered">
        No stored moves for this game and market. Prices are only written when they change,
        so a market that has not moved has nothing to plot.
    </EmptyState>
}
else
{
    @* One observation per book is a reading, not a trend. Apple's charting guidance is to use
       a table where no analysis is being asked for, and a line chart of a single point draws a
       flat line that looks like a market holding steady rather than one nobody has watched
       twice yet. The table below says the same thing without the false shape. *@
    @if (_points < 2)
    {
        <Note Style="margin:0 0 12px">
            Only one observation stored so far, so there is nothing to plot yet — the current
            numbers are below. A second pull is what turns these into movement.
        </Note>
    }
    else
    {
        <DeskChart Series="_series" Labels="@_labels" Height="240px"
                   Family="DeskChartFamily.Movement"
                   Headline="@_headline"
                   Takeaway="@_takeaway"
                   Description="@_description" />
    }

    <PanelHeader Gap="PanelHeaderGap.Section">Current market</PanelHeader>

    <DeskGrid T="OddsSnapshot" Items="_current" EmptyText="No prices on this market.">
        <PropertyColumn T="OddsSnapshot" TProperty="string" Property="s => s.Book" Title="Book"
                        InitialDirection="SortDirection.Ascending" />
        <PropertyColumn T="OddsSnapshot" TProperty="string" Property="s => s.Outcome" Title="Selection" />

        <PropertyColumn T="OddsSnapshot" TProperty="decimal" Property="s => s.Line ?? 0" Title="Line" Align="Align.Right">
            <CellTemplate>@(context.Item.Line is { } l ? Line(l) : "—")</CellTemplate>
        </PropertyColumn>

        @* Sorting on price is how you find the best number across books. *@
        <PropertyColumn T="OddsSnapshot" TProperty="int" Property="s => s.PriceAmerican" Title="Price" Align="Align.Right">
            <CellTemplate>@Price(context.Item.PriceAmerican)</CellTemplate>
        </PropertyColumn>

        @* The quantity the chart above plots, so the picture and the table agree on what
           moved. A row with no usable price sorts last rather than as a certainty. *@
        <PropertyColumn T="OddsSnapshot" TProperty="double"
                        Property="@(s => Implied(s.PriceAmerican) ?? -1)"
                        Title="Implied" Align="Align.Right">
            <CellTemplate>
                <span class="dim">
                    @(Implied(context.Item.PriceAmerican) is { } p ? p.ToString("P1") : "—")
                </span>
            </CellTemplate>
        </PropertyColumn>

        <PropertyColumn T="OddsSnapshot" TProperty="DateTimeOffset" Property="s => s.CapturedAt"
                        Title="Observed" Align="Align.Right">
            <CellTemplate><span class="dim">@Starts(context.Item.CapturedAt)</span></CellTemplate>
        </PropertyColumn>
    </DeskGrid>

    <Note Style="margin:14px 0 12px">
        @_moveCount price @(_moveCount == 1 ? "move" : "moves") recorded across
        @_current.Count book/selection @(_current.Count == 1 ? "pair" : "pairs").
    </Note>
}

@*
    The cross-reference. Odds say what the market thinks; these say what actually happened.
    Read live from the stats history by reference — nothing here is copied onto the odds tier,
    because form changes daily and a stored copy would go stale without saying so.
*@

<PanelHeader Gap="PanelHeaderGap.Section">Recent form</PanelHeader>

@if (_form is null)
{
    <EmptyState Kind="EmptyStateKind.New">Select a game to cross-reference its players against their history.</EmptyState>
}
else if (_form.IsEmpty)
{
    <EmptyState Kind="EmptyStateKind.Filtered">
        <ChildContent>
            No appearances on record for either roster in the last @_windowDays days. History is
            gathered separately, by the walk that reaches back over past days.
        </ChildContent>
        <Action>
            <DeskButton Size="DeskKeySize.Small" Emphasis="DeskEmphasis.Tinted"
                        Icon="@Icons.Material.Filled.History"
                        OnClick="() => Manager.OpenHistory()">
                Open History
            </DeskButton>
        </Action>
    </EmptyState>
}
else
{
    <div class="row" style="margin-bottom:9px">
        <DeskSwitch Options="GateOptions.LookbackDays" Label="Lookback window" Mono="true"
                    Value="_windowDays" ValueChanged="@((int days) => SetWindowAsync(days))" />
        <span class="dim" style="font-size:11.5px">
            @_form.LinesRead stat @(_form.LinesRead == 1 ? "line" : "lines") read by reference
        </span>
    </div>

    @RenderSide(_form.Away, _form.Game.AwayTeam?.Name ?? "Away")
    @RenderSide(_form.Home, _form.Game.HomeTeam?.Name ?? "Home")
}

@code {
    /// <summary>Set when opened from the slate; otherwise the first upcoming game is shown.</summary>
    [Parameter] public int? GameId { get; set; }

    private List<Game> _games = [];
    private List<OddsSnapshot> _current = [];
    private List<ChartSeries<double>> _series = [];
    private string[] _labels = [];
    private int? _gameId;
    private string _market = Markets.Moneyline;
    private int _moveCount;

    /// <summary>Distinct observation times. Below two there is a reading but no trend.</summary>
    private int _points;

    /// <summary>Whether the y-axis is the handicap rather than implied probability. See <see cref="Plot"/>.</summary>
    private bool _plotsHandicap;

    private string _headline = string.Empty;
    private string _takeaway = string.Empty;
    private string _description = string.Empty;

    private static readonly IReadOnlyList<DeskSwitchOption<string>> _marketOptions =
    [
        new(Markets.Moneyline, "Moneyline"),
        new(Markets.Spread, "Spread"),
        new(Markets.Total, "Total")
    ];

    private MatchupForm? _form;
    private int _windowDays = 30;

    /// <summary>
    /// Columns are derived from the data rather than declared, because stat keys differ per
    /// sport and per source. The busiest keys across the roster are the ones worth the width.
    /// </summary>
    /// <summary>A stat is a rate if anyone on this side recorded a fractional value for it.</summary>
    private static bool IsRate(IReadOnlyList<PlayerForm> side, string key)
        => side.Any(p => p.Totals.ContainsKey(key) && !p.IsCounting(key));

    private static List<string> ColumnsFor(IReadOnlyList<PlayerForm> side)
        => side.SelectMany(p => p.Totals.Keys)
            .GroupBy(k => k)
            .OrderByDescending(g => g.Count())
            .ThenBy(g => g.Key)
            .Select(g => g.Key)
            .Take(5)
            .ToList();

    private RenderFragment RenderSide(IReadOnlyList<PlayerForm> side, string teamName) => @<text>
        @if (side.Count > 0)
        {
            var columns = ColumnsFor(side);

            <h4 class="panel-h" style="margin-top:12px; color:var(--text-secondary)">@teamName</h4>
            <div class="gridwrap">
                <DeskGrid T="PlayerForm" Items="side" EmptyText="No appearances on record.">
                    <PropertyColumn T="PlayerForm" TProperty="string" Property="p => p.Name"
                                    Title="Player" CellClass="trunc">
                        <CellTemplate><span title="@context.Item.Name">@context.Item.Name</span></CellTemplate>
                    </PropertyColumn>

                    <PropertyColumn T="PlayerForm" TProperty="string" Property="p => p.Position!" Title="Pos">
                        <CellTemplate><span class="dim">@(context.Item.Position ?? "—")</span></CellTemplate>
                    </PropertyColumn>

                    <PropertyColumn T="PlayerForm" TProperty="int" Property="p => p.Appearances"
                                    Title="GP" Align="Align.Right" />

                    @foreach (var c in columns)
                    {
                        var key = c;

                        @* Rates are averaged, counts are totalled, and the header says
                           which so a number is never ambiguous. A player with no reading
                           sorts below every real one rather than beside the zeroes. *@
                        <TemplateColumn T="PlayerForm" Title="@(key + (IsRate(side, key) ? "/g" : ""))"
                                        Align="Align.Right"
                                        SortBy="@(p => p.Summary(key) ?? double.MinValue)">
                            <CellTemplate>
                                @* A player with no reading for this key gets a dash, not a
                                   zero — they are different facts. *@
                                @(context.Item.Summary(key) is { } v
                                    ? v.ToString(context.Item.IsCounting(key) ? "0.##" : "0.000")
                                    : "—")
                            </CellTemplate>
                        </TemplateColumn>
                    }

                    <PropertyColumn T="PlayerForm" TProperty="DateTimeOffset" Property="p => p.LastPlayed"
                                    Title="Last" Align="Align.Right">
                        <CellTemplate>
                            <span class="dim">@context.Item.LastPlayed.ToLocalTime().ToString("MMM d")</span>
                        </CellTemplate>
                    </PropertyColumn>
                </DeskGrid>
            </div>
        }
    </text>;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        _games = await db.Games
            .Include(g => g.HomeTeam).Include(g => g.AwayTeam)
            .Where(g => g.StartsAt > DateTimeOffset.UtcNow.AddDays(-14))
            .OrderBy(g => g.StartsAt)
            .Take(120)
            .ToListAsync();

        _gameId = GameId ?? _games.FirstOrDefault()?.Id;
        await LoadAsync();
    }

    private async Task OnGameChanged(int? id)
    {
        _gameId = id;
        await LoadAsync();
    }

    private async Task SetMarketAsync(string market)
    {
        _market = market;
        await LoadAsync();
    }

    private async Task SetWindowAsync(int days)
    {
        _windowDays = days;
        await LoadFormAsync();
    }

    /// <summary>
    /// The cross-reference read. Separate from the odds load because the two answer different
    /// questions about the same game and only one of them changes when the market does.
    /// </summary>
    private async Task LoadFormAsync()
    {
        _form = null;

        if (_gameId is not { } gameId)
            return;

        await using var scope = ScopeFactory.CreateAsyncScope();
        var lookup = scope.ServiceProvider.GetRequiredService<MatchupCrossReference>();

        _form = await lookup.GetAsync(gameId, TimeSpan.FromDays(_windowDays));
    }

    private async Task LoadAsync()
    {
        _series = [];
        _labels = [];
        _current = [];
        _moveCount = 0;
        _points = 0;

        await LoadFormAsync();

        if (_gameId is not { } gameId)
        {
            Report(PulseState.Idle);
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();

        var snapshots = await db.OddsSnapshots
            .Where(s => s.GameId == gameId && s.Market == _market)
            .OrderBy(s => s.CapturedAt)
            .ToListAsync();

        _moveCount = snapshots.Count;

        if (snapshots.Count == 0)
        {
            Report(PulseState.Idle, "no moves");
            return;
        }

        var times = snapshots.Select(s => s.CapturedAt).Distinct().OrderBy(t => t).ToList();
        _points = times.Count;

        var stride = Math.Max(1, times.Count / 6);

        _labels = times
            .Select((t, i) => i % stride == 0 ? t.ToLocalTime().ToString("dd HH:mm") : string.Empty)
            .ToArray();

        // What the y-axis is made of. Handicap markets move the number; the moneyline has no
        // number to move, so it moves the price. See Plot for why the price itself is never
        // what gets plotted.
        _plotsHandicap = _market != Markets.Moneyline && snapshots.All(s => s.Line is not null);

        foreach (var group in snapshots.GroupBy(s => new { s.Book, s.Outcome }))
        {
            var ordered = group.OrderBy(s => s.CapturedAt).ToList();
            var data = new double[times.Count];
            var cursor = 0;
            var last = Plot(ordered[0]);

            for (var i = 0; i < times.Count; i++)
            {
                // A gap means "unchanged", not "unknown", so the last reading carries forward.
                while (cursor < ordered.Count && ordered[cursor].CapturedAt <= times[i])
                    last = Plot(ordered[cursor++]);

                data[i] = last;
            }

            _series.Add(new ChartSeries<double>
            {
                Name = $"{group.Key.Outcome} · {group.Key.Book}",
                Data = data
            });
        }

        _current = snapshots
            .GroupBy(s => new { s.Book, s.Outcome })
            .Select(g => g.OrderByDescending(s => s.CapturedAt).First())
            .OrderBy(s => s.Book).ThenBy(s => s.Outcome)
            .ToList();

        // After _current, which the caption counts.
        BuildCaption(snapshots, times);

        Report(PulseState.Healthy, $"{_moveCount} moves");
    }

    /// <summary>
    /// One snapshot as a plottable number.
    ///
    /// <para>
    /// A handicap market plots its handicap: -1.5 to -2.0 is the move, and the price beside it
    /// is the juice charged for it.
    /// </para>
    ///
    /// <para>
    /// Everything else plots implied probability, and never the American price. American odds
    /// are discontinuous across zero — +110 and -110 are neighbours in probability, 3.6 points
    /// apart, but 220 units apart as numbers, and nothing at all exists between -100 and +100.
    /// Plotting them raw draws a canyon down the middle of the chart between the favourite and
    /// the underdog, then flattens the movement inside each against an axis stretched to span
    /// that gap. Probability is continuous, is what actually moved, and puts both sides of a
    /// market on one scale that can be read against the other.
    /// </para>
    /// </summary>
    private double Plot(OddsSnapshot s)
        => _plotsHandicap
            ? (double)(s.Line ?? 0m)
            : (Implied(s.PriceAmerican) ?? 0) * 100;

    /// <summary>
    /// Implied probability, or null where the price cannot carry one.
    ///
    /// <para>
    /// Zero is not a price — there is no American odds value between -100 and +100 — so
    /// <c>OddsMath.ImpliedProbability</c> rejects it rather than inventing an answer. That
    /// contract is right, and it is deliberately not softened there. But it means a single
    /// malformed row from a provider would otherwise take down the whole window: the throw
    /// lands in the load, not in one cell. A stored zero is a broken reading, so it is shown
    /// as one and the rest of the market still renders.
    /// </para>
    /// </summary>
    private static double? Implied(int american)
        => american == 0 ? null : OddsMath.ImpliedProbability(american);

    /// <summary>
    /// Says what the chart shows, in the voice a person would use saying it out loud.
    ///
    /// <para>
    /// Apple's charting guidance is to headline the takeaway rather than name the mechanism: a
    /// chart captioned "Line movement" makes the reader do the reading it was drawn to save.
    /// The biggest single move is the thing worth saying, so it is found and stated — including
    /// when there isn't one, because "nothing moved" is also a finding.
    /// </para>
    /// </summary>
    private void BuildCaption(List<OddsSnapshot> snapshots, List<DateTimeOffset> times)
    {
        _description = _plotsHandicap
            ? "Line chart of the handicap over time, one line per book and selection."
            : "Line chart of implied probability over time, one line per book and selection. "
              + "Probability rather than American price, so both sides share one continuous scale.";

        // The axis carries bare numbers — MudBlazor keeps its Y-axis formatter behind the
        // seam — so the unit is stated here, immediately above the plot.
        var unit = _plotsHandicap ? "Handicap" : "Implied probability (%)";

        var span = times.Count > 1
            ? $"{times[0].ToLocalTime():MMM d HH:mm} to {times[^1].ToLocalTime():HH:mm}"
            : times[0].ToLocalTime().ToString("MMM d HH:mm");

        _takeaway = $"{unit}, {span} · {_current.Count} book/selection "
                    + $"{(_current.Count == 1 ? "pair" : "pairs")}";

        // The largest first-to-last change across every book and selection.
        var biggest = snapshots
            .GroupBy(s => new { s.Book, s.Outcome })
            .Select(g =>
            {
                var ordered = g.OrderBy(s => s.CapturedAt).ToList();
                return (g.Key.Outcome, g.Key.Book, First: ordered[0], Last: ordered[^1]);
            })
            .OrderByDescending(x => Math.Abs(Plot(x.Last) - Plot(x.First)))
            .FirstOrDefault();

        if (biggest.First is null || Math.Abs(Plot(biggest.Last) - Plot(biggest.First)) < 0.01)
        {
            _headline = "Every book is holding its opening number";
            return;
        }

        if (_plotsHandicap)
        {
            _headline = $"{biggest.Outcome} moved {Line(biggest.First.Line ?? 0m)} to "
                        + $"{Line(biggest.Last.Line ?? 0m)} at {biggest.Book}";
            return;
        }

        // Shortened or drifted, said the way the desk would say it: a price whose implied
        // probability rose is one the market got more confident about.
        var shortened = Plot(biggest.Last) > Plot(biggest.First);

        _headline = $"{biggest.Outcome} {(shortened ? "shortened" : "drifted")} "
                    + $"{Price(biggest.First.PriceAmerican)} to {Price(biggest.Last.PriceAmerican)} "
                    + $"at {biggest.Book}";
    }
}

@using LineOps.Data
@using LineOps.Data.CrossReference
@using LineOps.Desk.Windowing
@using LineOps.Web.Services
@using Microsoft.EntityFrameworkCore
@inherits PanelBase
@inject IDbContextFactory<LineOpsDbContext> DbFactory
@inject IServiceScopeFactory ScopeFactory

@*
    Line movement: how one side of a market moved at each book, a row per book.

    It used to be a chart of every book and both sides at once — eight lines for two books
    and a moneyline, each side the mirror of the other in probability, told apart by a palette
    and a legend that drew itself over the table beneath — and then that table again, with
    the latest prices the chart had just drawn. Apple's charting guidance is to keep a chart
    simple and let people choose the detail, to use a small chart for glanceable information
    about one item, and to put data in a table where nobody is being asked to analyse it. So
    the window shows one side at a time, because the other side is its mirror, and the rows
    are the representation: each book's open, where it is now, the move between them, when it
    last moved, and a sparkline of the path, on one time axis shared down the column so a move
    that hit every book in the same hour lines up.
*@

<PanelToolbar>
    @* The games with moves on record — the ones this window can show. Scans are kept until
       first pitch and then folded into one closing line (ADR 0010), so every game ahead of
       us with a price on file is in this list. It is the only game control: the search that
       sat beside it named the same game a second time, cut off at the window's edge. A game
       opened from elsewhere and not in the list is added to it, so the select always names
       the game the rows are about. *@
    <DeskSelect TValue="int?" aria-label="Game" style="max-width:min(280px, 100%)"
                disabled="@(_games.Count == 0 && _picked is null)"
                Value="@(Listed(_gameId) ? _gameId : null)" ValueChanged="OnGameChanged">
        <option value="">@(_games.Count == 0 ? "No game has moves on record" : "Games with moves…")</option>
        @if (_picked is { } picked && !_games.Any(g => g.Id == picked.Id))
        {
            <option value="@picked.Id">@MatchupWithDate(picked)</option>
        }
        @foreach (var g in _games)
        {
            <option value="@g.Id">@MatchupWithDate(g)</option>
        }
    </DeskSelect>

</PanelToolbar>

@* The view's own switches sit on a row of their own, over the rows they choose, the way a
   segmented control heads the view it switches (HIG, Segmented controls). In the toolbar,
   beside the game, a window beside the Board ran out of row: the game was cut off, Total fell
   past the edge and the side switch was out of sight altogether. Here they wrap as a pair. *@
<div class="movement__switches">
    <DeskSwitch Options="_marketOptions" Label="Market" Size="DeskKeySize.Small"
                Value="_market" ValueChanged="@((string market) => SetMarketAsync(market))" />

    @* The market's two outcomes, away first as the matchup reads, Over before Under. One at a
       time: a price that shortens on one side drifts on the other, so showing both doubles
       the rows and says nothing the first half did not. Built from the stored outcomes, so a
       market priced on one side only offers no switch at all. *@
    <DeskSwitch TValue="string" Options="_sideOptions" Label="Side" Size="DeskKeySize.Small"
                Value="_side" ValueChanged="@((string side) => SetSide(side))" />
</div>

@if (_rows.Count == 0)
{
    <EmptyState Kind="EmptyStateKind.Filtered">
        No stored prices for this game and market. A book that does not price the market has
        nothing to show, and once a game starts its moves are folded into one closing line,
        which the Game window shows.
    </EmptyState>
}
else
{
    @* The finding first, then the span it was found over (HIG charts: summarise the main
       message before the detail). The headline is about the side in focus, the same rows
       the table shows, so the sentence and the rows never disagree about who moved. *@
    <div class="movement">
        <div class="movement__cap">
            <p class="movement__headline">@_headline</p>
            <p class="movement__span">@_span</p>
        </div>

        <DeskGrid T="MovementRow" Items="_rows" Resizable="false" EmptyText="No prices on this side.">
            <PropertyColumn T="MovementRow" TProperty="string" Property="r => r.Book" Title="Book"
                            InitialDirection="SortDirection.Ascending" />

            @* No colour and no axis: the numbers are in the next cells, and the shape only has
               to say which way and when. A book seen once draws a dash, not a flat line. *@
            <TemplateColumn T="MovementRow" Title="Trend" Sortable="false">
                <CellTemplate>
                    <DeskSparkline Values="context.Item.Trend" Positions="context.Item.Positions" Step="true"
                                   Label="@TrendLabel(context.Item)" />
                </CellTemplate>
            </TemplateColumn>

            <TemplateColumn T="MovementRow" Title="Open" Align="Align.Right" Sortable="true"
                            SortBy="@(r => Rank(r.Open))" HeaderClass="col--wide" CellClass="col--wide">
                <CellTemplate>
                    <span class="dim movement__quote" title="@DisplayTime.Stamp(context.Item.Open.CapturedAt)">@Quote(context.Item.Open)</span>
                </CellTemplate>
            </TemplateColumn>

            @* Sorting on the current number is how you find the best one across books. *@
            <TemplateColumn T="MovementRow" Title="Now" Align="Align.Right" Sortable="true"
                            SortBy="@(r => Rank(r.Now))">
                <CellTemplate>
                    <span class="movement__quote">@Quote(context.Item.Now)</span>
                </CellTemplate>
            </TemplateColumn>

            @* The arrow is the direction the number moved as it is written, the same way the
               sparkline draws it, and nothing more: the ink is neutral because a price moving
               is not good or bad. The tooltip says it in words — shortened or drifted. *@
            <TemplateColumn T="MovementRow" Title="Move" Align="Align.Right" Sortable="true"
                            SortBy="@(r => MoveSize(r))">
                <CellTemplate>
                    <span class="movement__move @(context.Item.Moved ? null : "dim")"
                          title="@MoveTitle(context.Item, _market)">@MoveText(context.Item)</span>
                </CellTemplate>
            </TemplateColumn>

            <TemplateColumn T="MovementRow" Title="Last moved" Align="Align.Right" Sortable="true"
                            SortBy="@(r => r.LastMoved ?? DateTimeOffset.MinValue)"
                            HeaderClass="col--wide" CellClass="col--wide">
                <CellTemplate>
                    @if (context.Item.LastMoved is { } at)
                    {
                        <span class="dim" title="@DisplayTime.Stamp(at)">@Ago(at, DateTimeOffset.UtcNow)</span>
                    }
                    else
                    {
                        <span class="dim" title="Seen once, @DisplayTime.Stamp(context.Item.Open.CapturedAt)">—</span>
                    }
                </CellTemplate>
            </TemplateColumn>
        </DeskGrid>
    </div>
}

@*
    The cross-reference. Odds say what the market thinks; these say what actually happened.
    Read live from the stats history by reference — nothing here is copied onto the odds tier,
    because form changes daily and a stored copy would go stale without saying so.
*@

<PanelSection Title="Recent form">

@if (_form is null)
{
    <EmptyState Kind="EmptyStateKind.New">Select a game to cross-reference its players against their history.</EmptyState>
}
else if (_form.IsEmpty)
{
    <EmptyState Kind="EmptyStateKind.Filtered">
        <ChildContent>
            No appearances on record for either roster in the last @_windowDays days. History is
            gathered separately, by the walk that reaches back over past days.
        </ChildContent>
        <Action>
            <DeskButton Size="DeskKeySize.Small" Emphasis="DeskEmphasis.Tinted"
                        Icon="@Icons.Material.Filled.History"
                        OnClick="() => Manager.OpenHistory()">
                Open History
            </DeskButton>
        </Action>
    </EmptyState>
}
else
{
    <DeskRow>
        <DeskSwitch Options="GateOptions.LookbackDays" Label="Lookback window" Mono="true"
                    Value="_windowDays" ValueChanged="@((int days) => SetWindowAsync(days))" />
        <span class="meta">
            @_form.LinesRead stat @(_form.LinesRead == 1 ? "line" : "lines") read by reference
        </span>
    </DeskRow>

    @RenderSide(_form.Away, _form.Game.AwayTeam?.Name ?? "Away")
    @RenderSide(_form.Home, _form.Game.HomeTeam?.Name ?? "Home")
}
</PanelSection>

@code {
    protected override IReadOnlySet<string> Watches { get; } = new HashSet<string> { DataTopics.Odds };

    protected override Task RefreshAsync() => LoadAsync();

    /// <summary>Set when opened from the slate; otherwise the first upcoming game is shown.</summary>
    [Parameter] public int? GameId { get; set; }

    private List<Game> _games = [];
    private Game? _picked;
    private int? _gameId;
    private string _market = Markets.Moneyline;

    /// <summary>Every stored price on the chosen market, both sides. The side switch reads from it without a query.</summary>
    private List<OddsSnapshot> _snapshots = [];

    /// <summary>
    /// The outcome in focus, as stored. Kept across a market change when the new market has
    /// the same outcome — a team's moneyline and its spread — and reset to the first side
    /// when it does not.
    /// </summary>
    private string? _side;

    private IReadOnlyList<DeskSwitchOption<string>> _sideOptions = [];
    private IReadOnlyList<MovementRow> _rows = [];

    private string _headline = string.Empty;
    private string _span = string.Empty;

    private static readonly IReadOnlyList<DeskSwitchOption<string>> _marketOptions =
    [
        new(Markets.Moneyline, "Moneyline"),
        new(Markets.Spread, "Spread"),
        new(Markets.Total, "Total")
    ];

    private MatchupForm? _form;
    private int _windowDays = 30;

    /// <summary>A stat is a rate if anyone on this side recorded a fractional value for it.</summary>
    private static bool IsRate(IReadOnlyList<PlayerForm> side, string key)
        => side.Any(p => p.Totals.ContainsKey(key) && !p.IsCounting(key));

    /// <summary>
    /// Columns are derived from the data rather than declared, because stat keys differ per
    /// sport and per source. The busiest keys across the roster are the ones worth the width.
    /// </summary>
    private static List<string> ColumnsFor(IReadOnlyList<PlayerForm> side)
        => side.SelectMany(p => p.Totals.Keys)
            .GroupBy(k => k)
            .OrderByDescending(g => g.Count())
            .ThenBy(g => g.Key)
            .Select(g => g.Key)
            .Take(5)
            .ToList();

    private RenderFragment RenderSide(IReadOnlyList<PlayerForm> side, string teamName) => @<text>
        @if (side.Count > 0)
        {
            var columns = ColumnsFor(side);

            <PanelSection Title="@teamName">
            <div class="gridwrap">
                <DeskGrid T="PlayerForm" Items="side" EmptyText="No appearances on record.">
                    <PropertyColumn T="PlayerForm" TProperty="string" Property="p => p.Name"
                                    Title="Player" CellClass="trunc">
                        <CellTemplate><span title="@context.Item.Name">@context.Item.Name</span></CellTemplate>
                    </PropertyColumn>

                    <PropertyColumn T="PlayerForm" TProperty="string" Property="p => p.Position!" Title="Pos" HeaderClass="col--wide" CellClass="col--wide">
                        <CellTemplate><span class="dim">@(context.Item.Position ?? "—")</span></CellTemplate>
                    </PropertyColumn>

                    <PropertyColumn T="PlayerForm" TProperty="int" Property="p => p.Appearances"
                                    Title="GP" Align="Align.Right" />

                    @foreach (var c in columns)
                    {
                        var key = c;

                        @* Rates are averaged, counts are totalled, and the header says
                           which so a number is never ambiguous. A player with no reading
                           sorts below every real one rather than beside the zeroes. *@
                        <TemplateColumn T="PlayerForm" Sortable="true" Title="@(key + (IsRate(side, key) ? "/g" : ""))"
                                        Align="Align.Right"
                                        SortBy="@(p => p.Summary(key) ?? double.MinValue)">
                            <CellTemplate>
                                @* A player with no reading for this key gets a dash, not a
                                   zero — they are different facts. *@
                                @(context.Item.Summary(key) is { } v
                                    ? v.ToString(context.Item.IsCounting(key) ? "0.##" : "0.000")
                                    : "—")
                            </CellTemplate>
                        </TemplateColumn>
                    }

                    <PropertyColumn T="PlayerForm" TProperty="DateTimeOffset" Property="p => p.LastPlayed"
                                    Title="Last" Align="Align.Right">
                        <CellTemplate>
                            <span class="dim">@DisplayTime.Day(context.Item.LastPlayed)</span>
                        </CellTemplate>
                    </PropertyColumn>
                </DeskGrid>
            </div>
            </PanelSection>
        }
    </text>;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        _games = await db.Games.AsNoTracking()
            .Include(g => g.HomeTeam).Include(g => g.AwayTeam)
            .Where(g => db.OddsSnapshots.Any(s => s.GameId == g.Id))
            .OrderBy(g => g.StartsAt)
            .Take(120)
            .ToListAsync();

        _gameId = GameId ?? _games.FirstOrDefault()?.Id;
        _picked = await PickedAsync(db);
        await LoadAsync();
    }

    /// <summary>Whether the select has an option for this game, so it names it rather than its placeholder.</summary>
    private bool Listed(int? id)
        => id is not null && (_games.Any(g => g.Id == id) || _picked?.Id == id);

    private async Task OnGameChanged(int? id)
    {
        _gameId = id;

        await using (var db = await DbFactory.CreateDbContextAsync())
            _picked = await PickedAsync(db);

        await LoadAsync();
    }

    /// <summary>The chosen game with its teams and sport, so the sides can be put in matchup order.</summary>
    private async Task<Game?> PickedAsync(LineOpsDbContext db)
        => _gameId is { } id
            ? await db.Games.AsNoTracking()
                .Include(g => g.HomeTeam).Include(g => g.AwayTeam).Include(g => g.Sport)
                .FirstOrDefaultAsync(g => g.Id == id)
            : null;

    private async Task SetMarketAsync(string market)
    {
        _market = market;
        await LoadAsync();
    }

    /// <summary>The other side of what is already loaded: nothing is read again.</summary>
    private void SetSide(string side)
    {
        _side = side;
        Focus();
    }

    private async Task SetWindowAsync(int days)
    {
        _windowDays = days;
        await LoadFormAsync();
    }

    /// <summary>
    /// The cross-reference read. Separate from the odds load because the two answer different
    /// questions about the same game and only one of them changes when the market does.
    /// </summary>
    private async Task LoadFormAsync()
    {
        _form = null;

        if (_gameId is not { } gameId)
            return;

        await using var scope = ScopeFactory.CreateAsyncScope();
        var lookup = scope.ServiceProvider.GetRequiredService<MatchupCrossReference>();

        _form = await lookup.GetAsync(gameId, TimeSpan.FromDays(_windowDays));
    }

    private async Task LoadAsync()
    {
        _snapshots = [];
        _sideOptions = [];
        _rows = [];
        _headline = string.Empty;
        _span = string.Empty;

        await LoadFormAsync();

        if (_gameId is not { } gameId)
        {
            Report(PulseState.Idle);
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();

        _snapshots = await db.OddsSnapshots
            .Where(s => s.GameId == gameId && s.Market == _market)
            .OrderBy(s => s.CapturedAt)
            .ToListAsync();

        if (_snapshots.Count == 0)
        {
            Report(PulseState.Idle, "no moves");
            return;
        }

        var sides = Sides(_snapshots.Select(s => s.Outcome), _market,
            _picked?.AwayTeam?.Name, _picked?.HomeTeam?.Name);

        // Short names unless two clubs share one: the White Sox and the Red Sox are both "Sox".
        var shortNames = sides.Select(SideLabel).Distinct(StringComparer.OrdinalIgnoreCase).Count() == sides.Count;

        _sideOptions = sides
            .Select(o => new DeskSwitchOption<string>(o, shortNames ? SideLabel(o) : o, o.Contains(' ') ? o : null))
            .ToList();

        if (_side is null || !sides.Contains(_side))
            _side = sides[0];

        Focus();
    }

    /// <summary>Builds the rows, the headline and the window's status for the side in focus.</summary>
    private void Focus()
    {
        _rows = _side is null ? [] : MovementRows(_snapshots, _side);

        if (_rows.Count == 0)
        {
            _headline = string.Empty;
            _span = string.Empty;
            Report(PulseState.Idle, "no moves");
            return;
        }

        _headline = Headline(_rows, _market, _side!);
        _span = SpanText(_rows);

        Report(PulseState.Healthy, MovesText(_rows.Sum(r => r.Moves)));
    }

    // ---- The movement, as data -------------------------------------------------------------
    // Static and free of the database, so the arithmetic a reader trusts — what counts as a
    // move, which way it went, how far — is tested on its own (OddsMovementTests).

    /// <summary>
    /// One book's prices for the side in focus, open to now.
    ///
    /// <para>
    /// <see cref="Moves"/> is every observation after the first: prices are written only when
    /// they change, so each later row is a move and the first is where the book opened.
    /// <see cref="Trend"/> is what the sparkline draws, with <see cref="Positions"/> placing
    /// each value on the time axis the whole table shares; it ends with the last value held to
    /// the right edge, because a price written on change still stands until the next one.
    /// </para>
    /// </summary>
    public sealed record MovementRow(
        string Book,
        OddsSnapshot Open,
        OddsSnapshot Now,
        int Moves,
        bool TrendsLine,
        IReadOnlyList<double> Trend,
        IReadOnlyList<double>? Positions)
    {
        /// <summary>The price's change in cents, now less open. Null where either reading is broken.</summary>
        public int? PriceCents => Cents(Now.PriceAmerican) - Cents(Open.PriceAmerican);

        /// <summary>The line's change, now less open. Null on a moneyline.</summary>
        public decimal? LineChange => Now.Line - Open.Line;

        /// <summary>When the price last changed; null for a book seen once, which has not moved.</summary>
        public DateTimeOffset? LastMoved => Moves > 0 ? Now.CapturedAt : null;

        /// <summary>Whether open and now differ. A book can move and come back, which is not a move.</summary>
        public bool Moved => (PriceCents ?? 0) != 0 || (LineChange ?? 0) != 0;
    }

    /// <summary>
    /// An American price on a scale with no hole in it, in cents: +105 is 5, -105 is -5, and
    /// the ten cents between them are ten here rather than the 210 their numbers differ by.
    ///
    /// <para>
    /// American odds have nothing between -100 and +100, so subtracting them raw makes a move
    /// through even money look twenty times its size, and a sparkline of them draws a cliff.
    /// This keeps the order the numbers are written in — -120 below -110 below +105 — so the
    /// arrow and the sparkline go the way the printed number did, and closes the gap, so the
    /// distance is the one a bettor means by "ten cents". Zero is not a price (see
    /// <see cref="Implied"/>), so it has no place on the scale.
    /// </para>
    /// </summary>
    public static int? Cents(int american) => american switch
    {
        0 => null,
        > 0 => american - 100,
        _ => american + 100
    };

    /// <summary>
    /// A market's outcomes in the order the desk reads them: away before home, as the
    /// matchup reads ("Cowboys at Eagles"), and Over before Under. Anything else follows,
    /// alphabetically, so an outcome the provider named differently is offered, not lost.
    /// </summary>
    public static IReadOnlyList<string> Sides(IEnumerable<string> outcomes, string market, string? away, string? home)
    {
        static bool Is(string outcome, string? name)
            => name is not null && string.Equals(outcome, name, StringComparison.OrdinalIgnoreCase);

        int Order(string outcome) => market == Markets.Total
            ? Is(outcome, "over") ? 0 : Is(outcome, "under") ? 1 : 2
            : Is(outcome, away) ? 0 : Is(outcome, home) ? 1 : 2;

        return outcomes
            .Distinct(StringComparer.Ordinal)
            .OrderBy(Order)
            .ThenBy(o => o, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    /// <summary>
    /// Every book's row for one outcome. Snapshots for other outcomes are ignored, so the
    /// whole market can be handed over and the side chosen here.
    /// </summary>
    public static IReadOnlyList<MovementRow> MovementRows(IEnumerable<OddsSnapshot> snapshots, string outcome)
    {
        var side = snapshots
            .Where(s => string.Equals(s.Outcome, outcome, StringComparison.Ordinal))
            .OrderBy(s => s.CapturedAt)
            .ToList();

        if (side.Count == 0)
            return [];

        // One time axis for the table: the first reading at any book to the last. A side seen
        // at a single instant has no axis, and its sparklines are spaced evenly instead.
        var start = side[0].CapturedAt;
        var length = (side[^1].CapturedAt - start).TotalSeconds;

        double At(DateTimeOffset t) => (t - start).TotalSeconds / length;

        return side
            .GroupBy(s => s.Book, StringComparer.Ordinal)
            .Select(book =>
            {
                var seen = book.ToList();

                // A handicap market draws its number when the number moved, and its price when
                // only the juice did: a flat line beside "6¢" would say nothing happened.
                var trendsLine = seen.All(s => s.Line is not null)
                                 && seen.Select(s => s.Line).Distinct().Count() > 1;

                var plotted = seen
                    .Select(s => (s.CapturedAt, Value: trendsLine ? (double?)(double)s.Line!.Value : Cents(s.PriceAmerican)))
                    .Where(p => p.Value is not null)
                    .ToList();

                var values = plotted.Select(p => p.Value!.Value).ToList();
                List<double>? positions = length > 0 ? plotted.Select(p => At(p.CapturedAt)).ToList() : null;

                // The last price stands until the latest reading anywhere on the side.
                if (positions is not null && values.Count > 1 && positions[^1] < 1)
                {
                    values.Add(values[^1]);
                    positions.Add(1);
                }

                return new MovementRow(book.Key, seen[0], seen[^1], seen.Count - 1, trendsLine, values, positions);
            })
            .OrderBy(r => r.Book, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    /// <summary>
    /// The finding, in the voice a person would use saying it out loud — "Dallas Cowboys
    /// shortened +136 to -218 at draftkings" — about the side in focus.
    ///
    /// <para>
    /// The biggest move is the thing worth saying, so it is found and stated, including when
    /// there isn't one, because "nothing moved" is also a finding. A line move outranks any
    /// price move, since it changes what the bet is; between price moves the measure is
    /// implied probability, which is what actually moved.
    /// </para>
    /// </summary>
    public static string Headline(IReadOnlyList<MovementRow> rows, string market, string outcome)
    {
        var biggest = rows
            .Where(r => r.Moved)
            .OrderByDescending(r => Math.Abs(r.LineChange ?? 0))
            .ThenByDescending(r => Math.Abs(ImpliedChange(r)))
            .FirstOrDefault();

        if (biggest is null)
            return "Every book is holding its opening number";

        var (open, now) = (biggest.Open, biggest.Now);

        if ((biggest.LineChange ?? 0) != 0)
        {
            // Over and Under share one number, so a total's move belongs to the total.
            return market == Markets.Total
                ? $"The total moved {Bare(open.Line!.Value)} to {Bare(now.Line!.Value)} at {biggest.Book}"
                : $"{outcome} moved {OddsMath.FormatLine(open.Line!.Value, outcome)} to "
                  + $"{OddsMath.FormatLine(now.Line!.Value, outcome)} at {biggest.Book}";
        }

        // Shortened or drifted, said the way the desk would say it: a price whose implied
        // probability rose is one the market got more confident about.
        var who = market switch
        {
            Markets.Total when now.Line is { } total => $"{SideLabel(outcome)} {Bare(total)}",
            Markets.Spread when now.Line is { } line => $"{outcome} {OddsMath.FormatLine(line, outcome)}",
            _ => outcome
        };

        return $"{who} {(ImpliedChange(biggest) > 0 ? "shortened" : "drifted")} "
               + $"{Price(open.PriceAmerican)} to {Price(now.PriceAmerican)} at {biggest.Book}";
    }

    /// <summary>
    /// The secondary line: the span the rows cover and how many moves are in it — "Aug 24 to
    /// Oct 24 · 14 moves". A single day gives its hours instead, and a single instant says it
    /// was one reading.
    /// </summary>
    public static string SpanText(IReadOnlyList<MovementRow> rows)
    {
        if (rows.Count == 0)
            return string.Empty;

        var first = rows.Min(r => r.Open.CapturedAt);
        var last = rows.Max(r => r.Now.CapturedAt);

        var when = first == last
            ? $"Seen once, {DisplayTime.Stamp(first)}"
            : DisplayTime.Day(first) == DisplayTime.Day(last)
                ? $"{DisplayTime.Format(first, "MMM d HH:mm")} to {DisplayTime.Format(last, "HH:mm")} {DisplayTime.Label}"
                : $"{DisplayTime.Day(first)} to {DisplayTime.Day(last)}";

        return $"{when} · {MovesText(rows.Sum(r => r.Moves))}";
    }

    /// <summary>A count of moves, as the window's status and the span line both say it.</summary>
    public static string MovesText(int moves) => moves switch
    {
        0 => "no moves yet",
        1 => "1 move",
        _ => $"{moves} moves"
    };

    /// <summary>
    /// The Move cell: the line's change in points, then the price's in cents with the
    /// direction the number went — "-1.5 pts · ↓ 6¢". "unmoved" for a book seen once, and
    /// "no net move" for one that moved and came back, which are different facts.
    /// </summary>
    public static string MoveText(MovementRow row)
    {
        if (row.Moves == 0)
            return "unmoved";

        var parts = new List<string>(2);

        if (row.LineChange is { } line && line != 0)
            parts.Add($"{Signed(line)} {(Math.Abs(line) == 1 ? "pt" : "pts")}");

        if (row.PriceCents is { } cents && cents != 0)
            parts.Add($"{(cents > 0 ? "↑" : "↓")} {Math.Abs(cents)}¢");

        return parts.Count == 0 ? "no net move" : string.Join(" · ", parts);
    }

    /// <summary>The Move cell's tooltip: the same change in words, with what it means for the side.</summary>
    public static string MoveTitle(MovementRow row, string market)
    {
        if (row.Moves == 0)
            return $"Seen once, {DisplayTime.Stamp(row.Open.CapturedAt)}: nothing to compare it with yet";

        var parts = new List<string>(2);

        if (row.LineChange is { } line && line != 0)
        {
            parts.Add(market == Markets.Total
                ? $"Total {Bare(row.Open.Line!.Value)} to {Bare(row.Now.Line!.Value)}"
                : $"Line {OddsMath.FormatLine(row.Open.Line!.Value, row.Open.Outcome)} to "
                  + $"{OddsMath.FormatLine(row.Now.Line!.Value, row.Now.Outcome)}");
        }

        if (row.PriceCents is { } cents && cents != 0)
        {
            parts.Add($"price {Price(row.Open.PriceAmerican)} to {Price(row.Now.PriceAmerican)}, "
                      + $"{(ImpliedChange(row) > 0 ? "shortened" : "drifted")} {Math.Abs(cents)}¢");
        }

        if (parts.Count == 0)
            return $"Moved {row.Moves} {(row.Moves == 1 ? "time" : "times")} and is back at its opening number";

        var sentence = string.Join("; ", parts);
        return char.ToUpperInvariant(sentence[0]) + sentence[1..];
    }

    /// <summary>
    /// The sparkline's accessible name: what it draws, from the open to now, and how many moves
    /// — the numbers somebody who cannot see the shape needs instead of it.
    /// </summary>
    public static string TrendLabel(MovementRow row)
    {
        var moves = row.Moves == 0 ? "seen once, no moves" : MovesText(row.Moves);

        if (row.TrendsLine)
            return $"Line {OddsMath.FormatLine(row.Open.Line!.Value, row.Open.Outcome)} to "
                   + $"{OddsMath.FormatLine(row.Now.Line!.Value, row.Now.Outcome)}, {moves}";

        return row.Moves == 0
            ? $"Price {Price(row.Now.PriceAmerican)}, {moves}"
            : $"Price {Price(row.Open.PriceAmerican)} to {Price(row.Now.PriceAmerican)}, {moves}";
    }

    /// <summary>
    /// A reading as the market writes it: the price alone on a moneyline, the line and its price
    /// on a spread or total — "+4.5 -104". A stored zero is a broken reading and says so.
    /// </summary>
    public static string Quote(OddsSnapshot s)
    {
        var price = s.PriceAmerican == 0 ? "—" : Price(s.PriceAmerican);

        return s.Line is { } line ? $"{OddsMath.FormatLine(line, s.Outcome)} {price}" : price;
    }

    /// <summary>"2.0d ago", in the desk's own age wording.</summary>
    public static string Ago(DateTimeOffset at, DateTimeOffset now)
    {
        var minutes = (now - at).TotalMinutes;

        return minutes < 1 ? "just now" : $"{Age(minutes)} ago";
    }

    /// <summary>A side's name on the switch: the club's last word, or Over and Under capitalised.</summary>
    private static string SideLabel(string outcome)
    {
        var label = SelectionText.Short(outcome);

        return label.Length == 0 ? label : char.ToUpperInvariant(label[0]) + label[1..];
    }

    /// <summary>
    /// What a column sorts on: the line first where there is one, then the price on the cents
    /// scale, so books on the same number sort by what they pay. A broken price sorts last.
    /// </summary>
    private static double Rank(OddsSnapshot s)
        => (double)(s.Line ?? 0m) * 10_000 + (Cents(s.PriceAmerican) ?? -9_999);

    /// <summary>How big a move was, for sorting the Move column: points first, then cents.</summary>
    private static double MoveSize(MovementRow row)
        => (double)Math.Abs(row.LineChange ?? 0m) * 10_000 + Math.Abs(row.PriceCents ?? 0);

    /// <summary>The change in implied probability, open to now. Zero where either price is broken.</summary>
    private static double ImpliedChange(MovementRow row)
        => Implied(row.Now.PriceAmerican) is { } now && Implied(row.Open.PriceAmerican) is { } open
            ? now - open
            : 0;

    /// <summary>
    /// Implied probability, or null where the price cannot carry one.
    ///
    /// <para>
    /// Zero is not a price — there is no American odds value between -100 and +100 — so
    /// <c>OddsMath.ImpliedProbability</c> rejects it rather than inventing an answer. That
    /// contract is right, and it is deliberately not softened there. But it means a single
    /// malformed row from a provider would otherwise take down the whole window: the throw
    /// lands in the load, not in one cell. A stored zero is a broken reading, so it is shown
    /// as one and the rest of the market still renders.
    /// </para>
    /// </summary>
    private static double? Implied(int american)
        => american == 0 ? null : OddsMath.ImpliedProbability(american);

    private static string Signed(decimal value)
        => (value > 0 ? "+" : "") + value.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);

    /// <summary>A total's number, unsigned: "47.5", since Over and Under both read it.</summary>
    private static string Bare(decimal value)
        => Math.Abs(value).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
}

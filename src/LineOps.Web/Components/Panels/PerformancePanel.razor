@using LineOps.Data
@using LineOps.Web.Windowing
@using Microsoft.EntityFrameworkCore
@inherits PanelBase
@inject IDbContextFactory<LineOpsDbContext> DbFactory

@if (_summary.SettledCount == 0)
{
    @* This panel had no control of any kind: a screen that names the window you need and then
       makes you go and find it. The one step out of an empty screen belongs on the screen. *@
    <EmptyState Kind="EmptyStateKind.New">
        <ChildContent>
            No settled entries yet. Log entries in the Journal and settle them once games
            finish — closing-line value resolves at the same time.
        </ChildContent>
        <Action>
            <DeskButton Size="DeskKeySize.Small" Emphasis="DeskEmphasis.Tinted"
                        Icon="@Icons.Material.Filled.MenuBook"
                        OnClick="() => Manager.OpenJournal()">
                Open the Journal
            </DeskButton>
        </Action>
    </EmptyState>
}
else
{
    <MetricRow Style="margin-bottom:16px">
        <Metric Label="ROI"
                Value='@_summary.Roi.ToString("P1")'
                Note='@($"{_summary.SettledCount} settled")'
                State="@(_summary.Roi > 0 ? DeskState.Positive : _summary.Roi < 0 ? DeskState.Negative : DeskState.Neutral)" />
        <Metric Label="Net"
                Value='@_summary.NetProfit.ToString("C0")'
                Note='@($"on {_summary.TotalStaked.ToString("C0")} staked")'
                State="@(_summary.NetProfit > 0 ? DeskState.Positive : _summary.NetProfit < 0 ? DeskState.Negative : DeskState.Neutral)" />
        <Metric Label="Win rate"
                Value='@_summary.WinRate.ToString("P0")'
                Note='@($"{_summary.Wins} W · {_summary.Losses} L · {_summary.Pushes} P")' />
        <Metric Label="Beat the close"
                Value="@_beatRate"
                Note='@($"avg {_avgClv.ToString("+0.00;-0.00")}%")'
                State="@(_avgClv > 0 ? DeskState.Positive : _avgClv < 0 ? DeskState.Negative : DeskState.Neutral)" />
    </MetricRow>

    <PanelHeader>Bankroll</PanelHeader>
    @if (_bankroll.Length > 1)
    {
        <DeskChart Series="@_bankrollSeries" Labels="@_labels" Height="200px"
                   Family="DeskChartFamily.Ledger"
                   ShowLegend="false"
                   Takeaway="Cumulative units across every settled entry, oldest first."
                   Description="Line chart of cumulative units won or lost over settled entries." />
    }
    else
    {
        <EmptyState Kind="EmptyStateKind.New">Two settled entries are needed to plot a curve.</EmptyState>
    }

    <PanelHeader>By market</PanelHeader>
    @Breakdown(_byMarket)

    <PanelHeader>By book</PanelHeader>
    @Breakdown(_byBook)
}

@code {
    private PerformanceSummary _summary;
    private double[] _bankroll = [];
    private List<ChartSeries<double>> _bankrollSeries = [];
    private string[] _labels = [];
    // Held flat rather than as the dictionaries the analytics return: a grid binds to rows, and
    // rebuilding that list inside the render would hand MudDataGrid a new collection every time,
    // throwing away the sort the operator had just clicked.
    private List<BreakdownRow> _byMarket = [];
    private List<BreakdownRow> _byBook = [];
    private string _beatRate = "—";
    private double _avgClv;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var entries = await db.JournalEntries.ToListAsync();

        _summary = PerformanceAnalytics.Summarise(entries);
        _byMarket = Rows(PerformanceAnalytics.SummariseBy(entries, e => e.Market));
        _byBook = Rows(PerformanceAnalytics.SummariseBy(entries, e => e.Book));

        var curve = PerformanceAnalytics.BankrollCurve(entries);
        _bankroll = curve.Select(p => (double)p.Cumulative).ToArray();

        // Built once here rather than in the markup: DeskChart rebuilds the plot when the
        // series reference changes, and an expression in the template hands it a new list
        // on every render of the panel.
        _bankrollSeries = [new ChartSeries<double> { Name = "Cumulative", Data = _bankroll }];

        var stride = Math.Max(1, curve.Count / 6);
        _labels = curve
            .Select((p, i) => i % stride == 0 ? p.At.ToLocalTime().ToString("MMM d") : string.Empty)
            .ToArray();

        var clvs = entries
            .Where(e => e.ClosingPrice is not null && e.PriceTaken != 0)
            .Select(e => new ClvResult(e.PriceTaken, e.ClosingPrice!.Value))
            .ToList();

        if (clvs.Count > 0)
        {
            _beatRate = ((double)clvs.Count(c => c.BeatClose) / clvs.Count).ToString("P0");
            _avgClv = clvs.Average(c => c.CentsPercent);
        }

        // CLV is the honest signal, so it — not profit — sets this window's state.
        Report(
            _summary.SettledCount == 0 ? PulseState.Idle
            : _avgClv > 0 ? PulseState.Healthy
            : PulseState.Warn,
            _summary.SettledCount == 0 ? null : _summary.Roi.ToString("P1") + " ROI");
    }

    private static List<BreakdownRow> Rows(IReadOnlyDictionary<string, PerformanceSummary> data)
        => data.Select(kv => new BreakdownRow(kv.Key, kv.Value)).ToList();

    private RenderFragment Breakdown(List<BreakdownRow> data) => @<text>
        @if (data.Count == 0)
        {
            <EmptyState Kind="EmptyStateKind.Filtered">No settled entries.</EmptyState>
        }
        else
        {
            <DeskGrid T="BreakdownRow"
                      Items="data"
                      EmptyText="No settled entries.">
                <PropertyColumn T="BreakdownRow" TProperty="string" Property="r => r.Key" Title="Key" />

                <PropertyColumn T="BreakdownRow" TProperty="int" Property="r => r.Summary.SettledCount"
                                Title="Bets" Align="Align.Right">
                    <CellTemplate><span class="dim">@context.Item.Summary.SettledCount</span></CellTemplate>
                </PropertyColumn>

                @* Best-earning first was the hand-written order; sorting keeps it as the default
                   rather than as the only one. *@
                <PropertyColumn T="BreakdownRow" TProperty="decimal" Property="r => r.Summary.NetProfit"
                                Title="Net" Align="Align.Right" InitialDirection="SortDirection.Descending">
                    <CellTemplate>
                        <span class="@(context.Item.Summary.NetProfit > 0 ? "up" : context.Item.Summary.NetProfit < 0 ? "down" : null)">
                            @context.Item.Summary.NetProfit.ToString("C0")
                        </span>
                    </CellTemplate>
                </PropertyColumn>

                <PropertyColumn T="BreakdownRow" TProperty="decimal" Property="r => r.Summary.Roi"
                                Title="ROI" Align="Align.Right">
                    <CellTemplate><span class="dim">@context.Item.Summary.Roi.ToString("P1")</span></CellTemplate>
                </PropertyColumn>
            </DeskGrid>
        }
    </text>;

    /// <summary>One breakdown line. The dictionary is flattened because a grid sorts rows.</summary>
    private sealed record BreakdownRow(string Key, PerformanceSummary Summary);
}

@using LineOps.Data.CrossReference
@using LineOps.Web.Components.Desk
@inject IServiceScopeFactory ScopeFactory

@*
    Recent form for both rosters, beside the price.

    Same lookup the Line movement window uses — read live from the stats history by reference,
    nothing copied. The reason it is worth a floating panel rather than a window is that it is
    consulted *while* deciding: it wants to sit next to the board, not replace it.
*@

@if (_form is null)
{
    <EmptyState>Reading the last @_windowDays days…</EmptyState>
}
else if (_form.IsEmpty)
{
    <EmptyState Kind="EmptyStateKind.Filtered">
        No appearances on record for either roster in the last @_windowDays days. History is
        gathered separately — open the History window to backfill it.
    </EmptyState>
}
else
{
    <div class="row" style="margin-bottom:10px">
        <DeskSwitch Options="GateOptions.LookbackDays" Label="Lookback window" Mono="true"
                    Value="_windowDays" ValueChanged="@((int days) => SetWindowAsync(days))" />
        <span class="dim" style="font-size:11.5px">
            @_form.LinesRead stat @(_form.LinesRead == 1 ? "line" : "lines") read by reference
        </span>
    </div>

    @RenderSide(_form.Away, Row?.Game.AwayTeam?.Name ?? "Away")
    @RenderSide(_form.Home, Row?.Game.HomeTeam?.Name ?? "Home")
}

@code {
    /// <summary>
    /// The game this view is about. Taken as an id rather than a row so the view can be hosted
    /// as a desk window, which is rebuilt from its parameters and cannot carry an object.
    /// </summary>
    [Parameter, EditorRequired] public int GameId { get; set; }

    private BoardRow? Row;
    private MatchupForm? _form;
    private int _windowDays = 30;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task SetWindowAsync(int days)
    {
        _windowDays = days;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var scope = ScopeFactory.CreateAsyncScope();

        Row ??= await scope.ServiceProvider.GetRequiredService<BoardService>().GetRowAsync(GameId);

        var lookup = scope.ServiceProvider.GetRequiredService<MatchupCrossReference>();
        _form = await lookup.GetAsync(GameId, TimeSpan.FromDays(_windowDays), maxPlayersPerTeam: 8);
    }

    private static bool IsRate(IReadOnlyList<PlayerForm> side, string key)
        => side.Any(p => p.Totals.ContainsKey(key) && !p.IsCounting(key));

    private static List<string> ColumnsFor(IReadOnlyList<PlayerForm> side)
        => side.SelectMany(p => p.Totals.Keys)
            .GroupBy(k => k)
            .OrderByDescending(g => g.Count())
            .ThenBy(g => g.Key)
            .Select(g => g.Key)
            .Take(4)
            .ToList();

    private RenderFragment RenderSide(IReadOnlyList<PlayerForm> side, string teamName) => @<text>
        @if (side.Count > 0)
        {
            var columns = ColumnsFor(side);

            <h4 class="panel-h" style="margin-top:10px; color:var(--haze)">@teamName</h4>
            <div class="gridwrap"><table class="grid">
                <thead>
                    <tr>
                        <th>Player</th>
                        <th>Pos</th>
                        <th class="r">GP</th>
                        @foreach (var c in columns)
                        {
                            <th class="r">@c@(IsRate(side, c) ? "/g" : "")</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in side)
                    {
                        <tr>
                            <td class="trunc" title="@p.Name">@p.Name</td>
                            <td class="dim">@(p.Position ?? "—")</td>
                            <td class="r">@p.Appearances</td>
                            @foreach (var c in columns)
                            {
                                <td class="r">
                                    @* A dash where a player has no reading, not a zero — they
                                       are different facts. *@
                                    @(p.Summary(c) is { } v ? v.ToString(p.IsCounting(c) ? "0.##" : "0.000") : "—")
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table></div>
        }
    </text>;
}

@using LineOps.Data.CrossReference
@using LineOps.Desk.Primitives
@inject IServiceScopeFactory ScopeFactory

@*
    Recent form for both rosters, beside the price.

    Same lookup the Line movement window uses — read live from the stats history by reference,
    nothing copied. The reason it is worth a floating panel rather than a window is that it is
    consulted *while* deciding: it wants to sit next to the board, not replace it.
*@

@if (_fight)
{
    @* A fight has no rosters: the form worth reading beside its price is the two fighters (ADR 0021). *@
    <LineOps.Web.Components.Snippets.TaleOfTheTape GameId="GameId" />
}
else if (_form is null)
{
    @* The lookback row and the first roster's rows, where they will land. Only on the first
       read: changing the window keeps the rosters on screen until the new ones arrive. *@
    <DeskSkeleton Width="40%" />
    <DeskGrid T="PlayerForm" Items="@(Array.Empty<PlayerForm>())" Loading="true" SkeletonRows="3"
              LoadingLabel="@($"Reading the last {_windowDays} days")" />
}
else if (_form.IsEmpty)
{
    <EmptyState Kind="EmptyStateKind.Filtered">
        No appearances on record for either roster in the last @_windowDays days. History is
        gathered separately — open the History window to backfill it.
    </EmptyState>
}
else
{
    <PanelToolbar>
        <DeskSwitch Options="GateOptions.LookbackDays" Label="Lookback window" Mono="true"
                    Value="_windowDays" ValueChanged="@((int days) => SetWindowAsync(days))" />
        <span class="meta">
            @_form.LinesRead.ToString("N0") stat @(_form.LinesRead == 1 ? "line" : "lines") read by reference
        </span>
    </PanelToolbar>

    @RenderSide(_form.Away, Row?.Game.AwayTeam?.Name ?? "Away")
    @RenderSide(_form.Home, Row?.Game.HomeTeam?.Name ?? "Home")
}

@code {
    /// <summary>
    /// The game this view is about. Taken as an id rather than a row so the view can be hosted
    /// as a desk window, which is rebuilt from its parameters and cannot carry an object.
    /// </summary>
    [Parameter, EditorRequired] public int GameId { get; set; }

    private BoardRow? Row;
    private MatchupForm? _form;
    private int _windowDays = 30;
    private bool _fight;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task SetWindowAsync(int days)
    {
        _windowDays = days;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var scope = ScopeFactory.CreateAsyncScope();

        Row ??= await scope.ServiceProvider.GetRequiredService<BoardService>().GetRowAsync(GameId);

        _fight = FightSports.IsFight(Row?.Game.Sport?.Key);
        if (_fight)
            return;

        var lookup = scope.ServiceProvider.GetRequiredService<MatchupCrossReference>();
        _form = await lookup.GetAsync(GameId, TimeSpan.FromDays(_windowDays), maxPlayersPerTeam: 8);
    }

    private static bool IsRate(IReadOnlyList<PlayerForm> side, string key)
        => side.Any(p => p.Totals.ContainsKey(key) && !p.IsCounting(key));

    private static List<string> ColumnsFor(IReadOnlyList<PlayerForm> side)
        => side.SelectMany(p => p.Totals.Keys)
            .GroupBy(k => k)
            .OrderByDescending(g => g.Count())
            .ThenBy(g => g.Key)
            .Select(g => g.Key)
            .Take(4)
            .ToList();

    private RenderFragment RenderSide(IReadOnlyList<PlayerForm> side, string teamName) => @<text>
        @if (side.Count > 0)
        {
            var columns = ColumnsFor(side);

            <PanelSection Class="psection--subject" Title="@teamName">
            <div class="gridwrap">
                <DeskGrid T="PlayerForm" Items="side" EmptyText="No appearances on record.">
                    <PropertyColumn T="PlayerForm" TProperty="string" Property="p => p.Name"
                                    Title="Player" CellClass="trunc">
                        <CellTemplate><span title="@context.Item.Name">@context.Item.Name</span></CellTemplate>
                    </PropertyColumn>

                    <PropertyColumn T="PlayerForm" TProperty="string" Property="p => p.Position!" Title="Pos" HeaderClass="col--wide" CellClass="col--wide">
                        <CellTemplate><span class="dim">@(context.Item.Position ?? "—")</span></CellTemplate>
                    </PropertyColumn>

                    <PropertyColumn T="PlayerForm" TProperty="int" Property="p => p.Appearances"
                                    Title="GP" Align="Align.Right" />

                    @* Stat keys differ per sport and per source, so the columns are derived from
                       the data rather than declared. A player with no reading sorts below every
                       real one rather than beside the zeroes — sorting a stat descending is how
                       you find the top of it, and a blank is not a nought. *@
                    @foreach (var c in columns)
                    {
                        var key = c;

                        <TemplateColumn T="PlayerForm" Sortable="true" Title="@(StatLabels.StatLabel(key) + (IsRate(side, key) ? "/g" : ""))"
                                        Align="Align.Right"
                                        SortBy="@(p => p.Summary(key) ?? double.MinValue)">
                            <CellTemplate>
                                @* A dash where a player has no reading, not a zero — they
                                   are different facts. *@
                                @(context.Item.Summary(key) is { } v
                                    ? v.ToString(context.Item.IsCounting(key) ? "#,0.##" : "0.000")
                                    : "—")
                            </CellTemplate>
                        </TemplateColumn>
                    }
                </DeskGrid>
            </div>
            </PanelSection>
        }
    </text>;
}

# Copy to .env and fill in. .env is gitignored; this file is not.
#
#   cp .env.example .env
#
# Then generate the HTTPS development certificate (see README → HTTPS):
#
#   dotnet dev-certs https -ep "$env:USERPROFILE\.aspnet\https\LineOps.Web.pfx" -p <CERT_PASSWORD>
#   dotnet dev-certs https --trust
#
# Use a long random value for each password, e.g.
#   [Convert]::ToBase64String((1..24|%{Get-Random -Max 256})) -replace '[+/=]',''

POSTGRES_PASSWORD=

# Must exactly match the -p value used when exporting the PFX above.
CERT_PASSWORD=

# Host directory containing LineOps.Web.pfx. Mounted read-only into the container.
#   Windows: ${USERPROFILE}/.aspnet/https
#   macOS/Linux: ${HOME}/.aspnet/https
CERT_PATH=${USERPROFILE}/.aspnet/https

# Host port for the app (HTTPS). Published on 127.0.0.1 only, never 0.0.0.0.
HTTPS_PORT=9443

# Optional provider keys. Blank is fine — the demo and ESPN sources need no auth.
ODDS_API_IO_KEY=
THE_ODDS_API_KEY=
BALLDONTLIE_KEY=

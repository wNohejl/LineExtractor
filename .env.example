# The shape of .env, which is gitignored; this file is not.
#
# Normally scripts/setup.ps1 writes .env for you, with random passwords and the HTTPS
# development certificate (README, "Quick start"). By hand instead:
#
#   cp .env.example .env
#   dotnet dev-certs https -ep "$env:USERPROFILE\.aspnet\https\LineOps.Web.pfx" -p <CERT_PASSWORD>
#
# Use a long random value for each password, e.g.
#   [Convert]::ToBase64String((1..24|%{Get-Random -Max 256})) -replace '[+/=]',''

POSTGRES_PASSWORD=

# Must exactly match the -p value used when exporting the PFX above.
CERT_PASSWORD=

# Host directory containing LineOps.Web.pfx. Mounted read-only into the container.
#   Windows: ${USERPROFILE}/.aspnet/https
#   macOS/Linux: ${HOME}/.aspnet/https
CERT_PATH=${USERPROFILE}/.aspnet/https

# Host port for the app (HTTPS). Published on 127.0.0.1 only, never 0.0.0.0.
HTTPS_PORT=9443

# The stats source (schedules, scores, box scores), off until you opt in.
# ESPN's endpoints are unofficial and undocumented. ESPN's terms of use license its services
# for personal, non-commercial use and prohibit automated access. Turning this on is your
# decision; use it only to keep data in your own local database, never to host, redistribute
# or sell it. The MLB Stats API (probable pitchers, MLB's ids) follows this switch.
# true, then start the stack again: docker compose -f docker-compose.yml -f compose/dev.yml up -d
ESPN_ENABLED=false

# Optional provider keys, for the containers (a host run reads appsettings.Local.json instead).
# Blank is fine: with no odds key there are simply no prices. A key does nothing until its
# *_ENABLED is true.
ODDS_API_IO_KEY=
ODDS_API_IO_ENABLED=false
# A The Odds API key (api.the-odds-api.com); odds-api.io rejects it with 401.
# Free Starter plan, 500 credits a month: https://the-odds-api.com/#get-access (key by email);
# usage and the key again: https://dash.the-odds-api.com/
THE_ODDS_API_KEY=
THE_ODDS_API_ENABLED=false
# Moneyline and spread are always requested. Leave this line out to add totals; blank drops them.
THE_ODDS_API_TOTALS=
BALLDONTLIE_KEY=
BALLDONTLIE_ENABLED=false

# Only for compose/tailnet.yml (the desk on your own tailnet, ADR 0022).
# Auth key from the Tailscale admin console (Settings -> Keys): not reusable, not ephemeral, tagged tag:xlines (required: an untagged node expires in about 180 days).
# Used once, at the node's first sign-in; its identity then lives on a volume.
TS_AUTHKEY=
# The node's name on the tailnet: https://<TS_HOSTNAME>.<tailnet>.ts.net
# Public in certificate logs once HTTPS is on, so keep it neutral.
TS_HOSTNAME=desk
# Once you know it, <TS_HOSTNAME>.<tailnet>.ts.net; any other Host is then refused. Blank is "*".
XLINES_TAILNET_HOST=
# The tailnet desk is gated: make this with scripts/new-access-code.ps1.
ACCESS_OPERATOR_CODE_HASH=

# One database, two desks (ADR 0023). Both optional, and each set on one machine only.
# On the desktop: its Tailscale address (`tailscale ip -4`), for compose/tailnet-db.yml.
#TAILNET_IP=100.x.y.z
# On the laptop: the desktop's POSTGRES_PASSWORD, for scripts/connect-remote-db.ps1.
#REMOTE_POSTGRES_PASSWORD=

<?xml version="1.0" encoding="utf-8"?>
<!--
  The feed a Desk application restores LineOps.Desk and LineOps.Desk.Hosting from: copy this file
  beside the application's solution. Everything else still comes from nuget.org; the mapping sends
  only the Desk's packages to GitHub Packages, so no other package can be answered by it.

  GitHub Packages asks for a sign-in even to read. Set DESK_FEED_USER to a GitHub user name and
  DESK_FEED_TOKEN to a personal access token (classic) with the read:packages scope, in the
  environment rather than in this file, which is committed.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="desk" value="https://nuget.pkg.github.com/wNohejl/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="desk">
      <package pattern="LineOps.Desk" />
      <package pattern="LineOps.Desk.*" />
    </packageSource>
  </packageSourceMapping>
  <packageSourceCredentials>
    <desk>
      <add key="Username" value="%DESK_FEED_USER%" />
      <add key="ClearTextPassword" value="%DESK_FEED_TOKEN%" />
    </desk>
  </packageSourceCredentials>
</configuration>

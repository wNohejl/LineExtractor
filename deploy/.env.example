# The hosted desk's secrets and settings. Copy to .env beside compose.yml, fill it in, and
# `chmod 600 .env`. Gitignored; never commit the filled copy.

# ── Where it answers ─────────────────────────────────────────────────────────────
# The DNS name pointing at this server. Caddy gets its certificate for it, and the web host
# refuses requests addressed to any other (AllowedHosts).
XLINES_HOST=desk.example.com
# Let's Encrypt's contact for expiry notices.
ACME_EMAIL=you@example.com

# ── Images ───────────────────────────────────────────────────────────────────────
# Published by .github/workflows/images.yml. `main` follows the branch; `sha-<commit>` pins
# one build, which is how a deploy is rolled back.
GHCR_OWNER=wnohejl
IMAGE_TAG=main

# ── Database ─────────────────────────────────────────────────────────────────────
# Long and random: openssl rand -base64 30 | tr -d '+/='
POSTGRES_PASSWORD=

# ── Access (ADR 0018) ────────────────────────────────────────────────────────────
# Made by ./scripts/new-access-code.ps1 (Role Operator / Guest). Hashes, never codes.
ACCESS_OPERATOR_CODE_HASH=
ACCESS_GUEST_CODE_HASH=
# true lets anyone read the desk without a code. Leave false until the stats port is a
# licensed source (going-public plan §4).
ACCESS_ALLOW_ANONYMOUS=false

# ── Providers ────────────────────────────────────────────────────────────────────
# The stats source (schedules, scores, box scores), off until you opt in.
# ESPN's endpoints are unofficial and undocumented. ESPN's terms of use license its services
# for personal, non-commercial use and prohibit automated access. Turning this on is your
# decision; use it only to keep data in your own local database, never to host, redistribute
# or sell it. The MLB Stats API follows this switch. Leave the desk gated (ACCESS_* above,
# SHARING_MODE in compose.yml) if you turn it on here.
ESPN_ENABLED=false

# The Odds API, free Starter plan of 500 credits a month: https://the-odds-api.com/#get-access
THE_ODDS_API_KEY=
THE_ODDS_API_ENABLED=false
# odds-api.io has no Enabled switch in compose.yml here, so its key alone does nothing; and its
# free tier is for evaluation, not a hosted desk (ADR 0024). balldontlie has no adapter.
ODDS_API_IO_KEY=
BALLDONTLIE_KEY=

# ── Backups ──────────────────────────────────────────────────────────────────────
BACKUP_KEEP_DAYS=14

# The hosted desk's secrets and settings. Copy to .env beside compose.yml, fill it in, and
# `chmod 600 .env`. Gitignored; never commit the filled copy.

# ── Where it answers ─────────────────────────────────────────────────────────────
# The DNS name pointing at this server. Caddy gets its certificate for it, and the web host
# refuses requests addressed to any other (AllowedHosts).
LINEOPS_HOST=desk.example.com
# Let's Encrypt's contact for expiry notices.
ACME_EMAIL=you@example.com

# ── Images ───────────────────────────────────────────────────────────────────────
# Published by .github/workflows/images.yml. `main` follows the branch; `sha-<commit>` pins
# one build, which is how a deploy is rolled back.
GHCR_OWNER=wnohejl
IMAGE_TAG=main

# ── Database ─────────────────────────────────────────────────────────────────────
# Long and random: openssl rand -base64 30 | tr -d '+/='
POSTGRES_PASSWORD=

# ── Access (ADR 0018) ────────────────────────────────────────────────────────────
# Made by ./scripts/new-access-code.ps1 (Role Operator / Guest). Hashes, never codes.
ACCESS_OPERATOR_CODE_HASH=
ACCESS_GUEST_CODE_HASH=
# true lets anyone read the desk without a code. Leave false until the stats port is a
# licensed source (going-public plan §4).
ACCESS_ALLOW_ANONYMOUS=false

# ── Providers ────────────────────────────────────────────────────────────────────
THE_ODDS_API_KEY=
THE_ODDS_API_ENABLED=false
ODDS_API_IO_KEY=
BALLDONTLIE_KEY=

# ── Backups ──────────────────────────────────────────────────────────────────────
BACKUP_KEEP_DAYS=14
